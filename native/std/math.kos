// std/math.kos: formulas as data — build a symbolic expression, evaluate
// it exactly, differentiate it by rule, simplify it, and write it as
// LaTeX for a paper. No model.
//
//   import "std/math.kos"
//
// num(v) / neg(e)                        a constant, a negation
// x(name)                                a variable, like x("t")
// add(a, b) / sub(a, b) / mul(a, b)      the four operations
// div(a, b) / pow(a, b)
// sin(e) / cos(e) / exp(e) / ln(e)       the usual functions
// at(e, names, values)                   the number the expression is,
//                                        with each name given a value
// deriv(e, name)                         the derivative, by rule
// simplify(e)                            constants folded, identities gone
// to_text(e)                             the expression in plain words
// to_latex(e)                            the expression as LaTeX
// to_mathml(e)                           the expression as MathML, for a page
// parse(text)                           plain typed maths read into an expression
// same(a, b)                             whether two expressions are the same function
//
// An expression is its own prefix encoding: a list of words. "+ a b" is
// a plus of two parts, "~ a" a negation, "sin a" a sine, "n:2" a number
// and any other word a variable by name. The v0.1 checker does not yet
// accept records that hold themselves, so the tree lives flat — every
// rule reads it with the same two helpers, extent and child.
//
// The point: a model can PROPOSE a formula, but only a checked formula
// evaluates — and what a program can differentiate, it can verify. A
// paper whose formulas went through here carries math the language has
// already read.

export [num, neg, x, add, sub, mul, div, pow, sin, cos, tan, exp, ln, at, subst, Root, solve, Integral, integrate, exact, exact_mathml, Calc, calc, calc_mathml, eq_mathml, deriv, simplify, to_text, to_latex, to_mathml, Parsed, parse, same, names_in]

fn num(v: Number) -> Text[] { return ["n:" + v.to_text()] }
fn neg(e: Text[]) -> Text[] { return ["~"].concat(e) }
fn x(name: Text) -> Text[] { return [name] }
fn add(a: Text[], b: Text[]) -> Text[] { return ["+"].concat(a).concat(b) }
fn sub(a: Text[], b: Text[]) -> Text[] { return ["-"].concat(a).concat(b) }
fn mul(a: Text[], b: Text[]) -> Text[] { return ["*"].concat(a).concat(b) }
fn div(a: Text[], b: Text[]) -> Text[] { return ["/"].concat(a).concat(b) }
fn pow(a: Text[], b: Text[]) -> Text[] { return ["^"].concat(a).concat(b) }
fn sin(e: Text[]) -> Text[] { return ["sin"].concat(e) }
fn cos(e: Text[]) -> Text[] { return ["cos"].concat(e) }
fn exp(e: Text[]) -> Text[] { return ["exp"].concat(e) }
fn ln(e: Text[]) -> Text[] { return ["ln"].concat(e) }
fn tan(e: Text[]) -> Text[] { return ["tan"].concat(e) }

// Angles inside the maths are radians, as in any calculus book; the
// language's own sin and cos take degrees.
fn std_sin(a: Number) -> Number { return (a * 180 / 3.141592653589793).sin() }
fn std_cos(a: Number) -> Number { return (a * 180 / 3.141592653589793).cos() }

// The names every formula may use without being given them.
fn std_constant(name: Text) -> Number {
  if name == "pi" { return 3.141592653589793 }
  if name == "e" { return 2.718281828459045 }
  return 0
}

// The shape of the list: how many parts an operator takes, how far a
// part starting at a place reaches, and the part itself.
fn arity(op: Text) -> Number {
  if op == "+" or op == "-" or op == "*" or op == "/" or op == "^" { return 2 }
  if op == "~" or op == "sin" or op == "cos" or op == "tan" or op == "abs" or op == "exp" or op == "ln" { return 1 }
  return 0
}

fn extent(ts: Text[], from: Number) -> Number recurse 64 {
  if from >= ts.length() { return 0 }
  let take = arity(ts[from])
  if take == 0 { return 1 }
  let first = extent(ts, from + 1)
  if take == 1 { return 1 + first }
  return 1 + first + extent(ts, from + 1 + first)
}

fn child(e: Text[], which: Number) -> Text[] recurse 64 {
  let first = extent(e, 1)
  if which == 1 { return e.slice(1, 1 + first) }
  return e.slice(1 + first, 1 + first + extent(e, 1 + first))
}

fn is_const(e: Text[]) -> Bool { return e.length() == 1 and e[0].starts_with("n:") }
fn cval(e: Text[]) -> Number { return e[0].slice(2, e[0].length()).to_number().or(0) }

// The value of an expression, read once from its last word to its first:
// numbers and names go on a stack, and each operator takes its operands
// from the top. One pass, no recursion, however deep the expression.
fn at(e: Text[], names: Text[], values: Number[]) -> Number {
  var stack: Number[] = []
  var i = e.length() - 1
  while i >= 0 {
    let t = e[i]
    let take = arity(t)
    if take == 0 {
      if t.starts_with("n:") { stack = stack.append(t.slice(2, t.length()).to_number().or(0)) }
      else {
        let k = names.index_of(t).or(-1)
        stack = stack.append(if k >= 0 { values[k] } else { std_constant(t) })
      }
    } else if take == 1 {
      let a = stack[stack.length() - 1]
      stack = stack.slice(0, stack.length() - 1)
      let v = if t == "~" { -a } else if t == "sin" { std_sin(a) } else if t == "cos" { std_cos(a) } else if t == "tan" { std_sin(a) / std_cos(a) } else if t == "abs" { a.abs() } else if t == "exp" { a.exp() } else { a.log() }
      stack = stack.append(v)
    } else {
      let a = stack[stack.length() - 1]
      let b = stack[stack.length() - 2]
      stack = stack.slice(0, stack.length() - 2)
      let v = if t == "+" { a + b } else if t == "-" { a - b } else if t == "*" { a * b } else if t == "/" { a / b } else { a.power(b) }
      stack = stack.append(v)
    }
    i -= 1
  }
  return if stack.is_empty() { 0 } else { stack[0] }
}

// The derivative, by rule. Constants die, variables are recognised, the
// chain rule runs through the functions, and products and quotients use
// their own laws. Nothing here is a model's guess.
fn deriv(e: Text[], name: Text) -> Text[] recurse 64 {
  if is_const(e) { return num(0) }
  if e.length() == 1 { return num(if e[0] == name { 1 } else { 0 }) }
  let op = e[0]
  if op == "~" { return neg(deriv(child(e, 1), name)) }
  if op == "+" { return add(deriv(child(e, 1), name), deriv(child(e, 2), name)) }
  if op == "-" { return sub(deriv(child(e, 1), name), deriv(child(e, 2), name)) }
  if op == "*" {
    let a = child(e, 1)
    let b = child(e, 2)
    return add(mul(deriv(a, name), b), mul(a, deriv(b, name)))
  }
  if op == "/" {
    let a = child(e, 1)
    let b = child(e, 2)
    return div(sub(mul(deriv(a, name), b), mul(a, deriv(b, name))), pow(b, num(2)))
  }
  if op == "^" {
    // d/du u^c = c * u^(c-1) * u', for a constant exponent c.
    let u = child(e, 1)
    let c = child(e, 2)
    if is_const(c) { return mul(mul(c, pow(u, num(cval(c) - 1))), deriv(u, name)) }
    return mul(pow(u, c), deriv(mul(c, ln(u)), name))
  }
  let u = child(e, 1)
  if op == "sin" { return mul(deriv(u, name), cos(u)) }
  if op == "cos" { return neg(mul(deriv(u, name), sin(u))) }
  if op == "exp" { return mul(deriv(u, name), exp(u)) }
  if op == "tan" { return div(deriv(u, name), pow(cos(u), num(2))) }
  if op == "abs" { return mul(deriv(u, name), div(u, ["abs"].concat(u))) }
  return div(deriv(u, name), u)
}

fn is_cval(e: Text[], v: Number) -> Bool { return is_const(e) and cval(e) == v }

// Constants fold, identities vanish: 0 + x is x, 1 * x is x, x * 0 is 0,
// x ^ 1 is x, and lone arithmetic on constants becomes one number.
fn simplify(e: Text[]) -> Text[] recurse 64 {
  if e.length() == 1 { return e }
  let op = e[0]
  if arity(op) == 1 {
    let a = simplify(child(e, 1))
    if op == "~" {
      if is_const(a) { return num(-cval(a)) }
      return neg(a)
    }
    if is_const(a) {
      let v = cval(a)
      if op == "sin" { return num(v.sin()) }
      if op == "cos" { return num(v.cos()) }
      if op == "exp" { return num(v.exp()) }
      return num(v.log())
    }
    return [op].concat(a)
  }
  let a = simplify(child(e, 1))
  let b = simplify(child(e, 2))
  if is_const(a) and is_const(b) {
    if op == "+" { return num(cval(a) + cval(b)) }
    if op == "-" { return num(cval(a) - cval(b)) }
    if op == "*" { return num(cval(a) * cval(b)) }
    if op == "/" { return num(cval(a) / cval(b)) }
    return num(cval(a).power(cval(b)))
  }
  if op == "+" {
    if is_cval(a, 0) { return b }
    if is_cval(b, 0) { return a }
  }
  if op == "-" and is_cval(b, 0) { return a }
  if op == "*" {
    if is_cval(a, 0) or is_cval(b, 0) { return num(0) }
    if is_cval(a, 1) { return b }
    if is_cval(b, 1) { return a }
    // A number leads a product: 2 cos t, not cos t 2.
    if is_const(b) and not is_const(a) { return ["*"].concat(b).concat(a) }
  }
  if op == "/" and is_cval(b, 1) { return a }
  if op == "^" {
    if is_cval(b, 1) { return a }
    if is_cval(b, 0) { return num(1) }
  }
  return [op].concat(a).concat(b)
}

// Precedence, so parentheses appear exactly where they are needed.
fn prec(op: Text) -> Number {
  if op == "+" or op == "-" { return 1 }
  if op == "*" or op == "/" { return 2 }
  if op == "^" { return 3 }
  if op == "~" or op == "sin" or op == "cos" or op == "tan" or op == "abs" or op == "exp" or op == "ln" { return 4 }
  return 5
}

fn num_text(v: Number) -> Text {
  let r = (v * 1000000000).round() / 1000000000
  return r.to_text()
}

fn to_text(e: Text[]) -> Text recurse 64 {
  if is_const(e) { return num_text(cval(e)) }
  if e.length() == 1 { return e[0] }
  let op = e[0]
  if op == "~" { return "-" + to_text(child(e, 1)) }
  if arity(op) == 1 { return op + "(" + to_text(child(e, 1)) + ")" }
  let mark = if op == "+" { " + " } else if op == "-" { " - " } else if op == "*" { " * " } else if op == "/" { " / " } else { " ^ " }
  return to_text(child(e, 1)) + mark + to_text(child(e, 2))
}

fn latex_of(e: Text[], parent: Number) -> Text recurse 64 {
  var body = ""
  if is_const(e) { body = num_text(cval(e)) }
  else if e.length() == 1 { body = e[0] }
  else {
    let op = e[0]
    if op == "~" { body = "-" + latex_of(child(e, 1), 5) }
    else if op == "sin" { body = "\\sin " + latex_of(child(e, 1), 3) }
    else if op == "cos" { body = "\\cos " + latex_of(child(e, 1), 3) }
    else if op == "exp" { body = "e^{" + latex_of(child(e, 1), 0) + "}" }
    else if op == "ln" { body = "\\ln " + latex_of(child(e, 1), 3) }
    else if op == "tan" { body = "\\tan " + latex_of(child(e, 1), 3) }
    else if op == "abs" { body = "\\left|" + latex_of(child(e, 1), 0) + "\\right|" }
    else if op == "/" { body = "\\frac{" + latex_of(child(e, 1), 0) + "}{" + latex_of(child(e, 2), 0) + "}" }
    else {
      let mark = if op == "+" { " + " } else if op == "-" { " - " } else if op == "*" { " \\cdot " } else { "^{" }
      let close = if op == "^" { "}" } else { "" }
      let own = prec(op)
      let leftText = latex_of(child(e, 1), if op == "-" or op == "^" { own + 1 } else { own })
      let rightText = latex_of(child(e, 2), own + 1)
      body = leftText + mark + rightText + close
    }
  }
  let ownPrec = if e.length() == 1 { 5 } else { prec(e[0]) }
  if ownPrec < parent { return "(" + body + ")" }
  return body
}

fn to_latex(e: Text[]) -> Text { return latex_of(e, 0) }

// MathML, the notation a browser draws as a paper would print it: names
// in italic, numbers upright, fractions stacked, roots over their radicand.
// A name with an underscore is subscripted (F_n, F_n-1), and phi, psi and
// pi are written as their Greek letters.
fn mathml_name(name: Text) -> Text recurse 4 {
  let greek = if name == "phi" { "&#966;" } else if name == "psi" { "&#968;" } else if name == "pi" { "&#960;" } else { name }
  let cut = name.index_of("_").or(-1)
  if cut < 1 { return f"<mi>{greek}</mi>" }
  let base = name.slice(0, cut)
  let sub = name.slice(cut + 1, name.length())
  let parts = sub.replace("-", " - ").replace("+", " + ").words()
  let inner = (for p in parts { if p == "-" { "<mo>&#8722;</mo>" } else if p == "+" { "<mo>+</mo>" } else if "0123456789".contains(p.slice(0, 1)) { f"<mn>{p}</mn>" } else { f"<mi>{p}</mi>" } }).join("")
  return f"<msub>{mathml_name(base)}<mrow>{inner}</mrow></msub>"
}

fn mathml_of(e: Text[], parent: Number) -> Text recurse 64 {
  var body = ""
  if is_const(e) { body = f"<mn>{num_text(cval(e))}</mn>" }
  else if e.length() == 1 { body = mathml_name(e[0]) }
  else {
    let op = e[0]
    if op == "~" { body = "<mo>&#8722;</mo>" + mathml_of(child(e, 1), 5) }
    else if op == "abs" { body = "<mo>|</mo>" + mathml_of(child(e, 1), 0) + "<mo>|</mo>" }
    else if op == "sin" or op == "cos" or op == "tan" or op == "ln" {
      let arg = child(e, 1)
      let inner = mathml_of(arg, 0)
      body = f"<mspace width=\"0.17em\"/><mi>{op}</mi><mo>&#8289;</mo><mspace width=\"0.1em\"/>" + (if arg.length() == 1 { inner } else { "<mo stretchy=\"false\">(</mo>" + inner + "<mo stretchy=\"false\">)</mo>" })
    }
    else if op == "exp" { body = "<msup><mi>e</mi><mrow>" + mathml_of(child(e, 1), 0) + "</mrow></msup>" }
    else if op == "/" { body = "<mfrac><mrow>" + mathml_of(child(e, 1), 0) + "</mrow><mrow>" + mathml_of(child(e, 2), 0) + "</mrow></mfrac>" }
    else if op == "^" and is_const(child(e, 2)) and cval(child(e, 2)) == 0.5 { body = "<msqrt>" + mathml_of(child(e, 1), 0) + "</msqrt>" }
    else if op == "^" { body = "<msup><mrow>" + mathml_of(child(e, 1), 4) + "</mrow><mrow>" + mathml_of(child(e, 2), 0) + "</mrow></msup>" }
    else {
      let mark = if op == "+" { "<mo>+</mo>" } else if op == "-" { "<mo>&#8722;</mo>" } else if starts_with_number(child(e, 2)) { "<mo>&#215;</mo>" } else { "<mo>&#8290;</mo>" }
      let own = prec(op)
      body = mathml_of(child(e, 1), own) + mark + mathml_of(child(e, 2), if op == "-" { own + 1 } else { own })
    }
  }
  let ownPrec = if e.length() == 1 { 5 } else { prec(e[0]) }
  if ownPrec < parent { return "<mrow><mo>(</mo>" + body + "<mo>)</mo></mrow>" }
  return body
}

// Whether an expression is written starting with a digit: then a product
// needs its times sign, or 2 and 3 would read as 23.
fn starts_with_number(e: Text[]) -> Bool recurse 64 {
  if is_const(e) { return true }
  if e.length() == 1 { return false }
  if e[0] == "^" or e[0] == "*" { return starts_with_number(child(e, 1)) }
  return false
}

fn to_mathml(e: Text[]) -> Text { return "<mrow>" + mathml_of(e, 0) + "</mrow>" }

test "MathML writes fractions, roots, powers and subscripts" {
  binet = div(sub(pow(x("phi"), x("n")), pow(x("psi"), x("n"))), pow(num(5), num(0.5)))
  m = to_mathml(binet)
  expect m.contains("<mfrac>")
  expect m.contains("<msqrt><mn>5</mn></msqrt>")
  expect m.contains("<msup><mrow><mi>&#966;</mi></mrow><mrow><mi>n</mi></mrow></msup>")
  expect to_mathml(x("F_n-1")) == "<mrow><msub><mi>F</mi><mrow><mi>n</mi><mo>&#8722;</mo><mn>1</mn></mrow></msub></mrow>"
}

// ---------------------------------------------------------------- reading plain maths
//
// parse("x^2 sin(x) + 3x") reads maths as people type it into an
// expression: + - * / ^, brackets, numbers, names, the functions sin, cos,
// exp, ln and sqrt, and multiplication written by putting things side by
// side (2x, x sin(x), (x+1)(x-1)). A parse that fails says why.
//
// same(a, b) says whether two expressions are the same function: both are
// evaluated at several points for every name in them.

record Parsed { expr: Text[] error: Text }
record ParseStep { e: Text[] at: Number error: Text }

fn std_letter(ch: Text) -> Bool { return ch != "" and "abcdefghijklmnopqrstuvwxyz_".contains(ch.lower()) }
fn std_digit(ch: Text) -> Bool { return ch != "" and "0123456789.".contains(ch) }

// The text as tokens: numbers, names, and one-character signs.
fn tokens(text: Text) -> Text[] {
  var out: Text[] = []
  var i = 0
  let n = text.length()
  while i < n {
    let ch = text.slice(i, i + 1)
    if ch == " " { i += 1 }
    else if std_digit(ch) {
      var j = i
      while j < n and std_digit(text.slice(j, j + 1)) { j += 1 }
      out = out.append(text.slice(i, j))
      i = j
    } else if std_letter(ch) {
      var j = i
      while j < n and (std_letter(text.slice(j, j + 1)) or std_digit(text.slice(j, j + 1))) { j += 1 }
      out = out.append(text.slice(i, j))
      i = j
    } else {
      out = out.append(ch)
      i += 1
    }
  }
  return out
}

fn std_functions() -> Text[] { return ["sin", "cos", "tan", "abs", "exp", "ln", "sqrt"] }

fn is_number_token(t: Text) -> Bool { return t.length() > 0 and std_digit(t.slice(0, 1)) }
fn is_name_token(t: Text) -> Bool { return t.length() > 0 and std_letter(t.slice(0, 1)) }

// Where an atom can start: a number, a name or an opening bracket.
fn starts_atom(t: Text) -> Bool { return is_number_token(t) or is_name_token(t) or t == "(" }

fn sum_of(ts: Text[], pos: Number) -> ParseStep recurse 64 {
  var left = product_of(ts, pos)
  if not left.error.is_empty() { return left }
  while left.at < ts.length() and (ts[left.at] == "+" or ts[left.at] == "-") {
    let op = ts[left.at]
    let right = product_of(ts, left.at + 1)
    if not right.error.is_empty() { return right }
    left = {e: if op == "+" { add(left.e, right.e) } else { sub(left.e, right.e) }, at: right.at, error: ""}
  }
  return left
}

fn product_of(ts: Text[], pos: Number) -> ParseStep recurse 64 {
  var left = signed_of(ts, pos)
  if not left.error.is_empty() { return left }
  while left.at < ts.length() and (ts[left.at] == "*" or ts[left.at] == "/" or starts_atom(ts[left.at])) {
    let op = ts[left.at]
    let from = if op == "*" or op == "/" { left.at + 1 } else { left.at }
    let right = signed_of(ts, from)
    if not right.error.is_empty() { return right }
    left = {e: if op == "/" { div(left.e, right.e) } else { mul(left.e, right.e) }, at: right.at, error: ""}
  }
  return left
}

fn signed_of(ts: Text[], pos: Number) -> ParseStep recurse 64 {
  if pos < ts.length() and ts[pos] == "-" {
    let inner = signed_of(ts, pos + 1)
    if not inner.error.is_empty() { return inner }
    return {e: neg(inner.e), at: inner.at, error: ""}
  }
  return power_of(ts, pos)
}

fn power_of(ts: Text[], pos: Number) -> ParseStep recurse 64 {
  let base = atom_of(ts, pos)
  if not base.error.is_empty() { return base }
  if base.at < ts.length() and ts[base.at] == "^" {
    let top = signed_of(ts, base.at + 1)
    if not top.error.is_empty() { return top }
    return {e: pow(base.e, top.e), at: top.at, error: ""}
  }
  return base
}

fn atom_of(ts: Text[], pos: Number) -> ParseStep recurse 64 {
  if pos >= ts.length() { return {e: [], at: pos, error: "the expression ends too soon"} }
  let t = ts[pos]
  if is_number_token(t) {
    let v = t.to_number()
    if not v.exists() { return {e: [], at: pos, error: f"{t} is not a number"} }
    return {e: num(v.value()), at: pos + 1, error: ""}
  }
  if t == "(" {
    let inner = sum_of(ts, pos + 1)
    if not inner.error.is_empty() { return inner }
    if inner.at >= ts.length() or ts[inner.at] != ")" { return {e: [], at: inner.at, error: "a bracket is not closed"} }
    return {e: inner.e, at: inner.at + 1, error: ""}
  }
  if is_name_token(t) {
    if std_functions().contains(t) {
      if pos + 1 >= ts.length() or ts[pos + 1] != "(" { return {e: [], at: pos + 1, error: f"{t} needs its argument in brackets"} }
      let arg = sum_of(ts, pos + 2)
      if not arg.error.is_empty() { return arg }
      if arg.at >= ts.length() or ts[arg.at] != ")" { return {e: [], at: arg.at, error: f"the bracket after {t} is not closed"} }
      let e = if t == "sqrt" { pow(arg.e, num(0.5)) } else { [t].concat(arg.e) }
      return {e: e, at: arg.at + 1, error: ""}
    }
    return {e: x(t), at: pos + 1, error: ""}
  }
  return {e: [], at: pos, error: f"unexpected {t}"}
}

fn parse(text: Text) -> Parsed {
  let ts = tokens(text)
  if ts.is_empty() { return {expr: [], error: "there is nothing to read"} }
  let got = sum_of(ts, 0)
  if not got.error.is_empty() { return {expr: [], error: got.error} }
  if got.at < ts.length() { return {expr: [], error: f"unexpected {ts[got.at]} after the end"} }
  return {expr: got.e, error: ""}
}

// The names an expression uses, other than numbers and operators.
fn names_in(e: Text[]) -> Text[] {
  var out: Text[] = []
  for t in e {
    if is_name_token(t) and arity(t) == 0 and not out.contains(t) { out = out.append(t) }
  }
  return out
}

// Two expressions are the same function when they agree, to six places,
// at five points chosen away from the edges of ln and sqrt.
fn same(a: Text[], b: Text[]) -> Bool {
  let names = names_in(a).concat(names_in(b))
  let points = [0.37, 0.81, 1.29, 1.93, 2.71]
  for k in 0 until points.length() {
    let values = for j in 0 until names.length() { points[(k + j) % points.length()] + j * 0.13 }
    let va = at(a, names, values)
    let vb = at(b, names, values)
    if (va - vb).abs() > 0.000001 * (1 + va.abs()) { return false }
  }
  return true
}

test "plain maths is read as people type it" {
  expect parse("x^2 sin(x) + 3x").expr.join(" ") == "+ * ^ x n:2 sin x * n:3 x"
  expect at(parse("(x+1)(x-1)").expr, ["x"], [3]) == 8
  expect at(parse("-2^2").expr, [], []) == -4
  expect at(parse("sqrt(16)/2").expr, [], []) == 2
  expect parse("sin x").error == "sin needs its argument in brackets"
  expect parse("(x+1").error == "a bracket is not closed"
}

test "same tells equal functions from different ones" {
  expect same(parse("(x+1)^2").expr, parse("x^2 + 2x + 1").expr)
  expect not same(parse("(x+1)^2").expr, parse("x^2 + 1").expr)
  expect same(deriv(parse("x^2 sin(x)").expr, "x"), parse("2x sin(x) + x^2 cos(x)").expr)
}

test "an expression evaluates exactly" {
  // t^2 + 3t - 5 at t = 2 is 5.
  f = add(add(pow(x("t"), num(2)), mul(num(3), x("t"))), num(-5))
  expect at(f, ["t"], [2]) == 5
  expect at(f, ["t"], [0]) == -5
}

test "the derivative knows its rules" {
  // d/dt t^2 is 2t; the simplifier folds the rule's arithmetic away.
  d = simplify(deriv(pow(x("t"), num(2)), "t"))
  expect d.join(" ") == "* n:2 t"
  // d/dt sin(t) is cos(t), and a constant's derivative is 0.
  expect simplify(deriv(sin(x("t")), "t")).join(" ") == "cos t"
  expect simplify(deriv(num(7), "t")).join(" ") == "n:0"
  // d/dt e^t is e^t.
  expect simplify(deriv(exp(x("t")), "t")).join(" ") == "exp t"
}

test "the chain rule runs through a function" {
  // d/dt sin(2t) is 2 cos(2t).
  d = simplify(deriv(sin(mul(num(2), x("t"))), "t"))
  expect d.join(" ") == "* n:2 cos * n:2 t"
}

test "LaTeX writes fractions, powers and functions" {
  f = div(add(x("t"), num(1)), pow(x("t"), num(2)))
  expect to_latex(f) == "\\frac{t + 1}{t^{2}}"
  expect to_latex(mul(num(2), x("t"))) == "2 \\cdot t"
  expect to_latex(sin(pow(x("t"), num(2)))) == "\\sin t^{2}"
}

test "the simplifier folds and removes identities" {
  expect simplify(add(num(0), x("t"))).join(" ") == "t"
  expect simplify(mul(x("t"), num(1))).join(" ") == "t"
  expect simplify(mul(x("t"), num(0))).join(" ") == "n:0"
  expect simplify(add(num(2), num(3))).join(" ") == "n:5"
  expect simplify(pow(x("t"), num(1))).join(" ") == "t"
}

// ---------------------------------------------------------------- calculating
//
// subst puts a number in for a name. solve finds where an expression is
// zero by Newton's method, stepping with the derivative Kosika works out
// by rule, and says how many steps it took and whether it settled.
// integrate finds a definite integral by Simpson's rule, twice, at two
// step sizes, and says how far apart the two were. exact writes a number
// the way a person would: 1/3, 2/3 pi, sqrt 2, when the number is one of
// those to nine places, and as a decimal otherwise.

fn subst(e: Text[], name: Text, value: Number) -> Text[] {
  return for t in e { if t == name { "n:" + value.to_text() } else { t } }
}

record Root { value: Number steps: Number ok: Bool note: Text }

fn solve(e: Text[], name: Text, guess: Number) -> Root {
  let slope = simplify(deriv(e, name))
  var v = guess
  var steps = 0
  var settled = false
  var stuck = false
  for k in 0 until 60 {
    if not settled and not stuck {
      let f = at(e, [name], [v])
      let d = at(slope, [name], [v])
      if d == 0 { stuck = true } else {
        let next = v - f / d
        steps = steps + 1
        if (next - v).abs() < 0.000000000001 * (1 + next.abs()) { settled = true }
        v = next
      }
    }
  }
  let left = at(e, [name], [v]).abs()
  let ok = settled and left < 0.000001
  let note = if ok { f"settled after {steps} steps of Newton's method" } else if stuck { "the slope is flat there; try another starting guess" } else { "it did not settle; try another starting guess" }
  return {value: (v * 1000000000000).round() / 1000000000000, steps: steps, ok: ok, note: note}
}

record Integral { value: Number error: Number note: Text }

fn simpson(e: Text[], name: Text, a: Number, b: Number, n: Number) -> Number {
  let h = (b - a) / n
  var total = at(e, [name], [a]) + at(e, [name], [b])
  for k in 1 until n {
    total = total + (if k % 2 == 1 { 4 } else { 2 }) * at(e, [name], [a + k * h])
  }
  return total * h / 3
}

fn integrate(e: Text[], name: Text, a: Number, b: Number) -> Integral {
  let coarse = simpson(e, name, a, b, 64)
  let fine = simpson(e, name, a, b, 128)
  let error = (fine - coarse).abs() / 15
  // Richardson's step: Simpson's error falls sixteenfold when the step
  // halves, so the two answers together give a better one than either.
  let better = fine + (fine - coarse) / 15
  return {value: (better * 1000000000).round() / 1000000000, error: error, note: f"Simpson's rule at 64 and 128 steps, then Richardson's step; the two agreed to {exact_places(error)} places"}
}

fn exact_places(error: Number) -> Number {
  if error <= 0 { return 12 }
  return (0 - error.log() / (10).log()).floor().max(0).min(12)
}

// A fraction p / q, with q at most 1000, within 1e-9 of v; [0, 0] if none.
fn exact_ratio(v: Number) -> Number[] {
  if v == v.round() { return [v, 1] }
  if v.abs() >= 1000000 { return [0, 0] }
  for q in 1 until 1001 {
    let p = (v * q).round()
    if (p / q - v).abs() < 0.000000001 { return [p, q] }
  }
  return [0, 0]
}

fn ratio_text(p: Number, q: Number) -> Text { return if q == 1 { f"{p}" } else { f"{p}/{q}" } }

fn exact(v: Number) -> Text {
  let r = exact_ratio(v)
  if r[1] > 0 { return ratio_text(r[0], r[1]) }
  let pi = exact_ratio(v / 3.141592653589793)
  if pi[1] > 0 and pi[1] <= 12 { return (if pi[0] == 1 { "" } else if pi[0] == -1 { "-" } else { f"{pi[0]}" }) + "pi" + (if pi[1] == 1 { "" } else { f"/{pi[1]}" }) }
  let square = exact_ratio(v * v)
  if square[1] == 1 and square[0] < 10000 { return (if v < 0 { "-" } else { "" }) + f"sqrt {square[0]}" }
  return num_text(v)
}

fn exact_mathml(v: Number) -> Text {
  let r = exact_ratio(v)
  if r[1] > 1 { return (if r[0] < 0 { "<mo>&#8722;</mo>" } else { "" }) + f"<mfrac><mn>{r[0].abs()}</mn><mn>{r[1]}</mn></mfrac>" }
  if r[1] == 1 { return f"<mn>{r[0]}</mn>" }
  let pi = exact_ratio(v / 3.141592653589793)
  if pi[1] > 0 and pi[1] <= 12 {
    let top = (if pi[0].abs() == 1 { "" } else { f"<mn>{pi[0].abs()}</mn>" }) + "<mi>&#960;</mi>"
    let sign = if pi[0] < 0 { "<mo>&#8722;</mo>" } else { "" }
    return sign + (if pi[1] == 1 { top } else { f"<mfrac><mrow>{top}</mrow><mn>{pi[1]}</mn></mfrac>" })
  }
  let square = exact_ratio(v * v)
  if square[1] == 1 and square[0] < 10000 { return (if v < 0 { "<mo>&#8722;</mo>" } else { "" }) + f"<msqrt><mn>{square[0]}</mn></msqrt>" }
  return f"<mn>{num_text(v)}</mn>"
}

// A calculation as a person writes it out: the formula, the same formula
// with the numbers put in, and the answer, exact where it can be and
// rounded to four significant places beside it.
record Calc { formula: Text substituted: Text value: Number exact: Text rounded: Text }

fn round_sig(v: Number, places: Number) -> Number {
  if v == 0 { return 0 }
  let size = (v.abs().log() / (10).log()).floor()
  let shift = places - 1 - size
  if shift >= 0 {
    let up = (10).power(shift)
    return (v * up).round() / up
  }
  let down = (10).power(0 - shift)
  return (v / down).round() * down
}

fn calc(e: Text[], names: Text[], values: Number[]) -> Calc {
  var put = e
  for k in 0 until names.length() { put = subst(put, names[k], values[k]) }
  let v = at(e, names, values)
  return {formula: to_mathml(e), substituted: to_mathml(put), value: v, exact: exact(v), rounded: num_text(round_sig(v, 4))}
}

fn eq_mathml(left: Text, right: Text) -> Text {
  return f"<math display=\"block\"><mrow>{left}<mo>=</mo>{right}</mrow></math>"
}

// The whole calculation, lined up on its equals signs.
// A number too big or too small to read is written a x 10^n.
fn number_mathml(v: Number) -> Text {
  if v == 0 or (v.abs() >= 0.001 and v.abs() < 1000000) { return f"<mn>{num_text(v)}</mn>" }
  let size = (v.abs().log() / (10).log()).floor()
  let shift = 0 - size
  let lead = if shift >= 0 { v * (10).power(shift) } else { v / (10).power(size) }
  return f"<mn>{num_text(round_sig(lead, 4))}</mn><mo>&#215;</mo><msup><mn>10</mn><mn>{size}</mn></msup>"
}

fn calc_mathml(name: Text, e: Text[], names: Text[], values: Number[], unit: Text) -> Text {
  let c = calc(e, names, values)
  let unit_mml = if unit.is_empty() { "" } else { f"<mspace width=\"0.3em\"/><mtext>{unit}</mtext>" }
  let close = exact_ratio(c.value)[1] == 0 and exact(c.value) == num_text(c.value)
  let rounded = number_mathml(round_sig(c.value, 4))
  let answer = if close { "<mo>&#8776;</mo>" + rounded + unit_mml } else { "<mo>=</mo>" + exact_mathml(c.value) + unit_mml + (if exact_ratio(c.value)[1] == 1 { "" } else { "<mo>&#8776;</mo>" + rounded }) }
  // Each line its own row of a grid, so the equals signs line up in any
  // browser: the name on the first line, the working under it.
  let cell = "style=\"display:block\""
  let row1 = f"<math {cell}><mrow>{mathml_name(name)}</mrow></math><math {cell}><mrow><mo>=</mo>{c.formula}</mrow></math>"
  let row2 = f"<span></span><math {cell}><mrow><mo>=</mo>{c.substituted}</mrow></math>"
  let row3 = f"<span></span><math {cell}><mrow>{answer}</mrow></math>"
  return f"<div class=\"calc\" style=\"display:grid;grid-template-columns:auto 1fr;gap:6px 6px;align-items:center\">{row1}{row2}{row3}</div>"
}

test "tan, abs and the constants pi and e are understood" {
  expect (at(parse("tan(pi/4)").expr, [], []) * 1000000).round() == 1000000
  expect at(parse("abs(3 - 5)").expr, [], []) == 2
  expect (at(parse("e").expr, [], []) * 1000).round() == 2718
  expect to_latex(parse("tan(x)").expr) == "\\tan x"
}

test "Newton's method finds roots with the derivative worked by rule" {
  two = solve(parse("x^2 - 2").expr, "x", 1)
  expect two.ok
  expect (two.value * 1000000).round() == 1414214
  cosine = solve(parse("cos(x) - x").expr, "x", 1)
  expect (cosine.value * 10000).round() == 7391
  flat = solve(parse("x^2 + 1").expr, "x", 0)
  expect not flat.ok
}

test "integrals are found by Simpson's rule and checked at two step sizes" {
  area = integrate(parse("x^2").expr, "x", 0, 3)
  expect area.value == 9
  half = integrate(parse("sin(x)").expr, "x", 0, 3.141592653589793)
  expect half.value == 2
}

test "numbers are written exactly when they can be" {
  expect exact(0.3333333333333333) == "1/3"
  expect exact(2.0943951023931953) == "2pi/3"
  expect exact(1.4142135623730951) == "sqrt 2"
  expect exact(4) == "4"
  expect exact_mathml(0.75) == "<mfrac><mn>3</mn><mn>4</mn></mfrac>"
  expect exact(89875517873681.77) == "89875517873681.77"
  expect round_sig(89875517873681.77, 4) == 89880000000000
}

test "a calculation is written out with the numbers put in" {
  period = calc(parse("2 pi sqrt(L/g)").expr, ["L", "g"], [1, 9.81])
  expect period.rounded == "2.006"
  expect period.substituted.contains("<mn>9.81</mn>")
  expect calc_mathml("T", parse("2 pi sqrt(L/g)").expr, ["L", "g"], [1, 9.81], "s").contains("&#8776;")
  energy = calc_mathml("E", parse("m c^2").expr, ["m", "c"], [0.001, 299792458], "J")
  expect energy.contains("<mn>0.001</mn><mo>&#215;</mo>")
  expect energy.contains("<mn>8.988</mn><mo>&#215;</mo><msup><mn>10</mn><mn>13</mn></msup>")
}
