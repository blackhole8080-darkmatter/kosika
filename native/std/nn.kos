// std/nn.kos: a small neural network, written in Kosika, that learns on the
// laptop's processor in moments. No GPU and no library.
//
//   import "std/nn.kos"
//
// net(sizes, seed)            a new network: sizes [inputs, hidden..., outputs]
// predict(n, x)               the network's outputs for one input, each 0 to 1
// train(n, xs, ys, rate, rounds)
//                             the network after learning from examples:
//                             each xs[i] should give ys[i], every example
//                             seen once a round
// loss(n, xs, ys)             how wrong it is on examples, 0 is perfect
//
// Hidden layers use tanh and the outputs a sigmoid, so each output reads
// as a probability. Learning is plain gradient descent, one example at a
// time. A network is an ordinary record, so it can be kept in a memory and
// goes into traces like any other value. The starting weights come from
// `seed` and nothing else, so the same examples always make the same net.
//
// A run counts every named function call, 10,000 by default, so the work
// is written out inside each function rather than in small helpers: train
// makes one call however many examples and rounds it is given.

export [Layer, Net, net, predict, train, loss]

// weights[j] are the weights into unit j from each unit of the layer before.
record Layer { weights: Number[][] biases: Number[] }
record Net { layers: Layer[] }

fn net(sizes: Number[], seed: Number) -> Net {
  if sizes.length() < 2 { fail "a network needs at least inputs and outputs" }
  // A fixed sequence of numbers from the seed: a linear congruential
  // generator, the oldest kind there is.
  var state = (seed.abs().floor() * 1103515245 + 12345) % 2147483648
  var layers: Layer[] = []
  for l in 1 until sizes.length() {
    let inputs = sizes[l - 1]
    // Small weights and biases, scaled to the number of inputs, so tanh
    // starts near its middle where it learns fastest. Biases that start at
    // zero leave every unit seeing the same thing, and too often the net
    // never tells them apart.
    let spread = 3 / inputs.sqrt()
    var weights: Number[][] = []
    for j in 0 until sizes[l] {
      var row: Number[] = []
      for i in 0 until inputs {
        state = (state * 1103515245 + 12345) % 2147483648
        row = row.append((state / 2147483648 - 0.5) * spread)
      }
      weights = weights.append(row)
    }
    var biases: Number[] = []
    for j in 0 until sizes[l] {
      state = (state * 1103515245 + 12345) % 2147483648
      biases = biases.append((state / 2147483648 - 0.5) * spread)
    }
    layers = layers.append({weights: weights, biases: biases})
  }
  return {layers: layers}
}

fn predict(n: Net, x: Number[]) -> Number[] {
  var current = x
  for l in 0 until n.layers.length() {
    let layer = n.layers[l]
    let last = l == n.layers.length() - 1
    var next: Number[] = []
    for j in 0 until layer.biases.length() {
      var sum = layer.biases[j]
      for i in 0 until current.length() { sum += layer.weights[j][i] * current[i] }
      let z = sum.max(-15).min(15)
      let e = (2 * z).exp()
      next = next.append(if last { 1 / (1 + (0 - z).exp()) } else { (e - 1) / (e + 1) })
    }
    current = next
  }
  return current
}

fn train(n: Net, xs: Number[][], ys: Number[][], rate: Number, rounds: Number) -> Net {
  if xs.length() != ys.length() { fail "train needs one wanted output for each input" }
  var layers: Layer[] = n.layers
  let count = layers.length()
  for r in 0 until rounds {
    for e in 0 until xs.length() {
      // Forward: the units of every layer, the input first.
      var values: Number[][] = [xs[e]]
      var current = xs[e]
      for l in 0 until count {
        let layer = layers[l]
        var next: Number[] = []
        for j in 0 until layer.biases.length() {
          var sum = layer.biases[j]
          for i in 0 until current.length() { sum += layer.weights[j][i] * current[i] }
          let z = sum.max(-15).min(15)
          let g = (2 * z).exp()
          next = next.append(if l == count - 1 { 1 / (1 + (0 - z).exp()) } else { (g - 1) / (g + 1) })
        }
        values = values.append(next)
        current = next
      }
      // Back: with a sigmoid and cross-entropy, the error of an output is
      // simply how far it is from what was wanted.
      let wanted = ys[e]
      var delta: Number[] = for j in 0 until current.length() { current[j] - wanted[j] }
      var l = count - 1
      while l >= 0 {
        let layer = layers[l]
        let before = values[l]
        // The error passed to the layer before, with this layer's weights
        // as they were before this step.
        var back: Number[] = []
        if l > 0 {
          for i in 0 until before.length() {
            var total = 0
            for j in 0 until delta.length() { total += layer.weights[j][i] * delta[j] }
            back = back.append(total * (1 - before[i] * before[i]))
          }
        }
        var weights: Number[][] = []
        var biases: Number[] = []
        for j in 0 until delta.length() {
          var row: Number[] = []
          for i in 0 until before.length() {
            row = row.append(layer.weights[j][i] - rate * delta[j] * before[i])
          }
          weights = weights.append(row)
          biases = biases.append(layer.biases[j] - rate * delta[j])
        }
        layers[l] = {weights: weights, biases: biases}
        delta = back
        l = l - 1
      }
    }
  }
  return {layers: layers}
}

// The average cross-entropy over the examples.
fn loss(n: Net, xs: Number[][], ys: Number[][]) -> Number {
  if xs.is_empty() { return 0 }
  var total = 0
  for i in 0 until xs.length() {
    let out = predict(n, xs[i])
    for j in 0 until out.length() {
      let p = out[j].max(0.000001).min(0.999999)
      total += 0 - (ys[i][j] * p.log() + (1 - ys[i][j]) * (1 - p).log())
    }
  }
  return total / xs.length()
}
