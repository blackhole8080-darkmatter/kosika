// Kosika Designs: generative art that moves.
//
// A free model is the artist: from a prompt it picks the piece, the palette
// and the mood. Kosika is the painter: it works out every point, line and
// curve itself, here, and writes them as SVG with CSS that makes them move.
// No image model is used, so the art is free, fast and checked.
//
//   bloom   seeds grown by the golden angle, as in a sunflower head
//   flow    lines traced through a field of directions, like wind or water
//   waves   layered waves drifting past each other
//   tree    a tree that grows branch by branch, then sways
//   orbits  bodies circling a centre, each at its own speed (Kepler: the
//           time round grows as the distance to the power 1.5)
//
// Every name here starts with gen_ or Gen, because all Kosika modules share
// one namespace.

import "designs_palette.kos"
import "nn.kos"

export [GenRecipe, GenAsk, GenArt, GenFor, GenTake, GenTaste, GenRate, gen_pieces, gen_problems, gen_svg, gen_style, gen_page, gen_render, gen_make, gen_for, gen_backdrop, gen_takes, gen_score, gen_layered, gen_strip, gen_take_of, gen_taste_rate, gen_no_taste, GenEye, gen_new_eye, gen_judged, gen_eye_features]

record GenRecipe { piece: Text palette: Text mood: Text seed: Number density: Number title: Text }
record GenAsk { text: Text }
record GenBrief { task: Text ask: Text }
// One take on a piece: the layers it was built from, what the critic gave
// it and why. key names the layers ("flow+waves+mirror+ocean"), so a take
// can be told from those already made, and your thumbs can teach which
// layers you like.
record GenTake { recipe: GenRecipe under: Text symmetry: Text focal: Bool grain: Bool key: Text svg: Text score: Number why: Text[] marks: Number[] }
record GenArt { recipe: GenRecipe svg: Text page: Text problems: Text[] takes: GenTake[] }

// What the Brain has learned about art: the takes it has made, and those
// you liked and did not.
record GenTaste { seen: Text[] liked: Text[] disliked: Text[] }
record GenRate { svg: Text liked: Bool }

memory tastes of GenTaste

// Kosika's eye: a small network (std/nn.kos) that learns from your thumbs
// what you find beautiful. It reads a take as numbers, its contrast,
// balance, variety and novelty and which piece, field, symmetry and palette
// it was made from, and says how likely you are to like it. Unlike a list
// of liked takes, it carries over: liking reflections on a sea makes a
// reflected forest more likely to be chosen too.
record GenEye { net: Net xs: Number[][] ys: Number[][] seen: Number }

memory eyes of GenEye

model gen_artist {
  input: GenBrief
  output: GenRecipe
  parameters: {
    max_output_tokens: 2000
  }
}

fn gen_pieces() -> Text[] { return ["bloom", "flow", "waves", "tree", "orbits"] }
fn gen_moods() -> Text[] { return ["calm", "lively"] }

fn gen_problems(r: GenRecipe) -> Text[] {
  var out: Text[] = []
  if not gen_pieces().contains(r.piece) { out = out.append(f"piece {r.piece} is not one of {gen_pieces().join(\", \")}") }
  if not palette_names().contains(r.palette) { out = out.append(f"palette {r.palette} is not one of {palette_names().join(\", \")}") }
  if not gen_moods().contains(r.mood) { out = out.append(f"mood {r.mood} is not calm or lively") }
  if r.density < 0 or r.density > 1 { out = out.append("density must be from 0 to 1") }
  if r.seed < 0 or r.seed > 100000 { out = out.append("seed must be from 0 to 100000") }
  return out
}

// A number from 0 to 1 that looks random but is always the same for the
// same seed and index, so a piece can be drawn again exactly.
fn gen_noise(seed: Number, i: Number) -> Number {
  let v = (i * 12.9898 + seed * 78.233).sin() * 43758.5453
  return v - v.floor()
}

fn gen_n(x: Number) -> Text { return ((x * 10 + 0.5).floor() / 10).to_text() }

// The piece's pace: calm pieces move more slowly.
fn gen_pace(r: GenRecipe) -> Number { return if r.mood == "calm" { 1.6 } else { 0.75 } }

// ---------------------------------------------------------------- bloom

fn gen_bloom(r: GenRecipe) -> Text {
  let count = (180 + r.density * 420).floor()
  let spread = 200 / count.sqrt()
  let pace = gen_pace(r)
  var dots: Text[] = []
  for k in 0 until count {
    let angle = k * 137.50776
    let rad = spread * k.sqrt()
    let x = 400 + rad * angle.cos()
    let y = 240 + rad * angle.sin()
    let size = 1.6 + 4.2 * k / count
    let hue = ((k + r.seed) % 6).to_text()
    dots = dots.append(f"<circle class=\"gen-d\" cx=\"{x.floor()}\" cy=\"{y.floor()}\" r=\"{(size * 10).floor() / 10}\" style=\"fill:var(--h{hue});animation-delay:{(k * 6 * pace).floor()}ms\"/>")
  }
  let turn = gen_n(160 * gen_pace(r))
  return f"<g class=\"gen-turn\" style=\"animation-duration:{turn}s\">" + dots.join("") + "</g>"
}

// ---------------------------------------------------------------- flow

fn gen_flow(r: GenRecipe) -> Text {
  let lines = (40 + r.density * 80).floor()
  let scale = 0.9 + gen_noise(r.seed, 1) * 1.4
  var paths: Text[] = []
  for k in 0 until lines {
    var x = gen_noise(r.seed, k * 2 + 3) * 800
    var y = gen_noise(r.seed, k * 2 + 4) * 480
    var d = f"M{x.floor()} {y.floor()}"
    for hop in 0 until 46 {
      // The direction at a point comes from two slow waves crossing.
      let a = ((x * scale * 0.35 + r.seed).sin() + (y * scale * 0.5 - r.seed * 0.3).cos()) * 70 + 15
      x = x + 9 * a.cos()
      y = y + 9 * a.sin()
      d = d + f" L{x.floor()} {y.floor()}"
    }
    let hue = (k % 6).to_text()
    let dur = gen_n((5 + gen_noise(r.seed, k + 99) * 6) * gen_pace(r))
    let delay = gen_n(gen_noise(r.seed, k + 7) * 4)
    paths = paths.append(f"<path class=\"gen-line\" pathLength=\"1\" d=\"{d}\" style=\"stroke:var(--h{hue});animation-duration:{dur}s;animation-delay:-{delay}s\"/>")
  }
  return paths.join("")
}

// ---------------------------------------------------------------- waves

fn gen_waves(r: GenRecipe) -> Text {
  let layers = (4 + r.density * 6).floor()
  var bits: Text[] = []
  for k in 0 until layers {
    let base = 110 + k * 300 / layers + (gen_noise(r.seed, k + 40) - 0.5) * 50
    let amp = 10 + gen_noise(r.seed, k) * 38
    let length = 160 + gen_noise(r.seed, k + 20) * 220
    // Drawn two lengths wider than the picture, so sliding by one length
    // loops without a seam.
    var d = f"M-{gen_n(length)} 480 L-{gen_n(length)} {gen_n(base)}"
    var x = 0 - length
    while x <= 800 + length {
      d = d + f" L{x.floor()} {(base + amp * (x * 360 / length + k * 57).sin()).floor()}"
      x = x + 8
    }
    d = d + f" L{gen_n(800 + length)} 480 Z"
    let hue = (k % 6).to_text()
    let dur = gen_n((9 + k * 2.5) * gen_pace(r))
    let way = if k % 2 == 0 { "gen-slide" } else { "gen-slide back" }
    bits = bits.append(f"<g class=\"{way}\" style=\"--len:{gen_n(length)}px;animation-duration:{dur}s\"><path class=\"gen-wave\" d=\"{d}\" style=\"fill:var(--h{hue})\"/></g>")
  }
  return bits.join("")
}

// ---------------------------------------------------------------- tree

fn gen_tree(r: GenRecipe) -> Text {
  let depth = (6 + r.density * 3).floor()
  // Each branch is [x, y, angle, length, level], grown level by level
  // from a queue, so no recursion is needed.
  var queue: Number[][] = [[400, 470, -90, 92, 0]]
  var branches: Text[] = []
  var leaves: Text[] = []
  let pace = gen_pace(r)
  var i = 0
  while i < queue.length() {
    let b = queue[i]
    let x2 = b[0] + b[3] * b[2].cos()
    let y2 = b[1] + b[3] * b[2].sin()
    let width = ((depth - b[4]) * 13 + 6).floor() / 10
    let delay = (b[4] * 450 * pace).floor()
    branches = branches.append(f"<path class=\"gen-branch\" pathLength=\"1\" d=\"M{b[0].floor()} {b[1].floor()} L{x2.floor()} {y2.floor()}\" style=\"stroke-width:{width};animation-delay:{delay}ms\"/>")
    // The same noise as gen_noise, written out: a function call per branch
    // would spend the engine's call budget.
    let v = (i * 12.9898 + r.seed * 78.233).sin() * 43758.5453
    let wobble = v - v.floor()
    if b[4] + 1 < depth {
      let bend = 18 + wobble * 16
      let shrink = 0.68 + wobble * 0.12
      queue = queue.append([x2, y2, b[2] - bend, b[3] * shrink, b[4] + 1])
      queue = queue.append([x2, y2, b[2] + bend, b[3] * shrink, b[4] + 1])
    } else {
      let hue = (i % 6).to_text()
      leaves = leaves.append(f"<circle class=\"gen-leaf\" cx=\"{x2.floor()}\" cy=\"{y2.floor()}\" r=\"{(30 + wobble * 30).floor() / 10}\" style=\"fill:var(--h{hue});animation-delay:{(depth * 450 * pace + wobble * 1000).floor()}ms\"/>")
    }
    i += 1
  }
  return f"<g class=\"gen-sway\" style=\"animation-duration:{gen_n(7 * pace)}s\">" + branches.join("") + leaves.join("") + "</g>"
}

// ---------------------------------------------------------------- orbits

fn gen_orbits(r: GenRecipe) -> Text {
  let bodies = (4 + r.density * 5).floor()
  var bits: Text[] = ["<circle class=\"gen-sun\" cx=\"0\" cy=\"0\" r=\"20\"/>"]
  for k in 0 until bodies {
    let rad = 46 + k * 300 / bodies
    // Kepler's third law: the time round grows as the distance to the 1.5.
    let period = gen_n(4 * gen_pace(r) * (rad / 46) * (rad / 46).sqrt())
    let start = gen_n(gen_noise(r.seed, k) * 360)
    let hue = (k % 6).to_text()
    let size = gen_n(4 + gen_noise(r.seed, k + 30) * 6)
    bits = bits.append(f"<circle class=\"gen-ring\" cx=\"0\" cy=\"0\" r=\"{gen_n(rad)}\"/><g style=\"transform:rotate({start}deg)\"><g class=\"gen-spin\" style=\"animation-duration:{period}s\"><circle cx=\"{gen_n(rad)}\" cy=\"0\" r=\"{size}\" style=\"fill:var(--h{hue})\"/></g></g>")
  }
  return "<g transform=\"translate(400 240) scale(1 0.42)\">" + bits.join("") + "</g>"
}

// ---------------------------------------------------------------- the piece

fn gen_body(r: GenRecipe) -> Text {
  return if r.piece == "bloom" { gen_bloom(r) } else if r.piece == "flow" { gen_flow(r) } else if r.piece == "waves" { gen_waves(r) } else if r.piece == "tree" { gen_tree(r) } else { gen_orbits(r) }
}

fn gen_svg(r: GenRecipe) -> Text {
  return f"<svg class=\"gen gen-{r.piece}\" viewBox=\"0 0 800 480\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"{r.title}\">{gen_body(r)}</svg>"
}

// ---------------------------------------------------------------- layers
//
// A piece is built from layers, as a painter builds a canvas:
//
//   under     a faint field behind it: another piece, sparse and slow
//   main      the piece itself
//   symmetry  none; mirror, the piece and its mirror image side by side;
//             or reflect, the piece above a horizon and its reflection
//             below, as in still water
//   focal     a glowing body on a third of the picture, where the eye rests
//   grain     fine specks over everything, like paper or film
//
// Each layer has its own seed, so the same layers give a new piece each time.

fn gen_focal(r: GenRecipe) -> Text {
  let left = gen_noise(r.seed, 5) < 0.5
  let x = if left { 267 } else { 533 }
  let y = if r.piece == "waves" or r.piece == "tree" { 120 } else { 160 }
  let size = 26 + gen_noise(r.seed, 6) * 22
  return f"<g class=\"gen-focal\"><circle cx=\"{x}\" cy=\"{y}\" r=\"{gen_n(size * 2.2)}\" class=\"gen-glow\"/><circle cx=\"{x}\" cy=\"{y}\" r=\"{gen_n(size)}\" class=\"gen-core\"/></g>"
}

fn gen_grain(r: GenRecipe) -> Text {
  var dots: Text[] = []
  for k in 0 until 110 {
    let v = (k * 12.9898 + r.seed * 39.37).sin() * 43758.5453
    let w = (k * 78.233 + r.seed * 12.9898).sin() * 43758.5453
    dots = dots.append(f"<circle cx=\"{((v - v.floor()) * 800).floor()}\" cy=\"{((w - w.floor()) * 480).floor()}\" r=\".9\"/>")
  }
  return "<g class=\"gen-grain\">" + dots.join("") + "</g>"
}

fn gen_layered(t: GenTake) -> Text {
  let r = t.recipe
  let body = gen_body(r)
  let under = if t.under.is_empty() { "" } else { "<g class=\"gen-under\">" + gen_body({..r, piece: t.under, density: 0.2, seed: (r.seed * 7 + 13) % 99991}) + "</g>" }
  let centred = r.piece == "tree" or r.piece == "bloom" or r.piece == "orbits"
  let main = if t.symmetry == "mirror" and centred { f"<g transform=\"translate(-150 46) scale(.9)\">{body}</g><g class=\"gen-twin\" transform=\"translate(950 46) scale(-.9 .9)\">{body}</g>" } else if t.symmetry == "mirror" { f"<g>{body}</g><g class=\"gen-twin\" transform=\"translate(800 0) scale(-1 1)\">{body}</g>" } else if t.symmetry == "reflect" { f"<g transform=\"matrix(1 0 0 .62 0 0)\">{body}</g><line class=\"gen-horizon\" x1=\"0\" y1=\"298\" x2=\"800\" y2=\"298\"/><g class=\"gen-reflect\" transform=\"matrix(1 0 0 -.3 0 442)\">{body}</g>" } else { body }
  let focal = if t.focal { gen_focal(r) } else { "" }
  let grain = if t.grain { gen_grain(r) } else { "" }
  return f"<svg class=\"gen gen-{r.piece}\" data-take=\"{t.key}\" viewBox=\"0 0 800 480\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"{r.title}\">{under}{main}{focal}{grain}</svg>"
}

// The field that sits well behind each piece, and a second choice.
fn gen_under(piece: Text, second: Bool) -> Text {
  let first = if piece == "flow" { "waves" } else if piece == "bloom" { "flow" } else if piece == "waves" { "bloom" } else if piece == "tree" { "waves" } else { "bloom" }
  let other = if piece == "flow" { "orbits" } else if piece == "bloom" { "waves" } else if piece == "waves" { "flow" } else if piece == "tree" { "flow" } else { "flow" }
  return if second { other } else { first }
}

// A palette near in mood, for a take that tries other colours.
fn gen_near_palette(p: Text) -> Text {
  return if p == "dark_matter" { "aurora" } else if p == "aurora" { "dark_matter" } else if p == "ocean" { "aurora" } else if p == "ember" { "dark_matter" } else if p == "forest" { "ocean" } else if p == "paper" { "print" } else if p == "print" { "paper" } else { "dark_matter" }
}

fn gen_key(r: GenRecipe, under: Text, symmetry: Text) -> Text {
  let u = if under.is_empty() { "plain" } else { under }
  return f"{r.piece}+{u}+{symmetry}+{r.palette}"
}

fn gen_take(r: GenRecipe, under: Text, symmetry: Text, focal: Bool, grain: Bool) -> GenTake {
  let t: GenTake = {recipe: r, under: under, symmetry: symmetry, focal: focal, grain: grain, key: gen_key(r, under, symmetry), svg: "", score: 0, why: [], marks: []}
  return {..t, svg: gen_layered(t)}
}

// Four takes on what the artist chose: the piece alone; over a field with
// a focal point; with symmetry; and over another field in near colours,
// fuller, with grain.
// Every way to layer a piece: any other piece as its field, or none; no
// symmetry, a mirror or a reflection; its own palette or a near one. As
// keys, "flow+waves+mirror+ocean".
fn gen_grammar(r: GenRecipe) -> Text[] {
  let unders = [""].concat(for p in gen_pieces() where p != r.piece { p })
  var out: Text[] = []
  for pal in [r.palette, gen_near_palette(r.palette)] {
    for sym in ["none", "reflect", "mirror"] {
      for u in unders { out = out.append(gen_key({..r, palette: pal}, u, sym)) }
    }
  }
  return out
}

fn gen_from_key(r: GenRecipe, key: Text, k: Number) -> GenTake {
  let parts = key.split("+")
  let under = if parts[1] == "plain" { "" } else { parts[1] }
  let focal = gen_noise(r.seed, k + 61) < 0.5
  let grain = gen_noise(r.seed, k + 71) < 0.5
  let mood = if gen_noise(r.seed, k + 81) < 0.3 { (if r.mood == "calm" { "lively" } else { "calm" }) } else { r.mood }
  return gen_take({..r, palette: parts[3], mood: mood, seed: (r.seed + k * 11) % 99991, density: (r.density + (gen_noise(r.seed, k + 91) - 0.5) * 0.4).max(0.1).min(1)}, under, parts[2], focal, grain)
}

// Four takes: the artist's piece as it chose it, when that was never made,
// and then layerings not made before, picked by the seed; when every one
// has been made, any four.
fn gen_takes(r: GenRecipe, taste: GenTaste) -> GenTake[] { return gen_takes_of(r, taste, 4) }

fn gen_takes_of(r: GenRecipe, taste: GenTaste, count: Number) -> GenTake[] {
  let all = gen_grammar(r)
  let fresh = for x in all where not taste.seen.contains(x) { x }
  let pool = if fresh.length() >= count { fresh } else { all }
  let start = (gen_noise(r.seed, 3) * pool.length()).floor()
  let step = if pool.length() % 7 == 0 { 1 } else { 7 }
  var keys: Text[] = []
  if not taste.seen.contains(all[0]) { keys = [all[0]] }
  var k = 0
  while keys.length() < count and k < pool.length() {
    let x = pool[(start + k * step) % pool.length()]
    if not keys.contains(x) { keys = keys.append(x) }
    k += 1
  }
  return for i in 0 until keys.length() { gen_score(gen_from_key(r, keys[i], i), taste) }
}

// With an eye that knows your taste, Kosika sketches eight takes, lets the
// eye judge them all, and keeps the four best to show: it looks harder for
// what you would like, as a painter makes studies before the canvas.
fn gen_takes_judged(r: GenRecipe, taste: GenTaste, eye: GenEye) -> GenTake[] {
  if not gen_eye_ready(eye) { return gen_takes(r, taste) }
  var left = for t in gen_takes_of(r, taste, 8) { gen_judged(t, taste, eye) }
  var kept: GenTake[] = []
  while kept.length() < 4 and not left.is_empty() {
    let best = gen_best(left)
    kept = kept.append(best)
    left = for t in left where t.key != best.key { t }
  }
  return kept
}

// ---------------------------------------------------------------- the critic
//
// The critic looks at each take as Kosika drew it and gives it a score
// from four things, with no model:
//
//   contrast  how well the palette's colours stand off its background
//   balance   how evenly the marks spread over the four quarters
//   variety   how many of the palette's colours it uses, and its layers
//   novelty   whether these layers were made before; never-made scores most
//
// and then your taste: layers you liked count for a take, layers you did
// not count against it.

fn gen_contrast(palette: Text) -> Number {
  let p = palette_named(palette)
  let all = for h in p.hues { contrast(h, p.bg) }
  let mean = all.sum() / all.length().max(1)
  return (mean / 7).min(1)
}

// Where the marks are: the first point of every circle and of every step
// of a line, counted into the four quarters of the picture.
fn gen_balance(t: GenTake) -> Number {
  if t.symmetry != "none" { return 1 }
  if t.recipe.piece == "bloom" or t.recipe.piece == "orbits" { return 0.95 }
  var q = [0, 0, 0, 0]
  let parts = t.svg.split(" L").concat(t.svg.split("cx=\""))
  var k = 0
  for part in parts {
    k += 1
    if k % 4 == 0 {
      let ws = part.replace("\"", " ").replace("cy=", " ").words()
      if ws.length() >= 2 {
        let x = ws[0].to_number()
        let y = ws[1].to_number()
        if x.exists() and y.exists() {
          let i = (if x.value() < 400 { 0 } else { 1 }) + (if y.value() < 240 { 0 } else { 2 })
          q = for j in 0 until 4 { if j == i { q[j] + 1 } else { q[j] } }
        }
      }
    }
  }
  let total = q.sum()
  if total == 0 { return 0.5 }
  return 1 - (q.max().or(0) - q.min().or(0)) / total
}

fn gen_variety(t: GenTake) -> Number {
  let hues = (for h in 0 until 6 where t.svg.contains(f"var(--h{h})") { h }).length()
  let layers = (if t.under.is_empty() { 0 } else { 1 }) + (if t.focal { 1 } else { 0 }) + (if t.grain { 1 } else { 0 }) + (if t.symmetry == "none" { 0 } else { 1 })
  return (hues / 6 * 0.6 + layers / 4 * 0.4).min(1)
}

fn gen_shares(key: Text, other: Text) -> Number {
  let a = key.split("+")
  let b = other.split("+")
  if a.length() != b.length() { return 0 }
  return (for k in 0 until a.length() where a[k] == b[k] { k }).length()
}

fn gen_novelty(t: GenTake, taste: GenTaste) -> Number {
  if taste.seen.contains(t.key) { return 0.2 }
  let near = (for s in taste.seen where gen_shares(t.key, s) >= 3 { s }).length()
  return if near > 0 { 0.7 } else { 1 }
}

fn gen_liking(t: GenTake, taste: GenTaste) -> Number {
  let up = (for l in taste.liked { gen_shares(t.key, l) }).sum() * 0.05
  let down = (for d in taste.disliked { gen_shares(t.key, d) }).sum() * 0.07
  return (up - down).max(-0.4).min(0.4)
}

fn gen_pct(x: Number) -> Text { return (x * 100).floor().to_text() }

fn gen_score(t: GenTake, taste: GenTaste) -> GenTake {
  let c = gen_contrast(t.recipe.palette)
  let b = gen_balance(t)
  let v = gen_variety(t)
  let n = gen_novelty(t, taste)
  let like = gen_liking(t, taste)
  let score = c * 0.2 + b * 0.25 + v * 0.25 + n * 0.3 + like
  var why = [f"contrast {gen_pct(c)}", f"balance {gen_pct(b)}", f"variety {gen_pct(v)}", f"novelty {gen_pct(n)}"]
  if like > 0 { why = why.append("layers you liked") }
  if like < 0 { why = why.append("layers you did not like") }
  let marks = [c, b, v, n]
  let shown = (for m in marks { ((m * 100).floor() / 100).to_text() }).join(" ")
  return {..t, score: (score * 100).floor() / 100, why: why, marks: marks, svg: t.svg.replace("data-take=", f"data-marks=\"{shown}\" data-take=")}
}

fn gen_hot(all: Text[], x: Text) -> Number[] { return for a in all { if a == x { 1 } else { 0 } } }

// A take as the eye reads it: its four marks, then which piece, field,
// symmetry and palette, one place each.
fn gen_eye_features(key: Text, marks: Number[]) -> Number[] {
  let p = key.split("+")
  if p.length() != 4 or marks.length() != 4 { return [] }
  return marks.concat(gen_hot(gen_pieces(), p[0])).concat(gen_hot(["plain"].concat(gen_pieces()), p[1])).concat(gen_hot(["none", "reflect", "mirror"], p[2])).concat(gen_hot(palette_names(), p[3]))
}

fn gen_eye_size() -> Number { return 4 + gen_pieces().length() + gen_pieces().length() + 1 + 3 + palette_names().length() }

fn gen_new_eye() -> GenEye { return {net: net([gen_eye_size(), 6, 1], 11), xs: [], ys: [], seen: 0} }

fn gen_eye_of(had: EyesRecalled) -> GenEye { return if had.value.exists() { had.value.value() } else { gen_new_eye() } }

// How likely you are to like a take, from 0 to 1, by the eye.
fn gen_eye_says(eye: GenEye, t: GenTake) -> Number {
  let x = gen_eye_features(t.key, t.marks)
  if x.is_empty() { return 0.5 }
  return predict(eye.net, x)[0].max(0).min(1)
}

// Whether the eye has something to go on: at least one thumb up and one
// down. Taught only "no", it would say no to everything.
fn gen_eye_ready(eye: GenEye) -> Bool {
  let up = (for y in eye.ys where y[0] > 0.5 { y }).length()
  return up > 0 and up < eye.ys.length()
}

// The critic's score with the eye's judgement in it: once the eye has
// learned from a thumb up and a thumb down, it takes the place of the list
// of liked layers.
fn gen_judged(t: GenTake, taste: GenTaste, eye: GenEye) -> GenTake {
  if not gen_eye_ready(eye) { return t }
  let p = gen_eye_says(eye, t)
  let score = t.score - gen_liking(t, taste) + (p - 0.5) * 0.8
  let why = (for w in t.why where not w.starts_with("layers you") { w }).append(f"you would like it {gen_pct(p)}%, Kosika's eye learned from {eye.seen} thumbs")
  return {..t, score: (score * 100).floor() / 100, why: why}
}

fn gen_marks_of(svg: Text) -> Number[] {
  let parts = svg.split("data-marks=\"")
  if parts.length() < 2 { return [] }
  return for w in parts[1].split("\"")[0].words() where w.to_number().exists() { w.to_number().value() }
}

// One thumb taught: the take, read back from the drawing, and whether you
// liked it. The eye keeps its last 30 lessons and learns from them again.
fn gen_taught(eye: GenEye, r: GenRate) -> GenEye {
  let x = gen_eye_features(gen_take_of(r.svg), gen_marks_of(r.svg))
  if x.is_empty() { return eye }
  let xs = eye.xs.append(x)
  // Wanted outputs short of 0 and 1, so a few thumbs do not drive the
  // network to say never or always.
  let ys = eye.ys.append([if r.liked { 0.9 } else { 0.15 }])
  let from = (xs.length() - 30).max(0)
  let kx = xs.slice(from, xs.length())
  let ky = ys.slice(from, ys.length())
  return {net: train(eye.net, kx, ky, 0.3, 40), xs: kx, ys: ky, seen: eye.seen + 1}
}

fn gen_best(takes: GenTake[]) -> GenTake {
  var best = takes[0]
  for t in takes {
    if t.score > best.score { best = t }
  }
  return best
}

// The other takes, small, each with its score, under the best one.
fn gen_card(t: GenTake, best: Text) -> Text {
  let mark = if t.svg == best { " best" } else { "" }
  let name = t.key.replace("+", " · ")
  // What Kosika's eye thinks of it, once it has learned your taste.
  let eye = (for w in t.why where w.starts_with("you would like it ") { " &#183; <i>you'd like it " + w.split(" ")[4].split(",")[0] + "</i>" }).join("")
  return f"<figure class=\"gen-take{mark}\" data-palette=\"{t.recipe.palette}\">{t.svg}<figcaption><b>{gen_pct(t.score)}</b> {name}{eye}</figcaption></figure>"
}

fn gen_strip(art: GenArt) -> Text {
  if art.takes.length() < 2 { return "" }
  let cards = for t in art.takes { gen_card(t, art.svg) }
  return "<div class=\"gen-takes\" aria-label=\"The takes the critic compared\">" + cards.join("") + "</div>"
}

// The layers a drawing was made from, read back from it.
fn gen_take_of(svg: Text) -> Text {
  let parts = svg.split("data-take=\"")
  if parts.length() < 2 { return "" }
  return parts[1].split("\"")[0]
}

fn gen_no_taste() -> GenTaste { return {seen: [], liked: [], disliked: []} }

fn gen_taste_of(had: TastesRecalled) -> GenTaste { return if had.value.exists() { had.value.value() } else { gen_no_taste() } }

fn gen_saw(taste: GenTaste, takes: GenTake[]) -> GenTaste {
  let keys = for t in takes where not taste.seen.contains(t.key) { t.key }
  let all = taste.seen.concat(keys)
  return {..taste, seen: all.drop((all.length() - 60).max(0))}
}

fn gen_rated(taste: GenTaste, r: GenRate) -> GenTaste {
  let take = gen_take_of(r.svg)
  if take.is_empty() { return taste }
  let liked = for l in taste.liked where l != take { l }
  let disliked = for d in taste.disliked where d != take { d }
  return if r.liked { {..taste, liked: liked.append(take).drop((liked.length() - 19).max(0)), disliked: disliked} } else { {..taste, liked: liked, disliked: disliked.append(take).drop((disliked.length() - 19).max(0))} }
}

// A new seed each time, so asking again never gives the same piece.
fn gen_new_seed(r: GenRecipe, taste: GenTaste) -> GenRecipe {
  return {..r, seed: (r.seed + taste.seen.length() * 7919 + 1) % 99991}
}

workflow gen_taste_rate(r: GenRate) -> GenTaste {
  had    = recall tastes under "art"
  looked = recall eyes under "art"
  kept   = remember gen_rated(gen_taste_of(had), r) in tastes under "art"
  taught = remember gen_taught(gen_eye_of(looked), r) in eyes under "art"
  out    = gen_rated(gen_taste_of(had), r)
}

fn gen_style() -> Text {
  return ".gen{display:block;width:100%;height:auto;overflow:hidden}.gen-d{opacity:0;transform-box:fill-box;transform-origin:center;animation:gen-pop .7s ease-out forwards}.gen-turn{transform-origin:400px 240px;animation:gen-turn 160s linear infinite}.gen-line{fill:none;stroke-width:1.4;stroke-linecap:round;stroke-dasharray:.4 .6;opacity:.85;animation:gen-run 8s linear infinite}.gen-slide{animation:gen-slide 12s linear infinite}.gen-slide.back{animation-direction:reverse}.gen-wave{opacity:.28}.gen-branch{fill:none;stroke:var(--soft);stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;animation:gen-grow .6s ease-out forwards}.gen-leaf{opacity:0;transform-box:fill-box;transform-origin:center;animation:gen-pop .6s ease-out forwards}.gen-sway{transform-origin:400px 470px;animation:gen-sway 7s ease-in-out infinite alternate}.gen-ring{fill:none;stroke:color-mix(in srgb,var(--line) 14%,transparent);stroke-width:2.2;stroke-dasharray:3 9}.gen-sun{fill:var(--gold);filter:drop-shadow(0 0 18px var(--gold))}.gen-spin{animation:gen-turn 10s linear infinite}.gen-under{opacity:.32}.gen-twin{opacity:.72}.gen-reflect{opacity:.3}.gen-horizon{stroke:color-mix(in srgb,var(--line) 22%,transparent);stroke-width:1}.gen-glow{fill:var(--gold);opacity:.14;animation:gen-breathe 6s ease-in-out infinite alternate}.gen-core{fill:var(--gold);opacity:.9;filter:drop-shadow(0 0 22px var(--gold))}.gen-focal{transform-box:fill-box;transform-origin:center}.gen-grain{fill:var(--line);opacity:.16}.gen-takes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:10px}.gen-take{margin:0;border-radius:10px;overflow:hidden;border:1px solid color-mix(in srgb,var(--line) 12%,transparent);background:var(--bg)}.gen-take.best{outline:2px solid var(--gold)}.gen-take .gen *{animation:none!important}.gen-take .gen-d,.gen-take .gen-leaf{opacity:.9}.gen-take .gen-branch{stroke-dashoffset:0}.gen-take figcaption{font:11px ui-monospace,Consolas,monospace;color:var(--soft);padding:5px 7px}.gen-take b{color:var(--ink)}.gen-take i{color:var(--gold);font-style:normal}@keyframes gen-breathe{from{opacity:.08}to{opacity:.22}}@keyframes gen-pop{from{opacity:0;transform:scale(0)}to{opacity:.92;transform:scale(1)}}@keyframes gen-turn{to{transform:rotate(360deg)}}@keyframes gen-run{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}@keyframes gen-slide{to{transform:translateX(var(--len))}}@keyframes gen-grow{to{stroke-dashoffset:0}}@keyframes gen-sway{from{transform:rotate(-1.6deg)}to{transform:rotate(1.6deg)}}@media (prefers-reduced-motion:reduce){.gen *{animation:none!important;opacity:1!important;stroke-dashoffset:0!important}}"
}

fn gen_page(r: GenRecipe, svg: Text) -> Text {
  return f"<!doctype html><html lang=\"en\" data-palette=\"{r.palette}\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>{r.title}</title><style>{palettes_css()}body{{margin:0;font:15px system-ui,sans-serif;color:var(--ink);background:var(--bg)}}main{{max-width:980px;margin:0 auto;padding:28px 16px}}.lab{{font:600 11px ui-monospace,Consolas,monospace;letter-spacing:.32em;text-transform:uppercase;color:var(--gold)}}h1{{margin:8px 0 4px;font-size:30px}}.how{{color:var(--soft);margin:0 0 16px}}.frame{{border-radius:18px;overflow:hidden;border:1px solid color-mix(in srgb,var(--line) 12%,transparent);background:var(--halo)}}{gen_style()}</style></head><body><main><div class=\"lab\">Kosika Designs &#183; generative</div><h1>{r.title}</h1><p class=\"how\">A {r.mood} {r.piece} in {r.palette}, seed {gen_n(r.seed)}. Every point and curve was worked out by Kosika; the artist only chose.</p><div class=\"frame\">{svg}</div></main></body></html>"
}

workflow gen_render(r: GenRecipe) -> GenArt {
  svg = gen_svg(r)
  out = {recipe: r, svg: svg, page: gen_page(r, svg), problems: gen_problems(r), takes: []}
}

// ---------------------------------------------------------------- behind a drawing
//
// Behind a Designs drawing Kosika chooses the piece itself, with no model:
// one that echoes the kind of picture, in the drawing's own palette, calm
// and sparse so it never competes with the cards. The seed comes from the
// title, so the same drawing always gets the same backdrop.

record GenFor { shape: Text palette: Text title: Text }

fn gen_for(f: GenFor) -> GenRecipe {
  let piece = if ["cycle", "orbit", "hub", "nested"].contains(f.shape) { "orbits" } else if ["tree", "mindmap", "containers"].contains(f.shape) { "tree" } else if ["flow", "sequence", "graph"].contains(f.shape) { "flow" } else if f.shape == "timeline" or f.shape == "layers" { "waves" } else { "bloom" }
  let palette = if palette_names().contains(f.palette) { f.palette } else { "dark_matter" }
  var seed = 7
  for c in f.title.lower().chars() { seed = (seed * 31 + "abcdefghijklmnopqrstuvwxyz".index_of(c).or(13)) % 99991 }
  return {piece: piece, palette: palette, mood: "calm", seed: seed, density: 0.45, title: f.title}
}

workflow gen_backdrop(f: GenFor) -> GenArt {
  r   = gen_for(f)
  svg = gen_svg(r)
  out = {recipe: r, svg: svg, page: "", problems: gen_problems(r), takes: []}
}

// ---------------------------------------------------------------- the artist

fn gen_task() -> Text {
  return "You are an artist choosing a moving, abstract piece of generative art that suits what someone asked for. Give piece (one of bloom: seeds spiralling out by the golden angle, like a sunflower or a galaxy of points; flow: lines streaming through a field, like wind, water, thought or energy; waves: layered waves drifting, like sea, sound or calm; tree: a tree growing branch by branch, like growth, family, knowledge or nature; orbits: bodies circling a centre, like space, atoms, time or a system), palette (one of dark_matter, aurora, ocean, ember, forest, paper, print, clear, chosen for the mood: ocean for water, ember for fire and energy, forest for nature, aurora for night skies and dreams, dark_matter for space and thought), mood (calm or lively), seed (any whole number from 1 to 99999, to vary the piece), density (from 0 to 1: how full the piece is) and title (a short, evocative title of 2 to 5 words)."
}

fn gen_fallback() -> GenRecipe { return {piece: "bloom", palette: "dark_matter", mood: "calm", seed: 137, density: 0.6, title: "Golden Bloom"} }

// What the artist chose, with anything out of range brought back in, so
// a slip never stops the piece from being drawn.
fn gen_fixed(r: GenRecipe) -> GenRecipe {
  let piece = if gen_pieces().contains(r.piece) { r.piece } else { "bloom" }
  let palette = if palette_names().contains(r.palette) { r.palette } else { "dark_matter" }
  let mood = if gen_moods().contains(r.mood) { r.mood } else { "calm" }
  let title = if r.title.trim().is_empty() { "Untitled" } else { r.title.trim().slice(0, r.title.trim().length().min(48)) }
  return {piece: piece, palette: palette, mood: mood, seed: r.seed.max(0).min(100000).floor(), density: r.density.max(0).min(1), title: title}
}

workflow gen_make(ask: GenAsk) -> GenArt {
  budget 2 model calls, 200 seconds
  chosen = use_model gen_artist(gen_task(), ask.text) retry 1 otherwise gen_fallback()
  had    = recall tastes under "art"
  taste  = gen_taste_of(had)
  looked = recall eyes under "art"
  r      = gen_new_seed(gen_fixed(chosen), taste)
  takes  = gen_takes_judged(r, taste, gen_eye_of(looked))
  best   = gen_best(takes)
  seen   = remember gen_saw(taste, takes) in tastes under "art"
  out    = gen_art(best, takes)
}

fn gen_art(best: GenTake, takes: GenTake[]) -> GenArt {
  let r = best.recipe
  let art: GenArt = {recipe: r, svg: best.svg, page: "", problems: gen_problems(r), takes: takes}
  return {..art, page: gen_page(r, best.svg + gen_strip(art))}
}

test "four takes are made, scored, and the best is kept" {
  takes = gen_takes(gen_fallback(), gen_no_taste())
  expect takes.length() == 4
  expect (for t in takes where t.score > 0 { t }).length() == 4
  expect takes[0].key == "bloom+plain+none+dark_matter"
  expect gen_take_of(takes[2].svg) == takes[2].key
  expect gen_grammar(gen_fallback()).length() == 30
  // Made before, the same ask gives four layerings never made.
  again = gen_takes(gen_fallback(), {seen: for t in takes { t.key }, liked: [], disliked: []})
  expect (for t in again where (for o in takes where o.key == t.key { o }).length() > 0 { t }).is_empty()
  reflect = gen_take(gen_fallback(), "", "reflect", false, false)
  expect reflect.svg.contains("gen-reflect")
  best = gen_best(takes)
  expect (for t in takes where t.score > best.score { t }).is_empty()
  art = gen_art(best, takes)
  expect gen_strip(art).contains("gen-take best")
}

test "the critic prefers what was never made, and your taste" {
  r = gen_fallback()
  t = gen_take(r, "flow", "none", true, false)
  fresh = gen_score(t, gen_no_taste())
  seen = gen_score(t, {seen: [t.key], liked: [], disliked: []})
  expect fresh.score > seen.score
  liked = gen_score(t, gen_rated(gen_no_taste(), {svg: t.svg, liked: true}))
  disliked = gen_score(t, gen_rated(gen_no_taste(), {svg: t.svg, liked: false}))
  expect liked.score > fresh.score and disliked.score < fresh.score
  expect gen_new_seed(r, {seen: ["a"], liked: [], disliked: []}).seed != gen_new_seed(r, gen_no_taste()).seed
  flow = gen_take({..r, piece: "flow"}, "", "none", false, false)
  expect gen_balance(flow) > 0 and gen_balance(flow) <= 1
}

test "Kosika's eye learns what you like, and carries it over to new takes" {
  r = gen_fallback()
  sea = gen_score(gen_take({..r, piece: "waves", palette: "ocean"}, "", "reflect", false, false), gen_no_taste())
  dull = gen_score(gen_take({..r, piece: "waves", palette: "ocean"}, "flow", "mirror", false, false), gen_no_taste())
  expect gen_marks_of(sea.svg).length() == 4
  expect gen_eye_features(sea.key, sea.marks).length() == gen_eye_size()
  one = gen_taught(gen_new_eye(), {svg: sea.svg, liked: true})
  two = gen_taught(one, {svg: dull.svg, liked: false})
  eye = gen_taught(gen_taught(two, {svg: sea.svg, liked: true}), {svg: dull.svg, liked: false})
  expect eye.seen == 4
  expect gen_eye_says(eye, sea) > gen_eye_says(eye, dull)
  // Never shown: a reflected forest. The eye still leans towards it.
  forest = gen_score(gen_take({..r, piece: "tree", palette: "forest"}, "", "reflect", false, false), gen_no_taste())
  mirrored = gen_score(gen_take({..r, piece: "tree", palette: "forest"}, "flow", "mirror", false, false), gen_no_taste())
  expect gen_eye_says(eye, forest) > gen_eye_says(eye, mirrored)
  expect gen_judged(forest, gen_no_taste(), eye).why[4].starts_with("you would like it")
  expect gen_judged(forest, gen_no_taste(), gen_new_eye()).score == forest.score
  studies = gen_takes_judged({..r, piece: "waves", palette: "ocean"}, gen_no_taste(), eye)
  expect studies.length() == 4
  expect (for t in studies where t.symmetry == "reflect" { t }).length() >= 2
  only_no = gen_taught(gen_taught(gen_new_eye(), {svg: dull.svg, liked: false}), {svg: sea.svg, liked: false})
  expect not gen_eye_ready(only_no) and gen_eye_ready(eye)
  expect gen_judged(forest, gen_no_taste(), only_no).score == forest.score
}

test "a bloom and orbits are drawn" {
  base = gen_fallback()
  expect gen_problems(base).is_empty()
  expect gen_svg(base).contains("gen-d")
  expect gen_svg({..base, piece: "orbits"}).contains("gen-spin")
}

test "flow and waves are drawn" {
  base = gen_fallback()
  expect gen_svg({..base, piece: "flow", density: 0.2}).contains("gen-line")
  expect gen_svg({..base, piece: "waves"}).contains("gen-wave")
}

test "a tree is drawn" {
  expect gen_svg({..gen_fallback(), piece: "tree", density: 0}).contains("gen-branch")
}

test "the same seed draws the same piece, and another seed another" {
  base = {..gen_fallback(), piece: "flow", density: 0}
  expect gen_flow(base) == gen_flow(base)
  expect gen_flow(base) != gen_flow({..base, seed: 138})
}

test "a slip by the artist is brought back in range" {
  wild: GenRecipe = {piece: "fractal", palette: "neon", mood: "angry", seed: -4, density: 3, title: ""}
  expect gen_problems(wild).length() == 5
  expect gen_problems(gen_fixed(wild)).is_empty()
  expect gen_fixed(wild).title == "Untitled"
}

test "a drawing's backdrop echoes its kind and keeps its palette" {
  expect gen_for({shape: "cycle", palette: "ocean", title: "The water cycle"}).piece == "orbits"
  expect gen_for({shape: "mindmap", palette: "neon", title: "t"}).palette == "dark_matter"
  expect gen_for({shape: "flow", palette: "ember", title: "Jet engine"}).seed == gen_for({shape: "flow", palette: "ember", title: "Jet engine"}).seed
  expect gen_problems(gen_for({shape: "compare", palette: "aurora", title: "x"})).is_empty()
}

test "the golden angle places the seeds of a bloom" {
  expect gen_bloom(gen_fallback()).contains("cx=\"400\" cy=\"240\"")
  expect gen_noise(1, 2) >= 0 and gen_noise(1, 2) < 1
}
