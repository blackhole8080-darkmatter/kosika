// Planner: keeps your tasks, plans your day into focus blocks, breaks a big
// goal into small steps, and writes a standup note from what you finished
// and what you committed.
//
//   kosika test main.kos
//   kosika studio FOLDER --model qwen2.5:3b --model-protocol ollama --allow-folder YOUR_PROJECT --allow-shell
//
// The list, the order, and the timetable are plain code: exact and instant.
// The model is asked only to break a goal down, to write the standup, and
// to advise. Two things need your yes each time: starting git to read
// today's commits ("standup"), and creating a file ("save plan").
//
// Say: add: write the report !high 2h due friday, tasks, next, done 2,
// drop 3, log 2 45m, plan 4h from 9:30, break down: launch the website,
// review, standup, save plan to plan.md, clear done, or ask for advice.

record Msg { text: Text }
record Said { text: Text }
record Kind { label: Text }
record Clip { text: Text ok: Bool }

// priority: 3 high, 2 normal, 1 low. minutes: how long you think it takes.
// spent: minutes already logged. rank: its place in the list, lower first.
record Task {
  title: Text
  priority: Number
  minutes: Number
  due: Text
  done: Bool
  spent: Number
  rank: Number

  // Urgent and important first, then the shorter job. Done tasks sink.
  fn ranked(self) -> Task {
    let urgency = if self.due.length() > 0 { 50 } else { 0 }
    let score = self.priority * 100 + urgency - self.minutes / 10
    return {..self, rank: (if self.done { 100000 } else { 0 }) - score}
  }

  fn finished(self) -> Task {
    return {..self, done: true, rank: 0}
  }

  fn logged(self, minutes: Number) -> Task {
    return {..self, spent: self.spent + minutes, rank: 0}
  }

  // How much work is still to do, never less than a quarter of an hour.
  fn left(self) -> Number {
    return (self.minutes - self.spent).max(15)
  }

  fn line(self) -> Text {
    let mark = if self.priority == 3 { " !high" } else { if self.priority == 1 { " !low" } else { "" } }
    let due = if self.due.length() > 0 { f", due {self.due}" } else { "" }
    let spent = if self.spent > 0 { f", {length_text(self.spent)} done" } else { "" }
    return f"{self.title}{mark} ({length_text(self.minutes)}{due}{spent})"
  }
}
record Book { tasks: Task[] }
// The list after a request, and what to tell you about it.
record Change { book: Book text: Text }
record Steps { items: Text[] }

record Command { args: Text[] }
record Ran { exit_code: Number stdout: Text stderr: Text }
record NewFile { path: Text text: Text }
record Written { bytes: Number }
record Draft { path: Text text: Text problem: Text }

model coach {
  input: Prompt
  output: Reply
  parameters: {
    max_output_tokens: 200
  }
}

model splitter {
  input: Prompt
  output: Steps
  parameters: {
    max_output_tokens: 200
  }
}

memory books of Book

tool run_git {
  source system "shell"
  operation: "git"
  access: execute
  input: Command
  output: Ran
}

tool create_file {
  source system "files"
  operation: "create"
  access: execute
  input: NewFile
  output: Written
}

agent hands {
  can: [run_git, create_file]
  max_steps: 1
}

// ---------------------------------------------------------------- routing

fn kind_of(msg: Msg) -> Kind {
  let text = msg.text.lower().trim()
  let first = text.split(" ").first().or("")
  var kind = "advise"
  if text == "help" or text.contains("what can you do") { kind = "help" }
  else if text.starts_with("add:") or first == "add" { kind = "add" }
  else if text.starts_with("break down") { kind = "split" }
  else if text == "tasks" or text == "list" or text == "todo" { kind = "tasks" }
  else if text == "next" or text.starts_with("what next") { kind = "next" }
  else if first == "done" or first == "drop" or first == "log" or text == "clear done" { kind = "edit" }
  else if first == "plan" { kind = "plan" }
  else if text == "review" { kind = "review" }
  else if text == "standup" { kind = "standup" }
  else if text.starts_with("save plan") { kind = "save" }
  return {label: kind}
}

// -------------------------------------------------------------- the list

fn tasks_of(known: BooksRecalled) -> Task[] {
  let none: Task[] = []
  return if known.found { known.value.value().tasks } else { none }
}

fn ordered(tasks: Task[]) -> Task[] {
  var out: Task[] = []
  for task in tasks { out = out.append(task.ranked()) }
  return out.sort_by(field: "rank")
}

fn open_tasks(tasks: Task[]) -> Task[] {
  var out: Task[] = []
  for task in tasks where not task.done { out = out.append(task) }
  return out
}

fn length_text(minutes: Number) -> Text {
  if minutes < 60 { return f"{minutes}m" }
  let hours = (minutes / 60).floor()
  let rest = minutes - hours * 60
  return if rest > 0 { f"{hours}h {rest}m" } else { f"{hours}h" }
}

fn show_tasks(tasks: Task[]) -> Text {
  let open = open_tasks(tasks)
  if open.length() == 0 { return "Nothing is waiting. Say \"add: write the report !high 2h\" to add a task." }
  var rows: Text[] = []
  for i in 0 until open.length() {
    rows = rows.append(f"{i + 1}. {open[i].line()}")
  }
  return "Your tasks, most important first:\n" + rows.join("\n")
}

// A length such as "45m" or "2h", in minutes, or 0 when the word is not one.
fn as_minutes(word: Text) -> Number {
  let lower = word.lower()
  if lower.length() < 2 { return 0 }
  let amount = lower.slice(0, lower.length() - 1).to_number().or(0)
  if amount <= 0 { return 0 }
  if lower.ends_with("m") { return amount.round() }
  if lower.ends_with("h") { return (amount * 60).round() }
  return 0
}

// "add: write the report !high 2h due friday"
fn parse_task(msg: Msg) -> Task {
  let text = msg.text.trim()
  let body = if text.lower().starts_with("add:") { text.slice(4, text.length()) } else { text.slice(3.min(text.length()), text.length()) }
  var words: Text[] = []
  var priority = 2
  var minutes = 30
  var due = ""
  var wants_due = false
  for word in body.trim().split(" ") {
    let clean = word.trim()
    let lower = clean.lower()
    if clean.length() == 0 { wants_due = wants_due }
    else if wants_due { due = lower
      wants_due = false }
    else if lower == "!high" or lower == "!h" { priority = 3 }
    else if lower == "!low" or lower == "!l" { priority = 1 }
    else if lower == "due" { wants_due = true }
    else if as_minutes(clean) > 0 { minutes = as_minutes(clean) }
    else { words = words.append(clean) }
  }
  return {title: words.join(" "), priority: priority, minutes: minutes, due: due, done: false, spent: 0, rank: 0}
}

fn add_task(msg: Msg, known: BooksRecalled) -> Change {
  let tasks = tasks_of(known)
  let task = parse_task(msg)
  if task.title.length() == 0 {
    return {book: {tasks: tasks}, text: "Tell me the task, like this: add: write the report !high 2h due friday"}
  }
  let all = ordered(tasks.append(task))
  return {book: {tasks: all}, text: f"Added: {task.line()}\n{show_tasks(all)}"}
}

// The first whole number you wrote, or 0.
fn number_in(msg: Msg) -> Number {
  for word in msg.text.split(" ") {
    let n = word.trim().to_number().or(0)
    if n >= 1 and n == n.floor() { return n }
  }
  return 0
}

// "done 2", "drop 3", "log 2 45m", "clear done". Numbers are the ones shown
// by "tasks".
fn edit(msg: Msg, known: BooksRecalled) -> Change {
  let tasks = ordered(tasks_of(known))
  let text = msg.text.lower().trim()
  let verb = text.split(" ").first().or("")
  if text == "clear done" {
    let left = open_tasks(tasks)
    return {book: {tasks: left}, text: f"Cleared {tasks.length() - left.length()} finished task(s).\n{show_tasks(left)}"}
  }
  let open = open_tasks(tasks)
  let pick = number_in(msg)
  if pick < 1 or pick > open.length() {
    return {book: {tasks: tasks}, text: f"Tell me which task by its number, like this: {verb} 1\n{show_tasks(tasks)}"}
  }
  let chosen = open[pick - 1]
  var logged = 0
  for word in text.split(" ") {
    if as_minutes(word) > 0 { logged = as_minutes(word) }
  }
  if verb == "log" and logged == 0 {
    return {book: {tasks: tasks}, text: f"Tell me how long, like this: log {pick} 45m"}
  }
  var out: Task[] = []
  var seen = 0
  for task in tasks {
    if task.done { out = out.append(task) }
    else {
      seen += 1
      if seen != pick { out = out.append(task) }
      else if verb == "done" { out = out.append(task.finished()) }
      else if verb == "log" { out = out.append(task.logged(logged)) }
    }
  }
  let all = ordered(out)
  let told = if verb == "done" { f"Done: {chosen.title}. Well done." } else { if verb == "log" { f"Logged {length_text(logged)} on {chosen.title}." } else { f"Dropped: {chosen.title}." } }
  return {book: {tasks: all}, text: f"{told}\n{show_tasks(all)}"}
}

fn book_of(change: Change) -> Book {
  return change.book
}

fn told(change: Change) -> Said {
  return {text: change.text}
}

fn list_said(known: BooksRecalled) -> Said {
  return {text: show_tasks(ordered(tasks_of(known)))}
}

fn next_said(known: BooksRecalled) -> Said {
  let open = open_tasks(ordered(tasks_of(known)))
  if open.length() == 0 { return {text: "Nothing is waiting. Enjoy the quiet, or add a task."} }
  let task = open[0]
  let why = if task.priority == 3 { "it is marked high" } else { if task.due.length() > 0 { f"it is due {task.due}" } else { "it is the shortest of what matters most" } }
  let left = task.left()
  return {text: f"Do this next: {task.title}.\nWhy: {why}. It needs about {length_text(left)}. Start with one focus block of {length_text(left.min(50))}."}
}

// ------------------------------------------------------------ the timetable

fn two(n: Number) -> Text {
  return if n < 10 { "0" + n.to_text() } else { n.to_text() }
}

// Minutes since midnight as a clock time, such as 09:30.
fn clock(minutes: Number) -> Text {
  let hours = (minutes / 60).floor()
  return two(hours - (hours / 24).floor() * 24) + ":" + two(minutes - hours * 60)
}

// "plan 4h from 9:30": how long you have and when you start.
fn day_plan(msg: Msg, known: BooksRecalled) -> Said {
  var room = 240
  var start = 540
  var wants_start = false
  for word in msg.text.lower().trim().split(" ") {
    if wants_start {
      let parts = word.split(":")
      let hour = parts.first().or("").to_number().or(9)
      let minute = if parts.length() > 1 { parts[1].to_number().or(0) } else { 0 }
      start = (hour * 60 + minute).round()
      wants_start = false
    }
    else if word == "from" or word == "at" { wants_start = true }
    else if as_minutes(word) > 0 { room = as_minutes(word) }
  }
  let open = open_tasks(ordered(tasks_of(known)))
  if open.length() == 0 { return {text: "There is nothing to plan. Add a task first."} }
  var now = start
  let finish = start + room
  var rows: Text[] = []
  var later: Text[] = []
  for task in open {
    var left = task.left()
    var part = 1
    let blocks = (left / 50).ceil()
    if now + left.min(50) > finish { later = later.append(task.title) }
    else {
      while left > 0 and now + left.min(50) <= finish {
        let block = left.min(50)
        let label = if blocks > 1 { f" ({part} of {blocks})" } else { "" }
        rows = rows.append(f"{clock(now)}-{clock(now + block)}  {task.title}{label}")
        now += block
        left -= block
        part += 1
        if now + 10 <= finish and block == 50 {
          rows = rows.append(f"{clock(now)}-{clock(now + 10)}  break")
          now += 10
        }
      }
      if left > 0 { later = later.append(f"{task.title} ({length_text(left)} left)") }
    }
  }
  var text = f"Your plan for {length_text(room)}, starting {clock(start)}:\n" + rows.join("\n")
  if later.length() > 0 { text += "\nLeft for later:\n" + later.join("\n") }
  return {text: text}
}

fn review_said(known: BooksRecalled) -> Said {
  let tasks = tasks_of(known)
  let open = open_tasks(tasks)
  var waiting = 0
  var logged = 0
  var high = 0
  for task in tasks { logged += task.spent }
  for task in open {
    waiting += (task.minutes - task.spent).max(0)
    if task.priority == 3 { high += 1 }
  }
  return {text: f"Finished: {tasks.length() - open.length()} task(s).\nWaiting: {open.length()} task(s), about {length_text(waiting)} of work, {high} marked high.\nTime logged: {length_text(logged)}."}
}

// ------------------------------------------------------- breaking a goal down

fn goal_of(msg: Msg) -> Clip {
  let text = msg.text.trim()
  let head = text.split(":").first().or("")
  let goal = if head.length() < text.length() { text.slice(head.length() + 1, text.length()).trim() } else { text.slice(10.min(text.length()), text.length()).trim() }
  return {text: goal, ok: goal.length() > 0}
}

fn split_prompt(goal: Clip) -> Prompt {
  return {text: "Break this goal into 3 to 5 small, concrete tasks. Each task is one short phrase that starts with a verb and can be done in under an hour. Return them in the order they should be done.\n\nGoal: " + goal.text}
}

fn no_steps(msg: Msg) -> Steps {
  return {items: []}
}

fn add_steps(goal: Clip, steps: Steps, known: BooksRecalled) -> Change {
  let tasks = tasks_of(known)
  if not goal.ok { return {book: {tasks: tasks}, text: "Tell me the goal, like this: break down: launch the website"} }
  if steps.items.length() == 0 { return {book: {tasks: tasks}, text: "I could not break that down just now. Please try again."} }
  var all = tasks
  var rows: Text[] = []
  for item in steps.items.slice(0, steps.items.length().min(6)) {
    let title = item.trim()
    if title.length() > 0 {
      all = all.append({title: title, priority: 2, minutes: 30, due: "", done: false, spent: 0, rank: 0})
      rows = rows.append("- " + title)
    }
  }
  return {book: {tasks: ordered(all)}, text: "I broke \"" + goal.text + "\" into " + rows.length() + " tasks of 30m each and added them:\n" + rows.join("\n")}
}

// ------------------------------------------------------------------ advice

fn advice_prompt(msg: Msg, known: BooksRecalled) -> Prompt {
  let open = open_tasks(ordered(tasks_of(known)))
  var rows: Text[] = []
  for task in open.slice(0, open.length().min(12)) { rows = rows.append(f"- {task.line()}") }
  let list = if rows.length() > 0 { rows.join("\n") } else { "(no tasks yet)" }
  return {text: "You are a calm, practical productivity coach. Answer in at most four short sentences. Be specific to the tasks below; do not invent tasks.\n\nThe user's open tasks, most important first:\n" + list + "\n\nUser: " + msg.text + "\nCoach:"}
}

fn sorry(msg: Msg) -> Reply {
  return {text: "Sorry, I could not get an answer just now. Please try again."}
}

fn reply_said(reply: Reply) -> Said {
  return {text: reply.text.trim()}
}

// ----------------------------------------------------------------- standup

fn commits_command(msg: Msg) -> Command {
  return {args: ["log", "--since=midnight", "--oneline", "--no-merges"]}
}

fn standup_prompt(known: BooksRecalled, ran: Ran) -> Prompt {
  let tasks = ordered(tasks_of(known))
  var finished: Text[] = []
  for task in tasks where task.done { finished = finished.append("- " + task.title) }
  var coming: Text[] = []
  for task in open_tasks(tasks).slice(0, open_tasks(tasks).length().min(3)) { coming = coming.append("- " + task.title) }
  let commits = if ran.exit_code == 0 and ran.stdout.trim().length() > 0 { ran.stdout.slice(0, ran.stdout.length().min(1500)).trim() } else { "(none today)" }
  return {text: "Write a short standup note with exactly three lines, starting with \"Done:\", \"Next:\" and \"Blockers:\". Use only the facts below. If nothing blocks, write \"Blockers: none\".\n\nTasks finished:\n" + (if finished.length() > 0 { finished.join("\n") } else { "(none)" }) + "\n\nCommits today:\n" + commits + "\n\nNext tasks:\n" + (if coming.length() > 0 { coming.join("\n") } else { "(none)" })}
}

// ---------------------------------------------------------------- saving

fn draft_plan(msg: Msg, known: BooksRecalled) -> Draft {
  let text = msg.text.trim()
  var path = "day-plan.md"
  if text.lower().starts_with("save plan to ") {
    path = text.slice(13, text.length()).trim().split("\\").join("/").split("\"").join("")
  }
  if path.length() == 0 or path.contains("..") or path.contains(":") or path.starts_with("/") {
    return {path: "", text: "", problem: "Give me a file name inside the granted folder, like this: save plan to plan.md"}
  }
  if open_tasks(tasks_of(known)).length() == 0 {
    return {path: path, text: "", problem: "There is nothing to save yet. Add a task first."}
  }
  let plan = day_plan({text: "plan"}, known)
  return {path: path, text: "# Plan\n\n" + plan.text + "\n\n## All tasks\n\n" + show_tasks(ordered(tasks_of(known))) + "\n", problem: ""}
}

fn cannot_save(draft: Draft) -> Said {
  return {text: draft.problem}
}

fn saved_said(draft: Draft, done: Written) -> Said {
  return {text: f"Created {draft.path} ({done.bytes} bytes). It never overwrites: use a new name next time."}
}

fn help(msg: Msg) -> Said {
  return {text: "I keep your tasks and plan your time.\nadd: write the report !high 2h due friday\ntasks: the list, most important first\nnext: the one thing to do now\ndone 2, drop 3, log 2 45m, clear done\nplan 4h from 9:30: a timetable of focus blocks\nbreak down: launch the website\nreview: where you stand\nstandup: a note from finished tasks and today's commits (asks before starting git)\nsave plan to plan.md (asks before creating the file)\nOr ask me what to focus on."}
}

// ------------------------------------------------------------ the requests

workflow add(msg: Msg) -> Said {
  known  = recall books under "me"
  change = add_task(msg, known)
  book   = book_of(change)
  saved  = remember book in books under "me"
  said   = told(change)
}

workflow change_one(msg: Msg) -> Said {
  known  = recall books under "me"
  change = edit(msg, known)
  book   = book_of(change)
  saved  = remember book in books under "me"
  said   = told(change)
}

workflow show(msg: Msg) -> Said {
  known = recall books under "me"
  said  = list_said(known)
}

workflow next_up(msg: Msg) -> Said {
  known = recall books under "me"
  said  = next_said(known)
}

workflow plan_day(msg: Msg) -> Said {
  known = recall books under "me"
  said  = day_plan(msg, known)
}

workflow review(msg: Msg) -> Said {
  known = recall books under "me"
  said  = review_said(known)
}

workflow break_down(msg: Msg) -> Said {
  known  = recall books under "me"
  goal   = goal_of(msg)
  prompt = split_prompt(goal)
  steps  = match goal.ok {
    case true { use_model splitter(prompt.text) }
    case _ { no_steps(msg) }
  }
  change = add_steps(goal, steps, known)
  book   = book_of(change)
  saved  = remember book in books under "me"
  said   = told(change)
}

workflow advise(msg: Msg) -> Said {
  known  = recall books under "me"
  prompt = advice_prompt(msg, known)
  reply  = use_model coach(prompt.text) retry 1 otherwise sorry(msg)
  said   = reply_said(reply)
}

workflow standup(msg: Msg) -> Said {
  known   = recall books under "me"
  command = commits_command(msg)
  ran     = execute hands.run_git(command.args)
  prompt  = standup_prompt(known, ran)
  reply   = use_model coach(prompt.text) retry 1 otherwise sorry(msg)
  said    = reply_said(reply)
  require approval
}

workflow create_it(draft: Draft) -> Said {
  done = execute hands.create_file(draft.path, draft.text)
  said = saved_said(draft, done)
  require approval
}

workflow save_plan(msg: Msg) -> Said {
  known = recall books under "me"
  draft = draft_plan(msg, known)
  said  = match draft.problem {
    case "" { call create_it(draft) }
    case _ { cannot_save(draft) }
  }
  require approval
}

workflow main(msg: Msg) -> Said {
  budget 3 model calls, 240 seconds
  kind = kind_of(msg)
  said = match kind.label {
    case "add" { call add(msg) }
    case "edit" { call change_one(msg) }
    case "tasks" { call show(msg) }
    case "next" { call next_up(msg) }
    case "plan" { call plan_day(msg) }
    case "review" { call review(msg) }
    case "split" { call break_down(msg) }
    case "standup" { call standup(msg) }
    case "save" { call save_plan(msg) }
    case "help" { help(msg) }
    case _ { call advise(msg) }
  }
  require approval
}

// ------------------------------------------------------------------ tests

test "a task is read from one line" {
  a = parse_task({text: "add: write the report !high 2h due friday"})
  b = parse_task({text: "add call the bank 15m"})
  expect a.title == "write the report"
  expect a.priority == 3
  expect a.minutes == 120
  expect a.due == "friday"
  expect b.title == "call the bank"
  expect b.minutes == 15
  expect b.priority == 2
}

test "the list is kept in order of what matters" {
  a = main({text: "add: tidy the desk !low 10m"})
  b = main({text: "add: write the report !high 2h due friday"})
  c = main({text: "add: call the bank 15m"})
  d = main({text: "tasks"})
  expect d.text == "Your tasks, most important first:\n1. write the report !high (2h, due friday)\n2. call the bank (15m)\n3. tidy the desk !low (10m)"
}

test "tasks are finished, logged, and dropped by number" {
  a = main({text: "add: write the report !high 2h"})
  b = main({text: "add: call the bank 15m"})
  c = main({text: "log 1 45m"})
  d = main({text: "done 2"})
  e = main({text: "tasks"})
  f = main({text: "done 9"})
  g = main({text: "review"})
  expect c.text.starts_with("Logged 45m on write the report.")
  expect d.text.starts_with("Done: call the bank.")
  expect e.text == "Your tasks, most important first:\n1. write the report !high (2h, 45m done)"
  expect f.text.contains("by its number")
  expect g.text == "Finished: 1 task(s).\nWaiting: 1 task(s), about 1h 15m of work, 1 marked high.\nTime logged: 45m."
}

test "a day is planned into focus blocks with breaks" {
  a = main({text: "add: write the report !high 90m"})
  b = main({text: "add: call the bank 15m"})
  c = main({text: "plan 2h from 9:30"})
  expect c.text == "Your plan for 2h, starting 09:30:\n09:30-10:20  write the report (1 of 2)\n10:20-10:30  break\n10:30-11:10  write the report (2 of 2)\n11:10-11:25  call the bank"
  expect clock(545) == "09:05"
  expect length_text(135) == "2h 15m"
}

test "what does not fit is left for later" {
  a = main({text: "add: write the report !high 3h"})
  b = main({text: "add: call the bank 15m"})
  c = main({text: "plan 1h"})
  expect c.text.contains("09:00-09:50  write the report (1 of 4)")
  expect c.text.contains("Left for later:\nwrite the report (2h 10m left)\ncall the bank")
}

test "a goal is broken into tasks by the model and added" {
  answers splitter: [{items: ["Write the page text", "Pick a domain name", "Publish the site"]}]
  a = main({text: "break down: launch the website"})
  b = main({text: "tasks"})
  c = main({text: "break down"})
  expect a.text.starts_with("I broke \"launch the website\" into 3 tasks")
  expect b.text.contains("1. Write the page text (30m)")
  expect c.text.contains("like this")
}

test "next names one task and why, and advice goes to the model" {
  answers coach: [{text: "Start the report now; the call can wait."}]
  a = main({text: "next"})
  b = main({text: "add: write the report 40m due today"})
  c = main({text: "next"})
  d = main({text: "what should I focus on?"})
  expect a.text.starts_with("Nothing is waiting.")
  expect c.text == "Do this next: write the report.\nWhy: it is due today. It needs about 40m. Start with one focus block of 40m."
  expect d.text == "Start the report now; the call can wait."
}

test "a plan is drafted for saving, or the reason it cannot be" {
  none: BooksRecalled = {found: false, value: null}
  a = draft_plan({text: "save plan"}, none)
  b = draft_plan({text: "save plan to ../x.md"}, none)
  c = main({text: "save plan"})
  expect a.problem == "There is nothing to save yet. Add a task first."
  expect b.problem.contains("inside the granted folder")
  expect c.text == "There is nothing to save yet. Add a task first."
}
