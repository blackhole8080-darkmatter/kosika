// Kosika Studios -- Claude Animation Base.
// Handmade p5.brush character animation: boiling linework, brush wipes,
// one piece that is alive in every scene.
//
//   kosika run external_integrations/skills/claude_animation.kos --input plan.json
//
// The vendored kit's own guide carries the rules this program checks and
// then renders: shots between 2.5 and 4 seconds, a brush-wipe transition
// that always moves, boiling (redraw every frame) at 24fps, and something
// happening in every scene. The schedule it returns is what the supervisor
// sends through the render: contact sheets first, cheap; the clip, last.

record Shot { name: Text seconds: Number alive: Text }
record Plan { clips: Text[] fps: Number shots: Shot[] }
record Report { seconds: Number sheets: Text[] clip: Text[] yourself: Text[] }

fn is_color(c: Text) -> Bool {
  return c.starts_with("#") and c.length() == 7
}

// What is wrong with a shot plan, in words that can fix it.
fn plan_problem(p: Plan) -> Text {
  if p.shots.is_empty() { return "The film has no shots." }
  for s in p.shots {
    if s.seconds < 2.5 or s.seconds > 4.0 { return f"Shot {s.name} is {s.seconds} seconds. Shots run from 2.5 to 4 sec." }
    if s.alive.trim().is_empty() { return f"Shot {s.name} says what keeps it alive; the film is alive when something happens in every scene." }
  }
  if p.fps < 12 or p.fps > 60 { return "fps must be from 12 to 60 (boiling wants a low, honest fps)." }
  return ""
}

// The whole film is at least its shots plus the brush wipes between them.
fn whole(p: Plan) -> Number {
  let wipes = if p.shots.length() > 1 { (p.shots.length() - 1) * 0.3 } else { 0.0 }
  var total = wipes
  for s in p.shots {
    total = total + s.seconds
  }
  return total
}

// The QA schedule: a contact sheet at every shot boundary and its own mid.
fn schedule(p: Plan) -> Report {
  var spots: Text[] = []
  var at = 0.0
  for s in p.shots {
    let mid = at + s.seconds / 2
    spots = spots.append(mid.to_fixed(2))
    at = at + s.seconds + 0.3
  }
  let strip_from = p.shots[0].seconds
  let strip_to = strip_from + 0.5
  let bin = if p.clips.is_empty() { "external-integrations/ClaudeAnimationBase" } else { p.clips[0] }
  return {seconds: whole(p), sheets: spots,
    clip: [bin + "/render.mjs", "--clip", "--range=0:" + whole(p).to_fixed(2), "--out=out/video.mp4"],
    yourself: [bin + "/render.mjs", "--strip=" + strip_from.to_fixed(2) + ":" + strip_to.to_fixed(2), "--out=out/check/strip.jpg"]}
}

record Brief { plan: Plan }

workflow main(brief: Brief) -> Report {
  budget 2 model calls, 300 seconds
  problem = plan_problem(brief.plan)
  report = if problem.is_empty() { schedule(brief.plan) } else { schedule({clips: brief.plan.clips, fps: 12, shots: [{name: "hold", seconds: 2.5, alive: brief.plan.shots[0].alive}]}) }
}

// ------------------------------------------------------------------ tests

test "a two-shot film is scheduled sheet by sheet" {
  a = main({plan: {clips: [], fps: 24, shots: [
    {name: "chase", seconds: 3.0, alive: "a hand chases a pencil"},
    {name: "catch", seconds: 2.8, alive: "the pencil is caught and snapped"}
  ]}})
  expect a.sheets.length() == 2
  expect a.clip[3-1].starts_with("--range=0:")
  expect a.seconds > 5.5
}

test "a shot too long falls back to a held shot" {
  a = main({plan: {clips: [], fps: 24, shots: [{name: "one", seconds: 6.0, alive: "waiting"}]}})
  expect a.sheets.length() == 1
  expect a.seconds < 3.5
}

test "a plan with no shots is refused" {
  expect plan_problem({clips: [], fps: 24, shots: []}).starts_with("The film has no shots")
}

test "boiling wants an honest fps" {
  expect plan_problem({clips: [], fps: 6, shots: [{name: "one", seconds: 3.0, alive: "breathing"}]}).starts_with("fps must be")
}
