workflow list_all_styles() -> FilmStyle[] {
  return [
    satellite_briefing, engineering_briefing_board, lidar_survey,
    white_model, data_physicalization, exploded_teardown,
    microscope_story, archive_lighttable,
    crayon_picture_book, watercolor_brush, chinese_ink_wash,
    impasto_oil_painting, one_line_drawing, whiteboard_explainer,
    urban_sketch_pen_wash,
    shadow_puppetry, ukiyo_e, red_paper_cut, paper_cut_lightbox,
    risograph_print, halftone_dossier, woodcut_print,
    copperplate_engraving, silkscreen_travel_poster,
    swiss_motion_graphics, spy_title_sequence, art_deco,
    blueprint, stained_glass, pictogram_motion, ascii_crt_terminal,
    data_storytelling, isometric_infographic, dark_tech_keynote,
    living_screencast, sci_fi_hologram_hud,
    rubber_hose_cartoon, cel_anime, sci_fi_sitcom_toon,
    mid_century_cartoon,
    pixel_rpg, hd_2d, microgame_frenzy, game_show_flat,
    silent_film, liminal_found_footage,
    brick_toy, paper_pop_up_book, tilt_shift_miniature,
    low_poly_isometric_island, glass_product_render
  ]
}

// Check if style is appropriate for topic
workflow validate_style_for_topic(style: FilmStyle, topic: Text) -> Bool {
  invariants = load_style_invariants(style)

  // Check if topic matches style category
  // This would be more sophisticated in practice
  return true
}

// Apply style invariants to scene
workflow apply_style_invariants(scene: SceneDescription, style: FilmStyle) -> SceneDescription {
  invariants = load_style_invariants(style)

  // Apply color palette
  updated_scene = apply_color_palette(scene, invariants.color_palette)

  // Apply typography
  updated_scene = apply_typography(updated_scene, invariants.typography)

  // Apply motion rules
  updated_scene = apply_motion_rules(updated_scene, invariants.motion_rules)

  return updated_scene
}

// Apply color palette
workflow apply_color_palette(scene: SceneDescription, palette: Text[]) -> SceneDescription {
  // Map scene colors to palette
  return scene
}

// Apply typography
workflow apply_typography(scene: SceneDescription, typography: Text) -> SceneDescription {
  // Apply typography rules to text elements
  return scene
}

// Apply motion rules
workflow apply_motion_rules(scene: SceneDescription, rules: Text[]) -> SceneDescription {
  // Apply motion rules to animations
  return scene
}

// Style comparison
workflow compare_styles(style1: FilmStyle, style2: FilmStyle) -> Text {
  inv1 = load_style_invariants(style1)
  inv2 = load_style_invariants(style2)

  var comparison = "Comparing " + f"{style1}" + " and " + f"{style2}" + "\n"
  comparison = comparison + "Categories: " + f"{inv1.category}" + " vs " + f"{inv2.category}" + "\n"
  comparison = comparison + "Looks: " + inv1.look + " vs " + inv2.look + "\n"

  return comparison
}
