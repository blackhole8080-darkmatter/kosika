// Create character animation library
workflow create_animation_library(character: Character) -> Text {
  // Generate standard animations: walk, run, jump, idle, etc.
  var animations: Text[] = []

  animations = animations.append(create_walk_cycle(character))
  animations = animations.append(create_run_cycle(character))
  animations = animations.append(create_idle_animation(character))
  animations = animations.append(create_jump_animation(character))

  // Package as library
  library_path = "character_library/" + character.name + "/"
  return library_path
}

// Create walk cycle
workflow create_walk_cycle(character: Character) -> Text {
  brief = {
    character: character,
    story: "Character walking",
    duration: 2,
    fps: 24,
    width: 512,
    height: 512,
    use_watercolor: false
  }

  anim = create_animation(brief)
  return anim.video_path
}

