// Kosika Designs: interfaces. Websites, phone screens, agent windows and
// artifacts, designed from one sentence.
//
//   kosika run kosika/std/designs_ui.kos --workflow design_ui --input ask.json
//       --model openai/gpt-oss-120b --model-url https://api.groq.com/openai/v1
//       --model-protocol openai --max-output-tokens 8000
//
// where ask.json holds
//   {"ask": {"text": "a landing page for a quiet coffee shop", "target": "",
//            "theme": "", "accent": ""}}
//
// The model only writes what the screen says and which blocks it is made
// of: a nav, a hero, cards, a list, a chat, a tab bar. Kosika decides how
// every block looks. One design system, owned by code, draws them all:
// one type scale, one spacing scale, one radius scale, hairline borders,
// soft shadows, one accent and line icons drawn here. So whatever the
// model writes, the result looks calm, modern and finished, the same way
// every time, and a small or offline model can design as well as a big one.
//
// Kosika checks the description before drawing it, and says what it fixed:
// unknown blocks are dropped, text too long for its place is shortened,
// unknown icons are matched to known ones, a phone gets a title bar and a
// tab bar in their places, and an accent is used only if its contrast
// passes WCAG against the surface it sits on (contrast() in
// designs_palette.kos).
//
// targets   web       a website or landing page, in a browser window
//           phone     one to three phone screens, side by side
//           agent     an agent's window: sidebar, conversation, live panel
//           artifact  a single card: a report, a widget, a summary
//
// Two styles. Vivid, the default: the accent and a partner colour as
// gradients (indigo with amber is Dark Matter), glass with a glowing edge,
// light that drifts behind a website's opening, parts that rise in as they
// come into view, numbers that count up, and chart blocks (line, area,
// bar, ring) that draw themselves in. All motion stops when the device asks
// for reduced motion. Minimal, when the ask says so ("a minimal ..."): the
// same design, calm and still. The theme says which: "dark", "light",
// "dark minimal", "light minimal".
//
// The look is the model's too: its own one or two colours (Kosika keeps
// the hue and makes them readable), the shape of things (soft, round,
// sharp, pill), the type (geometric, grotesk, editorial, mono, rounded)
// and the moving art behind the design (orbits, blobs, waves,
// constellation, prism, rings, grid, aurora), drawn fresh from a seed of
// the ask's words, so no two designs are alike. An art block lets the
// model compose its own moving shapes: polygons, stars, blobs, spirals,
// waves. Whatever the model leaves out, Kosika picks from the seed.
//
// With no model answer at all (offline, or the model failed), Kosika still
// designs: ui_starter lays out a sensible screen for the target from the
// words of the ask.
//
// Other programs reuse the parts: ui_icon(name) gives an icon as SVG,
// ui_icon_names() lists them, ui_tokens_css() gives the spacing, radius
// and type scales as CSS variables (no colours: those stay with the
// Designs palettes), ui_render_spec draws a description without a model.

import "designs_palette.kos"
import "designs_motion.kos"

export [UiAsk, UiFile, UiAppMade, ui_make_app, design_app, ui_app_made, ui_app_page, UiLook, UiEdit, UiLike, UiTasteAsk, design_ui_for, ui_like, ui_lean, ui_edit, ui_edit_local, ui_spec_json, UiItem, UiBlock, UiScreen, UiSpec, UiResult, UiDraw, UiBind, UiApp, design_ui, ui_render, ui_app, ui_live_page, ui_binds_checked, ui_result, ui_target, ui_theme, ui_checked, ui_starter, ui_page, ui_icon, ui_icon_names, ui_tokens_css, ui_kinds, ui_accents, ui_accent_problems, ui_wants]

record UiAsk { text: Text target: Text theme: Text accent: Text }
record UiItem { title: Text text: Text meta: Text icon: Text }
record UiBlock { kind: Text title: Text text: Text meta: Text action: Text items: UiItem[] }
record UiScreen { name: Text blocks: UiBlock[] }
record UiLook { colours: Text[] shape: Text art: Text font: Text }
record UiSpec { target: Text title: Text brand: Text accent: Text theme: Text look: UiLook screens: UiScreen[] }
record UiResult { target: Text title: Text spec: UiSpec page: Text fixed: Text[] problems: Text[] }
record UiDraw { ask: UiAsk spec: UiSpec }
// A design that runs: each bind ties one block to a Kosika workflow.
//   block     composer, activity, progress, stats or list
//   workflow  the workflow to run; for a composer, run on send with what was
//             typed; for the others, run when the page opens and after each
//             send. Empty: the block is filled from the composer's last reply.
//   input     the name of the workflow's input (its one parameter), a record
//             with text: Text
//   field     where the items are in the answer (default items), a UiItem[]
//   every     also run it every so many seconds (0: never)
record UiBind { block: Text workflow: Text input: Text field: Text every: Number }
record UiApp { ask: UiAsk spec: UiSpec binds: UiBind[] }
record UiBrief { task: Text ask: Text target: Text problems: Text }
record UiAccent { name: Text light: Text dark: Text }

model ui_designer {
  input: UiBrief
  output: UiSpec
  parameters: {
    max_output_tokens: 7000
  }
}

// ---------------------------------------------------------------- what it can draw

fn ui_targets() -> Text[] { return ["web", "phone", "agent", "artifact"] }

fn ui_kinds() -> Text[] { return ["nav", "hero", "features", "stats", "cards", "list", "steps", "pricing", "quote", "cta", "footer", "form", "appbar", "search", "chips", "tabbar", "chat", "composer", "activity", "progress", "sidebar", "table", "chart", "art"] }

// Which blocks belong on which target.
fn ui_allowed(target: Text) -> Text[] {
  if target == "phone" { return ["appbar", "hero", "search", "chips", "stats", "cards", "list", "steps", "progress", "activity", "chat", "form", "quote", "cta", "composer", "tabbar", "features", "table", "chart", "art"] }
  if target == "agent" { return ["sidebar", "appbar", "chat", "composer", "activity", "progress", "stats", "list", "cards", "steps", "chips", "search", "form", "table", "chart", "art"] }
  if target == "artifact" { return ["appbar", "hero", "stats", "cards", "list", "steps", "progress", "activity", "chips", "quote", "table", "features", "cta", "form", "chart", "art"] }
  return ["nav", "hero", "features", "stats", "cards", "list", "steps", "pricing", "quote", "cta", "footer", "form", "table", "chips", "search", "chart", "art"]
}

fn ui_most_blocks(target: Text) -> Number {
  if target == "phone" { return 7 }
  if target == "agent" { return 9 }
  if target == "artifact" { return 6 }
  return 10
}

fn ui_most_items(kind: Text) -> Number {
  if kind == "chips" { return 8 }
  if kind == "tabbar" { return 5 }
  if kind == "chat" { return 8 }
  if kind == "sidebar" { return 8 }
  if kind == "nav" { return 5 }
  if kind == "pricing" { return 3 }
  if kind == "stats" { return 4 }
  if kind == "table" { return 7 }
  if kind == "chart" { return 12 }
  if kind == "art" { return 12 }
  return 6
}

// One accent, in a light-theme and a dark-theme shade.
fn ui_accents() -> UiAccent[] {
  return [
    {name: "indigo", light: "#4f46e5", dark: "#818cf8"},
    {name: "violet", light: "#7c3aed", dark: "#a78bfa"},
    {name: "blue", light: "#2563eb", dark: "#60a5fa"},
    {name: "sky", light: "#0369a1", dark: "#38bdf8"},
    {name: "teal", light: "#0f766e", dark: "#2dd4bf"},
    {name: "emerald", light: "#047857", dark: "#34d399"},
    {name: "amber", light: "#b45309", dark: "#fbbf24"},
    {name: "orange", light: "#c2410c", dark: "#ff8a4c"},
    {name: "rose", light: "#e11d48", dark: "#fb7185"},
    {name: "graphite", light: "#18181b", dark: "#f4f4f5"}
  ]
}

fn ui_accent_names() -> Text[] { return for a in ui_accents() { a.name } }

// Each accent's partner, the second colour of its gradients in the vivid
// style. Indigo with amber is Dark Matter.
fn ui_partners() -> UiAccent[] {
  return [
    {name: "indigo", light: "#b45309", dark: "#fbbf24"},
    {name: "violet", light: "#db2777", dark: "#f472b6"},
    {name: "blue", light: "#0e7490", dark: "#22d3ee"},
    {name: "sky", light: "#6d28d9", dark: "#a78bfa"},
    {name: "teal", light: "#4d7c0f", dark: "#a3e635"},
    {name: "emerald", light: "#0369a1", dark: "#38bdf8"},
    {name: "amber", light: "#be123c", dark: "#fb7185"},
    {name: "orange", light: "#be185d", dark: "#f472b6"},
    {name: "rose", light: "#c2410c", dark: "#fb923c"},
    {name: "graphite", light: "#4f46e5", dark: "#818cf8"}
  ]
}

fn ui_partner(name: Text) -> UiAccent {
  let all = ui_partners()
  for a in all {
    if a.name == name.trim().lower() { return a }
  }
  return all[0]
}

fn ui_accent(name: Text) -> UiAccent {
  let all = ui_accents()
  for a in all {
    if a.name == name.trim().lower() { return a }
  }
  return all[0]
}

// The surfaces every accent must read against.
fn ui_light_surface() -> Text { return "#ffffff" }
fn ui_dark_surface() -> Text { return "#141417" }

// What text sits on the accent: white or near-black, whichever reads better.
fn ui_on(colour: Text) -> Text {
  return if contrast(colour, "#ffffff") >= contrast(colour, "#0b0b0f") { "#ffffff" } else { "#0b0b0f" }
}

// Every accent checked by Kosika's own WCAG arithmetic: 3 to 1 against
// its surface, for shapes and large text, and 4.5 to 1 for the words on it.
fn ui_accent_problems() -> Text[] {
  var wrong: Text[] = []
  for a in ui_accents() {
    if contrast(a.light, ui_light_surface()) < 3 { wrong = wrong.append(a.name + " is too faint on white") }
    if contrast(a.dark, ui_dark_surface()) < 3 { wrong = wrong.append(a.name + " is too faint on the dark surface") }
    if contrast(a.light, ui_on(a.light)) < 4.5 { wrong = wrong.append(a.name + " has no readable text colour in light") }
    if contrast(a.dark, ui_on(a.dark)) < 4.5 { wrong = wrong.append(a.name + " has no readable text colour in dark") }
    let p = ui_partner(a.name)
    if contrast(p.light, ui_light_surface()) < 3 { wrong = wrong.append(a.name + "'s partner is too faint on white") }
    if contrast(p.dark, ui_dark_surface()) < 3 { wrong = wrong.append(a.name + "'s partner is too faint on the dark surface") }
    if contrast(p.light, ui_on(a.light)) < 4.5 { wrong = wrong.append(a.name + "'s gradient has no readable text colour in light") }
    if contrast(p.dark, ui_on(a.dark)) < 4.5 { wrong = wrong.append(a.name + "'s gradient has no readable text colour in dark") }
  }
  return wrong
}

// ---------------------------------------------------------------- reading the ask

fn ui_padded(text: Text) -> Text { return " " + text.lower().trim().trim_marks("?!.") + " " }

fn ui_any(t: Text, words: Text[]) -> Bool {
  for w in words {
    if t.contains(w) { return true }
  }
  return false
}

fn ui_phone_words() -> Text[] { return [" phone", " mobile", " iphone", " android", " ios ", " app screen", " app ui", " app design", " onboarding", " mobile app", " smartphone"] }
fn ui_agent_words() -> Text[] { return [" agent window", " agent's window", " agent ui", " agent interface", " agent app", " assistant window", " chat window", " chatbot", " copilot", " agent dashboard", " ai agent", " agents window", " agent console", " agent screen", " ai interface", " ai ui", " ai app", " ai chat", " ai assistant", " assistant app", " assistant ui", " chat app", " chat interface", " llm interface", " llm app", " model interface"] }
fn ui_artifact_words() -> Text[] { return [" artifact", " widget", " card ", " report card", " summary card", " one card", " single card", " receipt", " invoice", " ticket"] }
fn ui_web_words() -> Text[] { return [" website", " web site", " landing page", " homepage", " home page", " web page", " webpage", " portfolio site", " web app", " saas", " dashboard", " admin panel", " blog", " pricing page", " login page", " sign up page", " signup page"] }

// Does the ask want an interface designed? The front door asks this.
fn ui_wants(text: Text) -> Bool {
  let t = ui_padded(text)
  if ui_any(t, ui_web_words()) or ui_any(t, ui_agent_words()) { return true }
  if ui_any(t, [" ui ", " ux ", " user interface", " mockup", " mock-up", " wireframe", " app screen", " screen design", " app design", " design an app", " design a app", " design a screen", " design the screen", " mobile app", " phone app", " iphone app", " android app", " settings screen", " login screen", " onboarding screen", " home screen for"]) { return true }
  return false
}

// The target named by the ask's words, else the one asked, else web.
fn ui_target(ask: UiAsk) -> Text {
  let named = ask.target.trim().lower()
  if ui_targets().contains(named) { return named }
  let t = ui_padded(ask.text)
  if ui_any(t, ui_agent_words()) { return "agent" }
  if ui_any(t, ui_phone_words()) { return "phone" }
  if ui_any(t, ui_web_words()) { return "web" }
  if ui_any(t, ui_artifact_words()) { return "artifact" }
  if ui_any(t, [" app "]) { return "phone" }
  return "web"
}

// The theme holds two things: light or dark, and the style. Vivid is the
// default: gradients in two colours, glass, light that drifts, parts that
// rise in, numbers that count up and charts that draw themselves. Minimal
// is the calm version with none of that, and is written "light minimal"
// or "dark minimal".
fn ui_minimal_words() -> Text[] { return [" minimal", " minimalist", " minimalistic", " plain ", " no animation", " no animations", " no motion", " static ", " quiet design", " understated"] }

fn ui_theme(ask: UiAsk, said: Text) -> Text {
  let named = ask.theme.trim().lower()
  let t = ui_padded(ask.text)
  let s = said.trim().lower()
  let minimal = named.contains("minimal") or ui_any(t, ui_minimal_words()) or (s.contains("minimal") and not ui_any(t, [" vivid", " colourful", " colorful", " animated", " bold "]))
  let given = if named.starts_with("light") or named.starts_with("dark") { named.split(" ")[0] } else { "" }
  let worded = if ui_any(t, [" dark ", " dark mode", " dark theme", " night ", " black "]) { "dark" } else if ui_any(t, [" light ", " light mode", " light theme", " white "]) { "light" } else { "" }
  let told = if s.starts_with("dark") { "dark" } else if s.starts_with("light") { "light" } else { "" }
  let mode = if not given.is_empty() { given } else if not worded.is_empty() { worded } else if not told.is_empty() { told } else if minimal { "light" } else { "dark" }
  return if minimal { mode + " minimal" } else { mode }
}

fn ui_mode(theme: Text) -> Text { return if theme.trim().lower().starts_with("dark") { "dark" } else { "light" } }

fn ui_style(theme: Text) -> Text { return if theme.lower().contains("minimal") { "minimal" } else { "vivid" } }

fn ui_accent_named(ask: UiAsk, said: Text) -> Text {
  let named = ask.accent.trim().lower()
  if ui_accent_names().contains(named) { return named }
  let t = ui_padded(ask.text)
  for a in ui_accent_names() {
    if t.contains(" " + a + " ") { return a }
  }
  if ui_any(t, [" purple "]) { return "violet" }
  if ui_any(t, [" green "]) { return "emerald" }
  if ui_any(t, [" red ", " pink "]) { return "rose" }
  if ui_any(t, [" black and white", " monochrome", " grey ", " gray "]) { return "graphite" }
  if ui_any(t, [" dark matter"]) { return "orange" }
  let s = said.trim().lower()
  return if ui_accent_names().contains(s) { s } else { ui_pick(ui_accent_names().take(9), ui_seed(ask.text), 5) }
}

// ---------------------------------------------------------------- icons

fn ui_icon_names() -> Text[] { return ["home", "search", "user", "users", "chat", "bell", "settings", "plus", "check", "spark", "bolt", "chart", "trend", "calendar", "book", "play", "heart", "star", "lock", "globe", "code", "folder", "mail", "arrow", "back", "chevron", "phone", "camera", "pin", "music", "sun", "moon", "cloud", "leaf", "shield", "grid", "layers", "clock", "send", "mic", "file", "image", "cpu", "wallet", "cart", "more", "menu", "close", "agent", "terminal", "download", "link", "eye", "bookmark", "coffee", "flame", "dot"] }

fn ui_icon_body(name: Text) -> Text {
  if name == "home" { return "<path d='M4 10.5 12 4l8 6.5V19a1.5 1.5 0 0 1-1.5 1.5H15v-6H9v6H5.5A1.5 1.5 0 0 1 4 19z'/>" }
  if name == "search" { return "<circle cx='11' cy='11' r='6.5'/><path d='m16 16 4 4'/>" }
  if name == "user" { return "<circle cx='12' cy='8.5' r='3.5'/><path d='M5 20c1.2-3.6 4-5.5 7-5.5s5.8 1.9 7 5.5'/>" }
  if name == "users" { return "<circle cx='9' cy='9' r='3.2'/><path d='M3.5 19.5c.9-3.2 3-4.8 5.5-4.8s4.6 1.6 5.5 4.8'/><path d='M15.5 6.2a3.2 3.2 0 0 1 0 6M17 14.9c1.8.5 3 1.9 3.5 4.6'/>" }
  if name == "chat" { return "<path d='M5.5 5h13A1.5 1.5 0 0 1 20 6.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4.5 3.5V17h0A1.5 1.5 0 0 1 4 15.5v-9A1.5 1.5 0 0 1 5.5 5z'/>" }
  if name == "bell" { return "<path d='M6 16v-5a6 6 0 0 1 12 0v5l1.5 2h-15z'/><path d='M10 20.5a2 2 0 0 0 4 0'/>" }
  if name == "settings" { return "<path d='M4 7h9M17 7h3M4 17h3M11 17h9'/><circle cx='15' cy='7' r='2'/><circle cx='9' cy='17' r='2'/>" }
  if name == "plus" { return "<path d='M12 5v14M5 12h14'/>" }
  if name == "check" { return "<path d='m5 12.5 4.5 4.5L19 7.5'/>" }
  if name == "spark" { return "<path d='M12 3.5 13.8 10.2 20.5 12l-6.7 1.8L12 20.5l-1.8-6.7L3.5 12l6.7-1.8z'/>" }
  if name == "bolt" { return "<path d='M13 3 5 13.5h6L10.5 21 19 10h-6z'/>" }
  if name == "chart" { return "<path d='M4 20h16'/><path d='M7 16v-5M12 16V7M17 16v-8'/>" }
  if name == "trend" { return "<path d='m4 17 5.5-5.5 4 4L20 9'/><path d='M15 9h5v5'/>" }
  if name == "calendar" { return "<rect x='4' y='5.5' width='16' height='14.5' rx='2.5'/><path d='M4 10h16M8.5 3.5v4M15.5 3.5v4'/>" }
  if name == "book" { return "<path d='M5 5.5A1.5 1.5 0 0 1 6.5 4H18v13H7a2 2 0 0 0-2 2z'/><path d='M5 19a2 2 0 0 0 2 2h11v-4'/>" }
  if name == "play" { return "<path d='M8 5.5v13l10.5-6.5z'/>" }
  if name == "heart" { return "<path d='M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z'/>" }
  if name == "star" { return "<path d='m12 3.8 2.5 5.2 5.7.8-4.1 4 1 5.6-5.1-2.7-5.1 2.7 1-5.6-4.1-4 5.7-.8z'/>" }
  if name == "lock" { return "<rect x='5' y='10.5' width='14' height='10' rx='2.5'/><path d='M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5'/>" }
  if name == "globe" { return "<circle cx='12' cy='12' r='8.5'/><path d='M3.5 12h17M12 3.5c2.4 2.5 3.6 5.3 3.6 8.5s-1.2 6-3.6 8.5c-2.4-2.5-3.6-5.3-3.6-8.5S9.6 6 12 3.5z'/>" }
  if name == "code" { return "<path d='m8.5 8-4 4 4 4M15.5 8l4 4-4 4M13.5 5.5l-3 13'/>" }
  if name == "folder" { return "<path d='M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z'/>" }
  if name == "mail" { return "<rect x='3.5' y='5.5' width='17' height='13' rx='2.5'/><path d='m4.5 7.5 7.5 5.5 7.5-5.5'/>" }
  if name == "arrow" { return "<path d='M5 12h14M13 6l6 6-6 6'/>" }
  if name == "back" { return "<path d='m14.5 5.5-6.5 6.5 6.5 6.5'/>" }
  if name == "chevron" { return "<path d='m9.5 6 6 6-6 6'/>" }
  if name == "phone" { return "<rect x='7' y='3' width='10' height='18' rx='2.5'/><path d='M11 18h2'/>" }
  if name == "camera" { return "<path d='M4 8.5a2 2 0 0 1 2-2h2l1.5-2h5l1.5 2h2a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z'/><circle cx='12' cy='13' r='3.5'/>" }
  if name == "pin" { return "<path d='M12 21s6.5-5.6 6.5-11a6.5 6.5 0 0 0-13 0c0 5.4 6.5 11 6.5 11z'/><circle cx='12' cy='10' r='2.3'/>" }
  if name == "music" { return "<path d='M9 18V6l10-2v12'/><circle cx='6.5' cy='18' r='2.5'/><circle cx='16.5' cy='16' r='2.5'/>" }
  if name == "sun" { return "<circle cx='12' cy='12' r='4'/><path d='M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4'/>" }
  if name == "moon" { return "<path d='M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z'/>" }
  if name == "cloud" { return "<path d='M7 18.5a4.5 4.5 0 0 1-.5-9 6 6 0 0 1 11.3 1.6 3.8 3.8 0 0 1-.3 7.4z'/>" }
  if name == "leaf" { return "<path d='M5 19c0-8 5-13.5 14.5-14.5C19 14 13 19 5 19z'/><path d='M5 19 13 11'/>" }
  if name == "shield" { return "<path d='M12 3.5 19 6v5.5c0 4.4-3 7.8-7 9-4-1.2-7-4.6-7-9V6z'/><path d='m9 12 2 2 4-4'/>" }
  if name == "grid" { return "<rect x='4' y='4' width='6.5' height='6.5' rx='1.6'/><rect x='13.5' y='4' width='6.5' height='6.5' rx='1.6'/><rect x='4' y='13.5' width='6.5' height='6.5' rx='1.6'/><rect x='13.5' y='13.5' width='6.5' height='6.5' rx='1.6'/>" }
  if name == "layers" { return "<path d='m12 4 8.5 4.5L12 13 3.5 8.5z'/><path d='m3.5 12.5 8.5 4.5 8.5-4.5M3.5 16.5 12 21l8.5-4.5'/>" }
  if name == "clock" { return "<circle cx='12' cy='12' r='8.5'/><path d='M12 7.5V12l3 2'/>" }
  if name == "send" { return "<path d='M12 19V5M6 11l6-6 6 6'/>" }
  if name == "mic" { return "<rect x='9' y='3.5' width='6' height='11' rx='3'/><path d='M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v2.5'/>" }
  if name == "file" { return "<path d='M7 3.5h7l4.5 4.5v11.5a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1z'/><path d='M14 3.5V8h4.5M9 13h6M9 16.5h4'/>" }
  if name == "image" { return "<rect x='3.5' y='4.5' width='17' height='15' rx='2.5'/><circle cx='9' cy='9.5' r='1.7'/><path d='m4 17 5-4.5 4 3.5 3-2.5 4 3.5'/>" }
  if name == "cpu" { return "<rect x='6.5' y='6.5' width='11' height='11' rx='2'/><path d='M9.5 3.5v3M14.5 3.5v3M9.5 17.5v3M14.5 17.5v3M3.5 9.5h3M3.5 14.5h3M17.5 9.5h3M17.5 14.5h3'/>" }
  if name == "wallet" { return "<path d='M4 8a2.5 2.5 0 0 1 2.5-2.5h11V8.5'/><rect x='4' y='8.5' width='16.5' height='11' rx='2.5'/><circle cx='16' cy='14' r='1.2'/>" }
  if name == "cart" { return "<path d='M3.5 4.5h2.2l2 11h10.3l1.8-8H7'/><circle cx='9.5' cy='19.5' r='1.3'/><circle cx='16.5' cy='19.5' r='1.3'/>" }
  if name == "more" { return "<circle cx='6' cy='12' r='1.3' class='f'/><circle cx='12' cy='12' r='1.3' class='f'/><circle cx='18' cy='12' r='1.3' class='f'/>" }
  if name == "menu" { return "<path d='M4.5 7h15M4.5 12h15M4.5 17h15'/>" }
  if name == "close" { return "<path d='M6 6l12 12M18 6 6 18'/>" }
  if name == "agent" { return "<rect x='4.5' y='8' width='15' height='11' rx='3.5'/><path d='M12 4.5V8M9.5 12.5v1.5M14.5 12.5v1.5'/><circle cx='12' cy='3.8' r='1'/>" }
  if name == "terminal" { return "<rect x='3.5' y='5' width='17' height='14' rx='2.5'/><path d='m7.5 10 2.5 2-2.5 2M12.5 14.5h4'/>" }
  if name == "download" { return "<path d='M12 4v11M7 10.5l5 5 5-5M5 19.5h14'/>" }
  if name == "link" { return "<path d='M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1'/><path d='M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1'/>" }
  if name == "eye" { return "<path d='M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z'/><circle cx='12' cy='12' r='3'/>" }
  if name == "bookmark" { return "<path d='M6.5 4h11v16.5L12 16.5l-5.5 4z'/>" }
  if name == "coffee" { return "<path d='M4.5 9h12v5a5 5 0 0 1-5 5h-2a5 5 0 0 1-5-5z'/><path d='M16.5 10.5h1a2.5 2.5 0 0 1 0 5h-1.2M8 3.5v2.5M11.5 3.5v2.5'/>" }
  if name == "flame" { return "<path d='M12 21a6 6 0 0 0 6-6c0-4-3-6-4-10-2 2-3 4-3 6-1-1-1.5-2-1.5-3C7.5 10 6 12.5 6 15a6 6 0 0 0 6 6z'/>" }
  return "<circle cx='12' cy='12' r='3' class='f'/>"
}

// Words a model might use for an icon, matched to the one Kosika draws.
fn ui_icon_like(name: Text) -> Text {
  let n = name.trim().lower().replace("_", "-").replace(" ", "-")
  if ui_icon_names().contains(n) { return n }
  let pairs = [["profile", "user"], ["person", "user"], ["account", "user"], ["avatar", "user"], ["team", "users"], ["people", "users"], ["group", "users"], ["friends", "users"], ["message", "chat"], ["messages", "chat"], ["comment", "chat"], ["inbox", "mail"], ["email", "mail"], ["notification", "bell"], ["alert", "bell"], ["gear", "settings"], ["cog", "settings"], ["sliders", "settings"], ["preferences", "settings"], ["add", "plus"], ["new", "plus"], ["done", "check"], ["tick", "check"], ["sparkle", "spark"], ["sparkles", "spark"], ["ai", "spark"], ["magic", "spark"], ["fast", "bolt"], ["lightning", "bolt"], ["zap", "bolt"], ["energy", "bolt"], ["stats", "chart"], ["analytics", "chart"], ["bar-chart", "chart"], ["growth", "trend"], ["trending", "trend"], ["date", "calendar"], ["schedule", "calendar"], ["learn", "book"], ["study", "book"], ["docs", "book"], ["read", "book"], ["video", "play"], ["like", "heart"], ["love", "heart"], ["health", "heart"], ["favorite", "star"], ["favourite", "star"], ["rating", "star"], ["secure", "lock"], ["security", "shield"], ["privacy", "shield"], ["safe", "shield"], ["web", "globe"], ["world", "globe"], ["language", "globe"], ["developer", "code"], ["api", "code"], ["files", "folder"], ["project", "folder"], ["projects", "folder"], ["next", "arrow"], ["right", "chevron"], ["forward", "chevron"], ["mobile", "phone"], ["call", "phone"], ["photo", "camera"], ["location", "pin"], ["map", "pin"], ["place", "pin"], ["audio", "music"], ["day", "sun"], ["light", "sun"], ["weather", "cloud"], ["night", "moon"], ["dark", "moon"], ["nature", "leaf"], ["plant", "leaf"], ["eco", "leaf"], ["apps", "grid"], ["dashboard", "grid"], ["stack", "layers"], ["time", "clock"], ["history", "clock"], ["recent", "clock"], ["submit", "send"], ["voice", "mic"], ["document", "file"], ["note", "file"], ["notes", "file"], ["gallery", "image"], ["picture", "image"], ["chip", "cpu"], ["model", "cpu"], ["compute", "cpu"], ["pay", "wallet"], ["money", "wallet"], ["payment", "wallet"], ["finance", "wallet"], ["shop", "cart"], ["store", "cart"], ["buy", "cart"], ["dots", "more"], ["options", "more"], ["hamburger", "menu"], ["x", "close"], ["bot", "agent"], ["robot", "agent"], ["assistant", "agent"], ["console", "terminal"], ["shell", "terminal"], ["export", "download"], ["share", "link"], ["view", "eye"], ["save", "bookmark"], ["cafe", "coffee"], ["streak", "flame"], ["fire", "flame"], ["hot", "flame"]]
  for p in pairs {
    if p[0] == n { return p[1] }
  }
  return "dot"
}

fn ui_icon(name: Text) -> Text {
  return "<svg class='ic' viewBox='0 0 24 24' aria-hidden='true'>" + ui_icon_body(ui_icon_like(name)) + "</svg>"
}

// ---------------------------------------------------------------- checking a description

fn ui_cut(text: Text, most: Number) -> Text {
  let t = text.trim()
  if t.length() <= most { return t }
  let words = t.slice(0, most - 1).words()
  let kept = if words.length() > 1 { words.slice(0, words.length() - 1).join(" ") } else { t.slice(0, most - 1) }
  return kept.trim_marks(",;:-") + "…"
}

fn ui_item_fixed(kind: Text, i: UiItem) -> UiItem {
  let most = if kind == "chat" { 360 } else { 160 }
  return {title: ui_cut(i.title, 48), text: ui_cut(i.text, most), meta: ui_cut(i.meta, 28), icon: if i.icon.trim().is_empty() { "" } else { ui_icon_like(i.icon) }}
}

fn ui_block_fixed(b: UiBlock) -> UiBlock {
  let kind = b.kind.trim().lower()
  let most = ui_most_items(kind)
  let items = for i in b.items.take(most) { ui_item_fixed(kind, i) }
  return {kind: kind, title: ui_cut(b.title, 80), text: ui_cut(b.text, 220), meta: ui_cut(b.meta, 60), action: ui_cut(b.action, 60), items: items}
}

fn ui_block(kind: Text, title: Text, text: Text, meta: Text, action: Text, items: UiItem[]) -> UiBlock {
  return {kind: kind, title: title, text: text, meta: meta, action: action, items: items}
}

fn ui_item(title: Text, text: Text, meta: Text, icon: Text) -> UiItem {
  return {title: title, text: text, meta: meta, icon: icon}
}

fn ui_count(blocks: UiBlock[], kind: Text) -> Number {
  var n = 0
  for b in blocks {
    if b.kind == kind { n = n + 1 }
  }
  return n
}

// The blocks that belong at the very top, and the very bottom, of a target.
fn ui_tops() -> Text[] { return ["nav", "sidebar", "appbar"] }
fn ui_bottoms() -> Text[] { return ["footer", "composer", "tabbar"] }
fn ui_once() -> Text[] { return ["nav", "footer", "appbar", "tabbar", "composer", "sidebar", "hero"] }

record UiChecked { spec: UiSpec fixed: Text[] problems: Text[] }
record UiScreenChecked { screen: UiScreen fixed: Text[] }

fn ui_screen_checked(target: Text, title: Text, brand: Text, s: UiScreen) -> UiScreenChecked {
  var fixed: Text[] = []
  var kept: UiBlock[] = []
  let allowed = ui_allowed(target)
  for raw in s.blocks {
    let b = ui_block_fixed(raw)
    if not ui_kinds().contains(b.kind) {
      fixed = fixed.append(f"dropped a block Kosika does not know: {b.kind}")
    } else if not allowed.contains(b.kind) {
      fixed = fixed.append(f"dropped a {b.kind}, which does not belong on a {target} screen")
    } else if ui_once().contains(b.kind) and ui_count(kept, b.kind) > 0 {
      fixed = fixed.append(f"kept only the first {b.kind}")
    } else {
      kept = kept.append(b)
    }
  }
  // what a target always has
  if target == "web" and ui_count(kept, "nav") == 0 {
    kept = [ui_block("nav", "", "", "", "Get started", [ui_item("Product", "", "", ""), ui_item("Pricing", "", "", ""), ui_item("About", "", "", "")])].concat(kept)
    fixed = fixed.append("gave the page a navigation bar")
  }
  if target == "web" and ui_count(kept, "footer") == 0 {
    kept = kept.append(ui_block("footer", "", "", "", "", [ui_item("Privacy", "", "", ""), ui_item("Terms", "", "", ""), ui_item("Contact", "", "", "")]))
    fixed = fixed.append("gave the page a footer")
  }
  if target == "phone" and ui_count(kept, "appbar") == 0 {
    kept = [ui_block("appbar", if s.name.trim().is_empty() { title } else { s.name }, "", "", "", [])].concat(kept)
    fixed = fixed.append("gave the screen a title bar")
  }
  if target == "agent" and ui_count(kept, "sidebar") == 0 {
    kept = [ui_block("sidebar", brand, "", "", "New task", [ui_item("Today", "", "", "clock"), ui_item("Tasks", "", "", "check"), ui_item("Files", "", "", "folder"), ui_item("Settings", "", "", "settings")])].concat(kept)
    fixed = fixed.append("gave the window a sidebar")
  }
  if target == "agent" and ui_count(kept, "composer") == 0 and ui_count(kept, "chat") > 0 {
    kept = kept.append(ui_block("composer", "", "Ask, or give a task…", "", "", []))
    fixed = fixed.append("gave the conversation a place to type")
  }
  // tops first, bottoms last, the rest in the order written
  let tops = for b in kept where ui_tops().contains(b.kind) { b }
  let middle = for b in kept where not ui_tops().contains(b.kind) and not ui_bottoms().contains(b.kind) { b }
  let bottoms = for b in kept where ui_bottoms().contains(b.kind) { b }
  let most = ui_most_blocks(target)
  let room = most - tops.length() - bottoms.length()
  if middle.length() > room { fixed = fixed.append(f"kept {room} of {middle.length()} sections, so the screen stays calm") }
  let ordered = tops.concat(middle.take(room.max(1))).concat(bottoms)
  return {screen: {name: ui_cut(s.name, 32), blocks: ordered}, fixed: fixed}
}

// Kosika's check of a description: the target, theme and accent as the
// ask says, the blocks that belong, in their places, every text short
// enough for where it sits.
fn ui_checked(ask: UiAsk, linked: UiSpec) -> UiChecked {
  let said = ui_spec_unlinked(linked)
  let target = ui_target(ask)
  var fixed: Text[] = []
  if ui_targets().contains(said.target.trim().lower()) and said.target.trim().lower() != target {
    fixed = fixed.append(f"drew it as {target}, as the ask says, not {said.target}")
  }
  let empty = said.screens.is_empty() or (for s in said.screens where not s.blocks.is_empty() { s }).is_empty()
  let base = if empty { ui_starter(ask) } else { said }
  if empty { fixed = fixed.append("the model gave no screen, so Kosika laid one out itself") }
  let title = if base.title.trim().is_empty() { ui_subject(ask.text) } else { ui_cut(base.title, 60) }
  let brand = if base.brand.trim().is_empty() { ui_brand(ask.text) } else { ui_cut(base.brand, 24) }
  let most = if target == "phone" { 5 } else if target == "web" { 3 } else { 2 }
  if base.screens.length() > most { fixed = fixed.append(f"kept {most} of {base.screens.length()} screens") }
  var screens: UiScreen[] = []
  for s in base.screens.take(most) {
    let c = ui_screen_checked(target, title, brand, s)
    screens = screens.append(c.screen)
    fixed = fixed.concat(c.fixed)
  }
  let accent = ui_accent_named(ask, base.accent)
  let theme = ui_theme(ask, base.theme)
  let look = ui_look_checked(base.look, ui_seed(ask.text + " " + title))
  return {spec: {target: target, title: title, brand: brand, accent: accent, theme: theme, look: look, screens: screens}, fixed: fixed, problems: ui_accent_problems()}
}

// ---------------------------------------------------------------- with no model

fn ui_subject(text: Text) -> Text {
  var t = " " + text.trim().trim_marks("?!.") + " "
  for w in [" design ", " Design ", " make ", " Make ", " create ", " Create ", " build ", " Build ", " me ", " please ", " a modern ", " a minimal ", " a simple ", " a clean ", " a beautiful ", " an ", " a ", " the "] {
    if t.starts_with(w) { t = " " + t.slice(w.length(), t.length()) }
  }
  for w in [" for ", " of ", " about "] {
    let at = t.index_of(w).or(-1)
    if at >= 0 and at < 40 { t = " " + t.slice(at + w.length(), t.length()) }
  }
  for w in [" a ", " an ", " the ", " my ", " our "] {
    if t.starts_with(w) { t = " " + t.slice(w.length(), t.length()) }
  }
  let s = t.trim()
  if s.is_empty() { return "Your product" }
  return ui_cut(s.slice(0, 1).upper() + s.slice(1, s.length()), 40)
}

fn ui_brand(text: Text) -> Text {
  let words = ui_subject(text).words()
  let generic = [" with ", " that ", " where ", " which ", " your ", " shop ", " store ", " app ", " page ", " site ", " website ", " company ", " startup ", " business ", " service ", " platform ", " tool ", " agent ", " window ", " screen ", " dashboard ", " card ", " studio "]
  let picked = for w in words where w.length() > 3 and not generic.contains(" " + w.lower().trim_marks(",.;:!?") + " ") { w }
  let name = if picked.is_empty() { "Studio" } else { picked[picked.length() - 1] }
  let clean = name.trim_marks(",.;:!?'\"").lower()
  return clean.slice(0, 1).upper() + clean.slice(1, clean.length())
}

// A sensible screen for the target, from the words of the ask alone.
fn ui_starter(ask: UiAsk) -> UiSpec {
  let target = ui_target(ask)
  let subject = ui_subject(ask.text)
  let brand = ui_brand(ask.text)
  if target == "phone" {
    let home: UiScreen = {name: "Home", blocks: [
      ui_block("appbar", subject, "Good morning", "", "", [ui_item("", "", "", "bell"), ui_item("", "", "", "user")]),
      ui_block("search", "", "", "Search " + brand.lower(), "", []),
      ui_block("chips", "", "", "", "", [ui_item("For you", "", "", ""), ui_item("New", "", "", ""), ui_item("Popular", "", "", ""), ui_item("Saved", "", "", "")]),
      ui_block("cards", "Featured", "", "", "See all", [ui_item("Start here", "A short tour of what you can do.", "2 min", "spark"), ui_item("Your week", "What changed since Monday.", "Today", "calendar")]),
      ui_block("list", "Recent", "", "", "", [ui_item("Getting started", "Set up in a minute", "Now", "bolt"), ui_item("Saved items", "Everything you kept", "12", "bookmark"), ui_item("Shared with you", "From your people", "3", "users")]),
      ui_block("tabbar", "", "", "", "", [ui_item("Home", "", "", "home"), ui_item("Search", "", "", "search"), ui_item("Saved", "", "", "bookmark"), ui_item("You", "", "", "user")])
    ]}
    return {target: target, title: subject, brand: brand, accent: "", theme: "", look: ui_no_look(), screens: [home]}
  }
  if target == "agent" {
    let main: UiScreen = {name: subject, blocks: [
      ui_block("sidebar", brand, "", "", "New task", [ui_item("Today", "", "4", "clock"), ui_item("Tasks", "", "", "check"), ui_item("Files", "", "", "folder"), ui_item("Memory", "", "", "layers"), ui_item("Settings", "", "", "settings")]),
      ui_block("appbar", subject, "Working on your request", "Running", "", []),
      ui_block("chat", "", "", "", "", [ui_item("You", "Can you take a look at this for me?", "user", ""), ui_item(brand, "Of course. I read it through and made a short plan. I will ask before I change anything.", "agent", "")]),
      ui_block("activity", "Plan", "", "", "", [ui_item("Read the request", "", "done", "check"), ui_item("Gather what is needed", "", "now", "spark"), ui_item("Ask before changing anything", "", "next", "clock")]),
      ui_block("composer", "", "Ask, or give a task…", "", "", [])
    ]}
    return {target: target, title: subject, brand: brand, accent: "", theme: "", look: ui_no_look(), screens: [main]}
  }
  if target == "artifact" {
    let card: UiScreen = {name: subject, blocks: [
      ui_block("appbar", subject, "A summary at a glance", "Updated today", "", []),
      ui_block("stats", "", "", "", "", [ui_item("24", "Items", "+4", ""), ui_item("92%", "Done", "+6%", ""), ui_item("3", "Open", "", "")]),
      ui_block("list", "Highlights", "", "", "", [ui_item("What went well", "The main result, in one line.", "", "check"), ui_item("What to watch", "One thing that needs attention.", "", "eye"), ui_item("Next step", "The one action that matters most.", "", "arrow")])
    ]}
    return {target: target, title: subject, brand: brand, accent: "", theme: "", look: ui_no_look(), screens: [card]}
  }
  let page: UiScreen = {name: subject, blocks: [
    ui_block("nav", "", "", "", "Get started", [ui_item("Product", "", "", ""), ui_item("Pricing", "", "", ""), ui_item("About", "", "", "")]),
    ui_block("hero", subject, "Everything you need, and nothing you don't. Simple to start, calm to use, built to last.", "New", "Get started|Learn more", []),
    ui_block("features", "Why " + brand, "", "Features", "", [ui_item("Simple", "Starts in a minute, with nothing to set up.", "", "bolt"), ui_item("Thoughtful", "Every detail considered, nothing in your way.", "", "spark"), ui_item("Private", "Your data stays yours, always.", "", "shield")]),
    ui_block("cta", "Ready when you are", "Start today. It takes a minute.", "", "Get started", []),
    ui_block("footer", "", "", "", "", [ui_item("Privacy", "", "", ""), ui_item("Terms", "", "", ""), ui_item("Contact", "", "", "")])
  ]}
  return {target: "web", title: subject, brand: brand, accent: "", theme: "", look: ui_no_look(), screens: [page]}
}

// ---------------------------------------------------------------- the design system

fn ui_esc(text: Text) -> Text {
  return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

// Shape, space and type: the parts of the system that are not colour.
fn ui_tokens_css() -> Text {
  return ":root{--ui-s1:4px;--ui-s2:8px;--ui-s3:12px;--ui-s4:16px;--ui-s5:24px;--ui-s6:32px;--ui-s7:48px;--ui-s8:64px;--ui-s9:96px;--ui-r1:8px;--ui-r2:12px;--ui-r3:16px;--ui-r4:22px;--ui-r5:28px;--ui-pill:999px;--ui-t1:12px;--ui-t2:13.5px;--ui-t3:15px;--ui-t4:17px;--ui-t5:22px;--ui-t6:30px;--ui-t7:44px;--ui-t8:60px;--ui-font:Inter,ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;--ui-mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;--ui-ease:cubic-bezier(.2,.7,.2,1)}"
}

fn ui_colours_css(theme: Text, accent: UiAccent) -> Text {
  let dark = ui_mode(theme) == "dark"
  let a = if dark { accent.dark } else { accent.light }
  let p = ui_partner(accent.name)
  let a2 = if dark { p.dark } else { p.light }
  let on = ui_on(a)
  let pair = ".ui{--a2:" + a2 + "}"
  if dark {
    return pair + ".ui{--bg:#0b0b0d;--surface:#141417;--raised:#1a1a1e;--sunken:#101013;--ink:#f4f4f6;--soft:#a1a1aa;--faint:#71717a;--line:#26262b;--line2:#1d1d21;--accent:" + a + ";--on:" + on + ";--tint:color-mix(in srgb," + a + " 14%,transparent);--tint2:color-mix(in srgb," + a + " 7%,transparent);--shadow:0 1px 0 rgba(255,255,255,.04) inset,0 1px 2px rgba(0,0,0,.5),0 12px 32px -8px rgba(0,0,0,.6);--glass:rgba(20,20,23,.72);color-scheme:dark}"
  }
  return pair + ".ui{--bg:#f7f7f8;--surface:#ffffff;--raised:#ffffff;--sunken:#f2f2f4;--ink:#0b0b0f;--soft:#5b5b66;--faint:#8e8e98;--line:#e6e6ea;--line2:#efeff2;--accent:" + a + ";--on:" + on + ";--tint:color-mix(in srgb," + a + " 10%,transparent);--tint2:color-mix(in srgb," + a + " 5%,transparent);--shadow:0 1px 2px rgba(16,16,24,.04),0 10px 30px -10px rgba(16,16,24,.12);--glass:rgba(255,255,255,.72);color-scheme:light}"
}

fn ui_base_css() -> Text {
  return ".blk{display:contents}.ui{font-family:var(--ui-font);font-size:var(--ui-t3);line-height:1.55;color:var(--ink);-webkit-font-smoothing:antialiased;letter-spacing:-.008em;font-feature-settings:'cv11','ss01','ss03'}.ui *{box-sizing:border-box}.ui h1,.ui h2,.ui h3,.ui h4{margin:0;font-weight:640;letter-spacing:-.028em;line-height:1.08;text-wrap:balance}.ui p{margin:0;text-wrap:pretty}.ui .ic{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}.ui .ic .f{fill:currentColor;stroke:none}.ui .soft{color:var(--soft)}.ui .faint{color:var(--faint)}"
  + ".ui .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:42px;padding:0 20px;border-radius:var(--ui-pill);background:var(--accent);color:var(--on);font-weight:560;font-size:14.5px;letter-spacing:-.01em;white-space:nowrap;box-shadow:0 1px 0 rgba(255,255,255,.18) inset,0 6px 16px -6px color-mix(in srgb,var(--accent) 60%,transparent)}.ui .btn .ic{width:17px;height:17px}.ui .btn.ghost{background:var(--surface);color:var(--ink);box-shadow:0 0 0 1px var(--line) inset}.ui .btn.sm{height:34px;padding:0 14px;font-size:13.5px}.ui .btn.ink{background:var(--ink);color:var(--surface);box-shadow:none}"
  + ".ui .eyebrow{display:inline-flex;align-items:center;gap:8px;height:28px;padding:0 12px 0 10px;border-radius:var(--ui-pill);background:var(--tint);color:var(--accent);font-size:12.5px;font-weight:600;letter-spacing:.01em}.ui .eyebrow i{width:6px;height:6px;border-radius:50%;background:var(--accent)}.ui .kicker{font-size:12.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--accent)}"
  + ".ui .chip{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:var(--tint);color:var(--accent)}.ui .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--ui-r4);box-shadow:var(--shadow)}.ui .mark{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:linear-gradient(140deg,var(--accent),color-mix(in srgb,var(--accent) 55%,#000));color:var(--on);font-weight:700;font-size:14px;letter-spacing:-.02em}.ui .badge{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:var(--ui-pill);background:var(--sunken);color:var(--soft);font-size:12px;font-weight:550}.ui .badge.on{background:var(--tint);color:var(--accent)}"
}

// ---------------------------------------------------------------- blocks

fn ui_or(text: Text, other: Text) -> Text { return if text.trim().is_empty() { other } else { text } }

fn ui_act(action: Text) -> Text { return action.split("|")[0].trim() }

fn ui_or_dot(icon: Text, other: Text) -> Text { return if icon == "dot" or icon.trim().is_empty() { other } else { icon } }

fn ui_buttons(action: Text, size: Text) -> Text {
  if action.trim().is_empty() { return "" }
  let parts = action.split("|")
  let first = f"<span class=\"btn {size}\">{ui_esc(parts[0].trim())}</span>"
  let second = if parts.length() > 1 and not parts[1].trim().is_empty() { f"<span class=\"btn ghost {size}\">{ui_esc(parts[1].trim())}</span>" } else { "" }
  return first + second
}

fn ui_head(b: UiBlock, center: Bool) -> Text {
  if b.title.trim().is_empty() and b.text.trim().is_empty() { return "" }
  let kick = if b.meta.trim().is_empty() { "" } else { f"<div class=\"kicker\">{ui_esc(b.meta)}</div>" }
  let words = if b.text.trim().is_empty() { "" } else { f"<p class=\"soft\">{ui_esc(b.text)}</p>" }
  let cls = if center { "sec-head c" } else { "sec-head" }
  return f"<div class=\"{cls}\">{kick}<h2>{ui_esc(b.title)}</h2>{words}</div>"
}

fn ui_nav(b: UiBlock, brand: Text) -> Text {
  let links = (for i in b.items { f"<span>{ui_esc(i.title)}</span>" }).join("")
  let action = if b.action.trim().is_empty() { "" } else { f"<span class=\"btn sm\">{ui_esc(ui_act(b.action))}</span>" }
  return f"<header class=\"w-nav\"><div class=\"brand\"><span class=\"mark\">{ui_esc(brand.slice(0, 1).upper())}</span>{ui_esc(brand)}</div><nav>{links}</nav><div class=\"w-nav-end\">{action}</div></header>"
}

fn ui_hero_preview(b: UiBlock) -> Text {
  if b.items.is_empty() { return "" }
  let rows = (for k in 0 until b.items.length() { ui_row(b.items[k], k == 0) }).join("")
  return f"<div class=\"hero-shot card\"><div class=\"shot-bar\"><i></i><i></i><i></i></div><div class=\"rows\">{rows}</div></div>"
}

// Three slow orbits behind a website's opening, in the vivid style.
fn ui_orbit() -> Text {
  return "<svg class=\"orbit\" viewBox=\"0 0 800 800\" aria-hidden=\"true\"><g class=\"o1\"><circle cx=\"400\" cy=\"400\" r=\"200\"/><circle class=\"od\" cx=\"600\" cy=\"400\" r=\"6\"/></g><g class=\"o2\"><circle cx=\"400\" cy=\"400\" r=\"290\"/><circle class=\"od b\" cx=\"400\" cy=\"110\" r=\"5\"/><circle class=\"od\" cx=\"400\" cy=\"690\" r=\"3.5\"/></g><g class=\"o3\"><circle cx=\"400\" cy=\"400\" r=\"380\"/><circle class=\"od b\" cx=\"20\" cy=\"400\" r=\"4\"/></g></svg>"
}

fn ui_hero(b: UiBlock, s: UiSpec) -> Text {
  let eyebrow = if b.meta.trim().is_empty() { "" } else { f"<span class=\"eyebrow\"><i></i>{ui_esc(b.meta)}</span>" }
  let words = if b.text.trim().is_empty() { "" } else { f"<p class=\"lead soft\">{ui_esc(b.text)}</p>" }
  let buttons = ui_buttons(b.action, "")
  let acts = if buttons.is_empty() { "" } else { f"<div class=\"acts\">{buttons}</div>" }
  return f"<section class=\"hero\">{ui_spec_backdrop(s)}<div class=\"glow\"></div>{eyebrow}<h1>{ui_esc(b.title)}</h1>{words}{acts}{ui_hero_preview(b)}</section>"
}

fn ui_cols(n: Number) -> Number {
  if n == 4 { return 2 }
  if n == 1 or n == 2 { return n }
  return 3
}

fn ui_features(b: UiBlock) -> Text {
  let defaults = ["spark", "bolt", "shield", "layers", "chart", "globe"]
  let cards = (for k in 0 until b.items.length() { f"<div class=\"feat\"><span class=\"chip\">{ui_icon(ui_or_dot(b.items[k].icon, defaults[k % 6]))}</span><h3>{ui_esc(b.items[k].title)}</h3><p class=\"soft\">{ui_esc(b.items[k].text)}</p></div>" }).join("")
  return f"<section class=\"sec\">{ui_head(b, true)}<div class=\"feats n{ui_cols(b.items.length())}\">{cards}</div></section>"
}

fn ui_stats(b: UiBlock) -> Text {
  let cells = (for i in b.items { f"<div class=\"stat\"><div class=\"num\">{ui_esc(i.title)}</div><div class=\"lbl soft\">{ui_esc(i.text)}</div>" + (if i.meta.trim().is_empty() { "" } else { f"<span class=\"delta\">{ui_esc(i.meta)}</span>" }) + "</div>" }).join("")
  let head = if b.title.trim().is_empty() { "" } else { f"<div class=\"row-head\"><h2>{ui_esc(b.title)}</h2></div>" }
  return f"<section class=\"sec\">{head}<div class=\"stats card\">{cells}</div></section>"
}

fn ui_cards(b: UiBlock) -> Text {
  let defaults = ["spark", "layers", "star", "image", "bolt", "heart"]
  let cards = (for k in 0 until b.items.length() { f"<div class=\"tile\"><div class=\"cover h{k % 6}\">{ui_icon(ui_or_dot(b.items[k].icon, defaults[k % 6]))}</div><div class=\"tile-body\"><h3>{ui_esc(b.items[k].title)}</h3><p class=\"soft\">{ui_esc(b.items[k].text)}</p>" + (if b.items[k].meta.trim().is_empty() { "" } else { f"<span class=\"badge\">{ui_esc(b.items[k].meta)}</span>" }) + "</div></div>" }).join("")
  let more = if b.action.trim().is_empty() { "" } else { f"<span class=\"more\">{ui_esc(b.action)}</span>" }
  let head = if b.title.trim().is_empty() { "" } else { f"<div class=\"row-head\"><h2>{ui_esc(b.title)}</h2>{more}</div>" }
  return f"<section class=\"sec\">{head}<div class=\"tiles\">{cards}</div></section>"
}

fn ui_row(i: UiItem, first: Bool) -> Text {
  let icon = if i.icon.trim().is_empty() { "" } else { f"<span class=\"chip sm\">{ui_icon(i.icon)}</span>" }
  let sub = if i.text.trim().is_empty() { "" } else { f"<div class=\"r-sub soft\">{ui_esc(i.text)}</div>" }
  let meta = if i.meta.trim().is_empty() { "" } else { f"<span class=\"r-meta faint\">{ui_esc(i.meta)}</span>" }
  return f"<div class=\"r\">{icon}<div class=\"r-main\"><div class=\"r-title\">{ui_esc(i.title)}</div>{sub}</div>{meta}<span class=\"faint r-go\">" + ui_icon("chevron") + f"</span></div>"
}

fn ui_list(b: UiBlock) -> Text {
  let rows = (for k in 0 until b.items.length() { ui_row(b.items[k], k == 0) }).join("")
  let more = if b.action.trim().is_empty() { "" } else { f"<span class=\"more\">{ui_esc(b.action)}</span>" }
  let head = if b.title.trim().is_empty() { "" } else { f"<div class=\"row-head\"><h2>{ui_esc(b.title)}</h2>{more}</div>" }
  return f"<section class=\"sec\">{head}<div class=\"rows card\">{rows}</div></section>"
}

fn ui_steps(b: UiBlock) -> Text {
  let steps = (for k in 0 until b.items.length() { f"<div class=\"step\"><span class=\"n\">{k + 1}</span><div><h3>{ui_esc(b.items[k].title)}</h3><p class=\"soft\">{ui_esc(b.items[k].text)}</p></div></div>" }).join("")
  return f"<section class=\"sec\">{ui_head(b, true)}<div class=\"steps\">{steps}</div></section>"
}

fn ui_pricing(b: UiBlock) -> Text {
  let n = b.items.length()
  let best = if n >= 3 { 1 } else { n - 1 }
  let plans = (for k in 0 until n {
    f"<div class=\"plan" + (if k == best { " best" } else { "" }) + "\">" + (if k == best { "<span class=\"badge on\">Most popular</span>" } else { "" })
    + f"<h3>{ui_esc(b.items[k].title)}</h3><div class=\"price\">{ui_esc(b.items[k].meta)}</div><ul>"
    + (for f in b.items[k].text.split(";") where not f.trim().is_empty() { f"<li>" + ui_icon("check") + f"{ui_esc(f.trim())}</li>" }).join("")
    + "</ul><span class=\"btn" + (if k == best { "" } else { " ghost" }) + "\">" + ui_esc(if b.action.trim().is_empty() { "Choose" } else { b.action.split("|")[0].trim() }) + "</span></div>"
  }).join("")
  return f"<section class=\"sec\">{ui_head(b, true)}<div class=\"plans\">{plans}</div></section>"
}

fn ui_quote(b: UiBlock) -> Text {
  let who = if b.meta.trim().is_empty() { "" } else { f"<div class=\"who\"><span class=\"avatar\">{ui_esc(b.meta.slice(0, 1).upper())}</span><div><b>{ui_esc(b.meta)}</b>" + (if b.title.trim().is_empty() { "" } else { f"<div class=\"faint\">{ui_esc(b.title)}</div>" }) + "</div></div>" }
  return f"<section class=\"sec\"><figure class=\"quote\"><blockquote>{ui_esc(b.text)}</blockquote>{who}</figure></section>"
}

fn ui_cta(b: UiBlock) -> Text {
  let words = if b.text.trim().is_empty() { "" } else { f"<p class=\"soft\">{ui_esc(b.text)}</p>" }
  return f"<section class=\"sec\"><div class=\"cta\"><h2>{ui_esc(b.title)}</h2>{words}<div class=\"acts\">" + ui_buttons(b.action, "") + f"</div></div></section>"
}

fn ui_footer(b: UiBlock, brand: Text) -> Text {
  let links = (for i in b.items { f"<span>{ui_esc(i.title)}</span>" }).join("")
  let line = if b.text.trim().is_empty() { "© 2026 " + brand } else { b.text }
  return f"<footer class=\"w-foot\"><div class=\"brand\"><span class=\"mark\">{ui_esc(brand.slice(0, 1).upper())}</span>{ui_esc(brand)}</div><nav>{links}</nav><div class=\"faint small\">{ui_esc(line)}</div></footer>"
}

fn ui_form(b: UiBlock) -> Text {
  let fields = (for i in b.items { f"<label class=\"field\"><span>{ui_esc(i.title)}</span><div class=\"input\">" + (if i.icon == "dot" or i.icon.is_empty() { "" } else { ui_icon(i.icon) }) + f"<em>{ui_esc(i.text)}</em></div></label>" }).join("")
  let head = if b.title.trim().is_empty() { "" } else { f"<h2>{ui_esc(b.title)}</h2>" }
  let words = if b.text.trim().is_empty() { "" } else { f"<p class=\"soft\">{ui_esc(b.text)}</p>" }
  let action = if b.action.trim().is_empty() { "" } else { f"<span class=\"btn wide\">{ui_esc(ui_act(b.action))}</span>" }
  let alt = if b.meta.trim().is_empty() { "" } else { f"<p class=\"faint small c\">{ui_esc(b.meta)}</p>" }
  return f"<section class=\"sec\"><div class=\"form card\">{head}{words}{fields}{action}{alt}</div></section>"
}

fn ui_appbar(b: UiBlock, target: Text) -> Text {
  let icons = (for i in b.items where not i.icon.is_empty() { f"<span class=\"iconbtn\">{ui_icon(i.icon)}</span>" }).join("")
  let sub = if b.text.trim().is_empty() { "" } else { f"<p class=\"soft\">{ui_esc(b.text)}</p>" }
  let status = if b.meta.trim().is_empty() { "" } else { f"<span class=\"badge on live\"><i></i>{ui_esc(b.meta)}</span>" }
  let action = if b.action.trim().is_empty() { "" } else { f"<span class=\"btn sm\">{ui_esc(ui_act(b.action))}</span>" }
  if target == "phone" {
    return f"<div class=\"appbar\"><div class=\"ab-top\"><span></span><div class=\"ab-icons\">{icons}</div></div>{sub}<h1>{ui_esc(b.title)}</h1></div>"
  }
  return f"<div class=\"appbar\"><div class=\"ab-text\"><div class=\"ab-line\"><h1>{ui_esc(b.title)}</h1>{status}</div>{sub}</div><div class=\"ab-icons\">{icons}{action}</div></div>"
}

fn ui_search(b: UiBlock) -> Text {
  let hint = if b.meta.trim().is_empty() { (if b.text.trim().is_empty() { "Search" } else { b.text }) } else { b.meta }
  return f"<div class=\"search\">" + ui_icon("search") + f"<span>{ui_esc(hint)}</span><kbd>⌘K</kbd></div>"
}

fn ui_chips(b: UiBlock) -> Text {
  let chips = (for k in 0 until b.items.length() { f"<span class=\"pill" + (if k == 0 { " on" } else { "" }) + f"\">{ui_esc(b.items[k].title)}</span>" }).join("")
  return f"<div class=\"pills\">{chips}</div>"
}

fn ui_tabbar(b: UiBlock) -> Text {
  let tabs = (for k in 0 until b.items.length() { f"<span class=\"tab" + (if k == 0 { " on" } else { "" }) + f"\">{ui_icon(b.items[k].icon)}<em>{ui_esc(b.items[k].title)}</em></span>" }).join("")
  return f"<nav class=\"tabbar\">{tabs}</nav>"
}

fn ui_is_user(i: UiItem) -> Bool {
  let m = i.meta.trim().lower()
  return m == "user" or m == "you" or m == "me" or m == "human" or i.title.trim().lower() == "you"
}

fn ui_chat(b: UiBlock, brand: Text) -> Text {
  let msgs = (for i in b.items {
    if ui_is_user(i) { f"<div class=\"msg me\"><div class=\"bubble\">{ui_esc(i.text)}</div></div>" }
    else { f"<div class=\"msg\"><span class=\"av\">" + ui_icon("spark") + f"</span><div><div class=\"who-name\">{ui_esc(ui_or(i.title, brand))}</div><div class=\"bubble\">{ui_esc(i.text)}</div></div></div>" }
  }).join("")
  return f"<section class=\"chat\">{msgs}</section>"
}

fn ui_composer(b: UiBlock) -> Text {
  let hint = if b.text.trim().is_empty() { (if b.meta.trim().is_empty() { "Message…" } else { b.meta }) } else { b.text }
  return f"<div class=\"composer\"><span class=\"iconbtn\">" + ui_icon("plus") + f"</span><span class=\"hint\">{ui_esc(hint)}</span><span class=\"iconbtn\">" + ui_icon("mic") + f"</span><span class=\"send\">" + ui_icon("send") + f"</span></div>"
}

fn ui_state(meta: Text) -> Text {
  let m = meta.trim().lower()
  if ["done", "finished", "complete", "completed", "ok", "passed"].contains(m) { return "done" }
  if ["now", "running", "working", "active", "in progress", "live"].contains(m) { return "now" }
  if ["failed", "error", "blocked"].contains(m) { return "bad" }
  return "next"
}

fn ui_activity(b: UiBlock) -> Text {
  let rows = (for i in b.items { f"<li class=\"{ui_state(i.meta)}\"><span class=\"dotmark\">" + (if ui_state(i.meta) == "done" { ui_icon("check") } else { "" }) + f"</span><div><div class=\"a-title\">{ui_esc(i.title)}</div>" + (if i.text.trim().is_empty() { "" } else { f"<div class=\"soft small\">{ui_esc(i.text)}</div>" }) + "</div>" + (if i.meta.trim().is_empty() { "" } else { f"<span class=\"a-meta\">{ui_esc(i.meta)}</span>" }) + "</li>" }).join("")
  let head = if b.title.trim().is_empty() { "" } else { f"<div class=\"row-head\"><h2>{ui_esc(b.title)}</h2></div>" }
  return f"<section class=\"sec\">{head}<ol class=\"activity card\">{rows}</ol></section>"
}

fn ui_percent(meta: Text) -> Number {
  let n = meta.replace("%", "").trim().to_number().or(0)
  return n.max(0).min(100)
}

fn ui_progress(b: UiBlock) -> Text {
  let rows = (for i in b.items { f"<div class=\"bar\"><div class=\"bar-top\"><span>{ui_esc(i.title)}</span><span class=\"faint\">{ui_esc(i.meta)}</span></div><div class=\"track\"><div class=\"fill\" style=\"width:{ui_percent(i.meta)}%\"></div></div></div>" }).join("")
  let head = if b.title.trim().is_empty() { "" } else { f"<div class=\"row-head\"><h2>{ui_esc(b.title)}</h2></div>" }
  return f"<section class=\"sec\">{head}<div class=\"bars card\">{rows}</div></section>"
}

fn ui_sidebar(b: UiBlock, brand: Text) -> Text {
  let name = if b.title.trim().is_empty() { brand } else { b.title }
  let action = if b.action.trim().is_empty() { "" } else { f"<span class=\"btn ghost sm wide\">" + ui_icon("plus") + f"{ui_esc(ui_act(b.action))}</span>" }
  let links = (for k in 0 until b.items.length() { f"<span class=\"side-link" + (if k == 0 { " on" } else { "" }) + f"\">{ui_icon(b.items[k].icon)}<em>{ui_esc(b.items[k].title)}</em>" + (if b.items[k].meta.trim().is_empty() { "" } else { f"<b>{ui_esc(b.items[k].meta)}</b>" }) + "</span>" }).join("")
  let foot = if b.text.trim().is_empty() { "" } else { f"<div class=\"side-foot soft small\">{ui_esc(b.text)}</div>" }
  return f"<div class=\"side-in\"><div class=\"brand\"><span class=\"mark\">{ui_esc(name.slice(0, 1).upper())}</span>{ui_esc(name)}</div>{action}<div class=\"side-links\">{links}</div>{foot}</div>"
}

fn ui_table(b: UiBlock) -> Text {
  let head = if b.title.trim().is_empty() { "" } else { f"<div class=\"row-head\"><h2>{ui_esc(b.title)}</h2></div>" }
  let cols = b.meta.split("|")
  let th = if b.meta.trim().is_empty() { "" } else { "<tr>" + (for c in cols { f"<th>{ui_esc(c.trim())}</th>" }).join("") + "</tr>" }
  let rows = (for i in b.items { f"<tr><td><b>{ui_esc(i.title)}</b></td><td class=\"soft\">{ui_esc(i.text)}</td><td><span class=\"badge\">{ui_esc(i.meta)}</span></td></tr>" }).join("")
  return f"<section class=\"sec\">{head}<div class=\"card tbl\"><table>{th}{rows}</table></div></section>"
}

// The number in a value like "$4.2k", "92%" or "1,200": its digits.
fn ui_number(text: Text) -> Number {
  var kept = ""
  for k in 0 until text.length() {
    let ch = text.slice(k, k + 1)
    if "0123456789.".contains(ch) or (ch == "-" and kept.is_empty()) { kept = kept + ch }
  }
  return kept.to_number().or(0)
}

fn ui_value(i: UiItem) -> Number { return if i.meta.trim().is_empty() { ui_number(i.text) } else { ui_number(i.meta) } }

fn ui_shown(i: UiItem) -> Text { return if i.meta.trim().is_empty() { i.text } else { i.meta } }

fn ui_chart_kind(b: UiBlock) -> Text {
  let m = b.meta.trim().lower()
  if ["line", "area", "bar", "ring"].contains(m) { return m }
  if m == "bars" or m == "column" or m == "columns" { return "bar" }
  if m == "donut" or m == "pie" or m == "rings" or m == "gauge" { return "ring" }
  if m == "trend" or m == "lines" { return "line" }
  return if b.items.length() >= 6 { "area" } else { "bar" }
}

fn ui_grads() -> Text {
  return "<defs><linearGradient id=\"ui-ch-g\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\"><stop offset=\"0\" style=\"stop-color:var(--accent)\"/><stop offset=\"1\" style=\"stop-color:var(--a2)\"/></linearGradient><linearGradient id=\"ui-ch-a\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop offset=\"0\" style=\"stop-color:var(--accent);stop-opacity:.34\"/><stop offset=\"1\" style=\"stop-color:var(--accent);stop-opacity:0\"/></linearGradient></defs>"
}

fn ui_line_chart(b: UiBlock, area: Bool) -> Text {
  let vals = for i in b.items { ui_value(i) }
  let n = vals.length()
  if n == 0 { return "" }
  var hi = vals[0]
  var lo = vals[0]
  for v in vals {
    hi = hi.max(v)
    lo = lo.min(v)
  }
  let spread = hi - lo
  let floor = if spread == 0 { 0 } else if lo >= 0 and lo - spread * 0.3 < 0 { 0 } else { lo - spread * 0.3 }
  let top = if hi == floor { hi + 1 } else { hi }
  let w = 600
  let h = 220
  let xs = for k in 0 until n { if n == 1 { w / 2 } else { (12 + k * (w - 24) / (n - 1)).round() } }
  let ys = for v in vals { (h - 14 - (v - floor) / (top - floor) * (h - 40)).round() }
  let pts = (for k in 0 until n { f"{xs[k]},{ys[k]}" }).join(" L")
  let fill = if area { f"<path class=\"ar\" d=\"M{pts} L{xs[n - 1]},{h} L{xs[0]},{h} Z\" fill=\"url(#ui-ch-a)\"/>" } else { "" }
  let grid = (for g in [1, 2, 3] { f"<line class=\"gl\" x1=\"0\" x2=\"{w}\" y1=\"{g * h / 4}\" y2=\"{g * h / 4}\"/>" }).join("")
  let dots = (for k in 0 until n { f"<circle class=\"pt" + (if k == n - 1 { " last" } else { "" }) + f"\" cx=\"{xs[k]}\" cy=\"{ys[k]}\" r=\"5\" style=\"--i:{k}\"/>" }).join("")
  let labels = (for i in b.items { f"<span>{ui_esc(i.title)}</span>" }).join("")
  let last = b.items[n - 1]
  let now = f"<div class=\"ch-now\"><b>{ui_esc(ui_shown(last))}</b><span class=\"soft\">{ui_esc(last.title)}</span></div>"
  return now + f"<svg class=\"ch-svg\" viewBox=\"0 0 {w} {h}\">" + ui_grads() + grid + fill + f"<path class=\"ln\" d=\"M{pts}\" pathLength=\"1\" fill=\"none\" stroke=\"url(#ui-ch-g)\"/>" + dots + f"</svg><div class=\"ch-x faint\">{labels}</div>"
}

fn ui_bar_chart(b: UiBlock) -> Text {
  let vals = for i in b.items { ui_value(i).max(0) }
  var hi = 0
  for v in vals { hi = hi.max(v) }
  let top = if hi == 0 { 1 } else { hi }
  let bars = (for k in 0 until b.items.length() { f"<div class=\"cb\"><span class=\"cb-v\">{ui_esc(ui_shown(b.items[k]))}</span><div class=\"cb-col\"><i style=\"height:{(vals[k] / top * 100).round().max(2)}%;--i:{k}\"></i></div><span class=\"cb-l faint\">{ui_esc(b.items[k].title)}</span></div>" }).join("")
  return f"<div class=\"ch-bars\">{bars}</div>"
}

fn ui_ring_chart(b: UiBlock) -> Text {
  let items = b.items.take(4)
  var hi = 0
  for i in items { hi = hi.max(ui_value(i)) }
  let scale = if hi > 100 { 100 / hi } else { 1 }
  let rings = (for k in 0 until items.length() { f"<div class=\"ring\" style=\"--i:{k}\"><div class=\"ring-in\"><svg viewBox=\"0 0 120 120\">" + ui_grads() + f"<circle class=\"rt\" cx=\"60\" cy=\"60\" r=\"50\"/><circle class=\"rf\" cx=\"60\" cy=\"60\" r=\"50\" pathLength=\"100\" stroke-dasharray=\"{(ui_value(items[k]) * scale).max(0).min(100).round()} 100\" stroke=\"url(#ui-ch-g)\" transform=\"rotate(-90 60 60)\"/></svg><b>{ui_esc(ui_shown(items[k]))}</b></div><span class=\"soft\">{ui_esc(items[k].title)}</span></div>" }).join("")
  return f"<div class=\"ch-rings\">{rings}</div>"
}

fn ui_chart(b: UiBlock) -> Text {
  let kind = ui_chart_kind(b)
  let body = if kind == "ring" { ui_ring_chart(b) } else if kind == "bar" { ui_bar_chart(b) } else { ui_line_chart(b, kind == "area") }
  let head = if b.title.trim().is_empty() { "" } else { f"<div class=\"row-head\"><h2>{ui_esc(b.title)}</h2>" + (if b.action.trim().is_empty() { "" } else { f"<span class=\"more\">{ui_esc(b.action)}</span>" }) + "</div>" }
  let note = if b.text.trim().is_empty() { "" } else { f"<p class=\"ch-note soft\">{ui_esc(b.text)}</p>" }
  return f"<section class=\"sec\">{head}<div class=\"chart card k-{kind}\">{body}{note}</div></section>"
}

fn ui_block_html(b: UiBlock, s: UiSpec) -> Text {
  let k = b.kind
  if k == "nav" { return ui_nav(b, s.brand) }
  if k == "hero" { return ui_hero(b, s) }
  if k == "features" { return ui_features(b) }
  if k == "stats" { return ui_stats(b) }
  if k == "cards" { return ui_cards(b) }
  if k == "list" { return ui_list(b) }
  if k == "steps" { return ui_steps(b) }
  if k == "pricing" { return ui_pricing(b) }
  if k == "quote" { return ui_quote(b) }
  if k == "cta" { return ui_cta(b) }
  if k == "footer" { return ui_footer(b, s.brand) }
  if k == "form" { return ui_form(b) }
  if k == "appbar" { return ui_appbar(b, s.target) }
  if k == "search" { return ui_search(b) }
  if k == "chips" { return ui_chips(b) }
  if k == "tabbar" { return ui_tabbar(b) }
  if k == "chat" { return ui_chat(b, s.brand) }
  if k == "composer" { return ui_composer(b) }
  if k == "activity" { return ui_activity(b) }
  if k == "progress" { return ui_progress(b) }
  if k == "sidebar" { return ui_sidebar(b, s.brand) }
  if k == "table" { return ui_table(b) }
  if k == "chart" { return ui_chart(b) }
  if k == "art" { return ui_art(b, s) }
  return ""
}

fn ui_blocks_html(blocks: UiBlock[], s: UiSpec) -> Text {
  return (for b in blocks { f"<div class=\"blk\" data-kind=\"{b.kind}\">" + ui_block_html(b, s) + "</div>" }).join("")
}

// ---------------------------------------------------------------- frames

fn ui_slug(text: Text) -> Text {
  return (for w in text.lower().words() { w.trim_marks(",.;:!?'\"()&") }).join("")
}

fn ui_web(sc: UiScreen, s: UiSpec) -> Text {
  return f"<div class=\"browser\" data-screen=\"{ui_esc(sc.name)}\"><div class=\"b-bar\"><span class=\"lights\"><i></i><i></i><i></i></span><span class=\"url\">" + ui_icon("lock") + f"{ui_esc(ui_slug(s.brand))}.com</span><span></span></div><div class=\"b-body t-web\">{ui_blocks_html(sc.blocks, s)}</div></div>"
}

fn ui_status_bar() -> Text {
  return "<div class=\"status\"><b>9:41</b><span class=\"sig\"><svg viewBox='0 0 18 12'><rect x='0' y='8' width='3' height='4' rx='1'/><rect x='5' y='5.5' width='3' height='6.5' rx='1'/><rect x='10' y='3' width='3' height='9' rx='1'/><rect x='15' y='0' width='3' height='12' rx='1'/></svg><svg viewBox='0 0 16 12'><path d='M8 11.5 5.8 9.2a3.1 3.1 0 0 1 4.4 0zM3.6 7a6.2 6.2 0 0 1 8.8 0l-1.2 1.2a4.5 4.5 0 0 0-6.4 0zM1.4 4.8a9.3 9.3 0 0 1 13.2 0l-1.2 1.2a7.6 7.6 0 0 0-10.8 0z'/></svg><svg viewBox='0 0 27 12'><rect x='.5' y='.5' width='23' height='11' rx='3.5' fill='none' stroke='currentColor' opacity='.4'/><rect x='2' y='2' width='18' height='8' rx='2'/><rect x='24.5' y='4' width='2' height='4' rx='1' opacity='.4'/></svg></span></div>"
}

fn ui_phone(sc: UiScreen, s: UiSpec) -> Text {
  let scroll = for b in sc.blocks where b.kind != "tabbar" and b.kind != "composer" { b }
  let pinned = for b in sc.blocks where b.kind == "composer" or b.kind == "tabbar" { b }
  let label = if sc.name.trim().is_empty() { "" } else { f"<div class=\"phone-name faint\">{ui_esc(sc.name)}</div>" }
  return f"<div class=\"phone-wrap\" data-screen=\"{ui_esc(sc.name)}\"><div class=\"phone\"><div class=\"island\"></div><div class=\"screen t-phone\">{ui_spec_backdrop(s)}{ui_status_bar()}<div class=\"scroll\">{ui_blocks_html(scroll, s)}</div><div class=\"pinned\">{ui_blocks_html(pinned, s)}<div class=\"homebar\"></div></div></div></div>{label}</div>"
}

fn ui_side_kinds() -> Text[] { return ["activity", "progress", "stats", "chart"] }

fn ui_agent(sc: UiScreen, s: UiSpec) -> Text {
  let has_chat = ui_count(sc.blocks, "chat") > 0
  let side = for b in sc.blocks where b.kind == "sidebar" { b }
  let panel = for b in sc.blocks where has_chat and ui_side_kinds().contains(b.kind) { b }
  let main = for b in sc.blocks where b.kind != "sidebar" and b.kind != "composer" and not (has_chat and ui_side_kinds().contains(b.kind)) { b }
  let typing = for b in sc.blocks where b.kind == "composer" { b }
  let panel_html = if panel.is_empty() { "" } else { f"<aside class=\"panel\">{ui_blocks_html(panel, s)}</aside>" }
  let cls = if panel.is_empty() { "win-body" } else { "win-body three" }
  return f"<div class=\"win\" data-screen=\"{ui_esc(sc.name)}\"><div class=\"win-bar\"><span class=\"lights\"><i></i><i></i><i></i></span><span class=\"win-title\">{ui_esc(s.brand)}</span><span></span></div><div class=\"{cls} t-agent\"><aside class=\"side\">{ui_blocks_html(side, s)}</aside><main class=\"main\">{ui_spec_backdrop(s)}<div class=\"scroll\">{ui_blocks_html(main, s)}</div>{ui_blocks_html(typing, s)}</main>{panel_html}</div></div>"
}

fn ui_artifact(sc: UiScreen, s: UiSpec) -> Text {
  return f"<div class=\"artifact card t-artifact\" data-screen=\"{ui_esc(sc.name)}\">{ui_spec_backdrop(s)}{ui_blocks_html(sc.blocks, s)}</div>"
}

fn ui_frames(s: UiSpec) -> Text {
  if s.target == "phone" { return "<div class=\"phones\">" + (for sc in s.screens { ui_phone(sc, s) }).join("") + "</div>" }
  if s.target == "agent" { return (for sc in s.screens { ui_agent(sc, s) }).join("") }
  if s.target == "artifact" { return (for sc in s.screens { ui_artifact(sc, s) }).join("") }
  return (for sc in s.screens { ui_web(sc, s) }).join("")
}

// ---------------------------------------------------------------- layout CSS, per frame

fn ui_web_css() -> Text {
  return ".browser{width:min(1180px,100%);margin:0 auto;background:var(--bg);border-radius:16px;overflow:hidden;box-shadow:0 0 0 1px var(--line),0 30px 80px -30px rgba(10,10,20,.35)}.b-bar{display:grid;grid-template-columns:80px 1fr 80px;align-items:center;height:44px;padding:0 14px;background:var(--sunken);border-bottom:1px solid var(--line)}.lights{display:flex;gap:7px}.lights i{width:11px;height:11px;border-radius:50%;background:var(--line)}.url{justify-self:center;display:flex;align-items:center;gap:6px;height:28px;padding:0 14px;border-radius:9px;background:var(--surface);color:var(--soft);font-size:12.5px;min-width:240px;justify-content:center;box-shadow:0 0 0 1px var(--line2)}.url .ic{width:12px;height:12px}"
  + ".t-web .w-nav{display:flex;align-items:center;gap:32px;height:68px;padding:0 max(24px,calc((100% - 1080px)/2));border-bottom:1px solid var(--line2);background:var(--glass);backdrop-filter:blur(14px)}.brand{display:flex;align-items:center;gap:10px;font-weight:650;letter-spacing:-.02em;font-size:16px}.t-web .w-nav nav{display:flex;gap:28px;color:var(--soft);font-size:14px;flex:1}.t-web .w-nav-end{display:flex;gap:10px}@media (max-width:640px){.t-web .w-nav{gap:12px;justify-content:space-between}.t-web .w-nav nav{display:none}.t-web .hero{padding:72px 20px 56px}.t-web .sec{padding:48px 20px}.url{min-width:0}}"
  + ".t-web .hero{position:relative;text-align:center;padding:104px 24px 88px;overflow:hidden}.t-web .hero .glow{position:absolute;inset:-40% 10% auto;height:560px;background:radial-gradient(closest-side,color-mix(in srgb,var(--accent) 22%,transparent),transparent);filter:blur(10px);pointer-events:none}.t-web .hero>*{position:relative}.t-web .hero h1{font-size:clamp(40px,6.2vw,68px);max-width:15ch;margin:22px auto 0}.t-web .hero .lead{font-size:19px;max-width:54ch;margin:22px auto 0;line-height:1.6}.ui .acts{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:34px}.t-web .hero-shot{max-width:760px;margin:64px auto 0;text-align:left;overflow:hidden}.shot-bar{display:flex;gap:6px;padding:12px 14px;border-bottom:1px solid var(--line2)}.shot-bar i{width:8px;height:8px;border-radius:50%;background:var(--line)}"
  + ".t-web .sec{padding:72px max(24px,calc((100% - 1080px)/2))}.sec-head{max-width:640px;margin-bottom:40px}.sec-head.c{text-align:center;margin:0 auto 44px}.sec-head h2{font-size:clamp(28px,3.4vw,40px);margin-top:10px}.sec-head p{margin-top:14px;font-size:17px}.t-web .feats{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}.t-web .feats.n2{grid-template-columns:repeat(2,1fr)}.t-web .feats.n3{grid-template-columns:repeat(3,1fr)}@media (max-width:820px){.t-web .feats.n2,.t-web .feats.n3{grid-template-columns:1fr}}.feat{padding:28px;border-radius:var(--ui-r4);background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow)}.feat h3{font-size:17px;margin:20px 0 8px;letter-spacing:-.02em}.feat p{font-size:14.5px}"
  + ".stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}.stat{padding:28px;border-left:1px solid var(--line2);position:relative}.stat:first-child{border-left:0}.stat .num{font-size:40px;font-weight:650;letter-spacing:-.04em;line-height:1}.stat .lbl{margin-top:10px;font-size:14px}.stat .delta{position:absolute;top:26px;right:22px;font-size:12px;font-weight:600;color:var(--accent)}"
  + ".tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}.tile{border-radius:var(--ui-r4);background:var(--surface);border:1px solid var(--line);overflow:hidden;box-shadow:var(--shadow)}.cover{height:150px;display:grid;place-items:center;color:var(--accent)}.cover .ic{width:34px;height:34px;stroke-width:1.4;opacity:.9}.cover.h0{background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 22%,var(--sunken)),var(--sunken))}.cover.h1{background:linear-gradient(160deg,var(--sunken),color-mix(in srgb,var(--accent) 16%,var(--sunken)))}.cover.h2{background:radial-gradient(circle at 30% 20%,color-mix(in srgb,var(--accent) 24%,var(--sunken)),var(--sunken) 70%)}.cover.h3{background:linear-gradient(45deg,color-mix(in srgb,var(--accent) 12%,var(--sunken)),color-mix(in srgb,var(--accent) 26%,var(--sunken)))}.cover.h4{background:radial-gradient(circle at 80% 80%,color-mix(in srgb,var(--accent) 22%,var(--sunken)),var(--sunken) 65%)}.cover.h5{background:linear-gradient(200deg,color-mix(in srgb,var(--accent) 18%,var(--sunken)),var(--sunken))}.tile-body{padding:20px 22px 22px}.tile-body h3{font-size:16.5px;letter-spacing:-.02em}.tile-body p{font-size:14px;margin-top:6px}.tile-body .badge{margin-top:14px}"
  + ".row-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16px}.row-head h2{font-size:22px}.more{color:var(--accent);font-size:14px;font-weight:560}.rows{overflow:hidden}.r{display:flex;align-items:center;gap:14px;padding:14px 18px;border-top:1px solid var(--line2)}.r:first-child{border-top:0}.chip.sm{width:36px;height:36px;border-radius:11px}.chip.sm .ic{width:18px;height:18px}.r-main{flex:1;min-width:0}.r-title{font-weight:560;font-size:15px;letter-spacing:-.01em}.r-sub{font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r-meta{font-size:13px;white-space:nowrap}.r-go .ic{width:16px;height:16px}"
  + ".steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:28px}.step{display:flex;gap:16px}.step .n{flex:none;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--tint);color:var(--accent);font-weight:650;font-size:14px}.step h3{font-size:16.5px;margin:5px 0 6px}.step p{font-size:14.5px}"
  + ".plans{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;align-items:start}.plan{position:relative;padding:30px;border-radius:var(--ui-r4);background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);display:flex;flex-direction:column;gap:16px}.plan.best{border-color:color-mix(in srgb,var(--accent) 55%,var(--line));box-shadow:0 0 0 1px color-mix(in srgb,var(--accent) 40%,transparent),0 24px 60px -24px color-mix(in srgb,var(--accent) 45%,transparent)}.plan .badge{position:absolute;top:28px;right:24px}.plan h3{font-size:16px}.price{font-size:40px;font-weight:650;letter-spacing:-.04em}.plan ul{list-style:none;margin:0;padding:0;display:grid;gap:10px;font-size:14.5px;color:var(--soft)}.plan li{display:flex;gap:10px;align-items:center}.plan li .ic{width:16px;height:16px;color:var(--accent)}.plan .btn{margin-top:8px}"
  + ".quote{margin:0 auto;max-width:760px;text-align:center}.quote blockquote{margin:0;font-size:clamp(22px,2.6vw,30px);line-height:1.35;letter-spacing:-.025em;font-weight:500}.who{display:inline-flex;align-items:center;gap:12px;margin-top:28px;text-align:left;font-size:14px}.avatar{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--tint);color:var(--accent);font-weight:650}"
  + ".cta{text-align:center;padding:72px 32px;border-radius:var(--ui-r5);background:radial-gradient(120% 140% at 50% 0%,color-mix(in srgb,var(--accent) 16%,var(--surface)),var(--surface) 70%);border:1px solid var(--line)}.cta h2{font-size:clamp(28px,3.6vw,44px)}.cta p{margin-top:14px;font-size:17px}"
  + ".t-web .w-foot{display:flex;align-items:center;gap:32px;flex-wrap:wrap;padding:32px max(24px,calc((100% - 1080px)/2)) 40px;border-top:1px solid var(--line2);font-size:14px}.t-web .w-foot nav{display:flex;gap:24px;color:var(--soft);flex:1}.small{font-size:13px}.c{text-align:center}"
  + ".form{max-width:440px;margin:0 auto;padding:32px;display:flex;flex-direction:column;gap:16px}.form h2{font-size:26px}.field{display:grid;gap:7px;font-size:13.5px;font-weight:560}.input{display:flex;align-items:center;gap:10px;height:46px;padding:0 14px;border-radius:12px;background:var(--sunken);box-shadow:0 0 0 1px var(--line) inset;color:var(--faint)}.input em{font-style:normal;font-weight:400;font-size:14.5px}.input .ic{width:18px;height:18px}.btn.wide{width:100%;height:48px}"
  + ".search{display:flex;align-items:center;gap:10px;height:46px;padding:0 14px;border-radius:14px;background:var(--sunken);box-shadow:0 0 0 1px var(--line2) inset;color:var(--faint);font-size:15px}.search span{flex:1}.search kbd{font:500 11.5px var(--ui-font);padding:3px 6px;border-radius:6px;background:var(--surface);box-shadow:0 0 0 1px var(--line);color:var(--faint)}.pills{display:flex;gap:8px;flex-wrap:wrap}.pill{height:34px;padding:0 15px;display:inline-flex;align-items:center;border-radius:var(--ui-pill);background:var(--surface);box-shadow:0 0 0 1px var(--line) inset;font-size:13.5px;font-weight:540;color:var(--soft)}.pill.on{background:var(--ink);color:var(--surface);box-shadow:none}"
  + ".tbl{overflow:hidden}.tbl table{width:100%;border-collapse:collapse;font-size:14px}.tbl th{text-align:left;font-weight:560;color:var(--faint);font-size:12.5px;padding:12px 18px;background:var(--sunken)}.tbl td{padding:14px 18px;border-top:1px solid var(--line2)}"
  + ".activity{list-style:none;margin:0;padding:8px 0;position:relative}.activity li{display:flex;gap:14px;align-items:flex-start;padding:12px 18px;position:relative}.activity li:not(:last-child)::after{content:'';position:absolute;left:28px;top:36px;bottom:-12px;width:1.5px;background:var(--line)}.dotmark{flex:none;display:grid;place-items:center;width:21px;height:21px;border-radius:50%;margin-top:1px;box-shadow:0 0 0 1.5px var(--line) inset;background:var(--surface);position:relative;z-index:1}.activity .done .dotmark{background:var(--accent);box-shadow:none;color:var(--on)}.dotmark .ic{width:13px;height:13px;stroke-width:2.4}.activity .now .dotmark{box-shadow:0 0 0 1.5px var(--accent) inset,0 0 0 5px var(--tint)}.activity .now .dotmark::after{content:'';width:7px;height:7px;border-radius:50%;background:var(--accent)}.activity .bad .dotmark{box-shadow:0 0 0 1.5px #e11d48 inset}.activity li>div{flex:1}.a-title{font-weight:560;font-size:14.5px}.activity .next .a-title{color:var(--soft)}.a-meta{font-size:12px;color:var(--faint);font-weight:550;text-transform:capitalize}.activity .now .a-meta{color:var(--accent)}"
  + ".bars{padding:18px;display:grid;gap:16px}.bar-top{display:flex;justify-content:space-between;font-size:13.5px;font-weight:540;margin-bottom:8px}.track{height:7px;border-radius:99px;background:var(--sunken);overflow:hidden;box-shadow:0 0 0 1px var(--line2) inset}.fill{height:100%;border-radius:99px;background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 70%,var(--surface)),var(--accent))}"
  + ".chat{display:flex;flex-direction:column;gap:18px}.msg{display:flex;gap:12px;max-width:640px}.msg.me{align-self:flex-end;justify-content:flex-end}.msg .bubble{font-size:14.5px;line-height:1.6}.msg.me .bubble{background:var(--sunken);padding:10px 16px;border-radius:20px 20px 6px 20px;box-shadow:0 0 0 1px var(--line2) inset}.av{flex:none;display:grid;place-items:center;width:30px;height:30px;border-radius:10px;background:linear-gradient(140deg,var(--accent),color-mix(in srgb,var(--accent) 55%,#000));color:var(--on)}.av .ic{width:16px;height:16px}.who-name{font-size:13px;font-weight:620;margin:4px 0 4px}"
  + ".composer{display:flex;align-items:center;gap:6px;margin:12px 20px 20px;padding:8px 8px 8px 10px;border-radius:22px;background:var(--surface);box-shadow:0 0 0 1px var(--line) inset,var(--shadow)}.composer .hint{flex:1;color:var(--faint);font-size:14.5px;padding-left:4px}.iconbtn{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;color:var(--soft)}.send{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--accent);color:var(--on)}.send .ic{width:18px;height:18px;stroke-width:2.1}"
  + ".badge.live{gap:6px}.badge.live i{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 3px var(--tint);animation:ui-pulse 1.6s var(--ui-ease) infinite}@keyframes ui-pulse{50%{opacity:.35}}"
}

fn ui_phone_css() -> Text {
  return ".phones{display:flex;gap:40px;justify-content:center;flex-wrap:wrap}.phone-wrap{display:flex;flex-direction:column;align-items:center;gap:14px}.phone-name{font-size:13px;font-weight:550}.phone{position:relative;width:390px;height:844px;border-radius:58px;padding:11px;background:#0c0c0e;box-shadow:0 0 0 1.5px #2a2a2e,0 0 0 4px #121214,0 40px 90px -30px rgba(10,10,20,.5)}.island{position:absolute;top:22px;left:50%;transform:translateX(-50%);width:120px;height:34px;border-radius:20px;background:#000;z-index:5}.screen{position:relative;height:100%;border-radius:47px;overflow:hidden;background:var(--bg);display:flex;flex-direction:column}"
  + ".status{display:flex;justify-content:space-between;align-items:center;height:54px;padding:6px 30px 0 40px;font-size:16px;flex:none}.status b{font-weight:600;letter-spacing:-.01em}.sig{display:flex;gap:6px;align-items:center}.sig svg{height:12px;fill:currentColor}"
  + ".t-phone .scroll{flex:1;overflow:hidden;padding:0 20px 20px;display:flex;flex-direction:column;gap:22px}.t-phone .sec{padding:0}.t-phone .appbar{padding-top:4px}.t-phone .ab-top{display:flex;justify-content:space-between;align-items:center;height:40px}.t-phone .ab-icons{display:flex;gap:4px}.t-phone .iconbtn{background:var(--surface);box-shadow:0 0 0 1px var(--line2) inset;border-radius:50%;color:var(--ink)}.t-phone .iconbtn .ic{width:19px;height:19px}.t-phone .appbar p{font-size:14px;margin-top:6px}.t-phone .appbar h1{font-size:32px;letter-spacing:-.035em;margin-top:2px}"
  + ".t-phone .hero{text-align:left;padding:8px 0}.t-phone .hero .glow{display:none}.t-phone .hero h1{font-size:30px;margin-top:14px}.t-phone .hero .lead{font-size:15.5px;margin-top:10px}.t-phone .acts{justify-content:flex-start;margin-top:20px}.t-phone .hero-shot{margin-top:20px}"
  + ".t-phone .tiles{display:flex;gap:12px;overflow:hidden;margin-right:-20px}.t-phone .tile{flex:none;width:240px}.t-phone .cover{height:120px}.t-phone .feats{display:grid;gap:10px}.t-phone .feat{padding:18px;display:grid;grid-template-columns:40px 1fr;column-gap:14px}.t-phone .feat .chip{grid-row:span 2}.t-phone .feat h3{margin:0 0 2px}.t-phone .sec-head,.t-phone .sec-head.c{margin:0 0 16px;text-align:left}.t-phone .sec-head h2{font-size:22px}.t-phone .row-head{margin-bottom:12px}.t-phone .row-head h2{font-size:19px}.t-phone .r{padding:12px 14px}.t-phone .stats{grid-template-columns:repeat(2,1fr)}.t-phone .stat{padding:18px;border-left:0;border-top:1px solid var(--line2)}.t-phone .stat:nth-child(-n+2){border-top:0}.t-phone .stat:nth-child(2n){border-left:1px solid var(--line2)}.t-phone .stat .num{font-size:28px}.t-phone .stat .delta{top:18px;right:14px}.t-phone .steps{gap:16px}.t-phone .quote blockquote{font-size:20px}.t-phone .cta{padding:32px 20px}.t-phone .cta h2{font-size:24px}.t-phone .form{padding:22px;box-shadow:none}.t-phone .search kbd{display:none}.t-phone .pills{flex-wrap:nowrap;overflow:hidden;margin-right:-20px}.t-phone .pill{flex:none}.t-phone .chat{gap:14px}.t-phone .msg{max-width:100%}"
  + ".pinned{flex:none}.t-phone .composer{margin:0 14px 8px}.tabbar{display:flex;justify-content:space-around;padding:10px 12px 2px;border-top:1px solid var(--line2);background:var(--glass);backdrop-filter:blur(16px)}.tab{display:flex;flex-direction:column;align-items:center;gap:3px;color:var(--faint);min-width:56px}.tab em{font-style:normal;font-size:10.5px;font-weight:560}.tab .ic{width:23px;height:23px}.tab.on{color:var(--accent)}.homebar{width:134px;height:5px;border-radius:3px;background:var(--ink);opacity:.9;margin:10px auto 9px}"
}

fn ui_agent_css() -> Text {
  return ".win{width:min(1240px,100%);height:780px;margin:0 auto;display:flex;flex-direction:column;border-radius:14px;overflow:hidden;background:var(--bg);box-shadow:0 0 0 1px var(--line),0 30px 80px -30px rgba(10,10,20,.4)}.win-bar{display:grid;grid-template-columns:80px 1fr 80px;align-items:center;height:40px;padding:0 14px;background:var(--sunken);border-bottom:1px solid var(--line);flex:none}.win-title{justify-self:center;font-size:12.5px;font-weight:560;color:var(--soft)}"
  + ".win-body{flex:1;display:grid;grid-template-columns:248px 1fr;min-height:0}.win-body.three{grid-template-columns:248px 1fr 300px}.side{background:var(--sunken);border-right:1px solid var(--line);padding:18px 14px;min-height:0}.side-in{display:flex;flex-direction:column;gap:16px;height:100%}.side-in .brand{padding:2px 6px}.side-links{display:grid;gap:2px}.side-link{display:flex;align-items:center;gap:10px;height:36px;padding:0 10px;border-radius:10px;color:var(--soft);font-size:14px}.side-link em{flex:1;font-style:normal}.side-link b{font-size:11.5px;font-weight:600;color:var(--faint)}.side-link .ic{width:18px;height:18px}.side-link.on{background:var(--surface);color:var(--ink);box-shadow:0 0 0 1px var(--line) inset,0 1px 2px rgba(0,0,0,.04)}.side-foot{margin-top:auto;padding:0 6px}"
  + ".t-agent .main{display:flex;flex-direction:column;min-height:0;min-width:0;background:var(--bg)}.t-agent .main .scroll{flex:1;overflow:hidden;padding:24px 40px;display:flex;flex-direction:column;gap:26px}.t-agent .appbar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:20px;border-bottom:1px solid var(--line2)}.ab-line{display:flex;align-items:center;gap:10px}.t-agent .appbar h1{font-size:20px;letter-spacing:-.025em}.t-agent .appbar p{font-size:13.5px;margin-top:4px}.t-agent .ab-icons{display:flex;gap:6px;align-items:center}.t-agent .sec{padding:0}.t-agent .composer{margin:0 40px 22px}.t-agent .row-head h2{font-size:15px}"
  + ".panel{border-left:1px solid var(--line);background:var(--surface);padding:22px 18px;display:flex;flex-direction:column;gap:24px;min-height:0;overflow:hidden}.panel .sec{padding:0}.panel .row-head{margin-bottom:10px}.panel .row-head h2{font-size:13px;letter-spacing:.02em;color:var(--soft);font-weight:600}.panel .card{box-shadow:none;background:var(--bg)}.panel .stats{grid-template-columns:1fr 1fr}.panel .stat{padding:14px;border-left:0}.panel .stat .num{font-size:24px}.panel .stat .delta{top:14px;right:12px}.panel .activity li{padding:10px 14px}.panel .activity li:not(:last-child)::after{left:24px}"
  + "@media (max-width:900px){.win-body,.win-body.three{grid-template-columns:1fr}.side,.panel{display:none}.t-agent .main .scroll{padding:20px}.t-agent .composer{margin:0 16px 16px}}"
}

fn ui_artifact_css() -> Text {
  return ".artifact{width:min(880px,100%);margin:0 auto;padding:32px;display:flex;flex-direction:column;gap:28px;border-radius:var(--ui-r5)}.t-artifact .sec{padding:0}.t-artifact .appbar{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.t-artifact .appbar h1{font-size:28px;letter-spacing:-.03em}.t-artifact .appbar p{margin-top:6px}.t-artifact .ab-line{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.t-artifact .card{box-shadow:none}.t-artifact .hero{text-align:left;padding:0}.t-artifact .hero .glow{display:none}.t-artifact .hero h1{font-size:34px;margin-top:12px}.t-artifact .hero .lead{margin-top:10px}.t-artifact .acts{justify-content:flex-start}.t-artifact .feats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}.t-artifact .feat{box-shadow:none;padding:20px}.t-artifact .feat h3{margin-top:14px}.t-artifact .stat .num{font-size:34px}"
}

fn ui_stage_css(theme: Text) -> Text {
  let stage = if ui_mode(theme) == "dark" { "radial-gradient(1200px 600px at 50% -10%,#1b1b22,transparent 70%) no-repeat,#08080a" } else { "radial-gradient(1200px 600px at 50% -10%,#ffffff,transparent 70%) no-repeat,#ececf0" }
  return "html,body{margin:0;min-height:100%}body{min-height:100vh;background:" + stage + "}.stage{padding:48px 24px 72px;max-width:1320px;margin:0 auto}.stage-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:0 auto 32px;max-width:1240px}.stage-head .by{font-size:12.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--faint)}.stage-head h1{font-size:26px;margin-top:8px}.stage-tags{display:flex;gap:8px}.stage details{max-width:1240px;margin:28px auto 0;color:var(--soft);font-size:13.5px}.stage summary{cursor:pointer;color:var(--faint)}.stage details ul{margin:10px 0 0;padding-left:18px}@media (max-width:640px){.stage{padding:24px 12px 48px}.phone{transform:scale(.86);transform-origin:top center;margin-bottom:-118px}}"
}

// ---------------------------------------------------------------- the look

// What the model chooses beyond the words: its own colours (one or two
// hex colours, made readable by Kosika), the shape of things, the type and
// the art behind the design. Anything left empty or unknown is chosen by
// Kosika from the ask's words, so two asks rarely look alike.
fn ui_shapes() -> Text[] { return ["soft", "round", "sharp", "pill"] }
fn ui_arts() -> Text[] { return ["orbits", "blobs", "waves", "constellation", "prism", "rings", "grid", "aurora"] }
fn ui_fonts() -> Text[] { return ["geometric", "grotesk", "editorial", "mono", "rounded"] }

fn ui_no_look() -> UiLook { return {colours: [], shape: "", art: "", font: ""} }

// A number from the words, the same every time for the same words.
fn ui_seed(text: Text) -> Number {
  let chars = "abcdefghijklmnopqrstuvwxyz0123456789 .,"
  var h = 7
  for k in 0 until text.length() {
    let c = chars.index_of(text.slice(k, k + 1).lower()).or(40)
    h = (h * 31 + c + 1) % 1000003
  }
  return h
}

// A repeatable random number between 0 and 1: the k-th for this seed.
fn ui_rnd(seed: Number, k: Number) -> Number {
  let x = ((seed % 9973) * 0.61 + k * 37.719).sin() * 43758.5453
  return x - x.floor()
}

fn ui_pick(list: Text[], seed: Number, k: Number) -> Text { return list[(ui_rnd(seed, k) * list.length()).floor() % list.length()] }

fn ui_hexd(ch: Text) -> Number { return "0123456789abcdef".index_of(ch.lower()).or(0) }

fn ui_chan(hex: Text, at: Number) -> Number { return ui_hexd(hex.slice(at, at + 1)) * 16 + ui_hexd(hex.slice(at + 1, at + 2)) }

fn ui_hex2(n: Number) -> Text {
  let v = n.max(0).min(255).round()
  let d = "0123456789abcdef"
  let hi = (v / 16).floor()
  let lo = v % 16
  return d.slice(hi, hi + 1) + d.slice(lo, lo + 1)
}

// A colour written #rgb or #rrggbb, as #rrggbb; anything else as "".
fn ui_hex(text: Text) -> Text {
  let t = text.trim().lower()
  let body = if t.starts_with("#") { t.slice(1, t.length()) } else { t }
  for k in 0 until body.length() {
    if not "0123456789abcdef".contains(body.slice(k, k + 1)) { return "" }
  }
  if body.length() == 6 { return "#" + body }
  if body.length() == 3 { return "#" + body.slice(0, 1) + body.slice(0, 1) + body.slice(1, 2) + body.slice(1, 2) + body.slice(2, 3) + body.slice(2, 3) }
  return ""
}

fn ui_mix(a: Text, b: Text, t: Number) -> Text {
  return "#" + ui_hex2(ui_chan(a, 1) * (1 - t) + ui_chan(b, 1) * t) + ui_hex2(ui_chan(a, 3) * (1 - t) + ui_chan(b, 3) * t) + ui_hex2(ui_chan(a, 5) * (1 - t) + ui_chan(b, 5) * t)
}

// A chosen colour made readable: in dark, light enough for dark text on
// it and to stand out on the dark surface; in light, dark enough for white
// text and to stand out on white. The hue stays the model's.
fn ui_fit(colour: Text, dark: Bool) -> Text {
  var c = colour
  for k in 0 until 24 {
    if dark and contrast(c, "#0b0b0f") < 5.5 { c = ui_mix(c, "#ffffff", 0.1) }
    if not dark and contrast(c, "#ffffff") < 4.6 { c = ui_mix(c, "#000000", 0.1) }
  }
  return c
}

fn ui_look_checked(look: UiLook, seed: Number) -> UiLook {
  let colours = (for c in look.colours where not ui_hex(c).is_empty() { ui_hex(c) }).take(2)
  let shape = if ui_shapes().contains(look.shape.trim().lower()) { look.shape.trim().lower() } else { ui_pick(ui_shapes(), seed, 1) }
  let art = if ui_arts().contains(look.art.trim().lower()) or look.art.trim().lower() == "none" { look.art.trim().lower() } else { ui_pick(ui_arts(), seed, 2) }
  let font = if ui_fonts().contains(look.font.trim().lower()) { look.font.trim().lower() } else { ui_pick(ui_fonts(), seed, 3) }
  return {colours: colours, shape: shape, art: art, font: font}
}

fn ui_font_family(font: Text) -> Text {
  if font == "grotesk" { return "'Space Grotesk',var(--ui-font)" }
  if font == "editorial" { return "Fraunces,Georgia,'Times New Roman',serif" }
  if font == "mono" { return "'JetBrains Mono',var(--ui-mono)" }
  if font == "rounded" { return "Nunito,var(--ui-font)" }
  return "var(--ui-font)"
}

fn ui_font_link(font: Text) -> Text {
  let fam = if font == "grotesk" { "&family=Space+Grotesk:wght@500;600;700" } else if font == "editorial" { "&family=Fraunces:opsz,wght@9..144,500;9..144,600" } else if font == "mono" { "&family=JetBrains+Mono:wght@500;600;700" } else if font == "rounded" { "&family=Nunito:wght@600;700;800" } else { "" }
  return "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700" + fam + "&display=swap\">"
}

// The look as CSS, laid over the design system.
fn ui_look_css(s: UiSpec) -> Text {
  let l = s.look
  let dark = ui_mode(s.theme) == "dark"
  let r = if l.shape == "sharp" { "--ui-r1:3px;--ui-r2:4px;--ui-r3:6px;--ui-r4:8px;--ui-r5:10px" } else if l.shape == "round" { "--ui-r1:12px;--ui-r2:18px;--ui-r3:22px;--ui-r4:30px;--ui-r5:38px" } else if l.shape == "pill" { "--ui-r1:12px;--ui-r2:16px;--ui-r3:20px;--ui-r4:26px;--ui-r5:34px" } else { "" }
  let btn = if l.shape == "sharp" { ".ui .btn,.ui .send,.ui .chip,.ui .pill,.ui .eyebrow,.ui .badge{border-radius:6px}.ui .card{border-radius:var(--ui-r4)}" } else { "" }
  let head = ".ui{" + r + ";--ui-head:" + ui_font_family(l.font) + "}.ui h1,.ui h2,.ui h3,.ui .num,.ui .price,.ui .brand,.ui .ch-now b,.ui .ring-in b{font-family:var(--ui-head)}" + (if l.font == "editorial" { ".ui h1,.ui h2{font-weight:560;letter-spacing:-.02em}" } else if l.font == "mono" { ".ui h1,.ui h2{letter-spacing:-.04em}" } else { "" })
  if l.colours.is_empty() { return head + btn }
  let a = ui_fit(l.colours[0], dark)
  let a2 = if l.colours.length() > 1 { ui_fit(l.colours[1], dark) } else { ui_fit(ui_mix(l.colours[0], if dark { "#fbbf24" } else { "#b45309" }, 0.55), dark) }
  let on = if dark { "#0b0b0f" } else { "#ffffff" }
  return head + btn + ".ui{--accent:" + a + ";--a2:" + a2 + ";--on:" + on + ";--tint:color-mix(in srgb," + a + " 14%,transparent);--tint2:color-mix(in srgb," + a + " 7%,transparent)}"
}

// ---------------------------------------------------------------- art

fn ui_n(x: Number) -> Number { return (x * 10).round() / 10 }

fn ui_pt(x: Number, y: Number) -> Text { return f"{ui_n(x)},{ui_n(y)}" }

// A smooth closed curve through the points: a blob.
fn ui_smooth(xs: Number[], ys: Number[]) -> Text {
  let n = xs.length()
  let start = ui_pt((xs[n - 1] + xs[0]) / 2, (ys[n - 1] + ys[0]) / 2)
  let parts = (for k in 0 until n { "Q" + ui_pt(xs[k], ys[k]) + " " + ui_pt((xs[k] + xs[(k + 1) % n]) / 2, (ys[k] + ys[(k + 1) % n]) / 2) }).join(" ")
  return "M" + start + " " + parts + "Z"
}

fn ui_blob(cx: Number, cy: Number, r: Number, seed: Number, k: Number) -> Text {
  let n = 9
  let xs = for i in 0 until n { cx + r * (0.72 + ui_rnd(seed, k * 31 + i) * 0.5) * (i * 360 / n).cos() }
  let ys = for i in 0 until n { cy + r * (0.72 + ui_rnd(seed, k * 31 + i) * 0.5) * (i * 360 / n).sin() }
  return ui_smooth(xs, ys)
}

fn ui_poly(cx: Number, cy: Number, r: Number, sides: Number, turn: Number) -> Text {
  return "M" + (for i in 0 until sides { ui_pt(cx + r * (turn - 90 + i * 360 / sides).cos(), cy + r * (turn - 90 + i * 360 / sides).sin()) }).join(" L") + "Z"
}

fn ui_star(cx: Number, cy: Number, r: Number, points: Number, turn: Number) -> Text {
  let n = points * 2
  return "M" + (for i in 0 until n { ui_pt(cx + (if i % 2 == 0 { r } else { r * 0.46 }) * (turn - 90 + i * 180 / points).cos(), cy + (if i % 2 == 0 { r } else { r * 0.46 }) * (turn - 90 + i * 180 / points).sin()) }).join(" L") + "Z"
}

fn ui_spiral(cx: Number, cy: Number, r: Number) -> Text {
  return "M" + (for i in 0 until 49 { ui_pt(cx + r * i / 48 * (i * 15).cos(), cy + r * i / 48 * (i * 15).sin()) }).join(" L")
}

fn ui_wave(x0: Number, y: Number, width: Number, amp: Number, waves: Number) -> Text {
  let steps = 64
  return "M" + (for i in 0 until steps + 1 { ui_pt(x0 + width * i / steps, y + amp * (i * 360 * waves / steps).sin()) }).join(" L")
}

fn ui_fills() -> Text[] { return ["var(--accent)", "var(--a2)", "url(#ui-ch-g)", "color-mix(in srgb,var(--accent) 50%,var(--a2))"] }

// The art behind a design, drawn fresh from the seed: no two alike.
fn ui_backdrop(art: Text, seed: Number) -> Text {
  if art == "none" or art.is_empty() { return "" }
  let open = f"<svg class=\"art-bg a-{art}\" viewBox=\"0 0 800 800\" preserveAspectRatio=\"xMidYMid slice\" aria-hidden=\"true\">" + ui_grads()
  if art == "blobs" {
    return open + (for k in 0 until 4 { f"<path class=\"bl\" style=\"fill:{ui_fills()[k % 4]};--i:{k}\" d=\"{ui_blob(180 + ui_rnd(seed, k) * 440, 160 + ui_rnd(seed, k + 9) * 420, 140 + ui_rnd(seed, k + 4) * 120, seed, k)}\"/>" }).join("") + "</svg>"
  }
  if art == "waves" {
    let n = 2 + (ui_rnd(seed, 3) * 3).floor()
    return open + (for k in 0 until 6 { f"<path class=\"wv\" style=\"--i:{k}\" d=\"{ui_wave(0, 260 + k * 62, 1600, 26 + ui_rnd(seed, k) * 46, n * 2)}\"/>" }).join("") + "</svg>"
  }
  if art == "constellation" {
    let xs = for k in 0 until 26 { 60 + ui_rnd(seed, k) * 680 }
    let ys = for k in 0 until 26 { 60 + ui_rnd(seed, k + 50) * 680 }
    let lines = (for k in 0 until 25 where ((xs[k] - xs[k + 1]).power(2) + (ys[k] - ys[k + 1]).power(2)).power(0.5) < 300 { f"<line x1=\"{ui_n(xs[k])}\" y1=\"{ui_n(ys[k])}\" x2=\"{ui_n(xs[k + 1])}\" y2=\"{ui_n(ys[k + 1])}\"/>" }).join("")
    let dots = (for k in 0 until 26 { f"<circle class=\"st" + (if k % 5 == 0 { " big" } else { "" }) + f"\" cx=\"{ui_n(xs[k])}\" cy=\"{ui_n(ys[k])}\" r=\"" + (if k % 5 == 0 { "5" } else { "2.6" }) + f"\" style=\"--i:{k % 9}\"/>" }).join("")
    return open + "<g class=\"cl\">" + lines + "</g>" + dots + "</svg>"
  }
  if art == "prism" {
    return open + (for k in 0 until 7 { f"<path class=\"pr\" style=\"fill:{ui_fills()[k % 4]};--i:{k}\" d=\"{ui_poly(90 + ui_rnd(seed, k) * 620, 90 + ui_rnd(seed, k + 20) * 620, 50 + ui_rnd(seed, k + 40) * 110, 3 + (ui_rnd(seed, k + 60) * 4).floor(), ui_rnd(seed, k + 70) * 120)}\"/>" }).join("") + "</svg>"
  }
  if art == "rings" {
    return open + (for k in 0 until 6 { f"<circle class=\"rg\" cx=\"400\" cy=\"400\" r=\"{110 + k * 52}\" style=\"--i:{k};stroke-dasharray:{2 + (ui_rnd(seed, k) * 30).round()} {6 + (ui_rnd(seed, k + 8) * 22).round()}\"/>" }).join("") + "</svg>"
  }
  if art == "grid" {
    let hs = (for k in 0 until 9 { f"<line x1=\"0\" x2=\"800\" y1=\"{ui_n(430 + 370 * (k / 8).power(1.8))}\" y2=\"{ui_n(430 + 370 * (k / 8).power(1.8))}\"/>" }).join("")
    let vs = (for k in 0 until 17 { f"<line x1=\"400\" y1=\"400\" x2=\"{-800 + k * 150}\" y2=\"800\"/>" }).join("")
    return open + "<circle class=\"sun\" cx=\"400\" cy=\"330\" r=\"" + f"{110 + (ui_rnd(seed, 1) * 50).round()}" + "\" fill=\"url(#ui-ch-g)\"/><g class=\"gd\">" + hs + vs + "</g></svg>"
  }
  if art == "aurora" {
    return open + (for k in 0 until 3 { f"<ellipse class=\"au\" cx=\"{ui_n(250 + ui_rnd(seed, k) * 300)}\" cy=\"{ui_n(240 + k * 120)}\" rx=\"{ui_n(320 + ui_rnd(seed, k + 5) * 160)}\" ry=\"{ui_n(50 + ui_rnd(seed, k + 9) * 40)}\" style=\"fill:{ui_fills()[k % 4]};--i:{k}\" transform=\"rotate({ui_n(-18 + ui_rnd(seed, k + 3) * 36)} 400 400)\"/>" }).join("") + "</svg>"
  }
  let r1 = 170 + (ui_rnd(seed, 1) * 60).round()
  let r2 = r1 + 80 + (ui_rnd(seed, 2) * 40).round()
  let r3 = r2 + 80 + (ui_rnd(seed, 3) * 30).round()
  return open + f"<g class=\"ob o1\"><circle cx=\"400\" cy=\"400\" r=\"{r1}\"/><circle class=\"od\" cx=\"{400 + r1}\" cy=\"400\" r=\"6\"/></g><g class=\"ob o2\"><circle cx=\"400\" cy=\"400\" r=\"{r2}\"/><circle class=\"od b\" cx=\"400\" cy=\"{400 - r2}\" r=\"5\"/><circle class=\"od\" cx=\"400\" cy=\"{400 + r2}\" r=\"3.5\"/></g><g class=\"ob o3\"><circle cx=\"400\" cy=\"400\" r=\"{r3}\"/><circle class=\"od b\" cx=\"{400 - r3}\" cy=\"400\" r=\"4\"/></g></svg>"
}

fn ui_spec_seed(s: UiSpec) -> Number { return ui_seed(s.title + " " + s.brand + " " + s.target) }

fn ui_spec_backdrop(s: UiSpec) -> Text { return ui_backdrop(s.look.art, ui_spec_seed(s)) }

// The art block: shapes the model composes, drawn and set in motion.
fn ui_shape_names() -> Text[] { return ["circle", "ring", "square", "diamond", "triangle", "pentagon", "hexagon", "octagon", "star", "blob", "spiral", "wave", "polygon"] }

fn ui_motions() -> Text[] { return ["spin", "float", "pulse", "sway", "none"] }

fn ui_shape_fill(colour: Text) -> Text {
  let c = colour.trim().lower()
  if c == "accent" or c == "first" { return "var(--accent)" }
  if c == "partner" or c == "second" or c == "a2" { return "var(--a2)" }
  if c == "ink" or c == "text" { return "var(--ink)" }
  if c == "soft" { return "var(--line)" }
  let h = ui_hex(c)
  return if h.is_empty() { "url(#ui-ch-g)" } else { h }
}

fn ui_meta_nums(meta: Text) -> Number[] {
  return for w in meta.replace(",", " ").words() where not ui_hex(w).is_empty() or w.to_number().or(-1) >= 0 { w.to_number().or(0) }
}

fn ui_shape(i: UiItem, k: Number, n: Number, seed: Number) -> Text {
  let name = i.title.trim().lower()
  let nums = ui_meta_nums(i.meta)
  let x = (if nums.length() > 0 { nums[0].max(0).min(1) } else { (k + 0.5) / n }) * 600
  let y = (if nums.length() > 1 { nums[1].max(0).min(1) } else { 0.35 + ui_rnd(seed, k) * 0.3 }) * 320
  let r = (if nums.length() > 2 { nums[2].max(0.04).min(0.5) } else { 0.12 + ui_rnd(seed, k + 7) * 0.12 }) * 320
  let fill = ui_shape_fill(i.text)
  let motion = if ui_motions().contains(i.icon.trim().lower()) { i.icon.trim().lower() } else { ui_pick(["spin", "float", "pulse", "sway"], seed, k + 11) }
  let digits = ui_number(name)
  let turn = ui_rnd(seed, k + 13) * 40
  let line = name == "ring" or name == "spiral" or name == "wave"
  let d = if name == "circle" or name == "ring" { "" } else if name == "square" { ui_poly(x, y, r, 4, 45) } else if name == "diamond" { ui_poly(x, y, r, 4, 0) } else if name == "triangle" { ui_poly(x, y, r, 3, turn) } else if name == "pentagon" { ui_poly(x, y, r, 5, turn) } else if name == "hexagon" { ui_poly(x, y, r, 6, turn) } else if name == "octagon" { ui_poly(x, y, r, 8, turn) } else if name.starts_with("star") { ui_star(x, y, r, if digits >= 3 { digits.min(12) } else { 5 }, turn) } else if name.contains("gon") or name.starts_with("polygon") { ui_poly(x, y, r, if digits >= 3 { digits.min(16) } else { 7 }, turn) } else if name == "spiral" { ui_spiral(x, y, r) } else if name == "wave" { ui_wave(x - r * 1.6, y, r * 3.2, r * 0.35, 2) } else { ui_blob(x, y, r, seed, k) }
  let paint = if line { f"fill=\"none\" style=\"stroke:{fill}\"" } else { f"style=\"fill:{fill}\"" }
  let body = if d.is_empty() { f"<circle cx=\"{ui_n(x)}\" cy=\"{ui_n(y)}\" r=\"{ui_n(r)}\" {paint}/>" } else { f"<path d=\"{d}\" {paint}/>" }
  return f"<g class=\"sh m-{motion}" + (if line { " ln2" } else { "" }) + f"\" style=\"--i:{k}\">{body}</g>"
}

fn ui_art(b: UiBlock, s: UiSpec) -> Text {
  let seed = ui_seed(b.title + b.text) + ui_spec_seed(s)
  let n = b.items.length()
  let shapes = (for k in 0 until n { ui_shape(b.items[k], k, n, seed) }).join("")
  let head = if b.title.trim().is_empty() { "" } else { f"<div class=\"row-head\"><h2>{ui_esc(b.title)}</h2></div>" }
  let note = if b.text.trim().is_empty() { "" } else { f"<p class=\"ch-note soft\">{ui_esc(b.text)}</p>" }
  return f"<section class=\"sec\">{head}{note}<div class=\"artc card\"><svg class=\"art-svg\" viewBox=\"0 0 600 320\" aria-hidden=\"true\">" + ui_grads() + shapes + "</svg></div></section>"
}

fn ui_art_css() -> Text {
  return ".art-bg{display:none}.artc{padding:0;overflow:hidden}.art-svg{display:block;width:100%;height:auto}.art-svg .sh{transform-box:fill-box;transform-origin:center}.art-svg .ln2 path,.art-svg .ln2 circle{stroke-width:6;stroke-linecap:round;stroke-linejoin:round}.art-svg .sh{opacity:.92}"
  + ".v .art-bg{display:block;position:absolute;pointer-events:none;z-index:0}.v .t-web .hero>.art-bg{left:50%;top:46%;width:1100px;height:1100px;max-width:none;transform:translate(-50%,-50%);opacity:.75;-webkit-mask-image:radial-gradient(closest-side,#000 50%,transparent);mask-image:radial-gradient(closest-side,#000 50%,transparent)}.v .t-web .hero>.orbit{display:none}"
  + ".v .screen>.art-bg{left:0;top:0;width:100%;height:58%;opacity:.5;-webkit-mask-image:linear-gradient(#000,transparent);mask-image:linear-gradient(#000,transparent)}.v .screen>*:not(.art-bg){position:relative;z-index:1}"
  + ".v .t-agent .main{position:relative}.v .main>.art-bg{left:0;top:0;width:100%;height:420px;opacity:.35;-webkit-mask-image:linear-gradient(#000,transparent);mask-image:linear-gradient(#000,transparent)}.v .main>*:not(.art-bg){position:relative;z-index:1}"
  + ".v .artifact{position:relative;overflow:hidden}.v .artifact>.art-bg{right:-140px;top:-180px;width:560px;height:560px;opacity:.55;-webkit-mask-image:radial-gradient(closest-side,#000 40%,transparent);mask-image:radial-gradient(closest-side,#000 40%,transparent)}.v .artifact>*:not(.art-bg){position:relative;z-index:1}"
  + ".art-bg .bl{opacity:.55;filter:blur(36px)}.art-bg .wv{fill:none;stroke:url(#ui-ch-g);stroke-width:2;opacity:calc(.75 - var(--i) * .1)}.art-bg .cl line{stroke:color-mix(in srgb,var(--accent) 55%,transparent);stroke-width:1}.art-bg .st{fill:var(--ink)}.art-bg .st.big{fill:var(--a2)}.art-bg .pr{opacity:.32;stroke:color-mix(in srgb,var(--ink) 30%,transparent);stroke-width:1}.art-bg .rg{fill:none;stroke:url(#ui-ch-g);stroke-width:1.6;opacity:.6}.art-bg .gd line{stroke:color-mix(in srgb,var(--accent) 50%,transparent);stroke-width:1}.art-bg .sun{opacity:.7}.art-bg .au{opacity:.5;filter:blur(40px)}.art-bg .ob circle{fill:none;stroke:color-mix(in srgb,var(--ink) 16%,transparent);stroke-width:1}.art-bg .ob .od{fill:var(--accent);stroke:none}.art-bg .ob .od.b{fill:var(--a2)}.art-bg .bl,.art-bg .pr,.art-bg .ob,.art-bg .rg{transform-box:view-box;transform-origin:400px 400px}"
  + "@media (prefers-reduced-motion:no-preference){@keyframes v-bob{50%{transform:translateY(-14px)}}@keyframes v-breathe{50%{transform:scale(1.12)}}@keyframes v-sway{0%,100%{transform:rotate(-8deg)}50%{transform:rotate(8deg)}}@keyframes v-slide{to{transform:translateX(-800px)}}@keyframes v-twinkle{50%{opacity:.25}}@keyframes v-roam{0%{transform:translate(0,0) rotate(0)}50%{transform:translate(30px,-24px) rotate(12deg)}100%{transform:translate(-20px,18px) rotate(-6deg)}}"
  + ".v .art-svg .m-spin{animation:v-spin calc(14s + var(--i) * 3s) linear infinite}.v .art-svg .m-float{animation:v-bob calc(4s + var(--i) * .7s) ease-in-out infinite}.v .art-svg .m-pulse{animation:v-breathe calc(3s + var(--i) * .5s) ease-in-out infinite}.v .art-svg .m-sway{animation:v-sway calc(5s + var(--i) * .6s) ease-in-out infinite}"
  + ".v .art-bg .bl,.v .art-bg .au{animation:v-roam calc(16s + var(--i) * 5s) ease-in-out infinite alternate}.v .art-bg .wv{animation:v-slide calc(14s + var(--i) * 4s) linear infinite}.v .art-bg .st{animation:v-twinkle calc(2.4s + var(--i) * .4s) ease-in-out infinite}.v .art-bg .pr{animation:v-spin calc(40s + var(--i) * 9s) linear infinite}.v .art-bg .rg:nth-child(odd){animation:v-spin calc(50s + var(--i) * 10s) linear infinite}.v .art-bg .rg:nth-child(even){animation:v-spin calc(60s + var(--i) * 10s) linear infinite reverse}.v .art-bg .o1{animation:v-spin 38s linear infinite}.v .art-bg .o2{animation:v-spin 64s linear infinite reverse}.v .art-bg .o3{animation:v-spin 96s linear infinite}.v .art-bg .sun{animation:v-breathe 8s ease-in-out infinite;transform-box:fill-box;transform-origin:center}}"
}

// Charts, in both styles: drawn still in minimal, drawn in motion in vivid.
fn ui_chart_css() -> Text {
  return ".chart{padding:20px 20px 16px;display:grid;gap:12px;overflow:hidden}.ch-now{display:flex;align-items:baseline;gap:10px}.ch-now b{font-size:30px;font-weight:650;letter-spacing:-.04em;line-height:1}.ch-now span{font-size:13.5px}.ch-svg{width:100%;height:auto;display:block;overflow:visible}.ch-svg .gl{stroke:var(--line2);stroke-width:1}.ch-svg .ln{stroke:var(--accent);stroke-width:4;stroke-linecap:round;stroke-linejoin:round}.ch-svg .pt{fill:var(--surface);stroke:var(--accent);stroke-width:2.5;transform-box:fill-box;transform-origin:center}.ch-svg .pt.last{fill:var(--accent);stroke:var(--surface);stroke-width:3}.ch-x{display:flex;justify-content:space-between;gap:4px;font-size:12px}.ch-x span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
  + ".ch-bars{display:flex;align-items:stretch;gap:10px;height:200px}.cb{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:6px}.cb-v{font-size:12.5px;font-weight:600;white-space:nowrap}.cb-col{flex:1;width:100%;display:flex;align-items:flex-end;border-radius:10px;background:var(--tint2)}.cb-col i{display:block;width:100%;border-radius:10px;background:var(--accent)}.cb-l{font-size:12px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
  + ".ch-rings{display:grid;grid-template-columns:repeat(auto-fit,minmax(104px,1fr));gap:16px}.ring{display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;font-size:13px}.ring-in{position:relative;width:min(116px,100%);aspect-ratio:1}.ring-in svg{display:block;width:100%;height:100%}.ring-in b{position:absolute;inset:0;display:grid;place-items:center;font-size:20px;font-weight:650;letter-spacing:-.03em}.rt{fill:none;stroke:var(--sunken);stroke-width:10}.rf{fill:none;stroke:var(--accent);stroke-width:10;stroke-linecap:round}.ch-note{font-size:13.5px}"
  + ".t-phone .ch-bars{height:150px;gap:7px}.t-phone .ch-rings{grid-template-columns:repeat(3,1fr);gap:8px}.t-phone .ch-now b{font-size:26px}.panel .chart{padding:14px}.panel .ch-bars{height:130px;gap:6px}.panel .ch-now b{font-size:22px}.panel .ch-rings{grid-template-columns:1fr 1fr;gap:10px}.panel .ring-in b{font-size:16px}.orbit{display:none}"
}

// The vivid style: the accent and its partner as gradients, glass with a
// glowing edge, a lit stage, and motion. Everything that moves stops when
// the person's device asks for reduced motion.
fn ui_vivid_css(theme: Text) -> Text {
  let dark = ui_mode(theme) == "dark"
  let ground = if dark { "#06060a" } else { "#eceef5" }
  let tone = if dark { ".ui[data-style=vivid]{--bg:color-mix(in srgb,var(--accent) 5%,#09090d);--surface:color-mix(in srgb,var(--accent) 6%,#121218);--sunken:color-mix(in srgb,var(--accent) 7%,#0d0d12);--line:color-mix(in srgb,var(--accent) 16%,#24242b);--line2:color-mix(in srgb,var(--accent) 10%,#1b1b21)}" } else { ".ui[data-style=vivid]{--bg:color-mix(in srgb,var(--accent) 3%,#f8f8fb);--sunken:color-mix(in srgb,var(--accent) 5%,#f1f1f5);--line:color-mix(in srgb,var(--accent) 14%,#e4e4ea)}" }
  return tone
  + ".ui[data-style=vivid]{--grad:linear-gradient(120deg,var(--accent),var(--a2));--glowc:color-mix(in srgb,var(--accent) 50%,transparent);--edge:linear-gradient(150deg,color-mix(in srgb,var(--accent) 60%,var(--line)),var(--line) 36%,var(--line) 64%,color-mix(in srgb,var(--a2) 50%,var(--line)))}"
  + "body[data-style=vivid]{background:radial-gradient(900px 520px at 12% -6%,color-mix(in srgb,var(--accent) 24%,transparent),transparent 70%) no-repeat,radial-gradient(760px 520px at 92% 4%,color-mix(in srgb,var(--a2) 16%,transparent),transparent 70%) no-repeat," + ground + "}"
  + ".v .btn{background:var(--grad);background-size:180% 100%;background-position:0 0;box-shadow:0 1px 0 rgba(255,255,255,.28) inset,0 10px 28px -10px var(--glowc);transition:transform .35s var(--ui-ease),box-shadow .35s var(--ui-ease),background-position .7s var(--ui-ease)}.v .btn:hover{transform:translateY(-2px);background-position:100% 0;box-shadow:0 1px 0 rgba(255,255,255,.28) inset,0 16px 36px -10px var(--glowc)}.v .btn.ghost{background:var(--glass);color:var(--ink);box-shadow:0 0 0 1px var(--line) inset;backdrop-filter:blur(12px)}.v .btn.ink{background:var(--ink);color:var(--surface)}"
  + ".v .chip,.v .mark,.v .av,.v .send,.v .step .n,.v .activity .done .dotmark{background:var(--grad);color:var(--on);box-shadow:0 8px 20px -10px var(--glowc)}.v .eyebrow{background:linear-gradient(var(--surface),var(--surface)) padding-box,var(--grad) border-box;border:1px solid transparent;color:var(--ink)}.v .eyebrow i{background:var(--a2);box-shadow:0 0 0 3px color-mix(in srgb,var(--a2) 25%,transparent)}.v .kicker,.v .more{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}.v .badge.on{background:var(--grad);color:var(--on)}"
  + ".v .card,.v .feat,.v .tile,.v .plan,.v .cta{border:1px solid transparent;background:linear-gradient(var(--surface),var(--surface)) padding-box,var(--edge) border-box}.v .feat,.v .tile,.v .plan,.v .r{transition:transform .5s var(--ui-ease),box-shadow .5s var(--ui-ease),background-color .3s}.v .feat:hover,.v .tile:hover,.v .plan:hover{transform:translateY(-4px);box-shadow:0 24px 50px -24px var(--glowc)}.v .plan.best{background:linear-gradient(var(--surface),var(--surface)) padding-box,var(--grad) border-box;box-shadow:0 30px 70px -30px var(--glowc)}"
  + ".v .cta{background:radial-gradient(90% 120% at 15% 0%,color-mix(in srgb,var(--accent) 30%,transparent),transparent 60%) padding-box,radial-gradient(90% 120% at 90% 100%,color-mix(in srgb,var(--a2) 24%,transparent),transparent 60%) padding-box,linear-gradient(var(--surface),var(--surface)) padding-box,var(--grad) border-box}"
  + ".v .hero h1,.v .stat .num,.v .price,.v .ch-now b{background:linear-gradient(100deg,var(--ink) 15%,var(--accent) 50%,var(--a2) 75%,var(--ink) 100%);background-size:240% 100%;-webkit-background-clip:text;background-clip:text;color:transparent}.v .stat .num,.v .price,.v .ch-now b{background:var(--grad);-webkit-background-clip:text;background-clip:text}"
  + ".v .t-web .hero{padding-top:120px;padding-bottom:104px}.v .t-web .hero::before{content:'';position:absolute;inset:0;background-image:radial-gradient(color-mix(in srgb,var(--ink) 16%,transparent) 1px,transparent 1.4px);background-size:22px 22px;-webkit-mask-image:radial-gradient(70% 60% at 50% 40%,#000,transparent);mask-image:radial-gradient(70% 60% at 50% 40%,#000,transparent);pointer-events:none}.v .t-web .hero .glow{inset:-30% -10% auto;height:760px;background:radial-gradient(38% 46% at 32% 42%,color-mix(in srgb,var(--accent) 52%,transparent),transparent 70%),radial-gradient(34% 42% at 68% 36%,color-mix(in srgb,var(--a2) 40%,transparent),transparent 70%);filter:blur(42px)}"
  + ".v .t-web .hero>.orbit{display:block;position:absolute;left:50%;top:46%;width:980px;max-width:none;height:980px;transform:translate(-50%,-50%);pointer-events:none;opacity:.7;-webkit-mask-image:radial-gradient(closest-side,#000 55%,transparent);mask-image:radial-gradient(closest-side,#000 55%,transparent)}.v .orbit circle{fill:none;stroke:color-mix(in srgb,var(--ink) 14%,transparent);stroke-width:1}.v .orbit .od{fill:var(--accent);stroke:none}.v .orbit .od.b{fill:var(--a2)}.v .orbit g{transform-origin:400px 400px}"
  + ".v .hero-shot{box-shadow:0 40px 90px -40px var(--glowc)}.v .tile .cover{color:var(--on)}.v .cover.h0{background:radial-gradient(120% 120% at 0% 0%,var(--accent),transparent 62%),radial-gradient(120% 120% at 100% 100%,var(--a2),transparent 58%),var(--sunken)}.v .cover.h1{background:linear-gradient(135deg,var(--accent),var(--a2))}.v .cover.h2{background:conic-gradient(from 210deg at 70% 30%,var(--a2),var(--accent),color-mix(in srgb,var(--accent) 60%,var(--a2)),var(--a2))}.v .cover.h3{background:radial-gradient(90% 90% at 80% 20%,var(--a2),transparent 60%),radial-gradient(90% 90% at 20% 90%,var(--accent),transparent 60%),var(--sunken)}.v .cover.h4{background:linear-gradient(200deg,var(--a2),var(--accent) 70%)}.v .cover.h5{background:radial-gradient(circle at 50% 120%,var(--a2),var(--accent) 70%)}.v .cover{background-size:150% 150%!important}"
  + ".v .fill,.v .cb-col i{background:var(--grad);position:relative;overflow:hidden}.v .cb-col i{background:linear-gradient(180deg,var(--a2),var(--accent))}.v .ch-svg .ln,.v .rf{stroke:url(#ui-ch-g)}.v .ch-svg .pt.last{fill:var(--a2);filter:drop-shadow(0 0 6px var(--a2))}.v .ln{filter:drop-shadow(0 6px 10px var(--glowc))}"
  + ".v .screen{background:radial-gradient(130% 45% at 50% -8%,color-mix(in srgb,var(--accent) 34%,transparent),transparent 70%) no-repeat,radial-gradient(90% 30% at 100% 100%,color-mix(in srgb,var(--a2) 16%,transparent),transparent 70%) no-repeat,var(--bg)}.v .phone{box-shadow:0 0 0 1.5px #2a2a2e,0 0 0 4px #121214,0 50px 120px -40px var(--glowc)}.v .win,.v .browser{box-shadow:0 0 0 1px var(--line),0 50px 120px -40px var(--glowc)}.v .t-agent .main{background:radial-gradient(70% 40% at 50% -5%,color-mix(in srgb,var(--accent) 16%,transparent),transparent 70%) no-repeat,var(--bg)}.v .side-link.on{background:linear-gradient(var(--surface),var(--surface)) padding-box,var(--edge) border-box;border:1px solid transparent}.v .tab.on{position:relative}.v .tab.on::after{content:'';position:absolute;bottom:-5px;width:5px;height:5px;border-radius:50%;background:var(--a2);box-shadow:0 0 8px var(--a2)}.v .msg.me .bubble{background:var(--grad);color:var(--on);box-shadow:none}"
  + ".v .artifact{background:radial-gradient(90% 60% at 100% 0%,color-mix(in srgb,var(--a2) 18%,transparent),transparent 60%) padding-box,radial-gradient(90% 60% at 0% 0%,color-mix(in srgb,var(--accent) 22%,transparent),transparent 60%) padding-box,linear-gradient(var(--surface),var(--surface)) padding-box,var(--grad) border-box;border:1px solid transparent;box-shadow:0 40px 100px -40px var(--glowc)}"
  + "@media (prefers-reduced-motion:no-preference){"
  + "@keyframes v-rise{from{opacity:0;transform:translateY(24px) scale(.98)}to{opacity:1;transform:none}}@keyframes v-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}@keyframes v-grow{from{transform:scaleY(0)}to{transform:none}}@keyframes v-ring{from{stroke-dasharray:0 100}}@keyframes v-fade{from{opacity:0}}@keyframes v-pop{0%{opacity:0;transform:scale(.3)}70%{opacity:1;transform:scale(1.25)}100%{transform:none}}@keyframes v-width{from{transform:scaleX(0)}}@keyframes v-drift{0%{transform:translate3d(-5%,-2%,0) scale(1)}100%{transform:translate3d(5%,6%,0) scale(1.15) rotate(8deg)}}@keyframes v-sheen{to{background-position:240% 0}}@keyframes v-spin{to{transform:rotate(360deg)}}@keyframes v-shine{from{transform:translateX(-100%)}to{transform:translateX(100%)}}@keyframes v-ping{0%{box-shadow:0 0 0 0 var(--glowc)}100%{box-shadow:0 0 0 12px transparent}}@keyframes v-pan{from{background-position:0% 0%}to{background-position:100% 100%}}@keyframes v-float{50%{transform:translateY(-8px)}}"
  + ".v .t-web .hero .glow{animation:v-drift 16s ease-in-out infinite alternate}.v .hero h1{animation:v-sheen 10s linear infinite}.v .orbit .o1{animation:v-spin 38s linear infinite}.v .orbit .o2{animation:v-spin 64s linear infinite reverse}.v .orbit .o3{animation:v-spin 96s linear infinite}.v .cover{animation:v-pan 14s ease-in-out infinite alternate}.v .hero-shot{animation:v-float 7s ease-in-out infinite}"
  + ".v .fill::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);animation:v-shine 2.6s 1.6s infinite}.v .activity .now .dotmark,.v .badge.live i,.v .ch-svg .pt.last{animation:v-ping 1.8s var(--ui-ease) infinite}.v .ch-svg .pt.last{animation:none}"
  + ".v.mo .rv{opacity:0}.v.mo .rv.in{opacity:1;animation:v-rise .9s var(--ui-ease) both;animation-delay:calc(var(--d,0) * 70ms)}.v.mo .rv.in .ln{stroke-dasharray:1;animation:v-draw 1.8s .25s var(--ui-ease) both}.v.mo .rv.in .ar{animation:v-fade 1.2s 1s both}.v.mo .rv.in .pt{animation:v-pop .55s var(--ui-ease) both;animation-delay:calc(.45s + var(--i,0) * 120ms)}.v.mo .rv.in .cb-col i{transform-origin:bottom;animation:v-grow 1.1s var(--ui-ease) both;animation-delay:calc(.2s + var(--i,0) * 90ms)}.v.mo .rv.in .rf{animation:v-ring 1.7s var(--ui-ease) both;animation-delay:calc(.25s + var(--i,0) * 160ms)}.v.mo .rv.in .fill{transform-origin:left center;animation:v-width 1.4s .25s var(--ui-ease) both}"
  + "}"
}

// The little script that runs the vivid motion: parts rise in as they
// come into view, numbers count up to their value. Nothing runs when the
// device asks for reduced motion, and without it the page shows still.
fn ui_motion_js() -> Text {
  return "(function(){var S=document.querySelector('.v');if(!S)return;if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)return;if(!('IntersectionObserver' in window))return;"
  + "function cu(el){if(el.dataset.c)return;el.dataset.c=1;var t=el.textContent,m=t.match(/^([^0-9]*)([0-9][0-9,]*[.]?[0-9]*)(.*)$/);if(!m)return;var raw=m[2],dec=(raw.split('.')[1]||'').length,end=parseFloat(raw.split(',').join(''));if(!isFinite(end)||end===0)return;var grp=raw.indexOf(',')>=0,t0=null,D=1500;function f(n){return m[1]+n.toLocaleString('en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec,useGrouping:grp})+m[3]}el.textContent=f(0);function step(ts){if(t0===null)t0=ts;var k=Math.min(1,(ts-t0)/D),e=1-Math.pow(1-k,3);el.textContent=f(end*e);if(k<1)requestAnimationFrame(step);else el.textContent=t}requestAnimationFrame(step)}"
  + "var skip={nav:1,appbar:1,tabbar:1,composer:1,sidebar:1},els=[];S.querySelectorAll('.blk').forEach(function(b){if(skip[b.getAttribute('data-kind')])return;var r=b.firstElementChild;if(r)els.push([r,0])});"
  + "S.querySelectorAll('.hero>*').forEach(function(e,i){if(!e.classList.contains('glow')&&!e.classList.contains('orbit'))els.push([e,i])});"
  + "['.feat','.tile','.plan','.step','.stat','.r','.msg','.activity li','.bar','.pill','.cb','.ring','.tbl tr'].forEach(function(q){S.querySelectorAll(q).forEach(function(e){els.push([e,Array.prototype.indexOf.call(e.parentNode.children,e)+1])})});"
  + "var io=new IntersectionObserver(function(es){es.forEach(function(x){if(!x.isIntersecting)return;x.target.classList.add('in');io.unobserve(x.target);x.target.querySelectorAll('.num,.ring-in b,.ch-now b,.cb-v,.price').forEach(cu)})},{rootMargin:'0px 0px -6% 0px'});"
  + "S.classList.add('mo');els.forEach(function(p){p[0].classList.add('rv');p[0].style.setProperty('--d',Math.min(p[1],9));io.observe(p[0])})})();"
}

fn ui_css(s: UiSpec) -> Text {
  let vivid = if ui_style(s.theme) == "vivid" { ui_vivid_css(s.theme) } else { "" }
  return ui_tokens_css() + ui_colours_css(s.theme, ui_accent(s.accent)) + ui_base_css() + ui_web_css() + ui_phone_css() + ui_agent_css() + ui_artifact_css() + ui_chart_css() + ui_art_css() + ui_stage_css(s.theme) + vivid + ui_look_css(s)
}

fn ui_colour_tag(s: UiSpec) -> Text { return if s.look.colours.is_empty() { s.accent } else { s.look.colours.join(" ") } }

fn ui_target_label(target: Text) -> Text {
  if target == "phone" { return "Phone app" }
  if target == "agent" { return "Agent window" }
  if target == "artifact" { return "Artifact" }
  return "Website"
}

// The whole page: the design in its frame, on a quiet stage, with what
// Kosika checked folded away beneath it.
fn ui_page(s: UiSpec, fixed: Text[]) -> Text {
  let vivid = ui_style(s.theme) == "vivid"
  let stage = if vivid { "stage v" } else { "stage" }
  let motion = if vivid { "<script>" + ui_motion_js() + "</script>" } else { "" }
  let checked = if fixed.is_empty() { "" } else { "<details><summary>What Kosika checked and fixed</summary><ul>" + (for f in fixed { f"<li>{ui_esc(f)}</li>" }).join("") + "</ul></details>" }
  let head = f"<div class=\"stage-head\"><div><div class=\"by\">Kosika Designs</div><h1>{ui_esc(s.title)}</h1></div><div class=\"stage-tags\"><span class=\"badge\">{ui_target_label(s.target)}</span><span class=\"badge\">{ui_esc(s.theme)}</span><span class=\"badge on\">{ui_esc(ui_colour_tag(s))}</span></div></div>"
  return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>" + ui_esc(s.title) + "</title><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">" + ui_font_link(s.look.font) + "<style>" + ui_css(s) + "</style></head><body class=\"ui\" data-style=\"" + ui_style(s.theme) + "\" data-theme=\"" + ui_mode(s.theme) + "\"><div class=\"" + stage + "\">" + head + ui_frames(s) + checked + "</div>" + motion + "</body></html>"
}

// ---------------------------------------------------------------- designs that run

fn ui_bindable() -> Text[] { return ["composer", "activity", "progress", "stats", "list"] }

fn ui_all_blocks(s: UiSpec) -> Text[] {
  var kinds: Text[] = []
  for sc in s.screens {
    for b in sc.blocks { kinds = kinds.append(b.kind) }
  }
  return kinds
}

record UiBindsChecked { binds: UiBind[] fixed: Text[] }

// Only blocks the design has, of a kind that can be filled, with a
// workflow name Kosika can serve; the input defaults to ask, the field to
// items.
fn ui_binds_checked(s: UiSpec, binds: UiBind[]) -> UiBindsChecked {
  let have = ui_all_blocks(s)
  var kept: UiBind[] = []
  var fixed: Text[] = []
  for raw in binds {
    let b: UiBind = {block: raw.block.trim().lower(), workflow: raw.workflow.trim(), input: if raw.input.trim().is_empty() { "ask" } else { raw.input.trim() }, field: if raw.field.trim().is_empty() { "items" } else { raw.field.trim() }, every: raw.every.max(0)}
    if not ui_bindable().contains(b.block) {
      fixed = fixed.append(f"did not bind a {b.block}: only a composer, activity, progress, stats or list can run")
    } else if not have.contains(b.block) {
      fixed = fixed.append(f"did not bind a {b.block}: the design has none")
    } else if b.block == "composer" and b.workflow.is_empty() {
      fixed = fixed.append("did not bind the composer: it needs a workflow to send to")
    } else if not b.workflow.is_empty() and not ui_name_ok(b.workflow) {
      fixed = fixed.append(f"did not bind {b.workflow}: not a workflow name")
    } else {
      kept = kept.append(b)
    }
  }
  return {binds: kept, fixed: fixed}
}

fn ui_name_ok(name: Text) -> Bool {
  if name.is_empty() { return false }
  for k in 0 until name.length() {
    let ch = name.slice(k, k + 1)
    if not "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".contains(ch) { return false }
  }
  return not "0123456789".contains(name.slice(0, 1))
}

// Text as a JavaScript string, safe inside a script element.
fn ui_js(text: Text) -> Text {
  return "'" + text.replace("\\", "\\\\").replace("'", "\\'").replace("<", "\\u003c").replace("\n", "\\n") + "'"
}

fn ui_live_data(s: UiSpec, binds: UiBind[]) -> Text {
  let icons = (for n in ui_icon_names() { n + ":" + ui_js(ui_icon(n)) }).join(",")
  let bs = (for b in binds { "{block:" + ui_js(b.block) + ",workflow:" + ui_js(b.workflow) + ",input:" + ui_js(b.input) + ",field:" + ui_js(b.field) + f",every:{b.every}}}" }).join(",")
  return "window.KOSIKA_LIVE={brand:" + ui_js(s.brand) + ",icons:{" + icons + "},binds:[" + bs + "]};"
}

fn ui_live_css() -> Text {
  return ".ui[data-live] .stage{padding:0;max-width:none}.ui[data-live] .stage-head,.ui[data-live] .stage>details,.ui[data-live] .win-bar,.ui[data-live] .b-bar{display:none}.ui[data-live] .win{width:100%;height:100vh;height:100dvh;border-radius:0;box-shadow:none}.ui[data-live] .browser{width:100%;border-radius:0;box-shadow:none}.ui[data-live] .artifact{margin:24px auto}.ui[data-live] .phones{padding:24px 0}.ui[data-live] .t-agent .main .scroll,.ui[data-live] .t-phone .scroll{overflow-y:auto;scrollbar-width:thin}.hint-in{flex:1;min-width:0;border:0;background:none;outline:none;font:inherit;font-size:14.5px;color:var(--ink);padding-left:4px}.hint-in::placeholder{color:var(--faint)}.composer:focus-within{box-shadow:0 0 0 1.5px var(--accent) inset,var(--shadow)}.composer.busy .send{opacity:.45}.send{cursor:pointer;border:0}.msg .grow{flex:1;min-width:0}.reply-frame{display:block;width:100%;height:560px;margin-top:12px;border:0;border-radius:16px;background:var(--surface);box-shadow:0 0 0 1px var(--line)}.typing{display:inline-flex;gap:4px;padding:6px 0}.typing i{width:6px;height:6px;border-radius:50%;background:var(--faint);animation:ui-dot 1.2s infinite}.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}@keyframes ui-dot{30%{opacity:.25;transform:translateY(-2px)}}.err{color:#e11d48}.live-note{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);padding:10px 16px;border-radius:12px;background:var(--ink);color:var(--surface);font-size:13.5px;box-shadow:var(--shadow);transition:opacity .4s;z-index:9}.live-note.bad{background:#e11d48;color:#fff}"
}

fn ui_runtime() -> Text {
  return "(function(){var K=window.KOSIKA_LIVE;if(!K)return;var root=document.body,brand=K.brand,icons=K.icons;function ic(n){return icons[n]||icons.dot}function esc(t){return String(t==null?'':t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/'/g,'&#39;').replace(/\"/g,'&quot;')}function blk(kind){return root.querySelector('.blk[data-kind='+kind+']')}function state(m){m=String(m||'').trim().toLowerCase();if(['done','finished','complete','completed','ok','passed'].indexOf(m)>=0)return 'done';if(['now','running','working','active','in progress','live'].indexOf(m)>=0)return 'now';if(['failed','error','blocked'].indexOf(m)>=0)return 'bad';return 'next'}function pct(m){var n=parseFloat(String(m||'').replace('%',''));return isNaN(n)?0:Math.max(0,Math.min(100,n))}var draw={ activity:function(items){return items.map(function(i){var s=state(i.meta);return '<li class='+s+'><span class=dotmark>'+(s=='done'?ic('check'):'')+'</span><div><div class=a-title>'+esc(i.title)+'</div>'+(i.text?'<div class=\\'soft small\\'>'+esc(i.text)+'</div>':'')+'</div>'+(i.meta?'<span class=a-meta>'+esc(i.meta)+'</span>':'')+'</li>'}).join('')}, progress:function(items){return items.map(function(i){return '<div class=bar><div class=bar-top><span>'+esc(i.title)+'</span><span class=faint>'+esc(i.meta)+'</span></div><div class=track><div class=fill style=width:'+pct(i.meta)+'%></div></div></div>'}).join('')}, stats:function(items){return items.map(function(i){return '<div class=stat><div class=num>'+esc(i.title)+'</div><div class=\\'lbl soft\\'>'+esc(i.text)+'</div>'+(i.meta?'<span class=delta>'+esc(i.meta)+'</span>':'')+'</div>'}).join('')}, list:function(items){return items.map(function(i){return '<div class=r>'+(i.icon?'<span class=\\'chip sm\\'>'+ic(i.icon)+'</span>':'')+'<div class=r-main><div class=r-title>'+esc(i.title)+'</div>'+(i.text?'<div class=\\'r-sub soft\\'>'+esc(i.text)+'</div>':'')+'</div>'+(i.meta?'<span class=\\'r-meta faint\\'>'+esc(i.meta)+'</span>':'')+'<span class=\\'faint r-go\\'>'+ic('chevron')+'</span></div>'}).join('')}};var holder={activity:'.activity',progress:'.bars',stats:'.stats',list:'.rows'};function fill(kind,items){var b=blk(kind);if(!b||!Array.isArray(items))return;var h=b.querySelector(holder[kind]);if(h)h.innerHTML=draw[kind](items)}var live=location.protocol!='file:';function note(text,bad){var n=root.querySelector('.live-note');if(!n){n=document.createElement('div');n.className='live-note';root.appendChild(n)}n.className='live-note'+(bad?' bad':'');n.textContent=text;n.style.opacity=1;clearTimeout(note.t);if(!bad)note.t=setTimeout(function(){n.style.opacity=0},2600)}function run(workflow,input,text){var body={};body[input||'ask']={text:text||''}; return fetch('/run/'+workflow,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(r){return r.json()})}function pick(o){if(o==null)return '';if(typeof o!='object')return String(o);var keys=['text','words','answer','reply','message','why'];for(var k=0;k<keys.length;k++)if(typeof o[keys[k]]=='string'&&o[keys[k]].trim())return o[keys[k]];return ''}var chat=blk('chat'),scroller=chat&&chat.closest('.scroll');function down(){if(scroller)scroller.scrollTop=scroller.scrollHeight}function say(html,me){var c=chat&&chat.querySelector('.chat');if(!c)return null;var d=document.createElement('div');d.className=me?'msg me':'msg';d.innerHTML=me?'<div class=bubble>'+html+'</div>':'<span class=av>'+ic('spark')+'</span><div class=grow><div class=who-name>'+esc(brand)+'</div><div class=bubble>'+html+'</div></div>';c.appendChild(d);down();return d}var last='';function refresh(){K.binds.forEach(function(b){if(b.block=='composer'||!b.workflow)return;run(b.workflow,b.input,last).then(function(r){if(r.ok&&r.output)fill(b.block,r.output[b.field||'items'])}).catch(function(){})})}function fromReply(out){K.binds.forEach(function(b){if(b.block!='composer'&&!b.workflow&&out)fill(b.block,out[b.field||'items'])})}var send=null;K.binds.forEach(function(b){if(b.block=='composer')send=b});var comp=blk('composer');if(comp&&send){var hint=comp.querySelector('.hint');var input=document.createElement('input');input.className='hint-in';input.placeholder=hint?hint.textContent:'Message';if(hint)hint.replaceWith(input); var go=comp.querySelector('.send'),busy=false; function submit(){var t=input.value.trim();if(!t||busy)return;if(!live){note('This is a preview. Serve it with kosika-native serve to make it answer.',true);return}  busy=true;input.value='';last=t;say(esc(t),true);var wait=say('<span class=typing><i></i><i></i><i></i></span>',false);comp.classList.add('busy');  run(send.workflow,send.input,t).then(function(r){var b=wait.querySelector('.bubble');   if(r.ok){var out=r.output,words=pick(out);b.innerHTML=esc(words||'Done.');    if(out&&typeof out.page=='string'&&out.page){var f=document.createElement('iframe');f.className='reply-frame';f.srcdoc=out.page;b.parentNode.appendChild(f)}    fromReply(out)}   else if(r.approval){b.innerHTML='This asks for your approval before it acts, so it waits for you in Studio or the terminal.'}   else{b.innerHTML='<span class=err>'+esc(r.error||'Something went wrong.')+'</span>'}   down()}).catch(function(e){wait.querySelector('.bubble').innerHTML='<span class=err>Kosika is not answering: '+esc(e.message)+'</span>'})  .then(function(){busy=false;comp.classList.remove('busy');refresh();input.focus()})} input.addEventListener('keydown',function(e){if(e.key=='Enter')submit()});if(go)go.addEventListener('click',submit)}if(live){refresh();K.binds.forEach(function(b){if(b.every>0&&b.workflow&&b.block!='composer')setInterval(function(){run(b.workflow,b.input,last).then(function(r){if(r.ok&&r.output)fill(b.block,r.output[b.field||'items'])}).catch(function(){})},b.every*1000)})}else note('Preview: run it with kosika-native serve to make it live.')})();"
}

// The page with its runtime: served by kosika-native serve --page, its
// parts call the workflows they are bound to.
fn ui_live_page(s: UiSpec, fixed: Text[], binds: UiBind[]) -> Text {
  let page = ui_page(s, fixed)
  let script = "<style>" + ui_live_css() + "</style><script>" + ui_live_data(s, binds) + ui_runtime() + "</script>"
  return page.replace("<body class=\"ui\"", "<body data-live class=\"ui\"").replace("</body>", script + "</body>")
}

fn ui_app_result(a: UiApp) -> UiResult {
  let c = ui_checked(a.ask, a.spec)
  let b = ui_binds_checked(c.spec, a.binds)
  let fixed = c.fixed.concat(b.fixed)
  return {target: c.spec.target, title: c.spec.title, spec: c.spec, page: ui_live_page(c.spec, fixed, b.binds), fixed: fixed, problems: c.problems}
}

// ---------------------------------------------------------------- screens that link

// A label that ends with " > " and a screen's name opens that screen when
// it is tapped: "Start lesson > Lesson". The design shows the label alone;
// the app keeps the link.
fn ui_screen_names(s: UiSpec) -> Text[] { return for sc in s.screens { sc.name.trim().lower() } }

fn ui_link_of(text: Text, names: Text[]) -> Text {
  let parts = text.split(" > ")
  if parts.length() < 2 { return "" }
  let to = parts[parts.length() - 1].trim()
  return if names.contains(to.lower()) { to } else { "" }
}

fn ui_unlink(text: Text, names: Text[]) -> Text {
  let parts = text.split(" > ")
  if parts.length() < 2 { return text }
  return if names.contains(parts[parts.length() - 1].trim().lower()) { parts.take(parts.length() - 1).join(" > ").trim() } else { text }
}

fn ui_unlink_action(text: Text, names: Text[]) -> Text {
  if not text.contains(" > ") { return text }
  return (for p in text.split("|") { ui_unlink(p, names) }).join("|")
}

fn ui_item_unlinked(i: UiItem, names: Text[]) -> UiItem { return ui_item(ui_unlink(i.title, names), i.text, i.meta, i.icon) }

fn ui_block_unlinked(b: UiBlock, names: Text[]) -> UiBlock {
  return ui_block(b.kind, ui_unlink(b.title, names), b.text, b.meta, ui_unlink_action(b.action, names), for i in b.items { ui_item_unlinked(i, names) })
}

fn ui_screen_unlinked(sc: UiScreen, names: Text[]) -> UiScreen { return {name: sc.name, blocks: for b in sc.blocks { ui_block_unlinked(b, names) }} }

fn ui_spec_unlinked(s: UiSpec) -> UiSpec {
  let names = ui_screen_names(s)
  return ui_with_screens(s, for sc in s.screens { ui_screen_unlinked(sc, names) })
}

fn ui_link_pair(text: Text, names: Text[]) -> Text[] {
  let to = ui_link_of(text, names)
  return if to.is_empty() { [] } else { [ui_js(ui_unlink(text, names)) + "," + ui_js(to)] }
}

// Every link in a design, as JavaScript pairs [label, screen].
fn ui_spec_links(s: UiSpec) -> Text {
  let names = ui_screen_names(s)
  var pairs: Text[] = []
  for sc in s.screens {
    for b in sc.blocks {
      pairs = pairs.concat(ui_link_pair(b.title, names))
      for part in b.action.split("|") { pairs = pairs.concat(ui_link_pair(part, names)) }
      for i in b.items { pairs = pairs.concat(ui_link_pair(i.title, names)) }
    }
  }
  return "[" + (for p in pairs { "[" + p + "]" }).join(",") + "]"
}

// ---------------------------------------------------------------- designs that become apps

// How a design looks when it is the app itself: full screen, one phone
// screen at a time, fields you can type in, a sheet that slides up.
fn ui_app_css() -> Text {
  return ".ui[data-app] .stage{padding:0;max-width:none}"
    + ".ui[data-app] .stage-head,.ui[data-app] .stage>details,.ui[data-app] .b-bar,.ui[data-app] .win-bar,.ui[data-app] .phone-name,.ui[data-app] .island,.ui[data-app] .status,.ui[data-app] .homebar{display:none}"
    + ".ui[data-app] .browser{width:100%;border-radius:0;box-shadow:none}"
    + ".ui[data-app] .win{width:100%;height:100vh;height:100dvh;border-radius:0;box-shadow:none}"
    + ".ui[data-app] .t-agent .main .scroll{overflow-y:auto}"
    + ".ui[data-app] .artifact{margin:max(16px,env(safe-area-inset-top)) auto 32px;width:min(880px,calc(100% - 32px))}"
    + ".ui[data-app] .phones{display:block;padding:0}"
    + ".ui[data-app] .phone-wrap{display:none}"
    + ".ui[data-app] .phone-wrap.on,.ui[data-app] .phones>.phone-wrap:only-child{display:block}"
    + ".ui[data-app] .phone{width:100%;max-width:560px;margin:0 auto;height:100vh;height:100dvh;border-radius:0;padding:0;background:var(--bg);box-shadow:none;transform:none}"
    + ".ui[data-app] .screen{border-radius:0;padding-top:env(safe-area-inset-top)}"
    + ".ui[data-app] .t-phone .scroll{overflow-y:auto;padding-top:16px;-webkit-overflow-scrolling:touch}"
    + ".ui[data-app] .t-phone .tiles,.ui[data-app] .t-phone .pills{overflow-x:auto;scrollbar-width:none}"
    + ".ui[data-app] .pinned{padding-bottom:max(10px,env(safe-area-inset-bottom))}"
    + ".ui[data-app] .tab,.ui[data-app] .pill,.ui[data-app] .r,.ui[data-app] .tile,.ui[data-app] .plan,.ui[data-app] .activity li,.ui[data-app] .bar,.ui[data-app] .btn,.ui[data-app] .w-nav nav span,.ui[data-app] .send{cursor:pointer;-webkit-tap-highlight-color:transparent}"
    + ".ui[data-app] .r:active,.ui[data-app] .tile:active{transform:scale(.985)}"
    + ".app-hide{display:none!important}"
    + ".app-done .r-title,.app-done h3{text-decoration:line-through;opacity:.55}"
    + ".app-done .r-go,.app-done .cover{opacity:.5}"
    + ".plan.app-chosen{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent),0 24px 60px -24px color-mix(in srgb,var(--accent) 50%,transparent)}"
    + ".app-add{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 12px;border:0;border-radius:99px;background:var(--tint);color:var(--accent);font:600 13px var(--ui-font);cursor:pointer;margin-left:auto}"
    + ".row-head .more{margin-left:auto}.row-head .more+.app-add{margin-left:10px}.row-head h2+.app-add{margin-left:auto}"
    + ".app-add .ic{width:15px;height:15px}"
    + ".app-in-f,.app-search,.hint-in{flex:1;min-width:0;border:0;background:none;outline:none;font:inherit;font-size:16px;color:var(--ink)}"
    + ".app-in-f::placeholder,.app-search::placeholder,.hint-in::placeholder{color:var(--faint)}"
    + ".input:focus-within,.search:focus-within{box-shadow:0 0 0 1.5px var(--accent) inset}"
    + ".app-entries{display:grid;gap:6px}"
    + ".app-eh{font-size:12px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--faint);margin-top:4px}"
    + ".app-e{font-size:14px;padding:10px 12px;border-radius:10px;background:var(--sunken)}"
    + ".app-note{position:fixed;left:50%;bottom:calc(90px + env(safe-area-inset-bottom));transform:translate(-50%,20px);opacity:0;padding:10px 16px;border-radius:12px;background:var(--ink);color:var(--surface);font-size:14px;font-weight:540;box-shadow:var(--shadow);transition:.3s var(--ui-ease);pointer-events:none;z-index:30;max-width:calc(100% - 32px)}"
    + ".app-note.show{opacity:1;transform:translate(-50%,0)}"
    + ".app-sheet{position:fixed;inset:0;z-index:20;pointer-events:none}"
    + ".app-dim{position:absolute;inset:0;background:rgba(0,0,0,.4);opacity:0;transition:opacity .3s}"
    + ".app-card{position:absolute;left:0;right:0;bottom:0;margin:0 auto;max-width:560px;padding:10px 22px calc(24px + env(safe-area-inset-bottom));border-radius:24px 24px 0 0;background:var(--surface);color:var(--ink);box-shadow:0 -20px 60px -20px rgba(0,0,0,.4);transform:translateY(105%);transition:transform .35s var(--ui-ease)}"
    + ".app-sheet.on{pointer-events:auto}.app-sheet.on .app-dim{opacity:1}.app-sheet.on .app-card{transform:none}"
    + ".app-grab{width:40px;height:5px;border-radius:3px;background:var(--line);margin:0 auto 16px}"
    + ".app-in{display:grid;gap:14px}.app-in h3{font-size:20px;letter-spacing:-.02em}.app-in p{margin:0}"
    + ".app-f{display:grid;gap:6px;font-size:13px;font-weight:560}"
    + ".app-f input{height:46px;padding:0 14px;border:0;border-radius:12px;background:var(--sunken);box-shadow:0 0 0 1px var(--line) inset;color:var(--ink);font:400 16px var(--ui-font);outline:none}"
    + ".app-f input:focus{box-shadow:0 0 0 1.5px var(--accent) inset}"
    + ".app-row{display:flex;gap:10px}.app-row .btn{flex:1}"
    + ".app-in .btn{height:48px;border:0;cursor:pointer;font:inherit;font-weight:600}"
    + "@media (prefers-reduced-motion:reduce){.app-card,.app-note,.app-dim{transition:none}}"
    + ".ui[data-app].app-multi [data-screen]:not(.on){display:none}"
    + ".ui[data-app] .b-body,.ui[data-app] .t-agent .main,.ui[data-app] .artifact{position:relative}"
    + ".app-from-r{animation:app-r .38s var(--ui-ease) both}.app-from-l{animation:app-l .38s var(--ui-ease) both}"
    + "@keyframes app-r{from{opacity:0;transform:translateX(28px)}}@keyframes app-l{from{opacity:0;transform:translateX(-28px)}}"
    + ".ui[data-app] [hidden]{display:none!important}"
    + ".ui[data-app] .app-back{position:absolute;z-index:8;top:calc(10px + env(safe-area-inset-top));left:max(12px,env(safe-area-inset-left));display:inline-flex;align-items:center;gap:4px;height:32px;padding:0 12px 0 8px;border:0;border-radius:99px;background:var(--glass);backdrop-filter:blur(14px);box-shadow:0 0 0 1px var(--line) inset,var(--shadow);color:var(--ink);font:600 13px var(--ui-font);cursor:pointer}"
    + ".ui[data-app] .b-body>.app-back{position:fixed;top:calc(84px + env(safe-area-inset-top))}"
    + ".app-back .ic{width:16px;height:16px}"
    + ".ui[data-app] .app-link{cursor:pointer}"
    + ".ui[data-app] .r.app-link .r-go{color:var(--accent)}"
    + "@media (prefers-reduced-motion:reduce){.app-from-r,.app-from-l{animation:none}}"
}

// What makes a design work with no server: tab bars switch screens, lists
// and cards take new items and remember what is done or removed, forms
// check and keep what is sent, search and chips filter, chat keeps its
// messages, steps move on, bars are set by a tap, plans are chosen. All of
// it is kept on the device (localStorage), so the app works offline.
fn ui_app_js() -> Text {
  return "(function(){"
    + "var A=window.KOSIKA_APP;if(!A)return;"
    + "var D=document,root=D.body,KEY='kosika-app:'+A.id,st={};"
    + "try{st=JSON.parse(localStorage.getItem(KEY)||'{}')||{}}catch(e){st={}}"
    + "['added','removed','done','forms','chat','acts','bars'].forEach(function(k){if(!st[k]||typeof st[k]!='object')st[k]=k=='removed'||k=='done'?[]:{}});"
    + "function save(){try{localStorage.setItem(KEY,JSON.stringify(st))}catch(e){}}"
    + "function esc(t){return String(t==null?'':t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/'/g,'&#39;')}"
    + "function ic(n){return (A.icons&&A.icons[n])||''}"
    + "var blks=[].slice.call(D.querySelectorAll('.blk'));"
    + "function bi(el){var b=el.closest('.blk');return blks.indexOf(b)}"
    + "function kind(el){var b=el.closest('.blk');return b?b.getAttribute('data-kind'):''}"
    + "function scope(el){return el.closest('.screen,.b-body,.main,.artifact')||root}"
    + "function note(t){var n=D.querySelector('.app-note');if(!n){n=D.createElement('div');n.className='app-note';root.appendChild(n)}n.textContent=t;n.classList.add('show');clearTimeout(note.t);note.t=setTimeout(function(){n.classList.remove('show')},2200)}"
    + "function txt(el,q){var e=el.querySelector(q);return e?e.textContent.trim():''}"
    + "function key(el,title){return bi(el)+':'+title}"
    + "/* sheet */"
    + "var sheet=D.createElement('div');sheet.className='app-sheet';sheet.innerHTML='<div class=app-dim></div><div class=app-card><div class=app-grab></div><div class=app-in></div></div>';root.appendChild(sheet);"
    + "var sin=sheet.querySelector('.app-in');"
    + "function open(html){sin.innerHTML=html;sheet.classList.add('on');var f=sin.querySelector('input');if(f)setTimeout(function(){f.focus()},250)}"
    + "function shut(){sheet.classList.remove('on')}"
    + "sheet.querySelector('.app-dim').addEventListener('click',shut);"
    + "/* screens: an app shows one screen at a time; tab bars and links switch them, like a prototype you can tap through */"
    + "var screens=[].slice.call(D.querySelectorAll('[data-screen]'));"
    + "var multi=screens.length>1;root.classList.toggle('app-multi',multi);"
    + "var names=screens.map(function(s){return (s.getAttribute('data-screen')||'').trim().toLowerCase()});"
    + "var bar0=D.querySelector('.phone-wrap .tabbar');"
    + "if(bar0&&multi)screens.forEach(function(s){if(s.querySelector('.tabbar'))return;var p=s.querySelector('.pinned');if(!p)return;var c=bar0.cloneNode(true);var hb=p.querySelector('.homebar');p.insertBefore(c,hb)});"
    + "function screenFor(tab,k){var w=tab.textContent.trim().toLowerCase();var j=names.indexOf(w);return j>=0?j:(k<screens.length?k:-1)}"
    + "var cur=-1,trail=[];"
    + "function show(k,how){if(!screens.length)return;k=Math.max(0,Math.min(k,screens.length-1));if(how=='go'&&cur>=0&&cur!=k)trail.push(cur);if(how=='back')trail.pop();var from=cur;cur=k;"
    + " screens.forEach(function(s,i){s.classList.toggle('on',i==k);s.classList.remove('app-from-r','app-from-l')});var s=screens[k];"
    + " if(from>=0&&from!=k&&multi){s.classList.add(how=='back'?'app-from-l':'app-from-r')}"
    + " s.querySelectorAll('.tabbar .tab').forEach(function(t,i){t.classList.toggle('on',screenFor(t,i)==k)});"
    + " var bk=s.querySelector('.app-back');if(bk)bk.hidden=!trail.length;"
    + " var sc=s.querySelector('.scroll');if(sc)sc.scrollTop=0;if(!s.querySelector('.scroll'))window.scrollTo(0,0);"
    + " st.tab=k;save();try{if(multi&&location.hash!='#'+(k+1)){if(how=='go')history.pushState(null,'','#'+(k+1));else history.replaceState(null,'','#'+(k+1))}}catch(e){}}"
    + "var tmp=D.createElement('div');tmp.innerHTML=ic('back');var backSvg=tmp.firstChild?tmp.firstChild.innerHTML:'#';"
    + "function goBack(){if(trail.length)history.back();else if(cur>0)show(0,'back')}"
    + "if(multi)screens.forEach(function(s){var own=[].slice.call(s.querySelectorAll('.appbar .iconbtn,.ab-icons .iconbtn')).filter(function(x){var v=x.querySelector('svg');return v&&v.innerHTML==backSvg});if(own.length){own.forEach(function(x){x.classList.add('app-link');x.addEventListener('click',function(e){e.stopPropagation();goBack()})});return}var b=D.createElement('button');b.type='button';b.className='app-back';b.hidden=true;b.innerHTML=ic('back')+'<span>Back</span>';b.addEventListener('click',function(e){e.stopPropagation();goBack()});(s.querySelector('.screen,.b-body,.main')||s).appendChild(b)});"
    + "var start=parseInt((location.hash||'').slice(1),10);"
    + "if(screens.length)show(start>0?start-1:(st.tab||0));"
    + "/* links: a label the design marked, or one that names a screen, opens it */"
    + "var LINKABLE='.btn,.more,.r,.tile,.feat,.step,.w-nav nav span,.side-link,.pill,.cta';"
    + "function labelOf(e){var t=e.querySelector&&e.querySelector('.r-title,h3,em');return (t?t.textContent:e.textContent).trim()}"
    + "var links=(A.links||[]).map(function(p){return [p[0].toLowerCase(),names.indexOf(p[1].toLowerCase())]}).filter(function(p){return p[1]>=0});"
    + "if(multi)[].slice.call(D.querySelectorAll(LINKABLE)).forEach(function(e){if(e.closest('.tabbar'))return;var l=labelOf(e).toLowerCase();if(!l)return;var hit=links.filter(function(p){return l==p[0]||l.indexOf(p[0])==0})[0];var j=hit?hit[1]:names.indexOf(l);if(j<0)return;var home=screens.filter(function(s){return s.contains(e)})[0];if(home&&screens.indexOf(home)==j)return;e.setAttribute('data-go',j);e.classList.add('app-link')});"
    + "root.addEventListener('click',function(e){var g=e.target.closest('[data-go]');if(!g||e.target.closest('.app-sheet'))return;e.stopPropagation();e.preventDefault();show(+g.getAttribute('data-go'),'go')},true);"
    + "window.addEventListener('popstate',function(){var k=parseInt((location.hash||'#1').slice(1),10)||1;if(k-1==cur)return;if(trail.length&&trail[trail.length-1]==k-1)show(k-1,'back');else{trail=[];show(k-1)}});"
    + "/* rows and tiles: what was added, removed, done */"
    + "function rowHtml(i){return '<div class=\"r\">'+(i.icon&&ic(i.icon)?'<span class=\"chip sm\">'+ic(i.icon)+'</span>':'')+'<div class=\"r-main\"><div class=\"r-title\">'+esc(i.title)+'</div>'+(i.text?'<div class=\"r-sub soft\">'+esc(i.text)+'</div>':'')+'</div>'+(i.meta?'<span class=\"r-meta faint\">'+esc(i.meta)+'</span>':'')+'<span class=\"r-go faint\">'+ic('chevron')+'</span></div>'}"
    + "function tileHtml(i,k){return '<div class=\"tile\"><div class=\"cover h'+(k%6)+'\">'+ic(i.icon||'spark')+'</div><div class=\"tile-body\"><h3>'+esc(i.title)+'</h3><p class=\"soft\">'+esc(i.text)+'</p>'+(i.meta?'<span class=\"badge\">'+esc(i.meta)+'</span>':'')+'</div></div>'}"
    + "function el(h){var t=D.createElement('div');t.innerHTML=h;return t.firstChild}"
    + "function holderOf(b){return b.querySelector('.rows,.tiles')}"
    + "function itemTitle(it){return txt(it,'.r-title')||txt(it,'h3')}"
    + "function mark(it,b){var k=bi(b)+':'+itemTitle(it);it.classList.toggle('app-done',st.done.indexOf(k)>=0);if(st.removed.indexOf(k)>=0)it.remove()}"
    + "blks.forEach(function(b,n){var k=b.getAttribute('data-kind');if(k!='list'&&k!='cards')return;var h=holderOf(b);if(!h)return;"
    + " (st.added[n]||[]).forEach(function(i,j){h.appendChild(el(k=='list'?rowHtml(i):tileHtml(i,j+h.children.length)))});"
    + " [].slice.call(h.children).forEach(function(it){mark(it,b)});"
    + " var head=b.querySelector('.row-head');if(!head){head=D.createElement('div');head.className='row-head';head.innerHTML='<h2></h2>';h.parentNode.insertBefore(head,h)}"
    + " var add=D.createElement('button');add.className='app-add';add.type='button';add.innerHTML=ic('plus')+'<span>Add</span>';head.appendChild(add);"
    + " add.addEventListener('click',function(e){e.stopPropagation();open('<h3>Add to '+esc(txt(b,'.row-head h2')||'the list')+'</h3><label class=app-f><span>Title</span><input name=t maxlength=60></label><label class=app-f><span>Detail</span><input name=x maxlength=120></label><label class=app-f><span>Tag</span><input name=m maxlength=20 placeholder=optional></label><button class=btn type=button data-go>Add</button>');"
    + "  sin.querySelector('[data-go]').onclick=function(){var t=sin.querySelector('[name=t]').value.trim();if(!t){sin.querySelector('[name=t]').focus();return}var i={title:t,text:sin.querySelector('[name=x]').value.trim(),meta:sin.querySelector('[name=m]').value.trim(),icon:k=='list'?'dot':'spark'};(st.added[n]=st.added[n]||[]).push(i);var r=st.removed.indexOf(n+':'+t);if(r>=0)st.removed.splice(r,1);save();h.appendChild(el(k=='list'?rowHtml(i):tileHtml(i,h.children.length)));shut();note('Added '+t)}})});"
    + "function details(it){var b=it.closest('.blk'),n=blks.indexOf(b),t=itemTitle(it),k=n+':'+t,done=st.done.indexOf(k)>=0;"
    + " open('<h3>'+esc(t)+'</h3>'+(txt(it,'.r-sub,.tile-body p')?'<p class=soft>'+esc(txt(it,'.r-sub,.tile-body p'))+'</p>':'')+(txt(it,'.r-meta,.badge')?'<p><span class=badge>'+esc(txt(it,'.r-meta,.badge'))+'</span></p>':'')+'<div class=app-row><button class=btn type=button data-done>'+(done?'Not done':'Mark done')+'</button><button class=btn ghost type=button data-rm>Remove</button></div>');"
    + " sin.querySelector('[data-done]').onclick=function(){var j=st.done.indexOf(k);if(j>=0)st.done.splice(j,1);else st.done.push(k);save();mark(it,b);shut();note(j>=0?'Not done':'Done')};"
    + " sin.querySelector('[data-rm]').onclick=function(){st.removed.push(k);var a=st.added[n];if(a)st.added[n]=a.filter(function(i){return i.title!=t});save();it.remove();shut();note('Removed '+t)}}"
    + "/* forms: real fields, saved entries */"
    + "function typeOf(l){l=l.toLowerCase();if(l.indexOf('mail')>=0)return 'email';if(l.indexOf('password')>=0)return 'password';if(l.indexOf('date')>=0||l.indexOf('day')>=0)return 'date';if(l.indexOf('time')>=0)return 'time';if(l.indexOf('phone')>=0)return 'tel';if(/(number|amount|age|count|guests|people)/.test(l))return 'number';return 'text'}"
    + "function entries(b,n){var w=b.querySelector('.app-entries');if(!w){w=D.createElement('div');w.className='app-entries';(b.querySelector('.form')||b).appendChild(w)}var es=st.forms[n]||[];w.innerHTML=es.length?'<div class=app-eh>Saved here</div>'+es.slice(-5).reverse().map(function(e){return '<div class=app-e>'+esc(e.slice(0,2).join(' · '))+'</div>'}).join(''):'';}"
    + "blks.forEach(function(b,n){if(b.getAttribute('data-kind')!='form')return;"
    + " b.querySelectorAll('.field').forEach(function(f){var lab=txt(f,'span'),box=f.querySelector('.input'),em=box&&box.querySelector('em');if(!em)return;var i=D.createElement('input');i.className='app-in-f';i.type=typeOf(lab);i.placeholder=em.textContent;i.setAttribute('aria-label',lab);if(i.type=='password')i.autocomplete='new-password';em.replaceWith(i)});"
    + " var go=b.querySelector('.btn');if(go){go.setAttribute('role','button');go.addEventListener('click',function(e){e.stopPropagation();var ins=[].slice.call(b.querySelectorAll('.app-in-f'));var empty=ins.filter(function(i){return !i.value.trim()});if(empty.length){empty[0].focus();note('Fill in '+(empty[0].getAttribute('aria-label')||'every field'));return}var bad=ins.filter(function(i){return i.type=='email'&&!/.+@.+[.].+/.test(i.value)});if(bad.length){bad[0].focus();note('That email looks wrong');return}var e2=ins.map(function(i){return i.type=='password'?'••••':i.value.trim()});(st.forms[n]=st.forms[n]||[]).push(e2);save();ins.forEach(function(i){i.value=''});entries(b,n);note('Saved')})}"
    + " entries(b,n)});"
    + "/* search and chips: filter what is on the same screen */"
    + "var FILTER='.r,.tile,.feat,.activity li,.tbl tbody tr,.plan,.step';"
    + "function filter(sc,q){q=q.trim().toLowerCase();var items=[].slice.call(sc.querySelectorAll(FILTER));var hit=items.filter(function(it){return it.textContent.toLowerCase().indexOf(q)>=0});if(q&&!hit.length)return false;items.forEach(function(it){it.classList.toggle('app-hide',q!=''&&hit.indexOf(it)<0)});return true}"
    + "D.querySelectorAll('.blk[data-kind=search] .search').forEach(function(s){var sp=s.querySelector('span');var i=D.createElement('input');i.className='app-search';i.type='search';i.placeholder=sp?sp.textContent:'Search';if(sp)sp.replaceWith(i);i.addEventListener('input',function(){if(!filter(scope(s),i.value))note('Nothing matches '+i.value)})});"
    + "D.querySelectorAll('.pills').forEach(function(p){var ps=[].slice.call(p.querySelectorAll('.pill'));ps.forEach(function(c,k){c.setAttribute('role','button');c.addEventListener('click',function(){ps.forEach(function(x){x.classList.toggle('on',x==c)});if(k==0){filter(scope(p),'');return}if(!filter(scope(p),c.textContent))filter(scope(p),'')})})});"
    + "/* chat: messages are kept */"
    + "var chat=D.querySelector('.blk[data-kind=chat] .chat'),cn=chat?bi(chat):-1;"
    + "function say(t,me){if(!chat)return;var d=D.createElement('div');d.className=me?'msg me':'msg';d.innerHTML=me?'<div class=bubble>'+esc(t)+'</div>':'<span class=av>'+ic('spark')+'</span><div><div class=who-name>'+esc(A.brand)+'</div><div class=bubble>'+esc(t)+'</div></div>';chat.appendChild(d);var sc=chat.closest('.scroll');if(sc)sc.scrollTop=sc.scrollHeight}"
    + "if(chat)(st.chat[cn]||[]).forEach(function(m){say(m.t,m.me)});"
    + "var live=window.KOSIKA_LIVE&&window.KOSIKA_LIVE.binds&&window.KOSIKA_LIVE.binds.some(function(b){return b.block=='composer'});"
    + "if(!live)D.querySelectorAll('.blk[data-kind=composer] .composer').forEach(function(c){var h=c.querySelector('.hint');var i=D.createElement('input');i.className='hint-in';i.placeholder=h?h.textContent:'Message';if(h)h.replaceWith(i);function send(){var t=i.value.trim();if(!t)return;i.value='';say(t,true);(st.chat[cn]=st.chat[cn]||[]).push({t:t,me:1});var r='Kept in your notes. Connect a workflow to '+A.brand+' to have it answer.';setTimeout(function(){say(r,false)},350);st.chat[cn].push({t:r,me:0});save()}i.addEventListener('keydown',function(e){if(e.key=='Enter')send()});var s=c.querySelector('.send');if(s)s.addEventListener('click',send)});"
    + "/* activity: tap to move a step on */"
    + "var NEXT={next:'now',now:'done',done:'next',bad:'now'};"
    + "function setAct(li,s){['next','now','done','bad'].forEach(function(c){li.classList.remove(c)});li.classList.add(s);var d=li.querySelector('.dotmark');if(d)d.innerHTML=s=='done'?ic('check'):'';var m=li.querySelector('.a-meta');if(m)m.textContent=s}"
    + "D.querySelectorAll('.activity li').forEach(function(li){var k=key(li,txt(li,'.a-title'));if(st.acts[k])setAct(li,st.acts[k]);li.addEventListener('click',function(){var now=['next','now','done','bad'].filter(function(c){return li.classList.contains(c)})[0]||'next';var s=NEXT[now];setAct(li,s);st.acts[k]=s;save()})});"
    + "/* progress: tap the bar to set it */"
    + "D.querySelectorAll('.bars .bar').forEach(function(bar){var k=key(bar,txt(bar,'.bar-top span')),f=bar.querySelector('.fill'),lab=bar.querySelector('.bar-top .faint');function set(p){p=Math.round(Math.max(0,Math.min(100,p)));if(f)f.style.width=p+'%';if(lab)lab.textContent=p+'%'}if(st.bars[k]!=null)set(st.bars[k]);bar.addEventListener('click',function(e){var tr=bar.querySelector('.track').getBoundingClientRect();var p=(e.clientX-tr.left)/tr.width*100;if(e.clientX<tr.left||e.clientX>tr.right)p=(parseFloat(lab&&lab.textContent)||0)+10;set(p);st.bars[k]=Math.round(Math.max(0,Math.min(100,p)));save()})});"
    + "/* pricing: choose a plan */"
    + "var plans=[].slice.call(D.querySelectorAll('.plan'));"
    + "function choose(p){plans.forEach(function(x){x.classList.toggle('app-chosen',x==p)});st.plan=txt(p,'h3');save()}"
    + "plans.forEach(function(p){if(st.plan&&txt(p,'h3')==st.plan)choose(p);p.addEventListener('click',function(e){choose(p);note('Chose '+txt(p,'h3'))})});"
    + "/* buttons and links go somewhere real */"
    + "var secs=[].slice.call(D.querySelectorAll('.blk')).filter(function(b){var k=b.getAttribute('data-kind');return k!='nav'&&k!='hero'});"
    + "function goTo(b){if(b)b.scrollIntoView({behavior:'smooth',block:'start'})}"
    + "D.querySelectorAll('.w-nav nav span').forEach(function(a,k){a.setAttribute('role','link');a.addEventListener('click',function(){var w=a.textContent.trim().toLowerCase();var hit=secs.filter(function(b){return b.textContent.toLowerCase().indexOf(w)>=0})[0];goTo(hit||secs[k])})});"
    + "D.querySelectorAll('.hero .btn,.cta .btn,.w-nav .btn').forEach(function(b){b.setAttribute('role','button');b.addEventListener('click',function(){var f=D.querySelector('.blk[data-kind=form]')||D.querySelector('.blk[data-kind=pricing]');if(f&&!b.closest('.blk[data-kind=form]')){goTo(f);var i=f.querySelector('input');if(i)setTimeout(function(){i.focus()},400)}else{var me=b.closest('.blk'),j=blks.indexOf(me);goTo(blks[j+1])}})});"
    + "/* one listener for taps on rows, tiles and tabs */"
    + "root.addEventListener('click',function(e){var t=e.target;if(t.closest('.app-sheet,.app-add'))return;"
    + " var tab=t.closest('.tabbar .tab');if(tab){var ts=[].slice.call(tab.parentNode.children),k=ts.indexOf(tab),j=screenFor(tab,k);if(multi&&j>=0){trail=[];show(j)}else{ts.forEach(function(x){x.classList.toggle('on',x==tab)});note(tab.textContent.trim())}return}"
    + " var it=t.closest('.rows .r,.tiles .tile');if(it&&(kind(it)=='list'||kind(it)=='cards')){details(it);return}});"
    + "D.addEventListener('keydown',function(e){if(e.key=='Escape')shut()});"
    + "if('serviceWorker' in navigator&&location.protocol!='file:'&&A.offline)navigator.serviceWorker.register('sw.js').catch(function(){});"
    + "})();"
}

record UiFile { path: Text text: Text }
record UiAppMade { title: Text slug: Text page: Text files: UiFile[] fixed: Text[] problems: Text[] }

// A short name for the app's folder and its saved data: letters and digits.
fn ui_app_id(s: UiSpec) -> Text {
  let words = ui_slug(if s.brand.trim().is_empty() { s.title } else { s.brand })
  let kept = (for k in 0 until words.length() where "abcdefghijklmnopqrstuvwxyz0123456789".contains(words.slice(k, k + 1)) { words.slice(k, k + 1) }).join("")
  return if kept.is_empty() { "kosika-app" } else { kept.slice(0, kept.length().min(32)) }
}

fn ui_app_colours(s: UiSpec) -> Text[] {
  let a = ui_accent(s.accent)
  let p = ui_partner(a.name)
  let dark = ui_mode(s.theme) == "dark"
  let base = [if dark { a.dark } else { a.light }, if dark { p.dark } else { p.light }]
  return if s.look.colours.is_empty() { base } else if s.look.colours.length() == 1 { [s.look.colours[0], base[1]] } else { s.look.colours.take(2) }
}

fn ui_app_ground(s: UiSpec) -> Text { return if ui_mode(s.theme) == "dark" { "#0b0b10" } else { "#ffffff" } }

// The app's icon: its first letter on its own two colours.
fn ui_app_icon(s: UiSpec) -> Text {
  let c = ui_app_colours(s)
  let letter = ui_esc(ui_or(s.brand, s.title).trim().slice(0, 1).upper())
  return f"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"{c[0]}\"/><stop offset=\"1\" stop-color=\"{c[1]}\"/></linearGradient></defs><rect width=\"512\" height=\"512\" rx=\"112\" fill=\"url(#g)\"/><circle cx=\"400\" cy=\"112\" r=\"150\" fill=\"#fff\" opacity=\".12\"/><text x=\"256\" y=\"256\" dy=\".35em\" text-anchor=\"middle\" font-family=\"system-ui,sans-serif\" font-size=\"280\" font-weight=\"700\" fill=\"#fff\">{letter}</text></svg>"
}

fn ui_app_manifest(s: UiSpec) -> Text {
  let name = ui_or(s.brand, s.title)
  return "{\"name\":" + ui_jstr(name + " · " + s.title) + ",\"short_name\":" + ui_jstr(name) + ",\"start_url\":\"./\",\"scope\":\"./\",\"display\":\"standalone\",\"background_color\":\"" + ui_app_ground(s) + "\",\"theme_color\":\"" + ui_app_ground(s) + "\",\"icons\":[{\"src\":\"icon.svg\",\"sizes\":\"any\",\"type\":\"image/svg+xml\",\"purpose\":\"any\"}]}"
}

// Keeps the app's files so it opens with no connection; a new version of
// the page gets a new cache.
fn ui_app_sw(id: Text, version: Text) -> Text {
  let c = "kosika-app-" + id
  return "var C='" + c + "-" + version + "',F=['./','index.html','manifest.webmanifest','icon.svg'];"
    + "self.addEventListener('install',function(e){e.waitUntil(caches.open(C).then(function(c){return c.addAll(F)}).then(function(){return self.skipWaiting()}))});"
    + "self.addEventListener('activate',function(e){e.waitUntil(caches.keys().then(function(ks){return Promise.all(ks.filter(function(k){return k!=C&&k.indexOf('" + c + "-')==0}).map(function(k){return caches.delete(k)}))}).then(function(){return self.clients.claim()}))});"
    + "self.addEventListener('fetch',function(e){if(e.request.method!='GET')return;e.respondWith(caches.match(e.request).then(function(r){return r||fetch(e.request).then(function(res){if(res.ok||res.type=='opaque'){var cp=res.clone();caches.open(C).then(function(c){c.put(e.request,cp)})}return res}).catch(function(){return caches.match('index.html')})}))});"
}

fn ui_app_head(s: UiSpec) -> Text {
  let name = ui_esc(ui_or(s.brand, s.title))
  return "<link rel=\"manifest\" href=\"manifest.webmanifest\"><link rel=\"icon\" href=\"icon.svg\" type=\"image/svg+xml\"><link rel=\"apple-touch-icon\" href=\"icon.svg\"><meta name=\"theme-color\" content=\"" + ui_app_ground(s) + "\"><meta name=\"mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\"><meta name=\"apple-mobile-web-app-title\" content=\"" + name + "\">"
}

fn ui_app_data(s: UiSpec, links: Text) -> Text {
  let icons = (for n in ["plus", "chevron", "check", "spark", "dot", "back"] { n + ":" + ui_js(ui_icon(n)) }).join(",")
  return "window.KOSIKA_APP={id:" + ui_js(ui_app_id(s)) + ",brand:" + ui_js(ui_or(s.brand, s.title)) + ",offline:true,links:" + links + ",icons:{" + icons + "}};"
}

// The design as an app: the same page, out of its frame, with the runtime
// that makes it work. Parts bound to workflows still call them when the app
// is served by kosika-native serve.
fn ui_app_page(s: UiSpec, fixed: Text[], binds: UiBind[], links: Text) -> Text {
  let page = if binds.is_empty() { ui_page(s, fixed) } else { ui_live_page(s, fixed, binds) }
  let viewport = "width=device-width,initial-scale=1,viewport-fit=cover"
  let tail = "<style>" + ui_app_css() + "</style><script>" + ui_app_data(s, links) + ui_app_js() + "</script></body>"
  return page.replace("width=device-width,initial-scale=1\"", viewport + "\"").replace("</head>", ui_app_head(s) + "</head>").replace("<body ", "<body data-app ").replace("</body>", tail)
}

fn ui_app_made(a: UiApp) -> UiAppMade {
  let c = ui_checked(a.ask, a.spec)
  let b = ui_binds_checked(c.spec, a.binds)
  let fixed = c.fixed.concat(b.fixed)
  let id = ui_app_id(c.spec)
  let page = ui_app_page(c.spec, fixed, b.binds, ui_spec_links(a.spec))
  let files: UiFile[] = [{path: "index.html", text: page}, {path: "manifest.webmanifest", text: ui_app_manifest(c.spec)}, {path: "sw.js", text: ui_app_sw(id, f"{page.length()}")}, {path: "icon.svg", text: ui_app_icon(c.spec)}]
  return {title: c.spec.title, slug: id, page: page, files: files, fixed: fixed, problems: c.problems}
}

fn ui_app_from(ask: UiAsk, said: UiSpec) -> UiAppMade {
  return ui_app_made({ask: ask, spec: if said.screens.is_empty() { ui_starter(ask) } else { said }, binds: []})
}

// ---------------------------------------------------------------- editing by talking

// A design changed by words: "warmer", "make it green and gold", "dark",
// "add pricing", "remove the quote", "serif", "waves". Kosika understands
// these itself, with no model; anything else goes to the model, which gets
// the whole design and changes only what was asked.
record UiEdit { ask: UiAsk spec: UiSpec change: Text }
record UiEditBrief { task: Text design: Text change: Text }
record UiEdited { spec: UiSpec done: Text[] understood: Bool }

model ui_editor {
  input: UiEditBrief
  output: UiSpec
  parameters: {
    max_output_tokens: 7000
  }
}

record UiNamedColour { name: Text hex: Text }

fn ui_colour_words() -> UiNamedColour[] {
  return [
    {name: "red", hex: "#e5484d"}, {name: "crimson", hex: "#d4234a"}, {name: "orange", hex: "#f76b15"},
    {name: "amber", hex: "#ffb224"}, {name: "gold", hex: "#d4a72c"}, {name: "yellow", hex: "#f5d90a"},
    {name: "lime", hex: "#99d52a"}, {name: "green", hex: "#30a46c"}, {name: "emerald", hex: "#10b981"},
    {name: "mint", hex: "#3dd68c"}, {name: "teal", hex: "#12a594"}, {name: "cyan", hex: "#05a2c2"},
    {name: "sky", hex: "#0ea5e9"}, {name: "blue", hex: "#3e63dd"}, {name: "navy", hex: "#1e3a8a"},
    {name: "indigo", hex: "#5b5bd6"}, {name: "violet", hex: "#8e4ec6"}, {name: "purple", hex: "#8e4ec6"},
    {name: "lavender", hex: "#a78bfa"}, {name: "pink", hex: "#d6409f"}, {name: "magenta", hex: "#c026d3"},
    {name: "rose", hex: "#f43f5e"}, {name: "coral", hex: "#ff6b5b"}, {name: "peach", hex: "#ffa07a"},
    {name: "brown", hex: "#a0663a"}, {name: "coffee", hex: "#8b5a3c"}, {name: "sand", hex: "#d6b98c"},
    {name: "silver", hex: "#a1a1aa"}, {name: "white", hex: "#f4f4f5"}, {name: "black", hex: "#27272a"}
  ]
}

// Which of the words name a block kind, with the everyday words for each.
fn ui_kind_word(w: Text) -> Text {
  let t = w.lower().trim_marks(",.;:!?'\"")
  if ui_kinds().contains(t) { return t }
  if ["prices", "price", "plans", "plan"].contains(t) { return "pricing" }
  if ["graph", "graphs", "charts", "plot", "diagram"].contains(t) { return "chart" }
  if ["numbers", "metrics", "stat", "kpis", "kpi"].contains(t) { return "stats" }
  if ["testimonial", "testimonials", "review", "reviews", "quotes"].contains(t) { return "quote" }
  if ["step", "how", "process"].contains(t) { return "steps" }
  if ["card", "gallery", "tiles"].contains(t) { return "cards" }
  if ["signup", "sign-up", "login", "contact"].contains(t) { return "form" }
  if ["shapes", "artwork", "illustration", "picture"].contains(t) { return "art" }
  if ["feature", "benefits", "reasons"].contains(t) { return "features" }
  if ["tasks", "timeline", "plan"].contains(t) { return "activity" }
  if ["bars", "goals"].contains(t) { return "progress" }
  if ["header", "menu", "navbar", "navigation"].contains(t) { return "nav" }
  if ["button", "call"].contains(t) { return "cta" }
  if ["tabs"].contains(t) { return "tabbar" }
  return ""
}

// A block of a kind, with content shaped from the design's own title,
// for when Kosika adds it without a model.
fn ui_new_block(kind: Text, s: UiSpec) -> UiBlock {
  let name = s.title
  if kind == "pricing" { return ui_block("pricing", "Simple pricing", "Start free. Upgrade when you need more.", "Pricing", "Choose", [ui_item("Starter", "Everything to begin;One project;Community help", "Free", ""), ui_item("Pro", "Everything in Starter;Unlimited projects;Priority help", "$9 / month", ""), ui_item("Team", "Everything in Pro;Shared spaces;Admin controls", "$29 / month", "")]) }
  if kind == "chart" { return ui_block("chart", "This week", "How " + name.lower() + " grew, day by day.", "area", "", [ui_item("Mon", "", "12", ""), ui_item("Tue", "", "18", ""), ui_item("Wed", "", "15", ""), ui_item("Thu", "", "24", ""), ui_item("Fri", "", "29", ""), ui_item("Sat", "", "34", "")]) }
  if kind == "stats" { return ui_block("stats", "", "", "", "", [ui_item("2,400", "people", "+12%", ""), ui_item("98%", "would return", "", ""), ui_item("4.9", "average rating", "", "")]) }
  if kind == "quote" { return ui_block("quote", "Early user", "It feels like it was made for exactly the way I work.", "Sam Rivera", "", []) }
  if kind == "steps" { return ui_block("steps", "How it works", "", "Three steps", "", [ui_item("Start", "Tell it what you need, in your own words.", "", ""), ui_item("Shape", "See it take form and adjust anything.", "", ""), ui_item("Share", "Send it on when it is ready.", "", "")]) }
  if kind == "art" { return ui_block("art", "", "", "", "", [ui_item("blob", "accent", "0.25 0.5 0.22", "float"), ui_item("star", "partner", "0.5 0.4 0.16", "spin"), ui_item("hexagon", "accent", "0.75 0.55 0.18", "sway"), ui_item("wave", "partner", "0.5 0.85 0.12", "float")]) }
  if kind == "cards" { return ui_block("cards", "Explore", "", "", "See all", [ui_item("Getting started", "The first ten minutes.", "New", "spark"), ui_item("Ideas", "What others made with it.", "Popular", "star"), ui_item("Guides", "Short, practical how-tos.", "", "book")]) }
  if kind == "form" { return ui_block("form", "Stay in touch", "One short email a month.", "", "Sign up", [ui_item("Name", "", "Your name", "user"), ui_item("Email", "", "you@example.com", "mail")]) }
  if kind == "features" { return ui_block("features", "Why " + s.brand, "", "Features", "", [ui_item("Fast", "Ready in seconds.", "", "bolt"), ui_item("Thoughtful", "Every detail considered.", "", "spark"), ui_item("Yours", "Your data stays yours.", "", "shield")]) }
  if kind == "cta" { return ui_block("cta", "Ready when you are", "It takes a minute to start.", "", "Get started", []) }
  if kind == "list" { return ui_block("list", "Recent", "", "", "", [ui_item("First item", "Added today", "Now", "bolt"), ui_item("Second item", "Added yesterday", "1d", "clock")]) }
  if kind == "activity" { return ui_block("activity", "Plan", "", "", "", [ui_item("Read the request", "", "done", ""), ui_item("Do the work", "", "now", ""), ui_item("Check and report", "", "next", "")]) }
  if kind == "progress" { return ui_block("progress", "Goals", "", "", "", [ui_item("This week", "", "70%", ""), ui_item("This month", "", "45%", "")]) }
  return ui_block(kind, name, "", "", "", [])
}

fn ui_with_look(s: UiSpec, look: UiLook) -> UiSpec { return {target: s.target, title: s.title, brand: s.brand, accent: s.accent, theme: s.theme, look: look, screens: s.screens} }

fn ui_with_theme(s: UiSpec, theme: Text) -> UiSpec { return {target: s.target, title: s.title, brand: s.brand, accent: s.accent, theme: theme, look: s.look, screens: s.screens} }

fn ui_with_screens(s: UiSpec, screens: UiScreen[]) -> UiSpec { return {target: s.target, title: s.title, brand: s.brand, accent: s.accent, theme: s.theme, look: s.look, screens: screens} }

fn ui_look_of(colours: Text[], shape: Text, art: Text, font: Text) -> UiLook { return {colours: colours, shape: shape, art: art, font: font} }

// The colours a design draws with now, as hex, whether chosen or named.
fn ui_colours_now(s: UiSpec) -> Text[] {
  if not s.look.colours.is_empty() { return s.look.colours }
  let dark = ui_mode(s.theme) == "dark"
  let a = ui_accent(s.accent)
  let p = ui_partner(s.accent)
  return if dark { [a.dark, p.dark] } else { [a.light, p.light] }
}

fn ui_colour_hex(word: Text) -> Text {
  for c in ui_colour_words() {
    if c.name == word { return c.hex }
  }
  return ""
}

fn ui_screen_without(sc: UiScreen, kind: Text) -> UiScreen { return {name: sc.name, blocks: for b in sc.blocks where b.kind != kind { b }} }

// Every change Kosika can make from the words alone.
fn ui_edit_local(s: UiSpec, change: Text) -> UiEdited {
  let words = for w in change.lower().words() { w.trim_marks(",.;:!?'\"()") }
  let t = " " + words.join(" ") + " "
  var spec = s
  var done: Text[] = []
  // light, dark, minimal, vivid
  let mode = ui_mode(spec.theme)
  let style = ui_style(spec.theme)
  let new_mode = if ui_any(t, [" dark ", " darker", " dark mode", " night mode"]) { "dark" } else if ui_any(t, [" light ", " lighter", " bright ", " brighter", " light mode", " day "]) { "light" } else { mode }
  let new_style = if ui_any(t, ui_minimal_words()) or ui_any(t, [" calmer", " calm ", " simpler", " still "]) { "minimal" } else if ui_any(t, [" vivid", " colourful", " colorful", " animated", " bolder", " bold ", " livelier", " more motion", " more colour", " more color"]) { "vivid" } else { style }
  if new_mode != mode or new_style != style {
    spec = ui_with_theme(spec, if new_style == "minimal" { new_mode + " minimal" } else { new_mode })
    done = done.append(f"made it {new_mode}" + (if new_style != style { ", " + new_style } else { "" }))
  }
  // colours: named ones first, then warmer or cooler
  let named = for w in words where not ui_colour_hex(w).is_empty() { ui_colour_hex(w) }
  let now = ui_colours_now(spec)
  var colours = spec.look.colours
  if not named.is_empty() {
    colours = if named.length() > 1 { named.take(2) } else { [named[0], now[1]] }
    done = done.append("changed the colours to " + (for w in words where not ui_colour_hex(w).is_empty() { w }).take(2).join(" and "))
  } else if ui_any(t, [" warmer", " warm ", " cosier", " cozier", " sunnier"]) {
    colours = [ui_mix(now[0], "#ff7a3d", 0.45), ui_mix(now[1], "#ffc145", 0.45)]
    done = done.append("warmed the colours")
  } else if ui_any(t, [" cooler", " cool ", " colder", " calmer colours", " icier"]) {
    colours = [ui_mix(now[0], "#3d8bff", 0.45), ui_mix(now[1], "#2dd4bf", 0.45)]
    done = done.append("cooled the colours")
  } else if ui_any(t, [" new colours", " new colors", " different colours", " different colors", " other colours", " other colors", " surprise"]) {
    let seed = ui_seed(change + spec.title)
    colours = [ui_colour_words()[(ui_rnd(seed, 1) * 26).floor()].hex, ui_colour_words()[(ui_rnd(seed, 2) * 26).floor()].hex]
    done = done.append("picked new colours")
  }
  // art, type, shape
  let art_named = for a in ui_arts() where t.contains(" " + a) { a }
  let art = if not art_named.is_empty() { art_named[0] } else if ui_any(t, [" no art", " remove the art", " plain background", " no background"]) { "none" } else if ui_any(t, [" new art", " different art", " other art", " different background", " new background"]) { ui_pick(for a in ui_arts() where a != spec.look.art { a }, ui_seed(change), 4) } else { spec.look.art }
  if art != spec.look.art { done = done.append(if art == "none" { "took the art away" } else { "drew " + art + " behind it" }) }
  let font = if ui_any(t, [" serif", " editorial", " elegant", " classic", " magazine"]) { "editorial" } else if ui_any(t, [" mono", " code ", " terminal", " hacker", " technical"]) { "mono" } else if ui_any(t, [" rounded", " friendly", " playful", " soft font"]) { "rounded" } else if ui_any(t, [" grotesk", " techy", " futuristic"]) { "grotesk" } else if ui_any(t, [" plain font", " geometric", " clean font"]) { "geometric" } else { spec.look.font }
  if font != spec.look.font { done = done.append("set the type in " + font) }
  let shape = if ui_any(t, [" sharp", " square ", " squarer", " edgy", " corners"]) { "sharp" } else if ui_any(t, [" pill", " capsule"]) { "pill" } else if ui_any(t, [" rounder", " round ", " rounded corners", " softer", " bubbly"]) { "round" } else { spec.look.shape }
  if shape != spec.look.shape { done = done.append("made the shapes " + shape) }
  if colours != spec.look.colours or art != spec.look.art or font != spec.look.font or shape != spec.look.shape {
    spec = ui_with_look(spec, ui_look_of(colours, shape, art, font))
  }
  // remove or add parts
  let removing = ui_any(t, [" remove", " delete", " drop ", " without", " get rid of", " take out", " no "])
  let adding = ui_any(t, [" add", " include", " put in", " put a", " with a ", " with an ", " needs a", " give it"])
  let kinds = for w in words where not ui_kind_word(w).is_empty() { ui_kind_word(w) }
  if removing and not kinds.is_empty() {
    let gone = kinds[0]
    spec = ui_with_screens(spec, for sc in spec.screens { ui_screen_without(sc, gone) })
    done = done.append("removed the " + gone)
  } else if adding and not kinds.is_empty() {
    let kind = kinds[0]
    let first = spec.screens[0]
    let fresh = ui_new_block(kind, spec)
    let n = first.blocks.length()
    let before_end = (for k in 0 until n where ui_bottoms().contains(first.blocks[k].kind) or first.blocks[k].kind == "cta" { k })
    let at = if before_end.is_empty() { n } else { before_end[0] }
    let blocks = first.blocks.take(at).concat([fresh]).concat(first.blocks.slice(at, n))
    let changed: UiScreen = {name: first.name, blocks: blocks}
    spec = ui_with_screens(spec, [changed].concat(spec.screens.slice(1, spec.screens.length())))
    done = done.append("added a " + kind)
  }
  return {spec: spec, done: done, understood: not done.is_empty()}
}

fn ui_jstr(t: Text) -> Text { return "\"" + t.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", " ") + "\"" }

fn ui_jitem(i: UiItem) -> Text { return "{\"title\":" + ui_jstr(i.title) + ",\"text\":" + ui_jstr(i.text) + ",\"meta\":" + ui_jstr(i.meta) + ",\"icon\":" + ui_jstr(i.icon) + "}" }

fn ui_jblock(b: UiBlock) -> Text { return "{\"kind\":" + ui_jstr(b.kind) + ",\"title\":" + ui_jstr(b.title) + ",\"text\":" + ui_jstr(b.text) + ",\"meta\":" + ui_jstr(b.meta) + ",\"action\":" + ui_jstr(b.action) + ",\"items\":[" + (for i in b.items { ui_jitem(i) }).join(",") + "]}" }

// A design as JSON text, to hand to the model.
fn ui_spec_json(s: UiSpec) -> Text {
  let look = "{\"colours\":[" + (for c in s.look.colours { ui_jstr(c) }).join(",") + "],\"shape\":" + ui_jstr(s.look.shape) + ",\"art\":" + ui_jstr(s.look.art) + ",\"font\":" + ui_jstr(s.look.font) + "}"
  let screens = (for sc in s.screens { "{\"name\":" + ui_jstr(sc.name) + ",\"blocks\":[" + (for b in sc.blocks { ui_jblock(b) }).join(",") + "]}" }).join(",")
  return "{\"target\":" + ui_jstr(s.target) + ",\"title\":" + ui_jstr(s.title) + ",\"brand\":" + ui_jstr(s.brand) + ",\"accent\":" + ui_jstr(s.accent) + ",\"theme\":" + ui_jstr(s.theme) + ",\"look\":" + look + ",\"screens\":[" + screens + "]}"
}

fn ui_edit_task() -> Text {
  return "You are a senior product designer changing a design someone already has. The design is given as JSON in the same shape you must return. Change only what the person asks for; keep every other block, word, colour and setting exactly as it is. You may add, remove, reorder or rewrite blocks, and change the look (colours as hex, shape, art, font) and theme, when the change asks for it. The blocks: " + ui_blocks_guide() + " Icons: only these names: " + ui_icons_guide() + ". Return the whole design."
}

// The ask the design is checked against after an edit: the design's own
// target, theme and accent, so the first ask's words cannot undo the edit.
fn ui_edit_ask(e: UiEdit, s: UiSpec) -> UiAsk { return {text: e.ask.text, target: s.target, theme: s.theme, accent: s.accent} }

fn ui_edit_result(e: UiEdit, local: UiEdited, said: UiSpec) -> UiResult {
  let fresh = not said.screens.is_empty()
  let base = if fresh { said } else { local.spec }
  let r = ui_result(ui_edit_ask(e, base), base)
  let notes = if fresh { ["changed it as you asked"] } else if local.understood { local.done } else { ["Kosika could not tell what to change, so the design is as it was"] }
  return {target: r.target, title: r.title, spec: r.spec, page: r.page, fixed: notes.concat(r.fixed), problems: r.problems}
}

fn ui_short(change: Text) -> Bool { return change.trim().words().length() <= 12 }

// A design changed by words. Short changes Kosika understands are made
// with no model; the rest go to the model, and if it fails, Kosika's own
// change stands.
record UiEditCall { spec: UiSpec change: Text }

// Words that ask for the content to change, which only a model can write.
fn ui_rewrite_words() -> Text[] { return [" rewrite", " write ", " reword", " rename", " replace", " headline", " title", " wording", " copy ", " text ", " about ", " instead of", " translate", " shorter", " longer", " funnier", " more professional", " tone"] }

fn ui_edit_route(local: UiEdited, change: Text) -> Text {
  let t = " " + (for w in change.lower().words() { w.trim_marks(",.;:!?'\"()") }).join(" ") + " "
  return if local.understood and ui_short(change) and not ui_any(t, ui_rewrite_words()) { "kosika" } else { "model" }
}

workflow ui_edit_by_model(c: UiEditCall) -> UiSpec {
  budget 3 model calls, 600 seconds
  out = use_model ui_editor(ui_edit_task(), ui_spec_json(c.spec), c.change) retry 1 otherwise ui_no_spec()
}

workflow ui_edit_by_kosika(c: UiEditCall) -> UiSpec {
  out = ui_no_spec()
}

workflow ui_edit(e: UiEdit) -> UiResult {
  local = ui_edit_local(e.spec, e.change)
  said  = match ui_edit_route(local, e.change) {
    case "kosika" { call ui_edit_by_kosika({spec: local.spec, change: e.change}) }
    case _ { call ui_edit_by_model({spec: local.spec, change: e.change}) }
  }
  out   = ui_edit_result(e, local, said)
}

// ---------------------------------------------------------------- taste

// The looks the person liked, kept by whatever holds their memory (the
// phone app, Studio, a notebook), and given back with each new ask: the
// model leans toward them, and Kosika fills what the model leaves out
// from them before falling back to the seed. Each design stays new.
record UiLike { look: UiLook theme: Text ask: Text }
record UiTasteAsk { ask: UiAsk likes: UiLike[] }

fn ui_like(r: UiResult, ask: UiAsk) -> UiLike { return {look: r.spec.look, theme: r.spec.theme, ask: ask.text} }

fn ui_most(values: Text[]) -> Text {
  var best = ""
  var count = 0
  for v in values {
    let n = (for w in values where w == v { w }).length()
    if not v.is_empty() and n > count {
      best = v
      count = n
    }
  }
  return best
}

fn ui_taste_text(likes: UiLike[]) -> Text {
  if likes.is_empty() { return "" }
  let shown = (for l in likes.take(6) { "colours " + ui_or(l.look.colours.join(" and "), "named accent") + ", " + l.look.art + " art, " + l.look.font + " type, " + l.look.shape + " shapes, " + l.theme }).join("; ")
  return " The person liked these looks before: " + shown + ". Lean toward what they liked (their colours, art, type and shapes), but make this design its own, not a copy."
}

// What the model left out, filled from what the person liked.
fn ui_lean(look: UiLook, likes: UiLike[]) -> UiLook {
  if likes.is_empty() { return look }
  let fav_colours = for l in likes where not l.look.colours.is_empty() { l.look.colours }
  return {
    colours: if look.colours.is_empty() and not fav_colours.is_empty() { fav_colours[fav_colours.length() - 1] } else { look.colours },
    shape: if look.shape.trim().is_empty() { ui_most(for l in likes { l.look.shape }) } else { look.shape },
    art: if look.art.trim().is_empty() { ui_most(for l in likes { l.look.art }) } else { look.art },
    font: if look.font.trim().is_empty() { ui_most(for l in likes { l.look.font }) } else { look.font }
  }
}

fn ui_taste_result(t: UiTasteAsk, said: UiSpec) -> UiResult {
  let base = if said.screens.is_empty() { ui_with_look(ui_starter(t.ask), ui_lean(ui_no_look(), t.likes)) } else { ui_with_look(said, ui_lean(said.look, t.likes)) }
  return ui_result(t.ask, base)
}

// A new design that leans toward the looks the person liked.
workflow design_ui_for(t: UiTasteAsk) -> UiResult {
  budget 3 model calls, 600 seconds
  said = use_model ui_designer(ui_task() + ui_taste_text(t.likes), t.ask.text, ui_target(t.ask), "") retry 1 otherwise ui_no_spec()
  out  = ui_taste_result(t, said)
}

// ---------------------------------------------------------------- the model's brief

fn ui_blocks_guide() -> Text {
  return "nav: the top bar of a website; items are its links (title only); action is the main button. hero: the opening of a page; title is the headline (at most 8 words, specific, no hype), text one or two sentences, meta a short label above it (like New or Now in beta), action the buttons as 'Primary|Secondary'; items (optional) are 3 to 4 rows shown in a product preview under it. features: 3 to 6 reasons or abilities; title and text head the section, meta a one-word label above; each item has title (2 to 4 words), text (one sentence), icon. stats: 2 to 4 numbers; each item has title (the number, like 12k or 98%), text (what it counts), meta (a change, like +12%, or empty). cards: 2 to 6 things to browse (posts, courses, places, products); title heads the row, action a link like See all; each item has title, text, meta (a short tag like 5 min or $24) and icon. list: 3 to 6 rows (settings, messages, files, recent items); each item has title, text, meta (a time or count) and icon. steps: 3 to 4 steps in order; each item has title and text. pricing: 2 to 3 plans; each item has title (plan name), meta (price, like $12/mo), text (features separated by ;); action is the button word. quote: a testimonial; text is the quote, meta the person's name, title their role. cta: a closing call to action; title, text, action. footer: items are its links; text the small print. form: a sign-in or sign-up or contact form; title, text, action (the button), meta a small line under it; each item is a field with title (label), text (placeholder) and icon. appbar: the top of a phone screen or a window; title is the screen name, text a short line under or over it, meta a live status (like Running, or empty), items are icon buttons (icon only). search: a search field; meta is its placeholder. chips: 3 to 6 filters; items have title only; the first is selected. tabbar: the bottom bar of a phone app; 3 to 5 items with title and icon; the first is the screen shown. chat: a conversation; each item is a message with title (the speaker's name), text (the message) and meta (user or agent). composer: where the person types; text is the placeholder. activity: what an agent did and will do; each item has title, text (optional detail) and meta (done, now or next). progress: 2 to 4 bars; each item has title and meta (a percentage like 72%). sidebar: the left side of an agent window or app; title is the product name, action its main button (like New chat), items are its sections with title, icon and meta (a count or empty). table: rows of data; meta is the column names as 'Name|Detail|Status', each item a row with title, text and meta. chart: a chart that draws itself in; title heads it, text is one line saying what it shows, meta is its kind (line, area, bar or ring), action an optional link like 'Details'; each item is one point: title the label (short, like Mon or Jan), meta the value (like 42, 92% or $1.2k); line and area take 4 to 12 points over time, bar 3 to 8 to compare, ring 1 to 4 percentages. art: a composition of moving shapes, for a hero image, a mood or an idea; title and text head it (optional); each item is one shape: title its kind (circle, ring, square, diamond, triangle, pentagon, hexagon, octagon, star or star7, polygon9, blob, spiral, wave), text its colour (accent, partner, ink, or a hex colour), meta its place and size as 'x y size' from 0 to 1 (like '0.3 0.5 0.2'), icon its motion (spin, float, pulse, sway or none); 3 to 12 shapes that make a picture together."
}

fn ui_targets_guide() -> Text {
  return "web: a website or landing page (1 to 3 pages, each a screen): nav, hero, then 3 to 6 sections (features, stats, cards, steps, pricing, quote, list, table, form), cta, footer. phone: 1 to 5 phone screens, each with an appbar first, then 2 to 5 blocks (search, chips, cards, list, stats, progress, activity, chat, form, hero), and a tabbar last for an app with sections (a chat screen ends with a composer instead). agent: one window: a sidebar, an appbar with the task and its status, a chat, a composer, and activity and progress or stats for the live panel. artifact: one card: an appbar as its heading, then 2 to 4 blocks (stats, list, progress, activity, table, cards)."
}

fn ui_icons_guide() -> Text { return ui_icon_names().join(", ") }

fn ui_task() -> Text {
  return "You are a senior product designer. Describe the screen someone asked for as blocks; Kosika draws them in one modern design system, vivid by default (gradients in the accent and its partner, glass, motion, charts that draw themselves) or minimal when asked, so describe only what the screen says and which blocks it holds. Give target (as given), look (colours: one or two hex colours you invent for this subject, like #c0703a and #2f6f5e for a coffee roaster, not the usual purple; shape: soft, round, sharp or pill; art: the moving art behind it, one of orbits, blobs, waves, constellation, prism, rings, grid, aurora or none; font: geometric, grotesk, editorial, mono or rounded), title (the design's name, 2 to 5 words), brand (a short, believable product name, one or two words, not a placeholder like Brand or Company), accent (one of " + ui_accent_names().join(", ") + ", chosen to suit the subject), theme (dark by default, light when the subject is bright and daytime; add the word minimal, as in 'light minimal', only when the person asks for a plain or minimal look), and screens (each with name and blocks; each block has kind, title, text, meta, action and items, and each item has title, text, meta and icon; leave any field empty that the block does not use). The blocks: " + ui_blocks_guide() + " By target: " + ui_targets_guide() + " Icons: only these names: " + ui_icons_guide() + ". Write like the real product: specific, concrete, short; headlines in sentence case with no full stop; never lorem ipsum, never placeholders like Feature 1, never exclamation marks or hype words like revolutionary or seamless; realistic numbers, names, times and prices; every item different. Less is more: fewer blocks done well beat many. Use a chart wherever real numbers change over time or compare. Make every design its own: choose a look that fits this subject and differs from a default template; surprise with colour, shape and art, while staying readable. Screens link like a prototype: name every screen, and end a button, a card title, a row title or a nav link with ' > ' and a screen's name (like 'Start lesson > Lesson') to open that screen when it is tapped; a tab bar's tabs open the screens of the same names. If problems are given, they are what was wrong with your last description: fix every one."
}

fn ui_no_spec() -> UiSpec { return {target: "", title: "", brand: "", accent: "", theme: "", look: ui_no_look(), screens: []} }

fn ui_result(ask: UiAsk, said: UiSpec) -> UiResult {
  let c = ui_checked(ask, said)
  return {target: c.spec.target, title: c.spec.title, spec: c.spec, page: ui_page(c.spec, c.fixed), fixed: c.fixed, problems: c.problems}
}

// ---------------------------------------------------------------- workflows

// A model describes the screen; Kosika checks it and draws it.
workflow design_ui(ask: UiAsk) -> UiResult {
  budget 3 model calls, 600 seconds
  said = use_model ui_designer(ui_task(), ask.text, ui_target(ask), "") retry 1 otherwise ui_no_spec()
  out  = ui_result(ask, said)
}

// A description drawn as it is, with no model: for programs that write
// their own, and for the samples.
workflow ui_render(d: UiDraw) -> UiResult {
  out = ui_result(d.ask, d.spec)
}

// A design that runs: drawn, checked, and given its runtime.
workflow ui_app(a: UiApp) -> UiResult {
  out = ui_app_result(a)
}

// A design that is an app of its own: index.html, its manifest, its icon
// and a service worker, so it works with no server, opens offline, and
// installs on a phone's home screen. Put the files in a folder of a site
// (kosika-site/apps/NAME/) and it is published.
workflow ui_make_app(a: UiApp) -> UiAppMade {
  out = ui_app_made(a)
}

// From one sentence to an app: the model designs it, Kosika makes it work.
workflow design_app(ask: UiAsk) -> UiAppMade {
  budget 3 model calls, 600 seconds
  said = use_model ui_designer(ui_task(), ask.text, ui_target(ask), "") retry 1 otherwise ui_no_spec()
  out  = ui_app_from(ask, said)
}

// ---------------------------------------------------------------- tests

fn ui_ask(text: Text) -> UiAsk { return {text: text, target: "", theme: "", accent: ""} }

test "every accent reads against its surface, in light and in dark" {
  expect ui_accent_problems() == []
}

test "the ask's words choose the target" {
  expect ui_target(ui_ask("design something like an AI interface")) == "agent"
  expect ui_wants("make me an AI interface")
  expect ui_target(ui_ask("a landing page for a quiet coffee shop")) == "web"
  expect ui_target(ui_ask("design a mobile app for learning Japanese")) == "phone"
  expect ui_target(ui_ask("an iPhone onboarding screen for a habit tracker")) == "phone"
  expect ui_target(ui_ask("an agent window for a research assistant")) == "agent"
  expect ui_target(ui_ask("a summary card artifact of my week")) == "artifact"
  expect ui_target({text: "anything", target: "phone", theme: "", accent: ""}) == "phone"
  expect ui_target(ui_ask("a dashboard for a solar farm")) == "web"
}

test "the front door can tell an interface from a diagram" {
  expect ui_wants("design a landing page for my bakery")
  expect ui_wants("make me a mobile app UI for a running club")
  expect ui_wants("an agent window for Kosi")
  expect not ui_wants("how does the heart pump blood")
  expect not ui_wants("compare Rust and Go")
}

test "theme and accent follow the person's words first" {
  expect ui_theme(ui_ask("a dark mode music app"), "light") == "dark"
  expect ui_theme(ui_ask("a music app"), "dark") == "dark"
  expect ui_theme(ui_ask("a music app"), "") == "dark"
  expect ui_theme(ui_ask("a minimal music app"), "") == "light minimal"
  expect ui_theme(ui_ask("a calm notes app, dark mode, minimalist"), "light") == "dark minimal"
  expect ui_theme(ui_ask("a vivid music app"), "light minimal") == "light"
  expect ui_style("dark") == "vivid"
  expect ui_mode("dark minimal") == "dark"
  expect ui_accent_named(ui_ask("a green finance app"), "indigo") == "emerald"
  expect ui_accent_named(ui_ask("a finance app"), "teal") == "teal"
  expect ui_accent_names().contains(ui_accent_named(ui_ask("a finance app"), "chartreuse"))
  expect ui_accent_named(ui_ask("a finance app"), "") == ui_accent_named(ui_ask("a finance app"), "")
}

test "unknown icons are matched to ones Kosika draws" {
  expect ui_icon_like("gear") == "settings"
  expect ui_icon_like("Profile") == "user"
  expect ui_icon_like("home") == "home"
  expect ui_icon_like("a unicorn") == "dot"
  expect ui_icon("bolt").contains("<path")
}

test "Kosika drops what does not belong and puts bars in their places" {
  said: UiSpec = {target: "phone", title: "Runs", brand: "Stride", accent: "emerald", theme: "", look: ui_no_look(), screens: [{name: "Home", blocks: [
    ui_block("tabbar", "", "", "", "", [ui_item("Home", "", "", "home"), ui_item("Runs", "", "", "trend")]),
    ui_block("pricing", "Plans", "", "", "", []),
    ui_block("sparkles", "x", "", "", "", []),
    ui_block("list", "Recent runs", "", "", "", [ui_item("Morning loop", "5.2 km", "28 min", "pin")])
  ]}]}
  c = ui_checked(ui_ask("a running app for my phone"), said)
  kinds = for b in c.spec.screens[0].blocks { b.kind }
  expect kinds == ["appbar", "list", "tabbar"]
  expect c.fixed.length() == 3
}

test "with no model answer Kosika still lays out a screen" {
  c = ui_checked(ui_ask("a landing page for a quiet coffee shop"), ui_no_spec())
  expect c.spec.target == "web"
  expect c.spec.screens[0].blocks[0].kind == "nav"
  expect c.spec.screens[0].blocks[1].title == "Quiet coffee shop"
  p = ui_checked(ui_ask("an agent window for a research assistant"), ui_no_spec())
  expect p.spec.screens[0].blocks[0].kind == "sidebar"
}

test "long text is cut at a word" {
  expect ui_cut("A calm place to drink very good coffee", 20) == "A calm place to…"
  expect ui_cut("short", 20) == "short"
}

test "the page holds the design in its frame" {
  r = ui_result(ui_ask("a mobile app for learning Japanese"), ui_no_spec())
  expect r.page.contains("class=\"phone\"")
  expect r.page.contains("class=\"tabbar\"")
  w = ui_result(ui_ask("a website for a bakery"), ui_no_spec())
  expect w.page.contains("class=\"browser\"")
}

test "a design's parts can be bound to workflows, and only real ones are" {
  spec = ui_starter(ui_ask("an agent window for a research assistant"))
  binds: UiBind[] = [
    {block: "composer", workflow: "answer", input: "", field: "", every: 0},
    {block: "activity", workflow: "", input: "", field: "plan", every: 0},
    {block: "pricing", workflow: "x", input: "", field: "", every: 0},
    {block: "stats", workflow: "s", input: "", field: "", every: 0},
    {block: "progress", workflow: "rm -rf", input: "", field: "", every: 0}
  ]
  c = ui_binds_checked(spec, binds)
  expect (for b in c.binds { b.block }) == ["composer", "activity"]
  expect c.binds[0].input == "ask"
  expect c.fixed.length() == 3
}

test "a running design carries its runtime and its binds" {
  r = ui_app_result({ask: ui_ask("an agent window for a research assistant"), spec: ui_no_spec(), binds: [{block: "composer", workflow: "answer", input: "say", field: "", every: 0}]})
  expect r.page.contains("window.KOSIKA_LIVE")
  expect r.page.contains("workflow:'answer'")
  expect r.page.contains("data-kind=\"composer\"")
  expect r.page.contains("<body data-live")
}

test "text in a script cannot close it" {
  expect ui_js("a'b</script>") == "'a\\'b\\u003c/script>'"
}

test "charts draw from the values written" {
  expect ui_number("$1,200.5k") == 1200.5
  expect ui_number("92%") == 92
  expect ui_chart_kind(ui_block("chart", "", "", "donut", "", [])) == "ring"
  expect ui_chart(ui_block("chart", "Focus", "", "bar", "", [ui_item("Mon", "", "2h", ""), ui_item("Tue", "", "4h", "")])).contains("height:50%")
  expect ui_chart(ui_block("chart", "Done", "", "ring", "", [ui_item("Maths", "", "75%", "")])).contains("stroke-dasharray=\"75 100\"")
  expect ui_chart(ui_block("chart", "Week", "", "area", "", [ui_item("Mon", "", "3", ""), ui_item("Tue", "", "5", ""), ui_item("Wed", "", "4", "")])).contains("class=\"ln\"")
}

test "vivid is the default and carries its motion; minimal carries none" {
  vivid = ui_result(ui_ask("a website for a quiet coffee shop"), ui_no_spec())
  expect vivid.spec.theme == "dark"
  expect vivid.page.contains("data-style=\"vivid\"")
  expect vivid.page.contains("prefers-reduced-motion")
  expect vivid.page.contains("IntersectionObserver")
  calm = ui_result(ui_ask("a minimal website for a quiet coffee shop"), ui_no_spec())
  expect calm.spec.theme == "light minimal"
  expect calm.page.contains("data-style=\"minimal\"")
  expect not calm.page.contains("IntersectionObserver")
}

test "the look is the model's where it is readable, and Kosika's where it is missing" {
  l = ui_look_checked({colours: ["#C0703A", "nope", "#2f6"], shape: "SHARP", art: "waves", font: "editorial"}, 42)
  expect l.colours == ["#c0703a", "#22ff66"]
  expect l.shape == "sharp"
  expect l.art == "waves"
  expect l.font == "editorial"
  filled = ui_look_checked(ui_no_look(), 42)
  expect ui_arts().contains(filled.art)
  expect ui_fonts().contains(filled.font)
  expect contrast(ui_fit("#1a1a40", true), "#0b0b0f") >= 5.5
  expect contrast(ui_fit("#ffe08a", false), "#ffffff") >= 4.6
  expect ui_seed("a coffee shop") == ui_seed("a coffee shop")
  expect ui_seed("a coffee shop") != ui_seed("a tea shop")
}

test "every art is drawn, and the art block draws the shapes asked for" {
  expect (for a in ui_arts() where not ui_backdrop(a, 7).contains("art-bg a-" + a) { a }).is_empty()
  expect ui_backdrop("none", 7) == ""
  s = ui_result(ui_ask("a website for a kite festival"), ui_no_spec()).spec
  b = ui_block("art", "Kites", "", "", "", [ui_item("star7", "partner", "0.2 0.4 0.2", "spin"), ui_item("hexagon", "#ff8800", "", "float"), ui_item("spiral", "accent", "", "")])
  html = ui_art(b, s)
  expect html.contains("m-spin")
  expect html.contains("fill:#ff8800")
  expect html.contains("ln2")
}

test "Kosika makes short changes from the words alone" {
  base = ui_result(ui_ask("a website for a kite festival"), ui_no_spec()).spec
  warm = ui_edit_local(base, "make it warmer")
  expect warm.understood
  expect warm.spec.look.colours.length() == 2
  green = ui_edit_local(base, "green and gold please")
  expect green.spec.look.colours == ["#30a46c", "#d4a72c"]
  light = ui_edit_local(base, "light and minimal")
  expect light.spec.theme == "light minimal"
  art = ui_edit_local(base, "waves behind it, serif type, sharp corners")
  expect art.spec.look.art == "waves"
  expect art.spec.look.font == "editorial"
  expect art.spec.look.shape == "sharp"
  priced = ui_edit_local(base, "add pricing")
  expect ui_all_blocks(priced.spec).contains("pricing")
  expect ui_all_blocks(priced.spec)[ui_all_blocks(priced.spec).length() - 1] == "footer"
  gone = ui_edit_local(base, "remove the features")
  expect not ui_all_blocks(gone.spec).contains("features")
  expect not ui_edit_local(base, "hmm").understood
  expect ui_edit_route(warm, "make it warmer") == "kosika"
  expect ui_edit_route(ui_edit_local(base, "rewrite the headline to be about night flying"), "rewrite the headline to be about night flying") == "model"
}

test "an edit is not undone by the first ask's words" {
  e: UiEdit = {ask: ui_ask("a dark website for a kite festival"), spec: ui_result(ui_ask("a dark website for a kite festival"), ui_no_spec()).spec, change: "light"}
  r = ui_edit_result(e, ui_edit_local(e.spec, "light"), ui_no_spec())
  expect r.spec.theme == "light"
  expect r.fixed[0] == "made it light"
  expect ui_spec_json(r.spec).contains("\"theme\":\"light\"")
}

test "new designs lean toward the looks the person liked" {
  liked: UiLike = {look: {colours: ["#ff4d4d", "#0077b6"], shape: "round", art: "rings", font: "editorial"}, theme: "light", ask: "a kite festival"}
  l = ui_lean(ui_no_look(), [liked, liked])
  expect l.colours == ["#ff4d4d", "#0077b6"]
  expect l.art == "rings"
  expect l.font == "editorial"
  own = ui_lean({colours: ["#30a46c"], shape: "", art: "waves", font: ""}, [liked])
  expect own.colours == ["#30a46c"]
  expect own.art == "waves"
  expect own.shape == "round"
  expect ui_taste_text([liked]).contains("rings art")
  r = ui_taste_result({ask: ui_ask("a website for a surf school"), likes: [liked]}, ui_no_spec())
  expect r.spec.look.art == "rings"
}

fn ui_app_ok(m: UiAppMade) -> Bool {
  return m.files.length() == 4 and m.page.contains("<body data-app ") and m.files[1].text.contains("standalone") and m.files[2].text.contains("kosika-app-")
}

test "a design becomes an app that works on its own" {
  expect ui_app_ok(ui_app_from(ui_ask("a phone app for my reading list"), ui_no_spec()))
}

test "a label that ends with a screen's name links to it, and shows the label alone" {
  expect ui_unlink("Start lesson > Lesson", ["today", "lesson"]) == "Start lesson"
  expect ui_link_of("Start lesson > Lesson", ["today", "lesson"]) == "Lesson"
  expect ui_unlink("x > 5", ["today"]) == "x > 5"
  expect ui_unlink_action("Get tickets > Tickets|Programme", ["tickets"]) == "Get tickets|Programme"
}

fn ui_page_css(page: Text) -> Text { return (for part in page.split("<style>").drop(1) { part.split("</style>")[0] }).join("") }

test "the motion Designs draws passes motion_check" {
  expect motion_check(ui_page_css(ui_result(ui_ask("a landing page for a kite festival"), ui_starter(ui_ask("a landing page for a kite festival"))).page)) == []
}
