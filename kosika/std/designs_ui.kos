  if name == "file" { return "<path d='M7 3.5h7l4.5 4.5v11.5a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1z'/><path d='M14 3.5V8h4.5M9 13h6M9 16.5h4'/>" }
  if name == "image" { return "<rect x='3.5' y='4.5' width='17' height='15' rx='2.5'/><circle cx='9' cy='9.5' r='1.7'/><path d='m4 17 5-4.5 4 3.5 3-2.5 4 3.5'/>" }
  if name == "cpu" { return "<rect x='6.5' y='6.5' width='11' height='11' rx='2'/><path d='M9.5 3.5v3M14.5 3.5v3M9.5 17.5v3M14.5 17.5v3M3.5 9.5h3M3.5 14.5h3M17.5 9.5h3M17.5 14.5h3'/>" }
  if name == "wallet" { return "<path d='M4 8a2.5 2.5 0 0 1 2.5-2.5h11V8.5'/><rect x='4' y='8.5' width='16.5' height='11' rx='2.5'/><circle cx='16' cy='14' r='1.2'/>" }
  if name == "cart" { return "<path d='M3.5 4.5h2.2l2 11h10.3l1.8-8H7'/><circle cx='9.5' cy='19.5' r='1.3'/><circle cx='16.5' cy='19.5' r='1.3'/>" }
  if name == "more" { return "<circle cx='6' cy='12' r='1.3' class='f'/><circle cx='12' cy='12' r='1.3' class='f'/><circle cx='18' cy='12' r='1.3' class='f'/>" }
