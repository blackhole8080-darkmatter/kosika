  if name == "agent" { return "<rect x='4.5' y='8' width='15' height='11' rx='3.5'/><path d='M12 4.5V8M9.5 12.5v1.5M14.5 12.5v1.5'/><circle cx='12' cy='3.8' r='1'/>" }
  if name == "terminal" { return "<rect x='3.5' y='5' width='17' height='14' rx='2.5'/><path d='m7.5 10 2.5 2-2.5 2M12.5 14.5h4'/>" }
  if name == "download" { return "<path d='M12 4v11M7 10.5l5 5 5-5M5 19.5h14'/>" }
