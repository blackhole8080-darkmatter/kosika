// Kosika Designs: interfaces. Websites, phone screens, agent windows and
// artifacts, designed from one sentence.
//
//   kosika run kosika/std/designs_ui.kos --workflow design_ui --input ask.json
//       --model openai/gpt-oss-120b --model-url https://api.groq.com/openai/v1
//       --model-protocol openai --max-output-tokens 8000
//
// where ask.json holds
//   {"ask": {"text": "a landing page for a quiet coffee shop", "target": "",
//            "theme": "", "accent": ""}}
//
// The model only writes what the screen says and which blocks it is made
// of: a nav, a hero, cards, a list, a chat, a tab bar. Kosika decides how
// every block looks. One design system, owned by code, draws them all:
// one type scale, one spacing scale, one radius scale, hairline borders,
// soft shadows, one accent and line icons drawn here. So whatever the
// model writes, the result looks calm, modern and finished, the same way
// every time, and a small or offline model can design as well as a big one.
//
// Kosika checks the description before drawing it, and says what it fixed:
// unknown blocks are dropped, text too long for its place is shortened,
// unknown icons are matched to known ones, a phone gets a title bar and a
// tab bar in their places, and an accent is used only if its contrast
// passes WCAG against the surface it sits on (contrast() in
// designs_palette.kos).
//
// targets   web       a website or landing page, in a browser window
//           phone     one to three phone screens, side by side
//           agent     an agent's window: sidebar, conversation, live panel
//           artifact  a single card: a report, a widget, a summary
//
// With no model answer at all (offline, or the model failed), Kosika still
// designs: ui_starter lays out a sensible screen for the target from the
// words of the ask.
//
// Other programs reuse the parts: ui_icon(name) gives an icon as SVG,
// ui_icon_names() lists them, ui_tokens_css() gives the spacing, radius
// and type scales as CSS variables (no colours: those stay with the
// Designs palettes), ui_render_spec draws a description without a model.

import "designs_palette.kos"

export [UiAsk, UiItem, UiBlock, UiScreen, UiSpec, UiResult, UiDraw, UiBind, UiApp, design_ui, ui_render, ui_app, ui_live_page, ui_binds_checked, ui_result, ui_target, ui_theme, ui_checked, ui_starter, ui_page, ui_icon, ui_icon_names, ui_tokens_css, ui_kinds, ui_accents, ui_accent_problems, ui_wants]

record UiAsk { text: Text target: Text theme: Text accent: Text }
record UiItem { title: Text text: Text meta: Text icon: Text }
record UiBlock { kind: Text title: Text text: Text meta: Text action: Text items: UiItem[] }
record UiScreen { name: Text blocks: UiBlock[] }
record UiSpec { target: Text title: Text brand: Text accent: Text theme: Text screens: UiScreen[] }
record UiResult { target: Text title: Text spec: UiSpec page: Text fixed: Text[] problems: Text[] }
record UiDraw { ask: UiAsk spec: UiSpec }
// A design that runs: each bind ties one block to a Kosika workflow.
//   block     composer, activity, progress, stats or list
//   workflow  the workflow to run; for a composer, run on send with what was
//             typed; for the others, run when the page opens and after each
//             send. Empty: the block is filled from the composer's last reply.
//   input     the name of the workflow's input (its one parameter), a record
//             with text: Text
//   field     where the items are in the answer (default items), a UiItem[]
//   every     also run it every so many seconds (0: never)
record UiBind { block: Text workflow: Text input: Text field: Text every: Number }
record UiApp { ask: UiAsk spec: UiSpec binds: UiBind[] }
record UiBrief { task: Text ask: Text target: Text problems: Text }
record UiAccent { name: Text light: Text dark: Text }

model ui_designer {
  input: UiBrief
  output: UiSpec
  parameters: {
    max_output_tokens: 7000
  }
}

// ---------------------------------------------------------------- what it can draw

fn ui_targets() -> Text[] { return ["web", "phone", "agent", "artifact"] }

fn ui_kinds() -> Text[] { return ["nav", "hero", "features", "stats", "cards", "list", "steps", "pricing", "quote", "cta", "footer", "form", "appbar", "search", "chips", "tabbar", "chat", "composer", "activity", "progress", "sidebar", "table"] }

// Which blocks belong on which target.
fn ui_allowed(target: Text) -> Text[] {
  if target == "phone" { return ["appbar", "hero", "search", "chips", "stats", "cards", "list", "steps", "progress", "activity", "chat", "form", "quote", "cta", "composer", "tabbar", "features", "table"] }
  if target == "agent" { return ["sidebar", "appbar", "chat", "composer", "activity", "progress", "stats", "list", "cards", "steps", "chips", "search", "form", "table"] }
  if target == "artifact" { return ["appbar", "hero", "stats", "cards", "list", "steps", "progress", "activity", "chips", "quote", "table", "features", "cta", "form"] }
  return ["nav", "hero", "features", "stats", "cards", "list", "steps", "pricing", "quote", "cta", "footer", "form", "table", "chips", "search"]
}

fn ui_most_blocks(target: Text) -> Number {
  if target == "phone" { return 7 }
  if target == "agent" { return 9 }
  if target == "artifact" { return 6 }
  return 10
}

fn ui_most_items(kind: Text) -> Number {
  if kind == "chips" { return 8 }
  if kind == "tabbar" { return 5 }
  if kind == "chat" { return 8 }
  if kind == "sidebar" { return 8 }
  if kind == "nav" { return 5 }
  if kind == "pricing" { return 3 }
  if kind == "stats" { return 4 }
  if kind == "table" { return 7 }
  return 6
}

// One accent, in a light-theme and a dark-theme shade.
fn ui_accents() -> UiAccent[] {
  return [
    {name: "indigo", light: "#4f46e5", dark: "#818cf8"},
    {name: "violet", light: "#7c3aed", dark: "#a78bfa"},
    {name: "blue", light: "#2563eb", dark: "#60a5fa"},
    {name: "sky", light: "#0369a1", dark: "#38bdf8"},
    {name: "teal", light: "#0f766e", dark: "#2dd4bf"},
    {name: "emerald", light: "#047857", dark: "#34d399"},
    {name: "amber", light: "#b45309", dark: "#fbbf24"},
    {name: "orange", light: "#c2410c", dark: "#ff8a4c"},
    {name: "rose", light: "#e11d48", dark: "#fb7185"},
    {name: "graphite", light: "#18181b", dark: "#f4f4f5"}
  ]
}

fn ui_accent_names() -> Text[] { return for a in ui_accents() { a.name } }

fn ui_accent(name: Text) -> UiAccent {
  let all = ui_accents()
  for a in all {
    if a.name == name.trim().lower() { return a }
  }
  return all[0]
}

// The surfaces every accent must read against.
fn ui_light_surface() -> Text { return "#ffffff" }
fn ui_dark_surface() -> Text { return "#141417" }

// What text sits on the accent: white or near-black, whichever reads better.
fn ui_on(colour: Text) -> Text {
  return if contrast(colour, "#ffffff") >= contrast(colour, "#0b0b0f") { "#ffffff" } else { "#0b0b0f" }
}

// Every accent checked by Kosika's own WCAG arithmetic: 3 to 1 against
// its surface, for shapes and large text, and 4.5 to 1 for the words on it.
fn ui_accent_problems() -> Text[] {
  var wrong: Text[] = []
  for a in ui_accents() {
    if contrast(a.light, ui_light_surface()) < 3 { wrong = wrong.append(a.name + " is too faint on white") }
    if contrast(a.dark, ui_dark_surface()) < 3 { wrong = wrong.append(a.name + " is too faint on the dark surface") }
    if contrast(a.light, ui_on(a.light)) < 4.5 { wrong = wrong.append(a.name + " has no readable text colour in light") }
    if contrast(a.dark, ui_on(a.dark)) < 4.5 { wrong = wrong.append(a.name + " has no readable text colour in dark") }
  }
  return wrong
}

// ---------------------------------------------------------------- reading the ask

fn ui_padded(text: Text) -> Text { return " " + text.lower().trim().trim_marks("?!.") + " " }

fn ui_any(t: Text, words: Text[]) -> Bool {
  for w in words {
    if t.contains(w) { return true }
  }
  return false
}

fn ui_phone_words() -> Text[] { return [" phone", " mobile", " iphone", " android", " ios ", " app screen", " app ui", " app design", " onboarding", " mobile app", " smartphone"] }
fn ui_agent_words() -> Text[] { return [" agent window", " agent's window", " agent ui", " agent interface", " agent app", " assistant window", " chat window", " chatbot", " copilot", " agent dashboard", " ai agent", " agents window", " agent console", " agent screen"] }
fn ui_artifact_words() -> Text[] { return [" artifact", " widget", " card ", " report card", " summary card", " one card", " single card", " receipt", " invoice", " ticket"] }
fn ui_web_words() -> Text[] { return [" website", " web site", " landing page", " homepage", " home page", " web page", " webpage", " portfolio site", " web app", " saas", " dashboard", " admin panel", " blog", " pricing page", " login page", " sign up page", " signup page"] }

// Does the ask want an interface designed? The front door asks this.
fn ui_wants(text: Text) -> Bool {
  let t = ui_padded(text)
  if ui_any(t, ui_web_words()) or ui_any(t, ui_agent_words()) { return true }
  if ui_any(t, [" ui ", " ux ", " user interface", " mockup", " mock-up", " wireframe", " app screen", " screen design", " app design", " design an app", " design a app", " design a screen", " design the screen", " mobile app", " phone app", " iphone app", " android app", " settings screen", " login screen", " onboarding screen", " home screen for"]) { return true }
  return false
}

// The target named by the ask's words, else the one asked, else web.
fn ui_target(ask: UiAsk) -> Text {
  let named = ask.target.trim().lower()
  if ui_targets().contains(named) { return named }
  let t = ui_padded(ask.text)
  if ui_any(t, ui_agent_words()) { return "agent" }
  if ui_any(t, ui_phone_words()) { return "phone" }
  if ui_any(t, ui_web_words()) { return "web" }
  if ui_any(t, ui_artifact_words()) { return "artifact" }
  if ui_any(t, [" app "]) { return "phone" }
  return "web"
}

fn ui_theme(ask: UiAsk, said: Text) -> Text {
  let named = ask.theme.trim().lower()
  if named == "light" or named == "dark" { return named }
  let t = ui_padded(ask.text)
  if ui_any(t, [" dark ", " dark mode", " dark theme", " night ", " black "]) { return "dark" }
  if ui_any(t, [" light ", " light mode", " light theme", " white "]) { return "light" }
  let s = said.trim().lower()
  return if s == "dark" { "dark" } else { "light" }
}

fn ui_accent_named(ask: UiAsk, said: Text) -> Text {
  let named = ask.accent.trim().lower()
  if ui_accent_names().contains(named) { return named }
  let t = ui_padded(ask.text)
  for a in ui_accent_names() {
    if t.contains(" " + a + " ") { return a }
  }
  if ui_any(t, [" purple "]) { return "violet" }
  if ui_any(t, [" green "]) { return "emerald" }
  if ui_any(t, [" red ", " pink "]) { return "rose" }
  if ui_any(t, [" black and white", " monochrome", " grey ", " gray "]) { return "graphite" }
  if ui_any(t, [" dark matter"]) { return "orange" }
  let s = said.trim().lower()
  return if ui_accent_names().contains(s) { s } else { "indigo" }
}

// ---------------------------------------------------------------- icons

fn ui_icon_names() -> Text[] { return ["home", "search", "user", "users", "chat", "bell", "settings", "plus", "check", "spark", "bolt", "chart", "trend", "calendar", "book", "play", "heart", "star", "lock", "globe", "code", "folder", "mail", "arrow", "back", "chevron", "phone", "camera", "pin", "music", "sun", "moon", "cloud", "leaf", "shield", "grid", "layers", "clock", "send", "mic", "file", "image", "cpu", "wallet", "cart", "more", "menu", "close", "agent", "terminal", "download", "link", "eye", "bookmark", "coffee", "flame", "dot"] }

fn ui_icon_body(name: Text) -> Text {
  if name == "home" { return "<path d='M4 10.5 12 4l8 6.5V19a1.5 1.5 0 0 1-1.5 1.5H15v-6H9v6H5.5A1.5 1.5 0 0 1 4 19z'/>" }
  if name == "search" { return "<circle cx='11' cy='11' r='6.5'/><path d='m16 16 4 4'/>" }
  if name == "user" { return "<circle cx='12' cy='8.5' r='3.5'/><path d='M5 20c1.2-3.6 4-5.5 7-5.5s5.8 1.9 7 5.5'/>" }
  if name == "users" { return "<circle cx='9' cy='9' r='3.2'/><path d='M3.5 19.5c.9-3.2 3-4.8 5.5-4.8s4.6 1.6 5.5 4.8'/><path d='M15.5 6.2a3.2 3.2 0 0 1 0 6M17 14.9c1.8.5 3 1.9 3.5 4.6'/>" }
  if name == "chat" { return "<path d='M5.5 5h13A1.5 1.5 0 0 1 20 6.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4.5 3.5V17h0A1.5 1.5 0 0 1 4 15.5v-9A1.5 1.5 0 0 1 5.5 5z'/>" }
  if name == "bell" { return "<path d='M6 16v-5a6 6 0 0 1 12 0v5l1.5 2h-15z'/><path d='M10 20.5a2 2 0 0 0 4 0'/>" }
  if name == "settings" { return "<path d='M4 7h9M17 7h3M4 17h3M11 17h9'/><circle cx='15' cy='7' r='2'/><circle cx='9' cy='17' r='2'/>" }
  if name == "plus" { return "<path d='M12 5v14M5 12h14'/>" }
  if name == "check" { return "<path d='m5 12.5 4.5 4.5L19 7.5'/>" }
  if name == "spark" { return "<path d='M12 3.5 13.8 10.2 20.5 12l-6.7 1.8L12 20.5l-1.8-6.7L3.5 12l6.7-1.8z'/>" }
  if name == "bolt" { return "<path d='M13 3 5 13.5h6L10.5 21 19 10h-6z'/>" }
  if name == "chart" { return "<path d='M4 20h16'/><path d='M7 16v-5M12 16V7M17 16v-8'/>" }
  if name == "trend" { return "<path d='m4 17 5.5-5.5 4 4L20 9'/><path d='M15 9h5v5'/>" }
  if name == "calendar" { return "<rect x='4' y='5.5' width='16' height='14.5' rx='2.5'/><path d='M4 10h16M8.5 3.5v4M15.5 3.5v4'/>" }
  if name == "book" { return "<path d='M5 5.5A1.5 1.5 0 0 1 6.5 4H18v13H7a2 2 0 0 0-2 2z'/><path d='M5 19a2 2 0 0 0 2 2h11v-4'/>" }
  if name == "play" { return "<path d='M8 5.5v13l10.5-6.5z'/>" }
  if name == "heart" { return "<path d='M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z'/>" }
  if name == "star" { return "<path d='m12 3.8 2.5 5.2 5.7.8-4.1 4 1 5.6-5.1-2.7-5.1 2.7 1-5.6-4.1-4 5.7-.8z'/>" }
  if name == "lock" { return "<rect x='5' y='10.5' width='14' height='10' rx='2.5'/><path d='M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5'/>" }
  if name == "globe" { return "<circle cx='12' cy='12' r='8.5'/><path d='M3.5 12h17M12 3.5c2.4 2.5 3.6 5.3 3.6 8.5s-1.2 6-3.6 8.5c-2.4-2.5-3.6-5.3-3.6-8.5S9.6 6 12 3.5z'/>" }
  if name == "code" { return "<path d='m8.5 8-4 4 4 4M15.5 8l4 4-4 4M13.5 5.5l-3 13'/>" }
  if name == "folder" { return "<path d='M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z'/>" }
  if name == "mail" { return "<rect x='3.5' y='5.5' width='17' height='13' rx='2.5'/><path d='m4.5 7.5 7.5 5.5 7.5-5.5'/>" }
  if name == "arrow" { return "<path d='M5 12h14M13 6l6 6-6 6'/>" }
  if name == "back" { return "<path d='m14.5 5.5-6.5 6.5 6.5 6.5'/>" }
  if name == "chevron" { return "<path d='m9.5 6 6 6-6 6'/>" }
  if name == "phone" { return "<rect x='7' y='3' width='10' height='18' rx='2.5'/><path d='M11 18h2'/>" }
  if name == "camera" { return "<path d='M4 8.5a2 2 0 0 1 2-2h2l1.5-2h5l1.5 2h2a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z'/><circle cx='12' cy='13' r='3.5'/>" }
  if name == "pin" { return "<path d='M12 21s6.5-5.6 6.5-11a6.5 6.5 0 0 0-13 0c0 5.4 6.5 11 6.5 11z'/><circle cx='12' cy='10' r='2.3'/>" }
