// Kosika Science, molecules: drawn from their formulas, and a reaction
// played atom by atom.
//
//   import "std/science_molecules.kos"
//
// A small molecule is drawn around its central atom: the atom there is the
// one other than hydrogen that appears once, and the rest sit around it,
// bent for water's oxygen, straight for carbon dioxide's carbon, spread
// evenly otherwise. Two-atom molecules get the bond their atoms need (O=O,
// N≡N). A larger molecule is drawn as its atoms packed together.
//
// A balanced reaction (science_chem.kos) is then played: every copy of
// every molecule on the left is drawn, every atom flies to its place in a
// molecule on the right, and Kosika matches the atoms element by element,
// so the same atoms are seen to leave and arrive: nothing is made, nothing
// is lost.

import "science_chem.kos"

export [sm_reaction_svg, sm_style, sm_molecule_svg]

// ---------------------------------------------------------------- how atoms look

fn sm_colour(e: Text) -> Text {
  let names = ["H", "C", "N", "O", "F", "Cl", "Br", "I", "S", "P", "Na", "K", "Ca", "Mg", "Fe", "Cu", "Zn", "Al", "Si", "Ag", "Au"]
  let colours = ["#f4f4f5", "#4b5563", "#3b82f6", "#ef4444", "#86efac", "#22c55e", "#a16207", "#7c3aed", "#facc15", "#fb923c", "#a78bfa", "#c084fc", "#94a3b8", "#4ade80", "#ea580c", "#f59e0b", "#94a3b8", "#cbd5e1", "#d6b38a", "#e5e7eb", "#fbbf24"]
  let at = names.index_of(e).or(-1)
  return if at < 0 { "#e879f9" } else { colours[at] }
}

fn sm_radius(e: Text) -> Number { return if e == "H" { 10 } else { 15 } }

// How many bonds an atom usually makes, for a two-atom molecule's bond.
fn sm_valence(e: Text) -> Number {
  if ["H", "F", "Cl", "Br", "I", "Na", "K", "Ag"].contains(e) { return 1 }
  if ["O", "S", "Ca", "Mg", "Zn", "Cu"].contains(e) { return 2 }
  if ["N", "P", "Al", "Fe"].contains(e) { return 3 }
  return 4
}

// ---------------------------------------------------------------- a molecule's shape

// The atoms of one molecule, each with its place: x, y, x, y ... in units
// of one bond, the first atom at the middle; and its bonds as pairs of
// atom numbers, with how many lines each.
record SmShape { els: Text[] xy: Number[] bonds: Number[] }

fn sm_list(a: ScAtoms) -> Text[] {
  var out: Text[] = []
  for i in 0 until a.els.length() {
    for k in 0 until a.ns[i] { out = out.append(a.els[i]) }
  }
  return out
}

fn sm_shape(formula: Text) -> SmShape {
  let a = sc_atoms(formula)
  let atoms = sm_list(a)
  let n = atoms.length()
  if n == 1 { return {els: atoms, xy: [0, 0], bonds: []} }
  if n == 2 {
    let order = sm_valence(atoms[0]).min(sm_valence(atoms[1]))
    return {els: atoms, xy: [-0.55, 0, 0.55, 0], bonds: [0, 1, order]}
  }
  // a centre: the heavy atom that appears once, or failing that any heavy atom
  var centre = -1
  for i in 0 until a.els.length() {
    if centre < 0 and a.els[i] != "H" and a.ns[i] == 1 { centre = i }
  }
  if centre >= 0 and n <= 6 {
    let middle = a.els[centre]
    var others: Text[] = []
    var taken = false
    for e in atoms {
      if e == middle and not taken { taken = true } else { others = others.append(e) }
    }
    let m = others.length()
    let bent = m == 2 and (middle == "O" or middle == "S")
    var xy: Number[] = [0, 0]
    var bonds: Number[] = []
    for k in 0 until m {
      let deg = if bent { 90 + (k * 2 - 1) * 52.25 } else { 360 * k / m - 90 + (if m == 2 { 90 } else { 0 }) }
      xy = xy.concat([deg.cos(), deg.sin()])
      let order = if m <= 2 and middle == "C" and others[k] == "O" { 2 } else { 1 }
      bonds = bonds.concat([0, k + 1, order])
    }
    return {els: [middle].concat(others), xy: xy, bonds: bonds}
  }
  // otherwise its atoms packed in a small honeycomb, heavy atoms first
  let heavy = for e in atoms where e != "H" { e }
  let light = for e in atoms where e == "H" { e }
  let packed = heavy.concat(light)
  let across = (packed.length().sqrt()).ceil().max(2)
  var xy: Number[] = []
  for k in 0 until packed.length() {
    let row = (k / across).floor()
    let col = k % across
    xy = xy.concat([(col - (across - 1) / 2 + (row % 2) * 0.5) * 0.85, (row - (packed.length() / across).floor() / 2) * 0.75])
  }
  return {els: packed, xy: xy, bonds: []}
}

// ---------------------------------------------------------------- drawing

fn sm_atom(e: Text, x: Number, y: Number) -> Text {
  let r = sm_radius(e)
  let ink = if e == "H" or e == "S" or e == "Cl" or e == "F" { "#111" } else { "#fff" }
  return f"<g><circle class=\"sm-a\" cx=\"{sm_n(x)}\" cy=\"{sm_n(y)}\" r=\"{r}\" style=\"fill:{sm_colour(e)}\"/><text class=\"sm-t\" x=\"{sm_n(x)}\" y=\"{sm_n(y + 4)}\" style=\"fill:{ink}\">{e}</text></g>"
}

fn sm_n(x: Number) -> Text { return x.to_fixed(1) }

fn sm_bond_lines(x1: Number, y1: Number, x2: Number, y2: Number, order: Number) -> Text {
  let dx = x2 - x1
  let dy = y2 - y1
  let len = (dx * dx + dy * dy).sqrt().max(0.001)
  let px = 0 - dy / len * 4
  let py = dx / len * 4
  let offsets = if order == 1 { [0] } else if order == 2 { [-0.5, 0.5] } else { [-1, 0, 1] }
  return (for o in offsets { f"<line class=\"sm-b\" x1=\"{sm_n(x1 + px * o)}\" y1=\"{sm_n(y1 + py * o)}\" x2=\"{sm_n(x2 + px * o)}\" y2=\"{sm_n(y2 + py * o)}\"/>" }).join("")
}

fn sm_bonds(s: SmShape, cx: Number, cy: Number, size: Number) -> Text {
  var out = ""
  for k in 0 until (s.bonds.length() / 3).floor() {
    let i = s.bonds[3 * k]
    let j = s.bonds[3 * k + 1]
    out = out + sm_bond_lines(cx + s.xy[2 * i] * size, cy + s.xy[2 * i + 1] * size, cx + s.xy[2 * j] * size, cy + s.xy[2 * j + 1] * size, s.bonds[3 * k + 2])
  }
  return out
}

// One molecule, still, centred at cx, cy.
fn sm_molecule_svg(formula: Text, cx: Number, cy: Number) -> Text {
  let s = sm_shape(formula)
  let size = 40
  let atoms = (for k in 0 until s.els.length() { sm_atom(s.els[k], cx + s.xy[2 * k] * size, cy + s.xy[2 * k + 1] * size) }).join("")
  return sm_bonds(s, cx, cy, size) + atoms
}

// Where each copy of each molecule on one side sits: centres spread over
// the side's half of the picture, in rows.
fn sm_centres(count: Number, left: Number, width: Number, height: Number) -> Number[] {
  let across = (count.sqrt()).ceil().max(1)
  let rows = (count / across).ceil()
  var out: Number[] = []
  for k in 0 until count {
    let row = (k / across).floor()
    let col = k % across
    out = out.concat([left + width * (col + 0.5) / across, 60 + (height - 90) * (row + 0.5) / rows])
  }
  return out
}

// The reaction, played: the left side's molecules come apart and every
// atom flies to its place in the right side's molecules, matched element
// by element; then the right side's bonds form. It loops, slowly.
fn sm_reaction_svg(b: ScBalanced) -> Text {
  if not b.ok { return "" }
  let w = 960
  let h = 400
  let size = 40
  // every copy of every molecule, with its side
  var formulas: Text[] = []
  var sides: Number[] = []
  for k in 0 until b.species.length() {
    for c in 0 until b.coefficients[k] {
      formulas = formulas.append(b.species[k])
      sides = sides.append(b.sides[k])
    }
  }
  let lefts = for k in 0 until formulas.length() where sides[k] > 0 { formulas[k] }
  let rights = for k in 0 until formulas.length() where sides[k] < 0 { formulas[k] }
  let lc = sm_centres(lefts.length(), 20, 400, h)
  let rc = sm_centres(rights.length(), 540, 400, h)
  // the atoms on each side, with their places
  var le: Text[] = []
  var lx: Number[] = []
  var ly: Number[] = []
  var lbonds = ""
  for k in 0 until lefts.length() {
    let s = sm_shape(lefts[k])
    lbonds = lbonds + sm_bonds(s, lc[2 * k], lc[2 * k + 1], size)
    for q in 0 until s.els.length() {
      le = le.append(s.els[q])
      lx = lx.append(lc[2 * k] + s.xy[2 * q] * size)
      ly = ly.append(lc[2 * k + 1] + s.xy[2 * q + 1] * size)
    }
  }
  var re: Text[] = []
  var rx: Number[] = []
  var ry: Number[] = []
  var rbonds = ""
  for k in 0 until rights.length() {
    let s = sm_shape(rights[k])
    rbonds = rbonds + sm_bonds(s, rc[2 * k], rc[2 * k + 1], size)
    for q in 0 until s.els.length() {
      re = re.append(s.els[q])
      rx = rx.append(rc[2 * k] + s.xy[2 * q] * size)
      ry = ry.append(rc[2 * k + 1] + s.xy[2 * q + 1] * size)
    }
  }
  // match each left atom to the next unused right atom of the same element
  var used: Number[] = for k in 0 until re.length() { 0 }
  var atoms = ""
  for i in 0 until le.length() {
    var j = -1
    for k in 0 until re.length() {
      if j < 0 and used[k] == 0 and re[k] == le[i] { j = k }
    }
    if j >= 0 {
      used = for k in 0 until used.length() { if k == j { 1 } else { used[k] } }
      let delay = (i % 7) * 0.08
      atoms = atoms + f"<g class=\"sm-fly\" style=\"--dx:{sm_n(rx[j] - lx[i])}px;--dy:{sm_n(ry[j] - ly[i])}px;animation-delay:{sm_n(delay)}s\">{sm_atom(le[i], lx[i], ly[i])}</g>"
    }
  }
  let count = le.length()
  return f"<svg class=\"sm\" viewBox=\"0 0 {w} {h}\" role=\"img\" aria-label=\"{b.equation}\"><text class=\"sm-side\" x=\"220\" y=\"28\">before</text><text class=\"sm-side\" x=\"740\" y=\"28\">after</text><text class=\"sm-arrow\" x=\"480\" y=\"{h / 2}\">&#8594;</text><g class=\"sm-lb\">{lbonds}</g><g class=\"sm-rb\">{rbonds}</g>{atoms}<text class=\"sm-count\" x=\"480\" y=\"{h - 14}\">{count} atoms before, {count} after: none made, none lost</text></svg>"
}

fn sm_style() -> Text {
  return ".sm{width:100%;height:auto;display:block;margin-top:14px;border-radius:18px;background:color-mix(in srgb,var(--halo) 88%,transparent);border:1px solid color-mix(in srgb,var(--line) 12%,transparent)}.sm-a{stroke:rgba(0,0,0,.35);stroke-width:1}.sm-t{font:700 12px ui-monospace,Consolas,monospace;text-anchor:middle}.sm-b{stroke:color-mix(in srgb,var(--ink) 70%,transparent);stroke-width:2.4;stroke-linecap:round}.sm-side{fill:var(--soft);font:600 11px ui-monospace,Consolas,monospace;letter-spacing:.2em;text-transform:uppercase;text-anchor:middle}.sm-arrow{fill:var(--amber);font-size:34px;text-anchor:middle;dominant-baseline:middle}.sm-count{fill:var(--soft);font:13px Figtree,system-ui,sans-serif;text-anchor:middle}.sm-fly{animation:sm-fly 7s ease-in-out infinite}.sm-lb{animation:sm-lb 7s ease-in-out infinite}.sm-rb{animation:sm-rb 7s ease-in-out infinite}@keyframes sm-fly{0%,22%{transform:translate(0,0)}62%,92%{transform:translate(var(--dx),var(--dy))}100%{transform:translate(0,0)}}@keyframes sm-lb{0%,18%{opacity:1}28%,94%{opacity:0}100%{opacity:1}}@keyframes sm-rb{0%,62%{opacity:0}72%,90%{opacity:1}96%,100%{opacity:0}}@media (prefers-reduced-motion:reduce){.sm-fly,.sm-lb,.sm-rb{animation:none}.sm-rb{opacity:0}}"
}

// ---------------------------------------------------------------- tests

test "molecules take their shape from their formula" {
  water = sm_shape("H2O")
  expect water.els == ["O", "H", "H"]
  co2 = sm_shape("CO2")
  expect co2.els == ["C", "O", "O"]
  expect co2.bonds == [0, 1, 2, 0, 2, 2]
  expect sm_shape("O2").bonds == [0, 1, 2]
  expect sm_shape("N2").bonds == [0, 1, 3]
  expect sm_shape("C6H12O6").els.length() == 24
}

test "a reaction keeps every atom" {
  svg = sm_reaction_svg(sc_balance("CH4 + O2 -> CO2 + H2O"))
  expect svg.contains("9 atoms before, 9 after")
  expect svg.split("class=\"sm-fly\"").length() == 10
}
