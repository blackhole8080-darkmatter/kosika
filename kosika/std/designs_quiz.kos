// Kosika Designs, quizzes: a few questions to check what was just learned.
//
// A model writes the questions, their choices, which choice is right, and
// why. Kosika checks every question (one right answer, choices that differ,
// an explanation for each), sets the right answers in different places so
// they never all sit first, and draws a quiz card: pick a choice, see at
// once whether it was right and why, and the score at the end.
//
//   kosika run designs_quiz.kos --workflow quiz --input ask.json ...
//
// where ask.json holds {"ask": {"text": "photosynthesis", "palette": ""}}.
// designs.kos chooses this for asks like "quiz me on ..." or "test me".

import "designs_palette.kos"

export [QzQuestion, Quiz, QzAsk, QzPage, qz_problems, qz_tidy, qz_card, qz_style, qz_script, qz_page, quiz, qz_render]

// answer: which choice is right, counting from 0. why: one sentence that
// says why it is right, shown once a choice is picked.
record QzQuestion { ask: Text choices: Text[] answer: Number why: Text }
record Quiz { title: Text topic: Text palette: Text questions: QzQuestion[] }
record QzAsk { text: Text palette: Text }
record QzPage { page: Text card: Text problems: Text[] quiz: Quiz }
record QzBrief { task: Text ask: Text problems: Text }

fn qz_esc(text: Text) -> Text {
  return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

// ---------------------------------------------------------------- tidying and checking

// Where the right answer goes in question k of n: spread over the places,
// so a guess of "always the first" scores no better than chance.
fn qz_place(k: Number, choices: Number) -> Number {
  return (k * 7 + 1) % choices
}

// A question with its right answer moved to its place, the others kept in
// their order.
fn qz_moved(q: QzQuestion, k: Number) -> QzQuestion {
  let n = q.choices.length()
  if n < 2 or q.answer < 0 or q.answer >= n { return q }
  let right = q.choices[q.answer]
  let others = for i in 0 until n where i != q.answer { q.choices[i] }
  let at = qz_place(k, n)
  var out: Text[] = []
  var taken = 0
  for i in 0 until n {
    if i == at { out = out.append(right) }
    else {
      out = out.append(others[taken])
      taken = taken + 1
    }
  }
  return {..q, choices: out, answer: at}
}

fn qz_tidy(z: Quiz) -> Quiz {
  let cleaned = for q in z.questions { {..q, ask: q.ask.trim(), why: q.why.trim(), choices: for c in q.choices { c.trim() }, answer: q.answer.floor()} }
  let placed = for k in 0 until cleaned.length() { qz_moved(cleaned[k], k) }
  let palette = if palette_names().contains(z.palette) { z.palette } else { "dark_matter" }
  return {..z, title: z.title.trim(), palette: palette, questions: placed}
}

fn qz_problems(raw: Quiz) -> Text[] {
  let z = qz_tidy(raw)
  var out: Text[] = []
  if z.title.is_empty() { out = out.append("give a title") }
  if z.questions.length() < 3 or z.questions.length() > 6 { out = out.append(f"{z.questions.length()} questions; write 3 to 6") }
  for k in 0 until z.questions.length() {
    let q = z.questions[k]
    let n = q.choices.length()
    let name = f"question {k + 1}"
    if q.ask.is_empty() { out = out.append(f"{name} asks nothing") }
    if n < 2 or n > 5 { out = out.append(f"{name} has {n} choices; give 2 to 5") }
    if q.answer < 0 or q.answer >= n { out = out.append(f"{name}: answer {q.answer} is not one of its choices (count from 0)") }
    if q.why.is_empty() { out = out.append(f"{name} needs a why: one sentence on why the answer is right") }
    var seen: Text[] = []
    for c in q.choices {
      if c.is_empty() { out = out.append(f"{name} has an empty choice") }
      else if seen.contains(c.lower()) { out = out.append(f"{name} gives the choice '{c}' twice") }
      seen = seen.append(c.lower())
    }
  }
  return out
}

// ---------------------------------------------------------------- drawing

fn qz_letter(i: Number) -> Text { return "ABCDE".slice(i, i + 1) }

fn qz_question(q: QzQuestion, k: Number) -> Text {
  let choices = (for i in 0 until q.choices.length() { f"<button type=\"button\" class=\"qz-choice\" data-i=\"{i}\"><b>{qz_letter(i)}</b><span>{qz_esc(q.choices[i])}</span></button>" }).join("")
  return f"<li class=\"qz-q\" data-answer=\"{q.answer}\"><div class=\"qz-ask\"><i>{k + 1}</i>{qz_esc(q.ask)}</div><div class=\"qz-choices\">{choices}</div><p class=\"qz-why\" hidden>{qz_esc(q.why)}</p></li>"
}

// The quiz alone, to sit inside any page that carries qz_style and qz_script.
fn qz_card(raw: Quiz) -> Text {
  let z = qz_tidy(raw)
  let questions = (for k in 0 until z.questions.length() { qz_question(z.questions[k], k) }).join("")
  return f"<div class=\"qz\"><div class=\"qz-head\"><span>Quiz</span><h3>{qz_esc(z.title)}</h3></div><ol class=\"qz-list\">{questions}</ol><div class=\"qz-score\" aria-live=\"polite\">Pick an answer for each question.</div><button type=\"button\" class=\"qz-again\" hidden>Try again</button></div>"
}

fn qz_style() -> Text {
  return ".qz{color:var(--ink);font:15px/1.5 Figtree,system-ui,-apple-system,'Segoe UI',sans-serif}.qz-head span{font:600 10.5px ui-monospace,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:var(--gold)}.qz-head h3{margin:4px 0 14px;font-size:22px;font-weight:850;letter-spacing:-.02em}.qz-list{list-style:none;margin:0;padding:0;display:grid;gap:12px}.qz-q{background:color-mix(in srgb,var(--halo) 88%,transparent);border:1px solid color-mix(in srgb,var(--line) 12%,transparent);border-radius:16px;padding:14px}.qz-ask{display:flex;gap:10px;font-weight:600;margin-bottom:10px}.qz-ask i{font:normal 600 11px ui-monospace,Consolas,monospace;flex:none;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;color:var(--think);border:1.5px solid color-mix(in srgb,var(--think) 70%,transparent)}.qz-choices{display:grid;gap:6px}.qz-choice{display:flex;gap:10px;align-items:center;text-align:left;font:inherit;color:var(--ink);background:transparent;border:1px solid color-mix(in srgb,var(--line) 16%,transparent);border-radius:12px;padding:8px 10px;cursor:pointer;transition:border-color .2s,background .2s}.qz-choice b{flex:none;width:22px;height:22px;border-radius:6px;display:grid;place-items:center;font:600 11px ui-monospace,Consolas,monospace;color:var(--soft);border:1px solid color-mix(in srgb,var(--line) 22%,transparent)}.qz-choice:hover:not([disabled]),.qz-choice:focus-visible{border-color:var(--amber);outline:none}.qz-choice[disabled]{cursor:default}.qz-choice.right{border-color:var(--h4,#4fe0a6);background:color-mix(in srgb,var(--h4,#4fe0a6) 14%,transparent)}.qz-choice.right b{background:var(--h4,#4fe0a6);color:#0b0a1f;border-color:transparent}.qz-choice.wrong{border-color:var(--h5,#ff6b81);background:color-mix(in srgb,var(--h5,#ff6b81) 12%,transparent)}.qz-choice.wrong b{background:var(--h5,#ff6b81);color:#0b0a1f;border-color:transparent}.qz-why{margin:10px 2px 0;color:var(--soft);font-size:14px}.qz-score{margin:14px 2px 6px;font-weight:600}.qz-again{font:600 10px ui-monospace,Consolas,monospace;letter-spacing:.2em;text-transform:uppercase;color:var(--soft);background:none;border:1px solid var(--line2);border-radius:999px;padding:7px 13px;cursor:pointer}"
}

// Each question takes one pick: the right choice turns green, a wrong pick
// red, the reason shows, and the score counts up; Try again starts over.
fn qz_script() -> Text {
  return "(function(){document.querySelectorAll('.qz').forEach(function(z){var qs=[].slice.call(z.querySelectorAll('.qz-q')),score=z.querySelector('.qz-score'),again=z.querySelector('.qz-again');function tally(){var done=qs.filter(function(q){return q.dataset.done}).length,right=qs.filter(function(q){return q.dataset.done==='right'}).length;if(done<qs.length){score.textContent=right+' right so far, '+(qs.length-done)+' to go.';return}score.textContent='You got '+right+' of '+qs.length+(right===qs.length?'. All right!':'. Read the reasons, then try again.');again.hidden=false}qs.forEach(function(q){var cs=[].slice.call(q.querySelectorAll('.qz-choice'));cs.forEach(function(c){c.addEventListener('click',function(){if(q.dataset.done)return;var ok=c.dataset.i===q.dataset.answer;q.dataset.done=ok?'right':'wrong';cs.forEach(function(x){x.disabled=true;if(x.dataset.i===q.dataset.answer)x.classList.add('right')});if(!ok)c.classList.add('wrong');q.querySelector('.qz-why').hidden=false;tally()})})});again.addEventListener('click',function(){qs.forEach(function(q){delete q.dataset.done;q.querySelector('.qz-why').hidden=true;q.querySelectorAll('.qz-choice').forEach(function(x){x.disabled=false;x.classList.remove('right','wrong')})});again.hidden=true;score.textContent='Pick an answer for each question.'})})})();"
}

fn qz_page(ask: Text, raw: Quiz) -> Text {
  let z = qz_tidy(raw)
  let asked = if ask.trim().is_empty() { "" } else { f"<p class=\"ask\">{qz_esc(ask)}</p>" }
  return f"<!doctype html><html lang=\"en\" data-palette=\"{z.palette}\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{qz_esc(z.title)}</title><style>{palettes_css()}body{{margin:0;background:var(--bg)}}main{{max-width:760px;margin:0 auto;padding:28px 16px 48px}}.ask{{color:var(--soft);font:14px system-ui,sans-serif;margin:0 0 6px}}{qz_style()}</style></head><body><main>{asked}{qz_card(z)}</main><script>{qz_script()}</script></body></html>"
}

fn qz_result(ask: Text, z: Quiz) -> QzPage {
  let wrong = qz_problems(z)
  let tidy = qz_tidy(z)
  if wrong.is_empty() { return {page: qz_page(ask, tidy), card: qz_card(tidy), problems: [], quiz: tidy} }
  return {page: "", card: "", problems: wrong, quiz: tidy}
}

// ---------------------------------------------------------------- the workflows

workflow qz_render(z: Quiz) -> QzPage {
  out = qz_result("", z)
}

model quizmaster {
  input: QzBrief
  output: Quiz
  parameters: {
    max_output_tokens: 4000
  }
}

fn qz_task() -> Text {
  return "Write a short quiz that checks real understanding of what was asked about, for a university student. Give title (a few words), topic (the subject in two to five words), palette (one of " + palette_names().join(", ") + "; dark_matter unless another suits the subject) and questions: 4 or 5 of them, from simple to harder, each testing an idea rather than a word to remember. Each question has ask (one sentence), choices (3 or 4 short, plausible answers, all different), answer (which choice is right, counting from 0) and why (one sentence saying why that answer is right). Make the wrong choices the mistakes a learner really makes. Be correct."
}

fn qz_none() -> Quiz { return {title: "", topic: "", palette: "dark_matter", questions: []} }
fn qz_kept(z: Quiz) -> Quiz { return z }
fn qz_wrong(z: Quiz) -> Text { return qz_problems(z).join("; ") }
fn qz_in(z: Quiz, palette: Text) -> Quiz { return if palette_names().contains(palette) { {..z, palette: palette} } else { z } }

workflow quiz(ask: QzAsk) -> QzPage {
  budget 4 model calls, 400 seconds
  first  = use_model quizmaster(qz_task(), ask.text, "") retry 1 otherwise qz_none()
  wrong  = qz_wrong(first)
  better = match wrong.is_empty() {
    case true { first }
    case _ { call qz_again(ask, {text: wrong, palette: ""}, first) }
  }
  out = qz_result(ask.text, qz_in(better, ask.palette))
}

workflow qz_again(ask: QzAsk, wrong: QzAsk, first: Quiz) -> Quiz {
  answer = use_model quizmaster(qz_task(), ask.text, wrong.text) retry 1 otherwise qz_kept(first)
  out    = answer
}

// ---------------------------------------------------------------- tests

fn qz_sample() -> Quiz {
  return {title: "Photosynthesis", topic: "plants", palette: "forest", questions: [
    {ask: "What gas do leaves take in?", choices: ["Carbon dioxide", "Oxygen", "Nitrogen"], answer: 0, why: "Carbon is built into sugar."},
    {ask: "Where does it happen?", choices: ["Chloroplasts", "Roots", "Nucleus"], answer: 0, why: "Chlorophyll is in chloroplasts."},
    {ask: "What is released?", choices: ["Oxygen", "Methane", "Helium"], answer: 0, why: "Water is split, freeing oxygen."}
  ]}
}

test "a good quiz has nothing wrong with it" {
  expect qz_problems(qz_sample()).length() == 0
}

test "Kosika spreads the right answers so they are not all first" {
  t = qz_tidy(qz_sample())
  expect (for q in t.questions { q.answer }) == [1, 2, 0]
  expect t.questions[0].choices == ["Oxygen", "Carbon dioxide", "Nitrogen"]
  expect t.questions[0].choices[t.questions[0].answer] == "Carbon dioxide"
}

test "the problems name what is wrong" {
  bad = {..qz_sample(), questions: [{ask: "", choices: ["A", "a"], answer: 4, why: ""}]}
  said = qz_problems(bad)
  expect said.contains("1 questions; write 3 to 6")
  expect said.contains("question 1 asks nothing")
  expect said.contains("question 1: answer 4 is not one of its choices (count from 0)")
  expect said.contains("question 1 gives the choice 'a' twice")
}

test "the card marks the right answer for its script" {
  card = qz_card(qz_sample())
  expect card.contains("data-answer=\"1\"")
  expect card.contains("Try again")
}
