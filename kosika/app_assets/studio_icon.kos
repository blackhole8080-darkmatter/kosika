// Kosika Studio app icon generator
record IconParams { size: Number }

model assistant

fn studio_icon(size: Number) -> Text {
  // corner radius = 22% of size, expressed as % for the 100×100 viewBox
  let radiusPercent = (size * 0.22 / size * 100).to_text()
  // highlight opacity
  let highlightOpacity = 0.18.to_text()
  // K scale (56% of the viewBox height)
  let kScale = (0.56).to_text()

  // K path – two filled shapes forming a bold “K”
  let kPath = "M30,20 L45,20 L45,45 L55,45 L55,20 L70,20 L70,80 L55,80 L55,55 L45,55 L45,80 L30,80 Z"

  return "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + size.to_text() + "\" height=\"" + size.to_text() + "\" viewBox=\"0 0 100 100\">" +
         "<defs>" +
           "<linearGradient id=\"grad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">" +
             "<stop offset=\"0%\" stop-color=\"#ff7a00\"/>" +
             "<stop offset=\"100%\" stop-color=\"#ff3ea5\"/>" +
           "</linearGradient>" +
         "</defs>" +
         "<rect x=\"0\" y=\"0\" width=\"100\" height=\"100\" rx=\"" + radiusPercent + "%\" fill=\"url(#grad)\"/>" +
         "<rect x=\"0\" y=\"0\" width=\"100\" height=\"33.33\" rx=\"" + radiusPercent + "%\" fill=\"white\" fill-opacity=\"" + highlightOpacity + "\"/>" +
         "<g fill=\"white\" transform=\"translate(50,50) scale(" + kScale + ") translate(-50,-50)\">" +
           "<path d=\"" + kPath + "\"/>" +
         "</g>" +
         "</svg>"
}
