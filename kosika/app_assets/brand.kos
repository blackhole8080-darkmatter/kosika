// The moving mark in Kosika Studio's own sidebar and headings.
//
// Studio does not carry a drawing of its mark. It carries this program, runs
// it when it starts, and plays the scene it describes. So the first
// animation anyone sees in Studio was written in Kosika — and, since the
// scene library, it is a scene the language itself has already checked:
// scene_problems reads the whole film before it leaves this file.
//
// What happens, as an event horizon: a violet halo fades in, the gold photon
// ring ignites, twelve particles of accretion fly out from the centre onto
// the ring, the void itself blooms at the middle, the K appears inside it,
// and then a slow wave of light keeps going round the ring for as long as
// Studio is open.

import "std/scene.kos"

fn build() -> Scene {
  let dots = 12
  let ring = 42
  var shapes: Shape[] = []
  var moves: Move[] = []
  // The halo: a dim violet ring of gravity, breathing very slowly.
  shapes = shapes.append(shape("halo", "ring", 60, 60, 108, "#241d45"))
  moves = moves.concat([
    hidden("halo"),
    move("halo", "fade", 1, 0, 0.5, "out"),
    forever(move("halo", "size", 114, 2, 5, "back"))
  ])
  // The photon ring: the bright circle light makes on its last orbit.
  shapes = shapes.append(shape("photon", "ring", 60, 60, 84, "#f5b45c"))
  moves = moves.concat([
    hidden("photon"),
    move("photon", "fade", 1, 0.15, 0.6, "out"),
    forever(move("photon", "size", 90, 2, 4, "back")),
    forever(color_move("photon", "#ffd9a0", 2.5, 4, "back"))
  ])
  // The accretion particles: gold and violet, out of the centre onto the
  // ring, then the wave — each swells and brightens after the one before
  // it, for as long as Studio is open.
  for i in 0 until dots {
    let id = f"dot{i}"
    let angle = 360 * i / dots - 90
    let leave = 0.1 + i * 0.05
    shapes = shapes.append(shape(id, "circle", 60, 60, 5, if i % 2 == 0 { "#f5b45c" } else { "#9a8cff" }))
    moves = moves.concat([
      hidden(id),
      move(id, "fade", 1, leave, 0.2, "out"),
      move(id, "x", 60 + ring * angle.cos(), leave, 0.7, "bounce"),
      move(id, "y", 60 + ring * angle.sin(), leave, 0.7, "bounce"),
      forever(move(id, "size", 8, 2 + i * 0.3, 3, "back")),
      forever(color_move(id, if i % 2 == 0 { "#ffe9c4" } else { "#cabfff" }, 2 + i * 0.3, 3, "back"))
    ])
  }
  // The void: darker than everything, blooming once and then perfectly
  // still. The letter rises inside it.
  shapes = shapes.concat([
    shape("core", "circle", 60, 60, 10, "#05060b"),
    words_shape("letter", 60, 61, 30, "#f2f4ff", "K")
  ])
  moves = moves.concat([
    hidden("core"),
    move("core", "fade", 1, 0.5, 0.4, "out"),
    move("core", "size", 58, 0.5, 0.7, "bounce"),
    hidden("letter"),
    move("letter", "fade", 1, 1.1, 0.4, "out")
  ])
  return scene(120, 120, 2.2, "#0a0c16", shapes, moves)
}

workflow main() -> Scene {
  scene = build()
}

test "the mark has a halo, a photon ring, accretion and a letter" {
  a = main()
  expect a.shapes.length() == 16
  expect a.moves.length() == 3 + 4 + 12 * 6 + 5
  expect a.shapes[15].text == "K"
}

test "the scene library has already checked the mark, and found nothing" {
  film = main()
  expect scene_problems(film).length() == 0
}
