{
  "name": "kosika-desktop",
  "productName": "Kosika",
  "version": "0.1.0",
  "private": true,
  "description": "Local Kosika programming and AI workflow workbench",
  "author": "Kosika",
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.kosika.workbench",
    "productName": "Kosika",
    "directories": {"output": "release"},
    "files": ["main.cjs", "package.json"],
    "extraResources": [{"from": "host-dist/KosikaHost", "to": "host"}],
    "win": {"target": "nsis", "signAndEditExecutable": false},
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Kosika App",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Kosika-Setup-${version}-${arch}.${ext}"
    }
  }
}
