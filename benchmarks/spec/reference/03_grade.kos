record Exam { score: Number }
record Grade { letter: Text passed: Bool }

fn letter_for(score: Number) -> Text {
  return if score >= 90 { "A" } else {
    if score >= 75 { "B" } else {
      if score >= 50 { "C" } else { "F" }
    }
  }
}

fn grade(exam: Exam) -> Grade {
  return {letter: letter_for(score: exam.score), passed: exam.score >= 50}
}

workflow main(exam: Exam) -> Grade {
  step assess {
    let result: Grade = grade(exam: exam)
    return result
  }
}
