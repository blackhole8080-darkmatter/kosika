record Ticket { text: Text }
record Routing { queue: Text escalate: Bool reason: Text }

model assistant

fn route(label: Choice, urgent: Decision) -> Routing {
  return {
    queue: if label.confidence >= 0.6 { label.label } else { "triage" },
    escalate: urgent.answer and urgent.confidence >= 0.7,
    reason: urgent.reason
  }
}

workflow main(ticket: Ticket) -> Routing {
  label   = classify ticket.text into ["billing", "bug", "other"]
  urgent  = decide "Does the customer say the problem blocks their work?" given ticket.text
  routing = route(label, urgent)
}
