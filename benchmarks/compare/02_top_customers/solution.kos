record Order { customer: Text total: Number }
record Orders { orders: Order[] }
record Spend { customer: Text total: Number }
record Top { names: Text[] best_total: Number }

fn main(input: Orders) -> Top {
  let groups = input.orders.group_by("customer")
  let spends: Spend[] = for name in groups.keys() {
    {customer: name, total: groups.get(name).or([]).sum_by("total")}
  }
  let ranked = spends.sort_by("total").reverse()
  return {
    names: for item in ranked.slice(start: 0, end: ranked.length().min(3)) { item.customer },
    best_total: ranked.first().value().total
  }
}
