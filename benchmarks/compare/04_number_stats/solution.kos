record Raw { values: Text[] }
record Stats { count: Number invalid: Number average: Number? largest: Number? }

fn stats(raw: Raw) -> Stats {
  let numbers: Number[] = for value in raw.values
    where value.to_number().exists() { value.to_number().value() }
  return {
    count: numbers.length(),
    invalid: raw.values.length() - numbers.length(),
    average: numbers.average(),
    largest: numbers.max()
  }
}

workflow main(raw: Raw) -> Stats {
  result = stats(raw)
}
