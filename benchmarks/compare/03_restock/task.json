      "inputs": {
        "request": {
          "stock": {
            "pen": 1
          },
          "deliveries": [
            {
              "item": "pen",
              "amount": "2"
            }
          ],
          "threshold": 3
        }
      }
    },
    {
      "label": "the threshold is missing",
      "inputs": {
        "request": {
          "stock": {
            "pen": 1
          },
          "deliveries": []
        }
      }
    }
  ],
  "model_answers": []
