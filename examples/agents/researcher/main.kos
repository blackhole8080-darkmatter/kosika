// Researcher: answers questions from the files in the folder you grant, and
// proves each answer with an exact quote and the line it came from.
//
//   kosika test main.kos
//   kosika studio FOLDER --model qwen2.5:3b --model-protocol ollama --allow-folder YOUR_NOTES_OR_PROJECT
//
// How it stays honest. Code picks the key words from your question and
// searches the folder. Only the lines that were found are shown to the
// model, which must answer and give one exact quote. Code then checks that
// the quote really is in one of those lines, and it is code, not the model,
// that names the file and line.
//
// Fast first, strong when needed. The question goes to the model called
// reader. If its answer is not proven, the same question goes to the model
// called strong. If that is not proven either, no answer is shown: you get
// the closest lines instead. Give the two names different models with
//
//   --model qwen2.5:3b,strong=qwen2.5:7b
//
// and most questions cost only the fast model's time.
//
//   kosika measure main.kos --model-protocol ollama --model qwen2.5:3b --model qwen2.5:7b --model qwen2.5:3b,strong=qwen2.5:7b
//
// runs the evals at the end of this file on each setup, so you can see
// which is right more often and how long each takes.
//
// Search by meaning. Key words miss a line that says the same thing in
// other words: "what do I pay my landlord" against "Rent is 900 euros".
// Start with an embedding model as well and the lines nearest in meaning
// are found too. Without one, only key words are used.
//
//   --embed-model nomic-embed-text
//
// With it there is also a further check. A quote can be real and still be
// about something else, so the line that proves an answer must be one of
// the five nearest in meaning to the question.
//
// Working it out. Some questions are answered by no line as it stands:
// "what are the two homeworks worth together" against "Homework 3 is worth
// 15 marks and homework 4 is worth 25 marks". When no answer can be proven
// word for word, the model called thinker is asked to work the answer out
// from one line and to say how. Such an answer is always marked as worked
// out and shown with its step, its quote and its line, so you can check
// it. The line must still be real, and must be about what was asked.
//
// It only reads. Say: a question, find WORDS, read FILE, summarize FILE,
// or help.

record Msg { text: Text }
record Said { text: Text }

record Query { path: Text query: Text }
record Hits { matches: Text[] }
record Where { path: Text }
record FileText { text: Text }
// What the model must give back: the answer, and the words that prove it.
record Found { answer: Text quote: Text }
record Ask { text: Text }
// An answer the lines do not state but lead to: the answer, the words it
// was worked out from, and the step taken.
record Worked { answer: Text quote: Text how: Text }

default model reader {
  input: Ask
  output: Found
  parameters: {
    max_output_tokens: 220
  }
}

// The model asked when reader's answer was not proven. It is asked the
// same question and held to the same check.
model strong {
  input: Ask
  output: Found
  parameters: {
    max_output_tokens: 220
  }
}

// The model that takes a second look at a worked-out answer and says
// only whether it follows. Give it the stronger model too.
model judge

// The model asked to work an answer out when none could be proven word
// for word. Give it the stronger model: --model fast,strong=big,thinker=big
model thinker {
  input: Ask
  output: Worked
  parameters: {
    max_output_tokens: 260
  }
}

tool search_files {
  source system "files"
  operation: "search"
  access: observe
  input: Query
  output: Hits
}

// Lines near in meaning to the question. Reachable only when the person
// running this grants an embedding model.
tool find_files {
  source system "files"
  operation: "find"
  access: observe
  input: Query
  output: Hits
}

tool look_at {
  source system "files"
  operation: "peek"
  access: observe
  input: Where
  output: FileText
}

agent hands {
  can: [search_files, find_files, look_at]
  max_steps: 1
}

// ---------------------------------------------------------------- routing

fn kind_of(text: Text) -> Text {
  let lower = text.lower().trim()
  let first = lower.words().first().or("")
  if lower == "help" or lower.contains("what can you do") { return "help" }
  if ["find", "search", "grep"].contains(first) { return "find" }
  if ["read", "open", "show"].contains(first) { return "read" }
  if ["summarize", "summarise"].contains(first) { return "summary" }
  return "ask"
}

// ------------------------------------------------------------- key words

fn clean(word: Text) -> Text {
  var out = word.lower()
  for mark in ["?", "!", ",", ";", "\"", "'", "(", ")", ":"] {
    out = out.replace(mark, "")
  }
  // A full stop ends a sentence but belongs inside a file name.
  if out.ends_with(".") { out = out.slice(0, out.length() - 1) }
  return out.trim()
}

// Words that say nothing about what a question or an answer is about.
fn small_words() -> Text[] {
  return ["a", "an", "the", "is", "are", "was", "were", "be", "do", "does", "did", "i", "me", "my", "we", "our", "you", "your", "it", "its", "of", "in", "on", "at", "to", "for", "from", "by", "with", "about", "and", "or", "what", "when", "where", "which", "who", "whom", "why", "how", "tell", "say", "says", "said", "there", "that", "this", "these", "those", "have", "has", "had", "can", "could", "should", "would", "will", "please", "any", "all", "much", "many", "need", "find", "search", "show", "am", "not", "no", "yes", "answer", "question", "line", "lines", "text"]
}

// The words of a question worth searching for: not the small words every
// question has. At most six, so the search stays sharp.
fn key_words(text: Text, skip_first: Bool) -> Text {
  let small = small_words()
  var words: Text[] = []
  var seen = false
  for word in text.words() {
    let item = clean(word)
    if not item.is_empty() {
      if (seen or not skip_first) and item.length() > 1 and not small.contains(item) and not words.contains(item) {
        words = words.append(item)
      }
      seen = true
    }
  }
  return words.take(6).join(" ")
}

// ------------------------------------------------------------- answering

// The best key-word lines, then the lines near in meaning that are not
// already among them, then the rest.
fn together(words: Hits, close: Hits) -> Hits {
  let more = for hit in close.matches where not words.matches.contains(hit) { hit }
  return {matches: words.matches.take(8).concat(more.take(6)).concat(words.matches.drop(8))}
}

// The lines found, as the model will see them. Kept short so a small
// model can read all of it.
fn passages(hits: Hits) -> Text {
  var rows: Text[] = []
  var size = 0
  for hit in hits.matches {
    if rows.length() < 14 and size + hit.length() < 2600 {
      rows = rows.append(hit)
      size += hit.length()
    }
  }
  return rows.join("\n")
}

fn ask_prompt(question: Text, lines: Text) -> Ask {
  return {text: "Answer the question using only the lines below. Each line is written as file:line: text.\nGive the answer in one or two short sentences.\nIn quote, copy the exact words from one line that prove your answer: the text only, without the file and line number, and without changing a single character.\nIf the lines do not answer the question, set answer to \"\" and quote to \"\".\n\nLines:\n" + lines + "\n\nQuestion: " + question.trim()}
}

// A quote without the marks around it. A model often ends a quote with a
// full stop where the line goes on with a comma. The words between must
// still be found exactly, so this forgives the ends and nothing else.
fn bare(quote: Text) -> Text {
  return quote.lower().trim_marks(".,;:!?\"'")
}

// The hit that really holds the quote, or "" when none does. This is the
// check: the model's quote must be found, letter for letter apart from
// capitals, in a line the search returned.
fn proof(hits: Hits, quote: Text) -> Text {
  let wanted = bare(quote)
  if wanted.length() < 6 { return "" }
  for hit in hits.matches {
    if hit.lower().contains(wanted) { return hit }
  }
  return ""
}

// "notes/plan.md:12: text" names its own source: "notes/plan.md, line 12".
fn source_of(hit: Text) -> Text {
  let parts = hit.split(":")
  if parts.length() < 3 { return hit }
  return parts[0] + ", line " + parts[1]
}

// The text of a hit without its file and line number.
fn line_of(hit: Text) -> Text {
  return hit.split(":").drop(2).join(":").trim()
}

// Does the line say what the answer says? The answer's own words, those
// that are not already in the question, must be found in the line. So
// "N/A", "it is not provided" and an answer taken from somewhere else
// are all refused: none of them is in the line.
fn supported(answer: Text, question: Text, line: Text) -> Bool {
  let asked = for word in question.words() { clean(word) }
  let lower = line.lower()
  var found = 0
  for word in answer.words() {
    let item = clean(word)
    if item.length() > 1 and not small_words().contains(item) and not asked.contains(item) and lower.contains(item) { found += 1 }
  }
  return found > 0
}

fn proven(found: Found, hits: Hits, close: Hits, msg: Msg) -> Text {
  if found.answer.trim().is_empty() { return "No answer was given. Answer from the lines and give an exact quote." }
  if found.quote.trim().length() < 6 { return "Give a quote of at least a few words copied from one line, or set answer and quote to \"\" if the lines do not answer." }
  let hit = proof(hits, found.quote)
  if hit.is_empty() { return "Your quote is not word for word in any of the lines. Copy the exact words from one line without changing them, and do not include the file name or line number. If the lines do not answer the question, set answer and quote to \"\"." }
  if line_of(hit).starts_with("#") { return "Your quote is a heading, which states no fact. Quote the line that holds the fact, or set answer and quote to \"\" if no line does." }
  if not supported(found.answer, msg.text, line_of(hit)) { return "Your answer is not what the quoted line says. Answer only with what that line states, or set answer and quote to \"\" if the lines do not answer." }
  // With search by meaning, the proving line must be among the lines
  // nearest in meaning to the question. A real line about something else
  // is not proof.
  if not close.matches.is_empty() and not close.matches.take(5).contains(hit) { return "The line you quoted is about something else. If none of the lines answers this exact question, set answer and quote to \"\"." }
  return ""
}

// --------------------------------------------------------- working it out

fn work_prompt(question: Text, lines: Text) -> Ask {
  return {text: "The lines below do not state the answer to the question word for word. Work the answer out from them if you can, for example by adding two numbers, comparing a time with a closing time, or using what a word means. Each line is written as file:line: text.\nIn answer, give the answer in one short sentence.\nIn quote, copy the exact words from the one line you worked it out from: the text only, without the file and line number, and without changing a single character.\nIn how, say the step you took in one short sentence, using the numbers or words from that line.\nUse nothing that is not in the lines, apart from plain arithmetic and what ordinary words mean. If the lines are about something else, or the answer cannot be worked out from them, set answer, quote and how to \"\".\n\nLines:\n" + lines + "\n\nQuestion: " + question.trim()}
}

// An answer that says there is no answer is not an answer.
fn non_answer(answer: Text) -> Bool {
  let lower = answer.lower()
  for words in ["n/a", "not provided", "not found", "not mentioned", "not stated", "not specified", "not given", "no information", "cannot be determined", "can't be determined", "cannot be worked out", "do not say", "does not say", "do not answer", "does not answer", "unknown", "not enough"] {
    if lower.contains(words) { return true }
  }
  return false
}

// How many of the question's key words the line holds. A line that shares
// none of them is about something else.
fn shared(question: Text, line: Text) -> Number {
  let keys = key_words(question, false).words()
  let have = for word in line.words() { clean(word) }
  var count = 0
  for key in keys {
    if have.contains(key) { count += 1 }
  }
  return count
}

// Why a worked-out answer is refused, or "" when it may be shown. Saying
// there is no answer is allowed, and ends the matter.
fn reasoned(worked: Worked, hits: Hits, close: Hits, msg: Msg) -> Text {
  if worked.answer.trim().is_empty() { return "" }
  if non_answer(worked.answer) { return "If the answer cannot be worked out from the lines, set answer, quote and how to \"\"." }
  if worked.quote.trim().length() < 6 { return "Give a quote of at least a few words copied from the line you worked the answer out from." }
  let hit = proof(hits, worked.quote)
  if hit.is_empty() { return "Your quote is not word for word in any of the lines. Copy the exact words from one line without changing them, and do not include the file name or line number." }
  if line_of(hit).starts_with("#") { return "Your quote is a heading, which states no fact. Quote the line you worked the answer out from, or set answer, quote and how to \"\"." }
  if shared(msg.text, line_of(hit)) < 1 { return "The line you quoted is about something else. If no line is about this exact question, set answer, quote and how to \"\"." }
  if not close.matches.is_empty() and not close.matches.take(5).contains(hit) { return "The line you quoted is about something else. If no line is about this exact question, set answer, quote and how to \"\"." }
  if worked.how.trim().length() < 8 { return "In how, say the step you took to get from the line to the answer." }
  return ""
}

fn answered(query: Text, hits: Hits, found: Found, worked: Worked) -> Said {
  if query.is_empty() {
    return {text: "Ask me something about the files, or say \"find\" and a few words."}
  }
  if hits.matches.is_empty() {
    return {text: "I found nothing about \"" + query + "\" in the folder. Try other words, or say \"find\" and a word you know is in the file."}
  }
  let hit = proof(hits, found.quote)
  let from = proof(hits, worked.quote)
  if (found.answer.trim().is_empty() or hit.is_empty()) and not worked.answer.trim().is_empty() and not from.is_empty() {
    return {text: "Worked out, not stated word for word: " + worked.answer.trim() + "\nHow: " + worked.how.trim() + "\nQuote: \"" + worked.quote.trim() + "\"\nFrom: " + source_of(from)}
  }
  if found.answer.trim().is_empty() or hit.is_empty() {
    return {text: "I will not guess: I could not back an answer with an exact quote. The closest lines I found for \"" + query + "\" are:\n" + hits.matches.take(5).join("\n")}
  }
  return {text: found.answer.trim() + "\nQuote: \"" + found.quote.trim() + "\"\nFrom: " + source_of(hit)}
}

fn listed(query: Text, hits: Hits) -> Said {
  if query.is_empty() { return {text: "Tell me what to look for, like this: find invoice 2026"} }
  if hits.matches.is_empty() { return {text: "No line in the folder has \"" + query + "\"."} }
  return {text: hits.matches.length().to_text() + " line(s) for \"" + query + "\", best first:\n" + hits.matches.take(15).join("\n")}
}

// ------------------------------------------------------------------ files

fn path_from(text: Text) -> Text {
  var path = text.words().drop(1).join(" ").replace("\\", "/")
  for mark in ["\"", "'", "?"] { path = path.replace(mark, "") }
  return path.trim()
}

fn shown(path: Text, file: FileText) -> Said {
  if path.is_empty() { return {text: "Tell me which file, like this: read notes/plan.md"} }
  if file.text.is_empty() { return {text: "I could not read \"" + path + "\". It may be missing, not text, or outside the folder I may look in."} }
  return {text: path + ":\n" + file.text.take(1500)}
}

fn summed(path: Text, brief: Summary) -> Said {
  if brief.text.is_empty() { return {text: "I could not read \"" + path + "\", so there is nothing to summarise."} }
  return {text: "Summary of " + path + ":\n" + brief.text.trim()}
}

fn help() -> Said {
  return {text: "I answer from the files in the folder you granted, with an exact quote and its line.\nAsk a question: when is the demo with Ravi?\nfind WORDS: every matching line, no model needed\nread FILE: the start of a file\nsummarize FILE: what a file says\nI only read. I never change anything."}
}

// ------------------------------------------------------------ the requests

// Ask the fast model and check its answer. If the check refuses it, ask
// the strong model. If that is refused too, there is no answer.
workflow read_and_prove(prompt: Ask, hits: Hits, close: Hits, msg: Msg) -> Found {
  found = use_model reader(prompt.text) verify proven(found, hits, close, msg) escalate strong otherwise {answer: "", quote: ""}
}

// Asked only when nothing could be proven word for word.
workflow work_out(prompt: Ask, hits: Hits, close: Hits, msg: Msg) -> Worked {
  worked = use_model thinker(prompt.text) verify reasoned(worked, hits, close, msg) otherwise {answer: "", quote: "", how: ""}
}

// A second look at a worked-out answer before it is shown. A small model
// can take the right step and still say the wrong thing: "6pm is after
// 5pm" and then "yes, it is open". So the answer and its step are read
// again, by the model called judge, which says only whether one follows from the
// other.
fn check_text(msg: Msg, worked: Worked, hits: Hits) -> Text {
  return "A question was answered by working from one line of a file. Decide whether the answer is correct.
Line: " + line_of(proof(hits, worked.quote)) + "
Question: " + msg.text.trim() + "
Answer given: " + worked.answer.trim() + "
Step taken: " + worked.how.trim() + "
Say follows if the answer is correct for the question, given the line and plain arithmetic. Say wrong if the answer is mistaken, contradicts its own step, or is not supported by the line."
}

workflow second_look(msg: Msg, worked: Worked, hits: Hits) -> Choice {
  judged = classify check_text(msg, worked, hits) into ["follows", "wrong"] using judge otherwise {label: "wrong", confidence: 0}
}

// The worked-out answer if the second look let it stand, else none.
fn kept(worked: Worked, judged: Choice) -> Worked {
  return if judged.label == "follows" { worked } else { {answer: "", quote: "", how: ""} }
}

fn nothing_proven(found: Found, hits: Hits) -> Bool {
  return not hits.matches.is_empty() and (found.answer.trim().is_empty() or proof(hits, found.quote).is_empty())
}

workflow near(msg: Msg) -> Hits {
  close = execute hands.find_files(".", msg.text) otherwise {matches: []}
}

workflow ask_files(msg: Msg) -> Said {
  query = key_words(msg.text, false)
  words = execute hands.search_files(".", query) otherwise {matches: []}
  close = match query.is_empty() {
    case false { call near(msg) }
    case _ { {matches: []} }
  }
  hits  = together(words, close)
  found = match hits.matches.is_empty() {
    case false { call read_and_prove(ask_prompt(msg.text, passages(hits)), hits, close, msg) }
    case _ { {answer: "", quote: ""} }
  }
  worked = match nothing_proven(found, hits) {
    case true { call work_out(work_prompt(msg.text, passages(hits)), hits, close, msg) }
    case _ { {answer: "", quote: "", how: ""} }
  }
  judged = match worked.answer.trim().is_empty() {
    case false { call second_look(msg, worked, hits) }
    case _ { {label: "wrong", confidence: 0} }
  }
  said  = answered(query, hits, found, kept(worked, judged))
}

workflow find_lines(msg: Msg) -> Said {
  query = key_words(msg.text, true)
  hits  = execute hands.search_files(".", query) otherwise {matches: []}
  said  = listed(query, hits)
}

workflow read_one(msg: Msg) -> Said {
  path = path_from(msg.text)
  file = execute hands.look_at(path) otherwise {text: ""}
  said = shown(path, file)
}

workflow summarise_one(msg: Msg) -> Said {
  path  = path_from(msg.text)
  file  = execute hands.look_at(path) otherwise {text: ""}
  brief = match file.text.is_empty() {
    case false { summarize file.text.take(3500) }
    case _ { {text: ""} }
  }
  said  = summed(path, brief)
}

workflow main(msg: Msg) -> Said {
  budget 7 model calls, 600 seconds
  said = match kind_of(msg.text) {
    case "find" { call find_lines(msg) }
    case "read" { call read_one(msg) }
    case "summary" { call summarise_one(msg) }
    case "help" { help() }
    case _ { call ask_files(msg) }
  }
}

// ------------------------------------------------------------------ tests

test "the key words of a question are found" {
  expect key_words("When is the demo with Ravi?", false) == "demo ravi"
  expect key_words("find invoice 2026", true) == "invoice 2026"
  expect key_words("What does calc.py do?", false) == "calc.py"
  expect key_words("what is it?", false) == ""
}

test "an answer is shown with its quote and the line it came from" {
  answers search_files: [{matches: ["notes/work.md:12: Kosika demo for Ravi is next Tuesday at 3pm", "notes/old.md:4: the demo went well"]}]
  answers reader: [{answer: "The demo is next Tuesday at 3pm.", quote: "Kosika demo for Ravi is next Tuesday at 3pm"}]
  a = main({text: "When is the demo with Ravi?"})
  expect a.text == "The demo is next Tuesday at 3pm.\nQuote: \"Kosika demo for Ravi is next Tuesday at 3pm\"\nFrom: notes/work.md, line 12"
}

test "an answer whose quote is not in the files is not shown" {
  answers search_files: [{matches: ["notes/work.md:12: Kosika demo for Ravi is next Tuesday at 3pm"]}]
  answers reader: [{answer: "The demo is on Friday.", quote: "The demo is on Friday at noon"}]
  answers strong: [{answer: "The demo is on Friday.", quote: "Friday at noon, as I said"}]
  a = main({text: "When is the demo with Ravi?"})
  expect a.text.starts_with("I will not guess")
  expect a.text.contains("notes/work.md:12")
  expect not a.text.contains("Friday")
}

test "when nothing is found the model is not asked at all" {
  answers search_files: [{matches: []}]
  a = main({text: "When is the demo with Ravi?"})
  b = main({text: "what is it?"})
  expect a.text.starts_with("I found nothing about \"demo ravi\"")
  expect b.text.starts_with("Ask me something")
}

test "the model may say the lines do not answer" {
  answers search_files: [{matches: ["a.md:1: Ravi likes tea"]}]
  answers reader: [{answer: "", quote: ""}]
  answers strong: [{answer: "", quote: ""}]
  a = main({text: "When is the demo with Ravi?"})
  expect a.text.starts_with("I will not guess")
}

test "lines found by meaning are read when the key words find nothing" {
  answers search_files: [{matches: []}]
  answers find_files: [{matches: ["notes/home.md:3: Rent is 900 euros a month, due on the 1st."]}]
  answers reader: [{answer: "You pay 900 euros a month.", quote: "Rent is 900 euros a month"}]
  a = main({text: "What do I pay my landlord?"})
  expect a.text == "You pay 900 euros a month.\nQuote: \"Rent is 900 euros a month\"\nFrom: notes/home.md, line 3"
  both = together({matches: ["a:1: x", "b:2: y"]}, {matches: ["b:2: y", "c:3: z"]})
  expect both.matches == ["a:1: x", "b:2: y", "c:3: z"]
}

test "a real quote from a line about something else is not shown" {
  answers search_files: [{matches: ["notes/work.md:5: The staging server password is rotated every 90 days.", "notes/home.md:9: Electricity is with Northwind Energy, account 40-7718."]}]
  answers find_files: [{matches: ["notes/home.md:9: Electricity is with Northwind Energy, account 40-7718."]}]
  answers reader: [{answer: "It is rotated every 90 days.", quote: "password is rotated every 90 days"}]
  answers strong: [{answer: "", quote: ""}]
  a = main({text: "What is the wifi password at home?"})
  expect a.text.starts_with("I will not guess")
  expect not a.text.contains("Quote:")
  expect line_of("notes/a.md:3: Due: the 1st.") == "Due: the 1st."
}

test "a heading, a non-answer, and an answer the line does not say are all refused" {
  hits: Hits = {matches: ["home.md:1: # Home", "home.md:4: The landlord, Mr Okafor, can be reached on 555-0134."]}
  none: Hits = {matches: []}
  expect proven({answer: "It is not provided.", quote: "# Home"}, hits, none, {text: "What is the wifi password at home?"}).starts_with("Your quote is a heading")
  expect proven({answer: "N/A", quote: "The landlord, Mr Okafor, can be reached"}, hits, none, {text: "What is his email?"}).starts_with("Your answer is not what the quoted line says")
  expect proven({answer: "The answer is not found in the provided lines.", quote: "The landlord, Mr Okafor, can be reached"}, hits, none, {text: "What is his email?"}).starts_with("Your answer is not what")
  expect proven({answer: "His number is 555-0134.", quote: "can be reached on 555-0134"}, hits, none, {text: "How can I reach the landlord?"}) == ""
  expect supported("Tom", "Which friend cannot eat nuts?", "Tom is allergic to peanuts.")
  expect not supported("the friend", "Which friend cannot eat nuts?", "Tom is allergic to peanuts.")
  expect proven({answer: "555-0134", quote: "can be reached on 555-0134"}, hits, {matches: ["a.md:1: x", "home.md:4: The landlord, Mr Okafor, can be reached on 555-0134."]}, {text: "landlord phone"}) == ""
  expect proven({answer: "555-0134", quote: "can be reached on 555-0134"}, hits, {matches: ["a.md:1: something else entirely"]}, {text: "landlord phone"}).starts_with("The line you quoted is about something else")
}

test "find lists matching lines without a model" {
  answers search_files: [{matches: ["calc.py:1: def add(a, b):", "tests/test_calc.py:1: from calc import add"]}]
  a = main({text: "find add"})
  expect a.text == "2 line(s) for \"add\", best first:\ncalc.py:1: def add(a, b):\ntests/test_calc.py:1: from calc import add"
}

test "when the fast model cannot prove its answer the strong model is asked" {
  answers search_files: [{matches: ["notes/work.md:12: Kosika demo for Ravi is next Tuesday at 3pm"]}]
  answers reader: [{answer: "It is next Tuesday.", quote: "The demo will be held next Tuesday"}]
  answers strong: [{answer: "It is next Tuesday at 3pm.", quote: "next Tuesday at 3pm"}]
  a = main({text: "When is the demo with Ravi?"})
  expect a.text == "It is next Tuesday at 3pm.\nQuote: \"next Tuesday at 3pm\"\nFrom: notes/work.md, line 12"
  expect proven({answer: "x", quote: "not in any line at all"}, {matches: ["a.md:1: something else"]}, {matches: []}, {text: "q"}).starts_with("Your quote is not word for word")
  expect proven({answer: "", quote: ""}, {matches: []}, {matches: []}, {text: "q"}).starts_with("No answer was given")
}

test "the check itself: a quote is proved only by a line that holds it" {
  hits: Hits = {matches: ["a.md:3: The rent is 900 euros a month", "b.md:9: Rent is due on the 1st"]}
  expect proof(hits, "rent is due on the 1st") == "b.md:9: Rent is due on the 1st"
  expect proof(hits, "The rent is 950 euros") == ""
  expect proof(hits, "rent") == ""
  expect source_of("a.md:3: The rent is 900 euros a month") == "a.md, line 3"
  expect proof({matches: ["h.md:3: Rent is 900 euros a month, due on the 1st."]}, "\"Rent is 900 euros a month.\"") == "h.md:3: Rent is 900 euros a month, due on the 1st."
  expect proof({matches: ["h.md:3: Rent is 900 euros a month, due on the 1st."]}, "Rent is 950 euros a month.") == ""
  expect bare(" ...\"Due on the 1st!\" ") == "due on the 1st"
}

test "an answer the lines lead to is shown as worked out, with its step" {
  answers search_files: [{matches: ["maths.md:5: Homework 3 is worth 15 marks and homework 4 is worth 25 marks."]}]
  answers reader: [{answer: "40 marks.", quote: "Homework 3 is worth 15 marks and homework 4 is worth 25 marks"}]
  answers strong: [{answer: "", quote: ""}]
  answers thinker: [{answer: "Together they are worth 40 marks.", quote: "Homework 3 is worth 15 marks and homework 4 is worth 25 marks", how: "15 plus 25 is 40."}]
  answers judge: [{label: "follows", confidence: 0.9}]
  a = main({text: "How many marks are homework 3 and homework 4 worth together?"})
  expect a.text == "Worked out, not stated word for word: Together they are worth 40 marks.\nHow: 15 plus 25 is 40.\nQuote: \"Homework 3 is worth 15 marks and homework 4 is worth 25 marks\"\nFrom: maths.md, line 5"
}

test "a worked-out answer is held to a real line about the question" {
  hits: Hits = {matches: ["home.md:1: # Home", "home.md:3: Rent is 900 euros a month, due on the 1st.", "work.md:5: The staging server password is rotated every 90 days."]}
  none: Hits = {matches: []}
  rent: Msg = {text: "What is the rent for a whole year?"}
  wifi: Msg = {text: "What is the wifi code at home?"}
  expect reasoned({answer: "10800 euros.", quote: "Rent is 900 euros a month", how: "900 times 12 is 10800."}, hits, none, rent) == ""
  expect reasoned({answer: "", quote: "", how: ""}, hits, none, rent) == ""
  expect reasoned({answer: "10800 euros.", quote: "Rent is 950 euros a month", how: "950 times 12."}, hits, none, rent).starts_with("Your quote is not word for word")
  expect reasoned({answer: "10800 euros.", quote: "Rent is 900 euros a month", how: ""}, hits, none, rent).starts_with("In how, say the step")
  expect reasoned({answer: "It cannot be determined.", quote: "Rent is 900 euros a month", how: "Nothing says."}, hits, none, rent).starts_with("If the answer cannot be worked out")
  expect reasoned({answer: "It changes every 90 days.", quote: "password is rotated every 90 days", how: "The password is rotated."}, hits, none, wifi).starts_with("The line you quoted is about something else")
  expect reasoned({answer: "Home.", quote: "# Home", how: "It is the heading."}, hits, none, wifi).starts_with("Your quote is a heading")
  expect reasoned({answer: "10800 euros.", quote: "Rent is 900 euros a month", how: "900 times 12 is 10800."}, hits, {matches: ["work.md:5: The staging server password is rotated every 90 days."]}, rent).starts_with("The line you quoted is about something else")
  expect shared("What is the rent for a whole year?", "Rent is 900 euros a month, due on the 1st.") == 1
  expect shared("What is the wifi code at home?", "The staging server password is rotated every 90 days.") == 0
  expect non_answer("The answer is not provided in the lines.")
  expect not non_answer("Together they are worth 40 marks.")
}

test "a worked-out answer that does not survive a second look is not shown" {
  answers search_files: [{matches: ["plan.md:4: The library closes at 9pm on weekdays and 5pm on Saturday."]}]
  answers reader: [{answer: "", quote: ""}]
  answers strong: [{answer: "", quote: ""}]
  answers thinker: [{answer: "Yes.", quote: "5pm on Saturday", how: "6pm is after 5pm."}]
  answers judge: [{label: "wrong", confidence: 0.8}]
  a = main({text: "Is the library open at 6pm on Saturday?"})
  expect a.text.starts_with("I will not guess")
  expect not a.text.contains("Yes.")
  expect kept({answer: "x", quote: "y", how: "z"}, {label: "follows", confidence: 1}).answer == "x"
  expect kept({answer: "x", quote: "y", how: "z"}, {label: "wrong", confidence: 1}).answer == ""
}

test "when nothing can be worked out either, there is still no guess" {
  answers search_files: [{matches: ["a.md:1: Ravi likes tea"]}]
  answers reader: [{answer: "", quote: ""}]
  answers strong: [{answer: "", quote: ""}]
  answers thinker: [{answer: "", quote: "", how: ""}]
  a = main({text: "When is the demo with Ravi?"})
  expect a.text.starts_with("I will not guess")
}

// ------------------------------------------------------------------ evals
// An eval is written like a test, but the model answers for itself. The
// lines the search "found" are fixed here, so every model is given exactly
// the same thing to read. `kosika test` skips these; `kosika measure` runs
// them on the models you name.

eval "it finds a date and proves it" {
  answers search_files: [{matches: ["notes/work.md:12: Kosika demo for Ravi is next Tuesday at 3pm in room 4.", "notes/old.md:4: the last demo went well"]}]
  a = main({text: "When is the demo with Ravi?"})
  expect a.text.contains("Tuesday")
  expect a.text.contains("From: notes/work.md, line 12")
}

eval "it copies a number exactly" {
  answers search_files: [{matches: ["notes/home.md:3: Rent is 900 euros a month, due on the 1st.", "notes/home.md:5: Car insurance renews in March; the policy number is KX-22917."]}]
  a = main({text: "How much is the rent?"})
  expect a.text.contains("900")
  expect a.text.contains("From: notes/home.md, line 3")
}

eval "it picks the right line among several" {
  answers search_files: [{matches: ["notes/home.md:3: Rent is 900 euros a month, due on the 1st.", "notes/home.md:4: The landlord, Mr Okafor, can be reached on 555-0134.", "notes/home.md:5: Car insurance renews in March; the policy number is KX-22917."]}]
  a = main({text: "What is the policy number of the car insurance?"})
  expect a.text.contains("KX-22917")
  expect a.text.contains("From: notes/home.md, line 5")
}

eval "it answers from a line found by meaning alone" {
  answers search_files: [{matches: []}]
  answers find_files: [{matches: ["notes/home.md:3: Rent is 900 euros a month, due on the 1st.", "notes/home.md:4: The landlord, Mr Okafor, can be reached on 555-0134."]}]
  a = main({text: "What do I pay for the flat each month?"})
  expect a.text.contains("900")
  expect a.text.contains("From: notes/home.md, line 3")
}

eval "it will not answer what the lines do not say" {
  answers search_files: [{matches: ["notes/home.md:3: Rent is 900 euros a month, due on the 1st.", "notes/work.md:5: The staging server password is rotated every 90 days."]}]
  a = main({text: "What is the wifi password at home?"})
  expect a.text.starts_with("I will not guess")
}

eval "it adds two numbers from one line and shows the step" {
  answers search_files: [{matches: ["maths.md:5: Homework 3 is worth 15 marks and homework 4 is worth 25 marks.", "maths.md:2: The exam is on 14 November in room B204."]}]
  a = main({text: "How many marks are homework 3 and homework 4 worth together?"})
  expect a.text.contains("40")
  expect a.text.contains("From: maths.md, line 5")
}

eval "it compares a time with a closing time" {
  answers search_files: [{matches: ["plan.md:4: The library closes at 9pm on weekdays and 5pm on Saturday.", "plan.md:2: Gym on Monday and Thursday at 7am."]}]
  a = main({text: "Is the library open at 6pm on Saturday?"})
  expect a.text.lower().contains("no") or a.text.lower().contains("closed")
  expect a.text.contains("From: plan.md, line 4")
}

eval "it uses what a word means" {
  answers search_files: [{matches: ["maths.md:3: A graph with n vertices and no cycles that is connected has n - 1 edges.", "trees.md:2: Oak trees can live for over 800 years."]}]
  a = main({text: "How many edges does a tree with n vertices have?"})
  expect a.text.contains("n - 1") or a.text.contains("n-1")
  expect a.text.contains("From: maths.md, line 3")
}

eval "it multiplies to get a yearly figure" {
  answers search_files: [{matches: ["notes/home.md:3: Rent is 900 euros a month, due on the 1st.", "notes/home.md:4: The landlord, Mr Okafor, can be reached on 555-0134."]}]
  a = main({text: "How much rent do I pay in a year?"})
  expect a.text.contains("10800") or a.text.contains("10,800")
  expect a.text.contains("From: notes/home.md, line 3")
}

eval "it still will not work out what no line is about" {
  answers search_files: [{matches: ["notes/home.md:3: Rent is 900 euros a month, due on the 1st.", "notes/work.md:5: The staging server password is rotated every 90 days.", "notes/home.md:4: The landlord, Mr Okafor, can be reached on 555-0134."]}]
  a = main({text: "What is my landlord's email address?"})
  expect a.text.starts_with("I will not guess")
}
