// Coder: give it a small task in a Python, Kosika, JavaScript or TypeScript project, and it shows you every
// file it will make or change before it touches one. Then it runs the
// project's tests and tells you what happened.
//
//   kosika test main.kos
//   kosika studio FOLDER --model qwen2.5:7b --model-protocol ollama --allow-folder YOUR_PROJECT --allow-shell --in-session
//
// Run it with --in-session. It then works in a copy of your project: its
// changes and its test run happen there, and nothing reaches your real
// folder until you tick the files to bring back in the Session tab.
//
// What it does with one task:
//   1. It looks: lists folders, reads the files it needs, searches for words.
//   2. It plans: every file it will write, each with its whole new text.
//      You see that plan once and say yes or no.
//   3. The files are written, and python -m pytest is run.
//   4. It tells you what it changed and whether the tests passed.
//
// Say "fix" after a failing run and it tries again, shown what the tests
// printed. It keeps only the last run in memory.
//
// It replaces whole files, so it suits small files. It starts only python
// and node.
//
// JavaScript and TypeScript (.js, .ts and their kin) are read as Python
// is: what a file had must stay, a test goes in a test file such as
// calc.test.ts, and an import must name a file and a thing that are there.
// Their tests are run by Node itself (node --test), which also runs
// TypeScript, so nothing is installed. A project that tests another way,
// with a library and a build step, is not served yet.
//
// Kosika files (.kos) are held to more than Python ones. Before anything
// is written, Kosika itself checks each one and runs the tests written in
// it; a file that does not check, or has a failing test, never reaches
// you. That is possible because a Kosika test can reach nothing.
//
// A stronger helper, if you have one. Some people have another AI agent
// installed that runs from the command line, such as devin or omp. If you
// have allowed one (kosika outside --allow devin --within FOLDER), the
// coder asks it first. It works in a copy of your project and changes
// nothing; what it would change comes back here, is checked by the same
// plan check as the coder's own work, and is shown to you as one list to
// allow or refuse. If none is allowed, or its work does not pass the
// check twice, the coder does the task itself with its own model.
//
// A second pair of eyes. If you allowed two outside agents, the one that
// did not write the change reads it: the files as they would be, beside
// the files as they are. If it finds a problem, the first is asked once
// more, told what was found. What the reviewer said is shown to you with
// the list of files, before you say yes. Tests catch what was tested for;
// a reviewer catches a wrong edge case the tests never tried.
//
// A website. Ask for a site or a web page and the coder builds it in
// three rounds, one file each, so that each fits in what a model can write
// at once: the page (index.html), its look (styles.css), then its motion
// (script.js). You see and allow each file before it is written. Each round
// reads what the round before wrote, and the skills in the skills folder say
// how a page, its style and its motion are made well. An outside agent, if
// allowed, is asked for the whole site first. A site has no tests to run:
// instead the files are checked (a page that is whole, a stylesheet whose
// braces close, a script Node can read), and you are told which file to
// open in your browser.
//
// Say: add a function is_even to calc.py, with a test

record Msg { text: Text }
record Said { text: Text }
record Task { text: Text }
record Where { path: Text }
record Listing { names: Text[] }
record FileText { text: Text }
record Query { path: Text query: Text }
record Hits { matches: Text[] }
record NewFile { path: Text text: Text }
record Written { bytes: Number }
record Command { args: Text[] }
record Ran { exit_code: Number stdout: Text stderr: Text }

// What the coder says it did, in one or two sentences, and what it really
// did. `did` is filled in by Kosika from the changes that ran, never by the
// model, which will sometimes say it wrote a file it did not.
record Work { summary: Text did: Text[] }
// The last run: the task, what the tests printed, and whether they passed.
record Last { task: Text output: Text passed: Bool known: Bool }
record Result { text: Text last: Last }
// A test run, and the names it was narrowed to ("" when all were run).
record Tested { ran: Ran only: Text }

// What is asked of an outside agent, and what comes back: whether it
// could be asked, what it said, and the files it would change.
record Handover { agent: Text text: Text }
record Proposed { ok: Bool agent: Text said: Text files: Planned[] }
// The files to write, and a note for the person who is asked.
record Batch { files: Planned[] note: Text }
// What the engine is asked to read: what was asked for, and the files.
record Reading { text: Text files: Planned[] }
// A change handed to a reviewer, and what the reviewer said.
record Reviewing { agent: Text text: Text files: Planned[] }
record Reviewed { ok: Bool agent: Text said: Text }
record Note { text: Text }
// What the engine itself finds wrong with files about to be written.
record Engine { problems: Text[] }
record Faults { items: Text[] }
record Saved { count: Number }
// The files a task names, in the order they are written: what is tested
// first, its tests after.
record Plan { files: Text[] }
// The files written so far for one task, not yet saved.
record Drafted { files: Planned[] }
// The nth file of a plan to write, and one file to write: what a step of
// writing file by file is given.
record Nth { task: Task plan: Plan n: Number drafted: Drafted }
record One { task: Task path: Text drafted: Drafted failure: Text }

// Reads what a reviewer wrote and says only whether it reports a problem.
model reader

// Room for a whole file in one answer: a web page's stylesheet is long.
model engineer {
  input: Task
  output: Work
  parameters: {
    max_output_tokens: 6000
  }
}

// Writes one whole file as itself, not inside JSON: the way a small model
// writes code best. Used when a task names the files it is about.
model scribe {
  input: Task
  output: FileText as text
  parameters: {
    max_output_tokens: 4000
    temperature: 0.2
  }
}

memory journal of Last

tool list_folder {
  source system "files"
  operation: "list"
  access: observe
  input: Where
  output: Listing
}

tool read_file {
  source system "files"
  operation: "read"
  access: observe
  input: Where
  output: FileText
}

tool find_text {
  source system "files"
  operation: "search"
  access: observe
  input: Query
  output: Hits
}

tool write_file {
  source system "files"
  operation: "write"
  access: execute
  input: NewFile
  output: Written
}

tool run_python {
  source system "shell"
  operation: "python"
  access: execute
  input: Command
  output: Ran
}

// Node, for the tests of a JavaScript or TypeScript project.
tool run_node {
  source system "shell"
  operation: "node"
  access: execute
  input: Command
  output: Ran
}

// An outside agent, asked to do the task in a copy of the project. It
// changes nothing here, so asking needs no approval.
tool ask_outside {
  source system "outside"
  operation: "propose"
  access: observe
  input: Handover
  output: Proposed
}

// Every file of a proposal, written in one step with one approval.
tool save_all {
  source system "files"
  operation: "write_all"
  access: execute
  input: Batch
  output: Saved
}

// A second outside agent, asked to read a proposed change. It is shown
// the change in a copy and changes nothing.
tool ask_review {
  source system "outside"
  operation: "review"
  access: observe
  input: Reviewing
  output: Reviewed
}

// Kosika's own reading of files about to be written: Python that is not
// valid or uses a name it never defines; Kosika that does not check or
// whose tests fail; and the rules of the skills that fit the task. It
// reaches nothing, so asking needs no approval.
tool code_check {
  source system "kosika"
  operation: "check_files"
  access: observe
  input: Reading
  output: Engine
}

agent helper {
  can: [ask_outside, ask_review, code_check, list_folder]
  max_steps: 1
}

agent writer {
  can: [save_all]
  max_steps: 1
}

agent coder {
  model: engineer
  can: [list_folder, read_file, find_text, write_file]
  max_steps: 8
  max_tool_calls: 16
  check: plan_check
  instructions: "You are a careful programmer working in one project. It may be Python, Kosika, JavaScript or TypeScript: write in the language of the files that are there. You cannot see anything until you use a tool. First list the folder with path \".\". Read every file you will write before you write it; that includes the test file if one exists. Then request all your changes in one reply, one write_file for each file. write_file replaces the whole file, so its text must be the complete new file: every line that was there and should stay, plus what you add. A task that adds a function with a test needs two write_file calls: the source file with the new function added, and the test file with its old tests kept and the new test added. Import the new function in the test file. Change nothing the task does not need. Write only the files the task needs changed: to fix a bug, change the file with the bug and leave the tests as they are. After the changes, answer with what you did in summary, and an empty list in did."
}

agent runner {
  can: [run_python, run_node]
  max_steps: 1
}

// The builder of a website: one file a round.
agent builder {
  model: engineer
  can: [list_folder, read_file, write_file]
  max_steps: 6
  max_tool_calls: 10
  check: plan_check
  instructions: "You are a web designer and front-end developer who builds modern, beautiful, professional websites with plain HTML, CSS and JavaScript: no frameworks, no build step and nothing loaded from the internet. Each request asks for one file. First list the folder with path \".\" and read the files the request names, so what you write fits what is there. Then call write_file once, for that one file, with its complete text: every line of it, finished, never cut short and never with a placeholder or a comment saying more goes here. Write real, specific words for the content, never lorem ipsum. After the file is written, answer with what you made in summary, and an empty list in did."
}

// ---------------------------------------------------------------- checking the plan
//
// A small model asked to add a function will often write the file again
// with only the new function in it, or put its tests in the wrong file.
// That can be seen by reading lines, so it is checked here, in Kosika,
// before the plan is shown to anyone. A plan with something wrong is sent
// back to the model with these sentences. (Whether a file is valid Python
// at all needs a Python parser, and Kosika's engine checks that.)

// One file the plan would write: where, its whole new text, the file as it
// is now, and whether it is there now at all.
record Planned { path: Text text: Text before: Text exists: Bool }

// What a file defines at its left margin. In Python: its functions and
// classes. In Kosika: its functions, records, workflows, agents, tools and
// models by name, and each test by its words, as `test "what it shows"`.
fn defined(text: Text) -> Text[] {
  var names: Text[] = []
  for line in text.lines() {
    var rest = ""
    for start in ["def ", "async def ", "class ", "fn ", "record ", "workflow ", "agent ", "tool ", "model ", "default model ", "memory "] {
      if rest.is_empty() and line.starts_with(start) { rest = line.drop(start.length()) }
    }
    var name = rest.split("(").first().or("").split(":").first().or("").split("{").first().or("").trim()
    if line.starts_with("test \"") { name = "test \"" + line.drop(6).split("\"").first().or("") + "\"" }
    if not name.is_empty() and not names.contains(name) { names = names.append(name) }
  }
  return names
}

fn is_kosika(path: Text) -> Bool {
  return path.lower().ends_with(".kos")
}

// ---------------------------------------------------------------- JavaScript and TypeScript
//
// The same reading for a third family of files. Node runs both, and runs
// their tests itself, so nothing has to be installed.

fn is_script(path: Text) -> Bool {
  let name = path.lower()
  for ending in [".js", ".mjs", ".cjs", ".ts", ".mts", ".jsx", ".tsx"] {
    if name.ends_with(ending) { return true }
  }
  return false
}

// A test file as Node finds one: calc.test.ts, or anything in a test folder.
fn is_script_test(path: Text) -> Bool {
  let name = file_name(path).lower()
  let folders = path.replace("\\", "/").lower().split("/")
  return name.contains(".test.") or name.contains(".spec.") or folders.contains("test") or folders.contains("__tests__")
}

// The name a line begins with: its letters, digits, _ and $.
fn name_at(text: Text) -> Text {
  var name = ""
  for letter in text.chars() {
    if not "abcdefghijklmnopqrstuvwxyz0123456789_$".contains(letter.lower()) { return name }
    name = name + letter
  }
  return name
}

// The words inside the quotes a text begins with, or "".
fn quoted(text: Text) -> Text {
  let mark = text.take(1)
  if mark != "\"" and mark != "'" and mark != "`" { return "" }
  return text.drop(1).split(mark).first().or("")
}

// A line without the words that may stand before what it declares.
fn bare(line: Text) -> Text {
  var rest = line
  for word in ["export ", "default ", "declare ", "async ", "abstract "] {
    if rest.starts_with(word) { rest = rest.drop(word.length()) }
  }
  return rest
}

// What a JavaScript or TypeScript file defines at its left margin: its
// functions, classes, constants, types and interfaces by name, and each
// test, wherever it stands, by its words, as `test("what it shows")`.
fn script_defined(text: Text) -> Text[] {
  var names: Text[] = []
  for line in text.lines() {
    let rest = bare(line)
    var name = ""
    for start in ["function* ", "function ", "class ", "const ", "let ", "var ", "interface ", "type ", "enum "] {
      if name.is_empty() and rest.starts_with(start) { name = name_at(rest.drop(start.length())) }
    }
    for start in ["test(", "it("] {
      if line.trim().starts_with(start) and not quoted(line.trim().drop(start.length())).is_empty() {
        name = "test(\"" + quoted(line.trim().drop(start.length())) + "\")"
      }
    }
    if not name.is_empty() and not names.contains(name) { names = names.append(name) }
  }
  return names
}

// What a file lets others import: what it declares after `export`, and
// the names in a line such as `export { a, b as c }`.
fn exported(text: Text) -> Text[] {
  var names: Text[] = []
  for line in text.lines() {
    if line.starts_with("export {") {
      for part in line.drop(8).split("}").first().or("").split(",") {
        let name = part.trim().words().last().or("")
        if not name.is_empty() { names = names.append(name) }
      }
    } else if line.starts_with("export ") {
      names = names.concat(script_defined(line))
    }
  }
  return names
}

// A file's name without its ending: calc for calc.test.ts is calc.test.
fn stem(path: Text) -> Text {
  let parts = file_name(path).split(".")
  return if parts.length() < 2 { file_name(path) } else { parts.take(parts.length() - 1).join(".") }
}

// What one file's imports get wrong about the other files of the plan: a
// name the other file does not export, or the other file called by a name
// Node will not find. Only imports written on one line are read.
fn import_problems(file: Planned, files: Planned[]) -> Text[] {
  var wrong: Text[] = []
  for line in file.text.lines() {
    if line.starts_with("import ") and line.contains(" from ") and line.contains("{") {
      let source = quoted(line.split(" from ").last().or("").trim())
      for other in files {
        // "./calc", "./calc.js" and "./calc.ts" all mean the planned calc.ts.
        let meant = stem(other.path) == stem(source) or stem(other.path) == file_name(source)
        if source.starts_with(".") and other.path != file.path and is_script(other.path) and meant {
          if file_name(other.path) != file_name(source) {
            wrong = wrong.append(file.path + ": it imports from \"" + source + "\", but the file is " + file_name(other.path) + ". Node needs the whole name: \"./" + file_name(other.path) + "\"")
          }
          let has = exported(other.text)
          for part in line.split("{").last().or("").split("}").first().or("").split(",") {
            let name = part.trim().words().first().or("")
            let wanted = if name == "type" { part.trim().words().drop(1).first().or("") } else { name }
            if not wanted.is_empty() and not has.contains(wanted) {
              wrong = wrong.append(file.path + ": it imports " + wanted + " from " + file_name(other.path) + ", which does not export it")
            }
          }
        }
      }
    }
  }
  return wrong
}

// What is wrong with the JavaScript and TypeScript files of a plan.
fn script_check(request: Text, files: Planned[]) -> Text[] {
  var wrong: Text[] = []
  let named = for word in request.words() { word.trim_marks(".,;:!?()'\"`") }
  let leaving = takes_away(request)
  var scripts = 0
  var tests = 0
  for file in files {
    if is_script(file.path) {
      scripts += 1
      if is_script_test(file.path) { tests += 1 }
      let now = script_defined(file.text)
      let had = script_defined(file.before)
      let gone = for name in had where not now.contains(name) and not (leaving and (named.contains(name) or name.starts_with("test("))) { name }
      if file.exists and not gone.is_empty() {
        wrong = wrong.append(file.path + ": it no longer has " + listed(gone) + ", which the file has now. write_file replaces the whole file: keep everything that is there and add to it")
      }
      let strays = for name in now where name.starts_with("test(") and not had.contains(name) { name }
      if not is_script_test(file.path) and not strays.is_empty() {
        wrong = wrong.append(file.path + ": it holds the test " + listed(strays) + ". Tests go in a test file, such as " + stem(file.path) + ".test." + file_name(file.path).split(".").last().or("js"))
      }
      wrong = wrong.concat(import_problems(file, files))
    }
  }
  if scripts > 0 and tests == 0 and wants_test(request) {
    wrong = wrong.append("the task asks for a test, but the plan writes no test file. Add a write_file for one, named like calc.test.ts for calc.ts")
  }
  return wrong
}

// How many tests a Kosika text holds.
fn test_count(text: Text) -> Number {
  var count = 0
  for line in text.lines() {
    if line.starts_with("test \"") { count += 1 }
  }
  return count
}

fn file_name(path: Text) -> Text {
  return path.replace("\\", "/").split("/").last().or(path)
}

fn is_test_file(path: Text) -> Bool {
  let name = file_name(path).lower()
  return name.starts_with("test_") or name.ends_with("_test.py")
}

// "a", "a and b", "a, b and c".
fn listed(names: Text[]) -> Text {
  if names.length() < 2 { return names.join("") }
  return names.take(names.length() - 1).join(", ") + " and " + names.last().or("")
}

// Does the request speak of taking something away or changing its name?
fn takes_away(request: Text) -> Bool {
  let words = for word in request.lower().words() { word.trim_marks(".,;:!?()'\"`") }
  for verb in ["rename", "renamed", "remove", "removed", "delete", "deleted", "drop", "replace", "replaced", "move", "moved"] {
    if words.contains(verb) { return true }
  }
  return false
}

// Does the request ask for a test along with the change?
fn wants_test(request: Text) -> Bool {
  let said = request.lower().words().join(" ")
  for words in ["with a test", "with tests", "and a test", "and tests", "with its test", "tests for", "test file"] {
    if said.contains(words) { return true }
  }
  return false
}

// What is wrong with a plan, one sentence for each thing, or nothing.
fn plan_check(request: Text, files: Planned[]) -> Text[] {
  var wrong: Text[] = []
  let named = for word in request.words() { word.trim_marks(".,;:!?()'\"`") }
  let leaving = takes_away(request)
  var python = 0
  var tests = 0
  for file in files {
    if file.path.lower().ends_with(".py") {
      python += 1
      if is_test_file(file.path) { tests += 1 }
      let now = defined(file.text)
      let had = defined(file.before)
      // A function the file has and the plan drops. One the request names
      // while speaking of removing or renaming is meant to go; naming it
      // alone is not enough, or "add a function" would excuse losing add.
      // The test of a function that is renamed or removed goes with it.
      let gone = for name in had where not now.contains(name) and not (leaving and (named.contains(name) or (name.starts_with("test_") and named.contains(name.drop(5))))) { name }
      if file.exists and not gone.is_empty() {
        wrong = wrong.append(file.path + ": it no longer has " + listed(gone) + ", which the file has now. write_file replaces the whole file: keep everything that is there and add to it")
      }
      let strays = for name in now where name.starts_with("test_") and not had.contains(name) { name }
      if not is_test_file(file.path) and not strays.is_empty() {
        wrong = wrong.append(file.path + ": it holds the test " + listed(strays) + ". Tests go in a test file, such as test_" + file_name(file.path))
      }
    }
  }
  if python > 0 and tests == 0 and wants_test(request) {
    wrong = wrong.append("the task asks for a test, but the plan writes no test file. Add a write_file for the test file as well")
  }
  // Kosika keeps a file's tests in the file. What it had must stay, and a
  // task that asks for a test must leave some file with one more.
  var kosika = 0
  var gained = 0
  for file in files {
    if is_kosika(file.path) {
      kosika += 1
      let now = defined(file.text)
      let lost = for name in defined(file.before) where not now.contains(name) and not (leaving and (named.contains(name) or name.starts_with("test \""))) { name }
      if file.exists and not lost.is_empty() {
        wrong = wrong.append(file.path + ": it no longer has " + listed(lost) + ", which the file has now. Keep everything that is there and add to it")
      }
      let had = defined(file.before)
      let fresh = for name in now where name.starts_with("test ") and not had.contains(name) { name }
      if not fresh.is_empty() { gained += 1 }
    }
  }
  if kosika > 0 and python == 0 and gained == 0 and wants_test(request) {
    wrong = wrong.append("the task asks for a test, but no Kosika file gains one. Add a test block, written test \"what it shows\" { expect ... }, to the file")
  }
  return wrong.concat(script_check(request, files)).concat(site_check(files))
}

// ---------------------------------------------------------------- routing

fn kind_of(msg: Msg) -> Text {
  let text = msg.text.lower().trim()
  var kind = "task"
  if text == "" or text == "help" { kind = "help" }
  else if text == "fix" or text == "try again" or text.starts_with("fix it") { kind = "fix" }
  else if text == "test" or text == "tests" or text == "run the tests" { kind = "test" }
  else if is_site_request(text) { kind = "site" }
  return kind
}

fn task_of(msg: Msg) -> Task {
  return {text: msg.text.trim()}
}

// What the coder is asked when the last run's tests failed.
fn fix_task(last: Last) -> Task {
  return {text: "The tests fail after your last change. The task was: " + last.task + "\nThis is what the tests printed:\n" + last.output.take(1800) + "\nRead the files involved again and put it right."}
}

// ---------------------------------------------------------------- reading the tests

// The end of what pytest printed is where the verdict is.
fn printed(ran: Ran) -> Text {
  let both = (ran.stdout + "\n" + ran.stderr).trim()
  let lines = both.split("\n")
  return if lines.length() > 25 { lines.drop(lines.length() - 25).join("\n") } else { both }
}

// Node says "tests 0" and calls that a success when it finds no test.
fn none_ran(ran: Ran) -> Bool {
  for line in ran.stdout.lines() {
    if line.trim().ends_with(" tests 0") { return true }
  }
  return false
}

fn verdict(ran: Ran) -> Text {
  var said = "The tests failed."
  if ran.exit_code == 0 and none_ran(ran) { said = "No tests were found to run." }
  else if ran.exit_code == 0 { said = "The tests pass." }
  else if ran.exit_code == 5 { said = "No tests were found to run." }
  return said
}

fn wrote_something(work: Work) -> Said {
  return {text: if work.did.length() > 0 { "yes" } else { "no" }}
}

fn kept(work: Work) -> Work {
  return work
}

// The task again, for a coder that answered without changing anything.
fn pushed(task: Task) -> Task {
  return {text: task.text + "\nYou answered before without writing anything, so nothing has been done. List the folder, read the files, then call write_file for every file that must be created or changed. Do not answer until the files are written."}
}

// With nothing written, what the model wrote is shown as what it said.
fn said_only(work: Work) -> Text {
  return if work.did.length() == 0 and work.summary.trim().length() > 0 { " The coder said: " + work.summary.trim() } else { "" }
}

// The files that were really written, from Kosika's own record.
fn files_line(work: Work) -> Text {
  var files: Text[] = []
  for line in work.did {
    files = files.append(line.words().drop(1).join(" "))
  }
  return if files.length() > 0 { "Wrote: " + files.unique().join(", ") } else { "No file was written." }
}

fn worked(task: Task, work: Work, ran: Ran) -> Result {
  let out = printed(ran)
  let tail = if ran.exit_code == 0 { "" } else { "\n" + out + "\nSay \"fix\" and I will try to put it right." }
  // With nothing written, passing tests say nothing about the task, and
  // what the model says it did is not to be believed.
  let judged = if work.did.length() == 0 and ran.exit_code == 0 { "Nothing was changed, so the task is not done. The tests as they were still pass." } else { verdict(ran) }
  return {
    text: (if work.did.length() == 0 { "" } else { work.summary.trim() + "\n" }) + files_line(work) + said_only(work) + "\n" + judged + tail,
    last: {task: task.text, output: out, passed: ran.exit_code == 0 and not none_ran(ran), known: true}
  }
}

// ---------------------------------------------------------------- which tests to run
//
// A large project's tests can take a quarter of an hour. After a change
// only the tests that have to do with the changed files are run: pytest
// is asked for the tests whose names hold the name of a changed file. If
// that finds none, they are all run, so a change is never left untested.

// A name pytest can be asked for: letters, digits and underscores only.
fn plain_name(name: Text) -> Bool {
  if name.is_empty() or name.length() > 60 { return false }
  for letter in name.lower().chars() {
    if not "abcdefghijklmnopqrstuvwxyz0123456789_".contains(letter) { return false }
  }
  return true
}

// The names to look for among the tests: each changed Python file's name
// without .py, and without the test_ a test file begins with.
fn test_names(work: Work) -> Text[] {
  var names: Text[] = []
  for line in work.did {
    let file = file_name(line.words().drop(1).join(" "))
    if file.lower().ends_with(".py") {
      var name = file.take(file.length() - 3)
      if name.starts_with("test_") { name = name.drop(5) }
      if name.ends_with("_test") { name = name.take(name.length() - 5) }
      if plain_name(name) and not names.contains(name) { names = names.append(name) }
    }
  }
  return names.take(8)
}

// The Kosika file whose tests to run after a change that touched no
// Python: the first one written. "" when Python was changed too.
fn kosika_file(work: Work) -> Text {
  var found = ""
  for line in work.did {
    let path = line.words().drop(1).join(" ")
    if path.lower().ends_with(".py") { return "" }
    if found.is_empty() and is_kosika(path) { found = path }
  }
  return found
}

// The test files a change wrote, for Node to run. With none, Node is
// left to find every test the project has.
fn script_tests(work: Work) -> Text[] {
  var files: Text[] = []
  for line in work.did {
    let path = line.words().drop(1).join(" ").replace("\\", "/")
    if is_script(path) and is_script_test(path) and not files.contains(path) { files = files.append(path) }
  }
  return files.take(8)
}

fn node_args(files: Text[]) -> Text[] {
  return ["--test"].concat(files)
}

// Which tests follow a change: "python" when any Python was written,
// "kosika" when a Kosika file was, "node" when only JavaScript or
// TypeScript was. With nothing written, the project's Python tests.
fn runner_of(work: Work) -> Text {
  if is_site_work(work) { return "web" }
  var scripts = 0
  for line in work.did {
    let path = line.words().drop(1).join(" ")
    if path.lower().ends_with(".py") { return "python" }
    if is_script(path) { scripts += 1 }
  }
  if not kosika_file(work).is_empty() { return "kosika" }
  return if scripts > 0 { "node" } else { "python" }
}

// Which tests a folder has when nothing is known of the last change:
// Node's, if it holds JavaScript or TypeScript and no Python.
fn runner_in(folder: Listing) -> Text {
  var scripts = 0
  for name in folder.names {
    if name.lower().ends_with(".py") or name == "pyproject.toml" { return "python" }
    if is_script(name) or name == "package.json" { scripts += 1 }
  }
  return if scripts > 0 { "node" } else { "python" }
}

fn test_args(names: Text[]) -> Text[] {
  let all = ["-m", "pytest", "-q", "-x", "--no-header", "-p", "no:cacheprovider"]
  return if names.is_empty() { all } else { all.concat(["-k", names.join(" or ")]) }
}

fn as_tested(ran: Ran, names: Text[]) -> Tested {
  return {ran: ran, only: names.join(", ")}
}

// Narrowed and found nothing to run: then they must all be run.
fn found_none(ran: Ran, names: Text[]) -> Bool {
  return ran.exit_code == 5 and not names.is_empty()
}

// The report of a run, saying so when only some of the tests were run.
fn worked_on(task: Task, work: Work, tested: Tested) -> Result {
  if is_site_work(work) { return site_report(task, work, tested.ran) }
  let whole = worked(task, work, tested.ran)
  if tested.only.is_empty() or tested.ran.exit_code != 0 or work.did.is_empty() { return whole }
  return {
    text: whole.text.replace("The tests pass.", "The tests for " + tested.only + " pass. Only those were run; say \"test\" to run them all."),
    last: whole.last
  }
}

fn tested(last: Last, ran: Ran) -> Result {
  let out = printed(ran)
  return {
    text: verdict(ran) + "\n" + out,
    last: {task: last.task, output: out, passed: ran.exit_code == 0 and not none_ran(ran), known: last.known}
  }
}

// The files a task names: words such as calc.py or src/text.ts. A test
// file that goes with a named file is added when the task asks for tests
// and one is there. Tests come last, so they are written knowing the code.
fn file_plan(task: Task, folder: Listing) -> Plan {
  let kinds = [".py", ".ts", ".js", ".mjs", ".kos", ".json", ".md", ".txt", ".html", ".css"]
  var named: Text[] = []
  for word in task.text.replace(",", " ").replace(";", " ").replace("(", " ").replace(")", " ").replace("`", " ").words() {
    let clean = word.trim_marks(".:!?'\"")
    for kind in kinds {
      if clean.lower().ends_with(kind) and clean.length() > kind.length() and not named.contains(clean) { named = named.append(clean) }
    }
  }
  if named.is_empty() or named.length() > 3 { return {files: []} }
  let wants_tests = task.text.lower().contains("test")
  var code: Text[] = []
  var tests: Text[] = []
  for path in named {
    if is_test_file(path) or is_script_test(path) { tests = tests.append(path) } else { code = code.append(path) }
  }
  if wants_tests and tests.is_empty() {
    for path in code {
      let pair = "test_" + file_name(path)
      if path.ends_with(".py") and folder.names.contains(pair) and not tests.contains(pair) { tests = tests.append(pair) }
    }
  }
  let all = code.concat(tests)
  return {files: if all.length() > 3 { [] } else { all }}
}

// What a model that has never seen Kosika needs to write it: the rules
// and one whole program that checks and passes its tests.
fn kosika_example() -> Text {
  return "Kosika is its own language, not Python. Rules: no semicolons; record fields have no commas between them; every fn ends with return; a workflow is a list of steps, one per line, each `name = call`; a thinking step (classify, extract, summarize, decide, use_model) is only ever a workflow line such as `x = classify TEXT into [\"a\", \"b\"]`, never inside a fn, and gives a Choice {label, confidence}; `learn` and then `otherwise f(...)` may follow it; `memory NAME of Record` keeps records, read with `recall NAME under KEY` (a NAMERecalled with found and value.value()) and written with `remember VALUE in NAME under KEY`; a test is `test \"words\" { ... }` with `answers MODEL: [...]` for each model answer in order and `expect` lines. This complete program checks and its tests pass; follow its shape:\n\n// Sorts a piece of feedback and counts each kind.\nrecord Feedback { text: Text }\nrecord Tally { count: Number }\nrecord Sorted { kind: Text count: Number }\n\nmodel assistant\n\nmemory tallies of Tally\n\nfn unsure(f: Feedback) -> Choice {\n  return {label: \"idea\", confidence: 0}\n}\n\nfn next_count(known: TalliesRecalled) -> Tally {\n  let before = if known.found { known.value.value().count } else { 0 }\n  return {count: before + 1}\n}\n\nfn sorted(label: Choice, tally: Tally) -> Sorted {\n  return {kind: label.label, count: tally.count}\n}\n\nworkflow main(f: Feedback) -> Sorted {\n  budget 3 model calls, 120 seconds\n  label  = classify f.text into [\"praise\", \"complaint\", \"idea\"] learn otherwise unsure(f)\n  known  = recall tallies under label.label\n  tally  = next_count(known)\n  saved  = remember tally in tallies under label.label\n  result = sorted(label, tally)\n}\n\ntest \"a complaint is sorted and counted\" {\n  answers assistant: [{label: \"complaint\", confidence: 0.9}]\n  r = main({text: \"The app keeps crashing.\"})\n  expect r.kind == \"complaint\"\n  expect r.count == 1\n}\n\ntest \"each kind is counted on its own\" {\n  answers assistant: [{label: \"idea\", confidence: 0.8}, {label: \"idea\", confidence: 0.7}, {label: \"praise\", confidence: 0.9}]\n  a = main({text: \"Add a dark mode.\"})\n  b = main({text: \"Could it export to PDF?\"})\n  c = main({text: \"I love it.\"})\n  expect b.count == 2\n  expect c.count == 1\n}\n"
}

fn nth_one(job: Nth) -> One {
  return {task: job.task, path: job.plan.files[job.n], drafted: job.drafted, failure: ""}
}

fn no_drafts() -> Drafted {
  return {files: []}
}

fn kept_drafts(drafted: Drafted) -> Drafted {
  return drafted
}

// What the scribe is asked for one file: the task, the file as it is, and
// every file already written for this task, so names and imports agree.
fn scribe_task(task: Task, path: Text, old: Text, drafted: Drafted, failure: Text) -> Task {
  var shown = ""
  for file in drafted.files {
    if file.path != path { shown = shown + "\n--- " + file.path + " (already written) ---\n" + file.text.take(6000) + "\n" }
  }
  let now = if old.trim().is_empty() { path + " does not exist yet: write it new." } else { "This is " + path + " now. Keep everything in it that should stay:\n```\n" + old.take(8000) + "\n```" }
  let tests = if is_test_file(path) or is_script_test(path) { " It is a test file: import what it tests from the files above by their names, keep the tests that are there, and add tests for what the task asks." } else { "" }
  let broken = if failure.trim().is_empty() { "" } else { "\nThe tests failed with this output. Find the cause in " + path + " and fix it:\n" + failure.take(2000) + "\n" }
  let language = if is_kosika(path) { kosika_example() + "\n" } else { "" }
  return {text: language + "Task: " + task.text + "\n" + shown + "\n" + now + broken + "\nWrite the complete new " + path + "." + tests + " Give only the file."}
}

// The drafts with one file written, or as they were when nothing came back.
fn with_draft(drafted: Drafted, path: Text, old: Text, text: Text) -> Drafted {
  if text.trim().is_empty() { return drafted }
  var files: Planned[] = []
  for file in drafted.files {
    if file.path != path { files = files.append(file) }
  }
  let body = if text.ends_with("\n") { text } else { text + "\n" }
  return {files: files.append({path: path, text: body, before: old, exists: not old.is_empty()})}
}

fn drafted_work(drafted: Drafted) -> Work {
  let did = for file in drafted.files { "save_all " + file.path }
  let names = for file in drafted.files { file.path }
  return {summary: if names.is_empty() { "" } else { "Wrote " + names.join(", ") + ", one whole file at a time." }, did: did}
}

// Which file to write again: the one named last in the failure's own
// lines, as `lru.py:12:`, which is where it went wrong; a test that
// expects the wrong thing is put right as readily as the code. Without
// such a line, the first file written.
fn to_mend(drafted: Drafted, output: Text) -> Text {
  var chosen = ""
  for file in drafted.files {
    if chosen.is_empty() { chosen = file.path }
  }
  for line in output.lines() {
    for file in drafted.files {
      if line.contains(file_name(file.path) + ":") { chosen = file.path }
    }
  }
  return chosen
}

fn as_is(result: Result) -> Result {
  return result
}

// Its own change wrote something and the tests that ran then failed.
fn needs_mending(work: Work, tested: Tested) -> Bool {
  return not work.did.is_empty() and tested.ran.exit_code != 0 and tested.ran.exit_code != 5 and not is_site_work(work)
}

// The second try, saying there was a first; or the first, if the second
// wrote nothing.
fn mended(before: Result, after: Result, fixed: Work) -> Result {
  if fixed.did.is_empty() { return before }
  let opening = if after.last.passed { "My first try failed its tests, so I read what they printed and put it right.
" } else { "My first try failed its tests and a second try did not fix them.
" }
  return {text: opening + after.text, last: after.last}
}

fn nothing(last: Last, text: Text) -> Result {
  return {text: text, last: last}
}

// The last run as it was kept, or an empty one when there has been none.
fn earlier(past: JournalRecalled) -> Last {
  let none: Last = {task: "", output: "", passed: false, known: false}
  return if past.found { past.value.value() } else { none }
}

fn last_of(result: Result) -> Last {
  return result.last
}

fn say(result: Result) -> Said {
  return {text: result.text}
}

// ---------------------------------------------------------------- workflows

workflow second_try(task: Task) -> Work {
  work = ask coder(task.text) otherwise {summary: "I could not finish a plan for that. Try a smaller task, or name the file.", did: []}
  require approval
}

// ---------------------------------------------------------------- outside help

fn nobody() -> Proposed {
  return {ok: false, agent: "", said: "", files: []}
}

// What is wrong with what an outside agent proposes. Nothing proposed is
// itself something wrong.
fn proposal_problems(task: Task, got: Proposed) -> Text[] {
  if not got.ok { return ["nobody could be asked"] }
  if got.files.is_empty() { return ["it changed no file"] }
  return plan_check(task.text, got.files)
}

// A proposal read twice: by the coder's own check, and by the engine.
fn all_faults(task: Task, got: Proposed, engine: Engine) -> Faults {
  let mine = proposal_problems(task, got)
  let theirs = for line in engine.problems where not mine.contains(line) { line }
  return {items: mine.concat(theirs)}
}

workflow judge(task: Task, got: Proposed) -> Faults {
  engine = execute helper.code_check(task.text, got.files) otherwise {problems: []}
  faults = all_faults(task, got, engine)
}

// The task again, with what was wrong with the first answer.
fn outside_again(task: Task, wrong: Text[]) -> Task {
  return {text: task.text + "\nYour first answer was not accepted because: " + wrong.join("; ") + ". Do the task again with this put right."}
}

// "use" when a proposal can be written, "again" when it is worth asking
// once more, "self" when the coder should do the task itself.
fn verdict_on(got: Proposed, wrong: Text[], second: Bool) -> Text {
  if wrong.is_empty() { return "use" }
  if got.ok and not second { return "again" }
  return "self"
}

// An outside agent's work, as the coder's own is reported: what it said,
// and the files that were written.
fn outside_work(got: Proposed) -> Work {
  let did = for file in got.files { "save_all " + file.path }
  // Its last line that says something: some agents end with "Working...".
  var said = ""
  for line in got.said.trim().lines() {
    if not line.trim().is_empty() and not line.trim().lower().starts_with("working") { said = line.trim().take(300) }
  }
  return {summary: "Asked " + got.agent + ". It said: " + said, did: did}
}

workflow run_all() -> Tested {
  ran    = execute runner.run_python(["-m", "pytest", "-q", "-x", "--no-header", "-p", "no:cacheprovider"])
  tested = as_tested(ran, [])
  require approval
}

workflow test_python(work: Work) -> Tested {
  first  = execute runner.run_python(test_args(test_names(work)))
  tested = match found_none(first, test_names(work)) {
    case true { call run_all() }
    case _ { as_tested(first, test_names(work)) }
  }
  require approval
}

// A Kosika file's tests are in the file, and Kosika runs them.
workflow test_kosika(file: Note) -> Tested {
  ran    = execute runner.run_python(["-m", "kosika.cli", "test", file.text])
  tested = as_tested(ran, [file.text])
  require approval
}

fn ran_of(tested: Tested) -> Ran {
  return tested.ran
}

workflow run_all_node() -> Tested {
  ran    = execute runner.run_node(["--test"])
  tested = as_tested(ran, [])
  require approval
}

// Node runs a JavaScript or TypeScript project's tests itself.
workflow test_script(work: Work) -> Tested {
  ran    = execute runner.run_node(node_args(script_tests(work)))
  tested = as_tested(ran, script_tests(work))
  require approval
}

workflow run_tests(work: Work) -> Tested {
  tested = match runner_of(work) {
    case "kosika" { call test_kosika(noted(kosika_file(work))) }
    case "node" { call test_script(work) }
    case "web" { call check_site(work) }
    case _ { call test_python(work) }
  }
  require approval
}

workflow ask_helper(task: Task) -> Proposed {
  got = execute helper.ask_outside("", task.text) otherwise nobody()
}

// ---------------------------------------------------------------- a second pair of eyes

fn noted(text: Text) -> Note {
  return {text: text}
}

fn no_review() -> Reviewed {
  return {ok: false, agent: "", said: ""}
}

// What the reviewer said, without the working noise some agents end with.
fn review_words(read: Reviewed) -> Text {
  var kept: Text[] = []
  for line in read.said.trim().lines() {
    if not line.trim().is_empty() and not line.trim().lower().starts_with("working") { kept = kept.append(line.trim()) }
  }
  return kept.join(" ").take(600)
}

fn review_question(read: Reviewed) -> Text {
  return "A programmer reviewed a change and wrote the text below. Does the review report at least one real problem with the change, such as a bug, a wrong result, a weak or missing test, or something changed that was not asked for? Answer problem if it does. Answer fine if the review says there are no findings or that the change looks good.\n\nReview:\n" + review_words(read)
}

// "problem" when the reviewer found one, else "write".
fn after_reading(read: Reviewed, judged: Choice) -> Text {
  return if read.ok and judged.label == "problem" { "problem" } else { "write" }
}

// What the person is told with the list of files.
fn review_note(read: Reviewed, judged: Choice) -> Text {
  if not read.ok { return "Not read by a second agent." }
  let found = if judged.label == "problem" { ", which found a problem" } else if judged.label == "fine" { ", which found no problem" } else { "" }
  return "Read by " + read.agent + found + ". It said: " + review_words(read)
}

// The task again for the author, with what the reviewer found.
fn after_review(task: Task, read: Reviewed) -> Task {
  return {text: task.text + "\nA reviewer read your first answer and found this: " + review_words(read) + "\nDo the task again with this put right."}
}

workflow get_review(task: Task, got: Proposed) -> Reviewed {
  read = execute helper.ask_review("not:" + got.agent, task.text, got.files) otherwise no_review()
}

workflow judge_review(read: Reviewed) -> Choice {
  judged = classify review_question(read) into ["problem", "fine"] using reader otherwise {label: "unclear", confidence: 0}
}

// The author's second answer, after the reviewer's remarks, is written if
// it passes the plan check. If it does not, the first answer is offered
// with the reviewer's remarks, and the person decides.
workflow redo_after_review(task: Task, got: Proposed, read: Reviewed) -> Result {
  again  = call ask_helper(after_review(task, read))
  faults = call judge(task, again)
  result = match faults.items.is_empty() {
    case true { call write_proposal(task, again, noted("A reviewer (" + read.agent + ") found a problem in the first answer, and the task was done again. It had said: " + review_words(read))) }
    case _ { call write_proposal(task, got, noted("A reviewer (" + read.agent + ") found a problem that has NOT been put right: " + review_words(read))) }
  }
  require approval
}

workflow reviewed_write(task: Task, got: Proposed) -> Result {
  read   = call get_review(task, got)
  judged = match read.ok {
    case true { call judge_review(read) }
    case _ { {label: "none", confidence: 0} }
  }
  result = match after_reading(read, judged) {
    case "problem" { call redo_after_review(task, got, read) }
    case _ { call write_proposal(task, got, noted(review_note(read, judged))) }
  }
  require approval
}

workflow write_proposal(task: Task, got: Proposed, note: Note) -> Result {
  saved  = execute writer.save_all(got.files, note.text)
  tested = call run_tests(outside_work(got))
  result = worked_on(task, outside_work(got), tested)
  require approval
}

workflow second_helper(task: Task, again: Task) -> Result {
  got    = call ask_helper(again)
  faults = call judge(task, got)
  result = match verdict_on(got, faults.items, true) {
    case "use" { call reviewed_write(task, got) }
    case _ { call do_it_myself(task) }
  }
  require approval
}

// An outside agent is asked first. If none is allowed this costs nothing:
// the tool is not there, and the coder does the task itself.
workflow do_task(task: Task) -> Result {
  got    = call ask_helper(task)
  faults = call judge(task, got)
  result = match verdict_on(got, faults.items, false) {
    case "use" { call reviewed_write(task, got) }
    case "again" { call second_helper(task, outside_again(task, faults.items)) }
    case _ { call on_my_own(task) }
  }
  require approval
}

// A task that names its files is written file by file, each whole, by the
// scribe; one that does not goes to the coder agent, which finds them.
workflow on_my_own(task: Task) -> Result {
  folder = execute coder.list_folder(".") otherwise {names: []}
  plan   = file_plan(task, folder)
  result = match plan.files.is_empty() {
    case true { call do_it_myself(task) }
    case _ { call do_directly(task, plan) }
  }
  require approval
}

// ---------------------------------------------------------------- file by file
//
// A small model asked to drive tools, read files and send each new file as
// a JSON string will often answer without writing anything. Asked for one
// whole file at a time, in plain text, with what it needs to see put in
// front of it, the same model writes it in a minute or two. The program
// does the rest: it reads the files, keeps what was written, saves it all
// at once, runs the tests, and puts the failing file right once.

workflow do_directly(task: Task, plan: Plan) -> Result {
  a      = call draft_nth({task: task, plan: plan, n: 0, drafted: no_drafts()})
  b      = call draft_nth({task: task, plan: plan, n: 1, drafted: a})
  c      = call draft_nth({task: task, plan: plan, n: 2, drafted: b})
  saved  = execute writer.save_all(c.files, "Written file by file for: " + task.text.take(200))
  work   = drafted_work(c)
  tested = call run_tests(work)
  report = worked_on(task, work, tested)
  result = match needs_mending(work, tested) {
    case true { call mend_directly(task, c, report) }
    case _ { as_is(report) }
  }
  require approval
}

workflow draft_nth(job: Nth) -> Drafted {
  more = match job.plan.files.length() > job.n {
    case true { call draft_one(nth_one(job)) }
    case _ { kept_drafts(job.drafted) }
  }
}

workflow draft_one(one: One) -> Drafted {
  old   = execute coder.read_file(one.path) otherwise {text: ""}
  asked = scribe_task(one.task, one.path, old.text, one.drafted, one.failure)
  code  = use_model scribe(asked.text) retry 1 learn by asked.text otherwise {text: ""}
  more  = with_draft(one.drafted, one.path, old.text, code.text)
}

// The tests fail: the file they point at is written again, shown what they
// printed, and everything is tested once more.
workflow mend_directly(task: Task, drafted: Drafted, before: Result) -> Result {
  fixed  = call draft_one({task: task, path: to_mend(drafted, before.last.output), drafted: drafted, failure: before.last.output})
  saved  = execute writer.save_all(fixed.files, "Put right after the tests failed: " + task.text.take(200))
  work   = drafted_work(fixed)
  tested = call run_tests(work)
  first  = mended(before, worked_on(task, work, tested), work)
  // A second try, shown what the first one's tests printed.
  result = match needs_mending(work, tested) {
    case true { call mend_last(task, fixed, first) }
    case _ { as_is(first) }
  }
  require approval
}

workflow mend_last(task: Task, drafted: Drafted, before: Result) -> Result {
  fixed  = call draft_one({task: task, path: to_mend(drafted, before.last.output), drafted: drafted, failure: before.last.output})
  saved  = execute writer.save_all(fixed.files, "Put right a second time: " + task.text.take(200))
  work   = drafted_work(fixed)
  tested = call run_tests(work)
  result = mended(before, worked_on(task, work, tested), work)
  require approval
}

workflow do_it_myself(task: Task) -> Result {
  first  = ask coder(task.text) otherwise {summary: "", did: []}
  wrote  = wrote_something(first)
  again  = pushed(task)
  // A model sometimes answers as if it had done the work without asking
  // for a single change. It is asked once more, told plainly that nothing
  // has been written.
  work   = match wrote.text {
    case "yes" { kept(first) }
    case _ { call second_try(again) }
  }
  tested = call run_tests(work)
  report = worked_on(task, work, tested)
  // Tests that fail after its own change are read and put right once,
  // before the person hears about it.
  result = match needs_mending(work, tested) {
    case true { call mend(task, report) }
    case _ { as_is(report) }
  }
  require approval
}

workflow mend(task: Task, before: Result) -> Result {
  fixed  = ask coder(fix_task(before.last).text) otherwise {summary: "", did: []}
  tested = call run_tests(fixed)
  result = mended(before, worked_on(task, fixed, tested), fixed)
  require approval
}

// ---------------------------------------------------------------- websites

// A request for a website or a web page, said in so many words.
fn is_site_request(text: Text) -> Bool {
  let said = " " + text.lower().words().join(" ") + " "
  for words in [" website", " web site", " web page", " webpage", " landing page", " homepage", " home page", " portfolio site", " one-page site", " one page site", " site for ", " page for ", " index.html"] {
    if said.contains(words) { return true }
  }
  return false
}

fn is_web_file(path: Text) -> Bool {
  let name = path.lower()
  return name.ends_with(".html") or name.ends_with(".htm") or name.ends_with(".css")
}

// Work that wrote a web page: an HTML or CSS file, and no Python or tests.
fn is_site_work(work: Work) -> Bool {
  var web = 0
  for line in work.did {
    let path = line.words().drop(1).join(" ")
    if is_web_file(path) { web += 1 }
    if path.lower().ends_with(".py") or is_kosika(path) or is_script_test(path) { return false }
  }
  return web > 0
}

// The scripts a site's work wrote, which Node is asked to read.
fn site_scripts(work: Work) -> Text[] {
  let paths = for line in work.did { line.words().drop(1).join(" ") }
  return for path in paths.unique() where is_script(path) { path }
}

fn check_args(scripts: Text[]) -> Text[] {
  return ["--check"].concat(scripts)
}

// The files of a page, each whole: a model that runs out of room stops in
// the middle, and such a file must not be written.
fn site_check(files: Planned[]) -> Text[] {
  var wrong: Text[] = []
  for file in files {
    let path = file.path.lower()
    let text = file.text.lower()
    if path.ends_with(".html") or path.ends_with(".htm") {
      if not text.contains("<html") or not text.contains("</html>") or not text.contains("</body>") {
        wrong = wrong.append(file.path + ": the page is not whole; it must run from <!doctype html> and <html> to </body> and </html>")
      }
      if text.contains("lorem ipsum") {
        wrong = wrong.append(file.path + ": it has lorem ipsum; write real words for this page")
      }
    }
    if path.ends_with(".css") {
      if file.text.split("{").length() != file.text.split("}").length() {
        wrong = wrong.append(file.path + ": its braces do not close; every { needs its }. Write the whole stylesheet")
      }
    }
  }
  return wrong
}

// The three rounds of building a site, each asking for one file.
fn round_task(task: Task, round: Text) -> Task {
  if round == "page" {
    return {text: "Write index.html, the page for this request: " + task.text + "\nThis round writes index.html only. Use semantic HTML: a header with the name and a nav, a main with a hero and several sections, and a footer. Write real, specific content for this subject. In the head link styles.css; at the end of the body load script.js with defer. Give each section and card the class reveal, and give the hero the class hero, so the style and motion rounds can use them. The other two files are written in later rounds; do not write them now."}
  }
  if round == "style" {
    return {text: "Write styles.css, the design and animation for index.html, for this request: " + task.text + "\nThis round writes styles.css only. Read index.html first and style every element and class it uses. Make it modern and professional: a design system in :root variables (colours, a type scale, spacing, radius, the motion easing and durations), a strong hero, generous spacing, a responsive layout with grid and flex that works on a phone, and visible focus. Add the motion styles: transitions, scroll reveal, hover and the reduced-motion rules."}
  }
  return {text: "Write script.js, the motion for index.html and styles.css, for this request: " + task.text + "\nThis round writes script.js only. Read index.html and styles.css first and use their classes and variables. It is a plain script loaded with defer, with no import or export and no library: scroll reveal with IntersectionObserver, the reading progress, the hero's motion, cursor and hover effects, all switched off when reduced motion is asked for."}
}

// The task as an outside agent is given it: the whole site at once.
fn site_task(task: Task) -> Task {
  return {text: task.text + "\nBuild it as a static site with plain HTML, CSS and JavaScript: index.html, styles.css and script.js, with no framework, no build step and nothing loaded from the internet."}
}

// What three rounds did, as one piece of work.
fn rounds_work(page: Work, style: Work, motion: Work) -> Work {
  var said: Text[] = []
  for one in [page, style, motion] {
    if not one.summary.trim().is_empty() { said = said.append(one.summary.trim()) }
  }
  return {summary: said.join(" "), did: page.did.concat(style.did).concat(motion.did)}
}

fn no_work() -> Work {
  return {summary: "", did: []}
}

// What a site's builder tells the person: what was written, whether it
// reads cleanly, and how to see it.
fn site_report(task: Task, work: Work, ran: Ran) -> Result {
  let out = printed(ran)
  let wrote = files_line(work)
  var judged = "Open index.html from the project folder in your browser to see it."
  if ran.exit_code != 0 {
    judged = "The script does not read cleanly, so the page's motion will not run:\n" + out + "\nSay \"fix\" and I will try to put it right."
  }
  let summary = if work.summary.trim().is_empty() { "" } else { work.summary.trim().take(600) + "\n" }
  return {
    text: summary + wrote + said_only(work) + "\n" + judged,
    last: {task: task.text, output: out, passed: ran.exit_code == 0, known: true}
  }
}

fn clean_run() -> Ran {
  return {exit_code: 0, stdout: "", stderr: ""}
}

// A site has no tests: its scripts are read by Node, which says whether
// they are valid JavaScript without running them.
workflow check_site(work: Work) -> Tested {
  tested = match site_scripts(work).is_empty() {
    case true { as_tested(clean_run(), []) }
    case _ { call read_scripts(work) }
  }
  require approval
}

workflow read_scripts(work: Work) -> Tested {
  ran    = execute runner.run_node(check_args(site_scripts(work)))
  tested = as_tested(ran, [])
  require approval
}

// The site built in rounds by the coder's own model, one file each.
// One file a round, each written whole by the scribe and shown the files
// before it, then all three saved at once and checked.
workflow build_site(task: Task) -> Result {
  page   = call draft_one({task: round_task(task, "page"), path: "index.html", drafted: no_drafts(), failure: ""})
  style  = call draft_one({task: round_task(task, "style"), path: "styles.css", drafted: page, failure: ""})
  motion = call draft_one({task: round_task(task, "motion"), path: "script.js", drafted: style, failure: ""})
  saved  = execute writer.save_all(motion.files, "A website, file by file: " + task.text.take(200))
  work   = drafted_work(motion)
  tested = call run_tests(work)
  result = worked_on(task, work, tested)
  require approval
}

// An outside agent is asked for the whole site first; its work is written
// if it passes the checks, and otherwise the coder builds it in rounds.
workflow do_site(task: Task) -> Result {
  got    = call ask_helper(site_task(task))
  faults = call judge(task, got)
  result = match verdict_on(got, faults.items, true) {
    case "use" { call reviewed_write(task, got) }
    case _ { call build_site(task) }
  }
  require approval
}

workflow new_site(msg: Msg) -> Result {
  task   = task_of(msg)
  result = call do_site(task)
  require approval
}

workflow new_task(msg: Msg) -> Result {
  task   = task_of(msg)
  result = call do_task(task)
  require approval
}

workflow fix_last(msg: Msg) -> Result {
  past   = recall journal under "me"
  last   = earlier(past)
  task   = fix_task(last)
  result = match last.known {
    case true { call do_task(task) }
    case _ { nothing(last, "There is no earlier run to fix. Give me a task first.") }
  }
  require approval
}

workflow only_test(msg: Msg) -> Result {
  past   = recall journal under "me"
  last   = earlier(past)
  folder = execute helper.list_folder(".") otherwise {names: []}
  all    = match runner_in(folder) {
    case "node" { call run_all_node() }
    case _ { call run_all() }
  }
  result = tested(last, ran_of(all))
  require approval
}

workflow help(msg: Msg) -> Result {
  past   = recall journal under "me"
  last   = earlier(past)
  result = nothing(last, "Give me one small task in this project, such as: add a function is_even to calc.py, with a test.\nI show you every file I will make or change before I do it, then I run the tests.\nOr ask for a website, such as: a one-page website for my bakery, with scroll animations. I build it in three rounds: the page, its style, its motion.\nfix: try again after failing tests\ntest: only run the tests")
}

workflow main(msg: Msg) -> Said {
  budget 22 model calls, 3600 seconds
  kind   = kind_of(msg)
  result = match kind {
    case "help" { call help(msg) }
    case "fix" { call fix_last(msg) }
    case "test" { call only_test(msg) }
    case "site" { call new_site(msg) }
    case _ { call new_task(msg) }
  }
  last   = last_of(result)
  saved  = remember last in journal under "me"
  said   = say(result)
  require approval
}

// ------------------------------------------------------------------ tests

test "requests are understood" {
  expect kind_of({text: "add a function"}) == "task"
  expect kind_of({text: " Fix "}) == "fix"
  expect kind_of({text: "tests"}) == "test"
  expect kind_of({text: ""}) == "help"
}

test "what the tests printed is read" {
  ok = worked({text: "add is_even"}, {summary: " Added is_even. ", did: ["write_file calc.py", "write_file test_calc.py", "write_file calc.py"]}, {exit_code: 0, stdout: "2 passed in 0.01s\n", stderr: ""})
  bad = worked({text: "add is_even"}, {summary: "Added is_even.", did: ["write_file calc.py"]}, {exit_code: 1, stdout: "E  assert 1 == 2\n1 failed", stderr: ""})
  none = verdict({exit_code: 5, stdout: "", stderr: ""})
  expect ok.text == "Added is_even.\nWrote: calc.py, test_calc.py\nThe tests pass."
  expect ok.last.passed == true
  expect bad.text.contains("Wrote: calc.py\nThe tests failed.\nE  assert 1 == 2")
  expect bad.text.ends_with("Say \"fix\" and I will try to put it right.")
  expect bad.last.passed == false
  expect none == "No tests were found to run."
}

test "a claim with nothing written is not believed" {
  idle = worked({text: "add greet.py"}, {summary: "Created greet.py and its test.", did: []}, {exit_code: 0, stdout: "2 passed", stderr: ""})
  expect idle.text == "No file was written. The coder said: Created greet.py and its test.\nNothing was changed, so the task is not done. The tests as they were still pass."
}

test "a coder that wrote nothing is asked again" {
  expect wrote_something({summary: "Done.", did: []}).text == "no"
  expect wrote_something({summary: "Done.", did: ["write_file a.py"]}).text == "yes"
  expect pushed({text: "add greet.py"}).text.starts_with("add greet.py\nYou answered before without writing anything")
}

test "a file written again with only the new function is caught" {
  calc = "def add(a, b):\n    return a + b\n\n\ndef double(n):\n    return n * 2\n"
  only: Planned[] = [{path: "calc.py", text: "def subtract(a, b):\n    return a - b\n", before: calc, exists: true}]
  kept: Planned[] = [{path: "calc.py", text: calc + "\n\ndef subtract(a, b):\n    return a - b\n", before: calc, exists: true}]
  fresh: Planned[] = [{path: "greet.py", text: "def greet(name):\n    return name\n", before: "", exists: false}]
  a = plan_check("add a function subtract(a, b) to calc.py", only)
  expect a == ["calc.py: it no longer has add and double, which the file has now. write_file replaces the whole file: keep everything that is there and add to it"]
  expect plan_check("add a function subtract(a, b) to calc.py", kept) == []
  expect plan_check("add greet.py", fresh) == []
  expect defined(calc) == ["add", "double"]
  expect defined("class Shape:\n    def area(self):\n        return 0\n\nasync def fetch(url):\n    pass\n") == ["Shape", "fetch"]
  expect defined("") == []
}

test "a function the request renames or removes may go" {
  calc = "def add(a, b):\n    return a + b\n\n\ndef double(n):\n    return n * 2\n"
  renamed: Planned[] = [{path: "calc.py", text: "def add(a, b):\n    return a + b\n\n\ndef twice(n):\n    return n * 2\n", before: calc, exists: true}]
  expect plan_check("rename the function double to twice everywhere", renamed) == []
  tests = "from calc import add, double


def test_add():
    assert add(2, 3) == 5


def test_double():
    assert double(4) == 8
"
  both: Planned[] = [{path: "calc.py", text: "def add(a, b):
    return a + b


def twice(n):
    return n * 2
", before: calc, exists: true}, {path: "test_calc.py", text: "from calc import add, twice


def test_add():
    assert add(2, 3) == 5


def test_twice():
    assert twice(4) == 8
", before: tests, exists: true}]
  lost: Planned[] = [{path: "test_calc.py", text: "from calc import twice


def test_twice():
    assert twice(4) == 8
", before: tests, exists: true}]
  expect plan_check("rename the function double to twice everywhere, the tests included", both) == []
  expect plan_check("rename the function double to twice everywhere, the tests included", lost).length() == 1
  expect plan_check("rename the function double to twice everywhere, the tests included", lost)[0].contains("it no longer has test_add,")
  expect plan_check("tidy calc.py", renamed).length() == 1
  expect plan_check("tidy calc.py", renamed)[0].contains("it no longer has double")
  expect takes_away("Remove the old helper.")
  expect not takes_away("add a function")
}

test "tests in the wrong file, and a missing test file, are caught" {
  calc = "def add(a, b):\n    return a + b\n"
  mixed: Planned[] = [{path: "calc.py", text: calc + "\n\ndef clamp(n, low, high):\n    return max(low, min(n, high))\n\n\ndef test_clamp():\n    assert clamp(5, 0, 3) == 3\n", before: calc, exists: true}]
  alone: Planned[] = [{path: "calc.py", text: calc + "\n\ndef subtract(a, b):\n    return a - b\n", before: calc, exists: true}]
  both: Planned[] = [{path: "calc.py", text: calc + "\n\ndef subtract(a, b):\n    return a - b\n", before: calc, exists: true}, {path: "tests/test_calc.py", text: "from calc import subtract\n\n\ndef test_subtract():\n    assert subtract(3, 1) == 2\n", before: "", exists: false}]
  notes: Planned[] = [{path: "notes.md", text: "def nothing", before: "def something\n", exists: true}]
  expect plan_check("add clamp to calc.py", mixed) == ["calc.py: it holds the test test_clamp. Tests go in a test file, such as test_calc.py"]
  expect plan_check("add subtract to calc.py, with a test", alone) == ["the task asks for a test, but the plan writes no test file. Add a write_file for the test file as well"]
  expect plan_check("add subtract to calc.py, with a test", both) == []
  expect plan_check("the test for add fails. find the bug and fix it", alone) == []
  expect plan_check("write notes with a test", notes) == []
  expect is_test_file("tests/test_calc.py")
  expect is_test_file("calc_test.py")
  expect not is_test_file("contest.py")
  expect listed(["a"]) == "a"
  expect listed(["a", "b", "c"]) == "a, b and c"
}

test "an outside agent's work is reported like the coder's own" {
  calc = "def add(a, b):\n    return a + b\n"
  files: Planned[] = [{path: "calc.py", text: calc + "\n\ndef subtract(a, b):\n    return a - b\n", before: calc, exists: true}, {path: "test_calc.py", text: "from calc import subtract\n\n\ndef test_subtract():\n    assert subtract(3, 1) == 2\n", before: "", exists: false}]
  got: Proposed = {ok: true, agent: "devin", said: "Reading files.
Added subtract and its test.", files: files}
  work = outside_work(got)
  expect proposal_problems({text: "add a function subtract(a, b) to calc.py, with a test"}, got) == []
  expect work.summary == "Asked devin. It said: Added subtract and its test."
  expect work.did == ["save_all calc.py", "save_all test_calc.py"]
  done = worked({text: "add subtract"}, work, {exit_code: 0, stdout: "3 passed in 0.01s
", stderr: ""})
  expect done.text == "Asked devin. It said: Added subtract and its test.
Wrote: calc.py, test_calc.py
The tests pass."
}

test "an outside agent that loses a function is asked again, told why" {
  calc = "def add(a, b):\n    return a + b\n"
  bad: Planned[] = [{path: "calc.py", text: "def subtract(a, b):\n    return a - b\n", before: calc, exists: true}]
  got: Proposed = {ok: true, agent: "omp", said: "Done.", files: bad}
  wrong = proposal_problems({text: "add subtract to calc.py"}, got)
  expect wrong.length() == 1
  expect wrong[0].contains("it no longer has add")
  expect verdict_on(got, wrong, false) == "again"
  expect verdict_on(got, wrong, true) == "self"
  expect verdict_on(got, [], false) == "use"
  expect outside_again({text: "add subtract"}, wrong).text.contains("was not accepted because: calc.py: it no longer has add")
  expect proposal_problems({text: "x"}, nobody()) == ["nobody could be asked"]
  expect verdict_on(nobody(), ["nobody could be asked"], false) == "self"
  expect proposal_problems({text: "x"}, {ok: true, agent: "omp", said: "", files: []}) == ["it changed no file"]
}

test "only the tests that have to do with the change are asked for" {
  work: Work = {summary: "s", did: ["write_file kosika/builtin_methods.py", "save_all tests/test_more_methods.py", "write_file KOSIKA.md", "write_file calc_test.py", "write_file my-file.py"]}
  expect test_names(work) == ["builtin_methods", "more_methods", "calc"]
  expect test_args(test_names(work)) == ["-m", "pytest", "-q", "-x", "--no-header", "-p", "no:cacheprovider", "-k", "builtin_methods or more_methods or calc"]
  expect test_args([]) == ["-m", "pytest", "-q", "-x", "--no-header", "-p", "no:cacheprovider"]
  expect test_names({summary: "s", did: []}) == []
  expect plain_name("more_methods")
  expect not plain_name("a or b")
  expect not plain_name("x;y")
  expect found_none({exit_code: 5, stdout: "", stderr: ""}, ["calc"])
  expect not found_none({exit_code: 5, stdout: "", stderr: ""}, [])
  expect not found_none({exit_code: 1, stdout: "", stderr: ""}, ["calc"])
}

test "a narrowed run says that it was narrowed" {
  work: Work = {summary: "Added is_even.", did: ["write_file calc.py"]}
  some = worked_on({text: "add is_even"}, work, {ran: {exit_code: 0, stdout: "2 passed", stderr: ""}, only: "calc"})
  all = worked_on({text: "add is_even"}, work, {ran: {exit_code: 0, stdout: "9 passed", stderr: ""}, only: ""})
  bad = worked_on({text: "add is_even"}, work, {ran: {exit_code: 1, stdout: "1 failed", stderr: ""}, only: "calc"})
  expect some.text == "Added is_even.\nWrote: calc.py\nThe tests for calc pass. Only those were run; say \"test\" to run them all."
  expect some.last.passed == true
  expect all.text == "Added is_even.\nWrote: calc.py\nThe tests pass."
  expect bad.text.contains("The tests failed.")
}

test "what a reviewer said decides what happens next, and is told to the person" {
  found: Reviewed = {ok: true, agent: "omp", said: "- [HIGH] calc.py:11 When n > high, clamp returns low.\n\nNo files edited.\nWorking..."}
  clean: Reviewed = {ok: true, agent: "omp", said: "No findings.\nWorking..."}
  expect review_words(found) == "- [HIGH] calc.py:11 When n > high, clamp returns low. No files edited."
  expect after_reading(found, {label: "problem", confidence: 0.9}) == "problem"
  expect after_reading(clean, {label: "fine", confidence: 0.9}) == "write"
  expect after_reading(found, {label: "unclear", confidence: 0}) == "write"
  expect after_reading(no_review(), {label: "problem", confidence: 1}) == "write"
  expect review_note(clean, {label: "fine", confidence: 0.9}) == "Read by omp, which found no problem. It said: No findings."
  expect review_note(found, {label: "unclear", confidence: 0}).starts_with("Read by omp. It said: - [HIGH]")
  expect review_note(no_review(), {label: "none", confidence: 0}) == "Not read by a second agent."
  expect after_review({text: "add clamp"}, found).text.starts_with("add clamp\nA reviewer read your first answer and found this: - [HIGH] calc.py:11")
  expect review_question(clean).ends_with("Review:\nNo findings.")
}

test "a Kosika file keeps what it had and gains a test when asked" {
  tools = "fn shout(text: Text) -> Text {\n  return text.upper()\n}\n\ntest \"shout makes it loud\" {\n  expect shout(\"hi\") == \"HI\"\n}\n"
  more = tools + "\nfn is_even(n: Number) -> Bool {\n  return n % 2 == 0\n}\n\ntest \"even and odd\" {\n  expect is_even(2)\n}\n"
  bare = tools + "\nfn is_even(n: Number) -> Bool {\n  return n % 2 == 0\n}\n"
  only = "fn is_even(n: Number) -> Bool {\n  return n % 2 == 0\n}\n\ntest \"even and odd\" {\n  expect is_even(2)\n}\n"
  good: Planned[] = [{path: "tools.kos", text: more, before: tools, exists: true}]
  untested: Planned[] = [{path: "tools.kos", text: bare, before: tools, exists: true}]
  lost: Planned[] = [{path: "tools.kos", text: only, before: tools, exists: true}]
  expect defined(tools) == ["shout", "test \"shout makes it loud\""]
  expect defined("record Point { x: Number y: Number }\nworkflow main(msg: Msg) -> Said {\nmodel voice {\ndefault model careful\nagent hands {\ntool save {") == ["Point", "main", "voice", "careful", "hands", "save"]
  expect test_count(more) == 2
  expect plan_check("add a function is_even to tools.kos, with a test", good) == []
  expect plan_check("add a function is_even to tools.kos, with a test", untested) == ["the task asks for a test, but no Kosika file gains one. Add a test block, written test \"what it shows\" { expect ... }, to the file"]
  expect plan_check("add a function is_even to tools.kos", untested) == []
  expect plan_check("add a function is_even to tools.kos, with a test", lost) == ["tools.kos: it no longer has shout and test \"shout makes it loud\", which the file has now. Keep everything that is there and add to it"]
}

test "the engine's reading joins the coder's own" {
  got: Proposed = {ok: true, agent: "omp", said: "", files: [{path: "a.kos", text: "fn f() -> Number {\n  return 1\n}\n", before: "", exists: false}]}
  both = all_faults({text: "add f"}, got, {problems: ["a.kos: it is not valid Kosika: x"]})
  none = all_faults({text: "add f"}, got, {problems: []})
  expect both.items == ["a.kos: it is not valid Kosika: x"]
  expect none.items == []
  expect verdict_on(got, both.items, false) == "again"
}

test "after a change to Kosika only, that file's own tests are run" {
  kos: Work = {summary: "s", did: ["save_all tools.kos", "save_all notes.md"]}
  mixed: Work = {summary: "s", did: ["save_all tools.kos", "save_all calc.py"]}
  expect kosika_file(kos) == "tools.kos"
  expect kosika_file(mixed) == ""
  expect kosika_file({summary: "s", did: []}) == ""
  done = worked_on({text: "add is_even"}, kos, {ran: {exit_code: 0, stdout: "3 passed, 0 failed", stderr: ""}, only: "tools.kos"})
  expect done.text.contains("The tests for tools.kos pass.")
}

test "what a TypeScript file defines is read from its lines" {
  text = "import { test } from \"node:test\";\nexport function add(a: number, b: number): number {\n  return a + b;\n}\nexport const double = (n: number): number => n * 2;\nexport default async function load() {}\nclass Shape {}\nexport interface Point { x: number }\nexport type Size = \"low\" | \"high\";\ntest(\"add works\", () => {\n});\ndescribe(\"group\", () => {\n  it('goes deep', () => {});\n});\n"
  expect script_defined(text) == ["add", "double", "load", "Shape", "Point", "Size", "test(\"add works\")", "test(\"goes deep\")"]
  expect exported(text + "export { Shape, add as plus };\n") == ["add", "double", "load", "Point", "Size", "Shape", "plus"]
  expect is_script("src/calc.TS") and is_script("a.mjs") and not is_script("calc.py") and not is_script("notes.json")
  expect is_script_test("calc.test.ts") and is_script_test("test/calc.js") and not is_script_test("contest.ts")
  expect stem("src/calc.test.ts") == "calc.test"
}

test "a TypeScript plan keeps what the file had and puts tests in a test file" {
  calc = "export function add(a: number, b: number): number {\n  return a + b;\n}\n"
  more = calc + "\nexport function isEven(n: number): boolean {\n  return n % 2 === 0;\n}\n"
  tests = "import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { isEven } from \"./calc.ts\";\n\ntest(\"isEven\", () => {\n  assert.equal(isEven(2), true);\n});\n"
  only: Planned[] = [{path: "calc.ts", text: "export function isEven(n: number): boolean {\n  return n % 2 === 0;\n}\n", before: calc, exists: true}]
  good: Planned[] = [{path: "calc.ts", text: more, before: calc, exists: true}, {path: "calc.test.ts", text: tests, before: "", exists: false}]
  alone: Planned[] = [{path: "calc.ts", text: more, before: calc, exists: true}]
  mixed: Planned[] = [{path: "calc.ts", text: more + "\ntest(\"isEven\", () => {});\n", before: calc, exists: true}]
  expect plan_check("add isEven to calc.ts, with a test", only)[0].contains("calc.ts: it no longer has add")
  expect plan_check("add isEven to calc.ts, with a test", good) == []
  expect plan_check("add isEven to calc.ts, with a test", alone) == ["the task asks for a test, but the plan writes no test file. Add a write_file for one, named like calc.test.ts for calc.ts"]
  expect plan_check("add isEven to calc.ts", alone) == []
  expect plan_check("add isEven to calc.ts", mixed) == ["calc.ts: it holds the test test(\"isEven\"). Tests go in a test file, such as calc.test.ts"]
  expect plan_check("rename add to plus in calc.ts", [{path: "calc.ts", text: "export function plus(a: number, b: number): number {\n  return a + b;\n}\n", before: calc, exists: true}]) == []
}

test "an import must name a file and a thing that are there" {
  calc = "export function add(a, b) {\n  return a + b;\n}\n"
  head = "import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\n"
  short: Planned[] = [{path: "calc.ts", text: calc, before: calc, exists: true}, {path: "calc.test.ts", text: head + "import { add } from \"./calc\";\n", before: "", exists: false}]
  missing: Planned[] = [{path: "calc.js", text: calc, before: calc, exists: true}, {path: "calc.test.js", text: head + "import { add, subtract as minus } from './calc.js';\n", before: "", exists: false}]
  expect plan_check("add a test for calc.ts", short) == ["calc.test.ts: it imports from \"./calc\", but the file is calc.ts. Node needs the whole name: \"./calc.ts\""]
  expect plan_check("add a test for calc.js", missing) == ["calc.test.js: it imports subtract from calc.js, which does not export it"]
}

test "after a change to JavaScript or TypeScript only, Node runs the tests" {
  ts: Work = {summary: "s", did: ["save_all src/calc.ts", "save_all src/calc.test.ts", "save_all README.md"]}
  page: Work = {summary: "s", did: ["write_file index.html", "write_file script.js"]}
  both: Work = {summary: "s", did: ["write_file calc.ts", "write_file calc.py"]}
  expect runner_of(ts) == "node"
  expect node_args(script_tests(ts)) == ["--test", "src/calc.test.ts"]
  expect node_args(script_tests(page)) == ["--test"]
  expect runner_of(both) == "python"
  expect runner_of({summary: "s", did: ["save_all tools.kos"]}) == "kosika"
  expect runner_of({summary: "s", did: []}) == "python"
  expect runner_in({names: ["package.json", "src", "README.md"]}) == "node"
  expect runner_in({names: ["calc.ts", "calc.py"]}) == "python"
  expect runner_in({names: ["README.md"]}) == "python"
  none: Ran = {exit_code: 0, stdout: "i tests 0\ni pass 0\n", stderr: ""}
  some: Ran = {exit_code: 0, stdout: "i tests 10\ni pass 10\n", stderr: ""}
  expect verdict(none) == "No tests were found to run."
  expect verdict(some) == "The tests pass."
}

test "only the end of a long test run is kept" {
  long = printed({exit_code: 1, stdout: "a\nb\nc\nd\ne\nf\ng\nh\ni\nj\nk\nl\nm\nn\no\np\nq\nr\ns\nt\nu\nv\nw\nx\ny\nz\nlast line", stderr: ""})
  expect long.starts_with("c\nd")
  expect long.ends_with("last line")
}

test "fix asks about the last failure" {
  a = fix_task({task: "add is_even", output: "1 failed", passed: false, known: true})
  expect a.text.contains("The task was: add is_even")
  expect a.text.contains("1 failed")
}

test "with no earlier run there is nothing to fix" {
  none: JournalRecalled = {found: false, value: null}
  last = earlier(none)
  expect last.known == false
  expect last.task == ""
}

test "help needs no model and no tool" {
  a = help({text: "help"})
  expect a.text.starts_with("Give me one small task in this project")
  expect a.last.known == false
}

test "a request for a website is built as one" {
  expect kind_of({text: "Create a beautiful website for a coffee studio"}) == "site"
  expect kind_of({text: "make a landing page for my app"}) == "site"
  expect kind_of({text: "add a function is_even to calc.py"}) == "task"
  expect kind_of({text: "fix"}) == "fix"
  page: Work = {summary: "s", did: ["write_file index.html", "write_file styles.css", "write_file script.js", "write_file script.js"]}
  expect runner_of(page) == "web"
  expect site_scripts(page) == ["script.js"]
  expect check_args(site_scripts(page)) == ["--check", "script.js"]
  expect runner_of({summary: "s", did: ["write_file index.html", "write_file app.test.js"]}) == "node"
  expect runner_of({summary: "s", did: ["write_file index.html", "write_file app.py"]}) == "python"
  task: Task = {text: "a site for Ember"}
  expect round_task(task, "page").text.starts_with("Write index.html")
  expect round_task(task, "style").text.contains("Read index.html first")
  expect round_task(task, "motion").text.contains("no import or export")
}

test "a page that is cut short, or a stylesheet that does not close, is caught" {
  whole: Planned = {path: "index.html", text: "<!doctype html>\n<html><body><main>Ember</main></body></html>\n", before: "", exists: false}
  cut: Planned = {path: "index.html", text: "<!doctype html>\n<html><body><main>Ember", before: "", exists: false}
  filler: Planned = {path: "about.html", text: "<html><body>Lorem ipsum dolor</body></html>", before: "", exists: false}
  closed: Planned = {path: "styles.css", text: ":root { --a: 1px; }\n.hero { padding: var(--a); }\n", before: "", exists: false}
  open: Planned = {path: "styles.css", text: ".hero { padding: 0;\n.card {", before: "", exists: false}
  expect site_check([whole, closed]) == []
  expect site_check([cut]) == ["index.html: the page is not whole; it must run from <!doctype html> and <html> to </body> and </html>"]
  expect site_check([filler]) == ["about.html: it has lorem ipsum; write real words for this page"]
  expect site_check([open]) == ["styles.css: its braces do not close; every { needs its }. Write the whole stylesheet"]
  expect plan_check("a site", [cut]).length() == 1
}

test "a built site says how to see it, or what is wrong with its script" {
  three = rounds_work({summary: "The page.", did: ["write_file index.html"]}, {summary: "", did: ["write_file styles.css"]}, {summary: "The motion.", did: ["write_file script.js"]})
  expect three.summary == "The page. The motion."
  expect three.did == ["write_file index.html", "write_file styles.css", "write_file script.js"]
  good = site_report({text: "a site"}, three, clean_run())
  expect good.text == "The page. The motion.\nWrote: index.html, styles.css, script.js\nOpen index.html from the project folder in your browser to see it."
  expect good.last.passed == true
  bad = site_report({text: "a site"}, three, {exit_code: 1, stdout: "", stderr: "SyntaxError: Unexpected token"})
  expect bad.text.contains("The script does not read cleanly")
  expect bad.text.contains("SyntaxError: Unexpected token")
  expect bad.last.passed == false
  expect worked_on({text: "a site"}, three, {ran: clean_run(), only: ""}).text == good.text
}

// ------------------------------------------------------------------ evals
// These ask a real model. Run them with:
//   kosika measure main.kos --model qwen2.5:7b --model-protocol ollama

test "its own change that fails the tests is put right once" {
  wrote: Work = {summary: "added", did: ["wrote calc.py"]}
  failed: Tested = {ran: {exit_code: 1, stdout: "1 failed", stderr: ""}, only: ""}
  expect needs_mending(wrote, failed)
  expect not needs_mending({summary: "", did: []}, failed)
  expect not needs_mending(wrote, {ran: {exit_code: 5, stdout: "", stderr: ""}, only: ""})
  before: Result = {text: "failed", last: {task: "t", output: "1 failed", passed: false, known: true}}
  after: Result = {text: "The tests pass.", last: {task: "t", output: "ok", passed: true, known: true}}
  expect mended(before, after, wrote).text.starts_with("My first try failed its tests, so I read")
  expect mended(before, after, {summary: "", did: []}).text == "failed"
}

test "a task that names its files is written file by file, tests last" {
  plan = file_plan({text: "write lru.py with an LRUCache class, and test_lru.py with tests"}, {names: []})
  expect plan.files == ["lru.py", "test_lru.py"]
  added = file_plan({text: "add a function is_even to calc.py that says whether a number is even, with a test"}, {names: ["calc.py", "test_calc.py"]})
  expect added.files == ["calc.py", "test_calc.py"]
  script = file_plan({text: "add a function whisper to text.ts, with a test in text.test.ts"}, {names: []})
  expect script.files == ["text.ts", "text.test.ts"]
  expect file_plan({text: "make the code faster"}, {names: []}).files == []
}

test "a file is asked for whole, with what was written before it" {
  first = with_draft(no_drafts(), "lru.py", "", "class LRUCache:\n    pass")
  expect first.files[0].text == "class LRUCache:\n    pass\n"
  asked = scribe_task({text: "write tests"}, "test_lru.py", "", first, "")
  expect asked.text.contains("--- lru.py (already written) ---")
  expect asked.text.contains("test_lru.py does not exist yet")
  expect with_draft(first, "x.py", "", "  ").files.length() == 1
  expect to_mend(first, "lru.py:3: TypeError") == "lru.py"
  both = with_draft(first, "test_lru.py", "", "def test_a(): pass")
  expect to_mend(both, "lru.py:8: in get
test_lru.py:19: AssertionError") == "test_lru.py"
  expect to_mend(both, "test_lru.py:5: in test_a
lru.py:8: KeyError") == "lru.py"
}
