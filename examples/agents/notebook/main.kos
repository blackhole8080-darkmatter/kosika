// Notebook: tell it things, and later ask in your own words. It finds what
// you meant, not only what you typed, and says what that reminds it of.
//
//   kosika test main.kos
//   kosika chat main.kos --memory FOLDER --embed-model nomic-embed-text
//
// No chat model is needed: only the small embedding model, which runs in
// Ollama on the laptop, so nothing you say leaves it. Without
// --embed-model it still works, by the words a question shares with a note.
//
// Say: remember <something>, or ask anything. "what do I pay for the flat"
// finds "Rent is 900 euros a month" although they share no word.
//
// How it works. Each note is kept in a memory. Asking recalls the notes
// most like the question, each with how near it is. The nearest is the
// answer, if it stands out from the rest. Then it recalls again with that note as
// the question: the notes near the answer are what it "reminds" the
// notebook of. That second hop is how memories link to each other without
// anyone writing the links down, and only notes that stand out are linked.
//
// Links also grow with use. Two notes that answer questions asked one
// after the other are linked, and the link gets stronger each time it
// happens again. Once a link has been used twice, recalling one note brings
// up the other, even when their meanings are far apart: the notebook learns
// that your maths exam goes with your physics revision because you keep
// asking about them together.

record Msg { text: Text }
record Said { text: Text }
record Note { text: Text }

// What a note has been asked about together with, and how many times.
record Links { notes: Text[] counts: Number[] }

memory notes of Note
// For each note, the notes asked about just before or after it.
memory links of Links
// The note that answered the last question, under the key "last".
memory recent of Note

// A link is shown once it has been used this many times.
fn learned() -> Number {
  return 2
}

// How near is near enough. With meaning, every note scores about 0.4 even
// against an unrelated question, so a fixed line does not work: a note
// counts when it stands out from the others the recall found, by
// stands_out() or more. Words in common have no such floor, so a share of
// words is enough there.
fn stands_out() -> Number {
  return 0.08
}

// How far the match at `at` is above the average of the others, leaving
// out the text it was asked with.
fn lead(found: NotesLike, at: Number, asked: Text) -> Number {
  var total = 0
  var count = 0
  for i in 0 until found.matches.length() {
    let other = found.matches[i]
    if i != at and other.value.text != asked {
      total = total + other.score
      count = count + 1
    }
  }
  if count == 0 { return found.matches[at].score }
  return found.matches[at].score - total / count
}

fn near_enough(found: NotesLike, at: Number, asked: Text) -> Bool {
  if found.by != "meaning" { return found.matches[at].score >= 0.15 }
  if found.matches.length() < 3 { return found.matches[at].score >= 0.6 }
  return lead(found, at, asked) >= stands_out()
}

// ---------------------------------------------------------------- notes

fn first_word(msg: Msg) -> Text {
  return msg.text.trim().lower().words().first().or("")
}

fn note_of(msg: Msg) -> Note {
  return {text: msg.text.trim().drop(8).trim()}
}

// The same note said twice is kept once.
fn key_of(note: Note) -> Text {
  return key_text(note.text)
}

fn key_text(text: Text) -> Text {
  return text.lower().trim().take(200)
}

fn question_of(msg: Msg) -> Msg {
  let text = msg.text.trim()
  if first_word(msg) == "recall" { return {text: text.drop(6).trim()} }
  return {text: text}
}

// The nearest note when it is near enough, else nothing.
fn best(found: NotesLike) -> Msg {
  if found.matches.is_empty() { return {text: ""} }
  if not near_enough(found, 0, "") { return {text: ""} }
  return {text: found.matches[0].value.text}
}

// ---------------------------------------------------------------- replies

fn kept(note: Note) -> Said {
  if note.text.is_empty() { return {text: "Tell me what to remember, like this: remember rent is 900 euros"} }
  return {text: "I will remember: " + note.text}
}

// ---------------------------------------------------------------- links

fn last_of(last: RecentRecalled) -> Msg {
  if not last.found { return {text: ""} }
  return {text: last.value.or({text: ""}).text}
}

// `known` with the link to `other` one stronger, or new.
fn grown(known: LinksRecalled, other: Text, me: Text) -> Links {
  let links = known.value.or({notes: [], counts: []})
  if other.is_empty() or other == me { return links }
  var counts: Number[] = []
  var found = false
  for i in 0 until links.notes.length() {
    if links.notes[i] == other {
      counts = counts.append(links.counts[i] + 1)
      found = true
    } else {
      counts = counts.append(links.counts[i])
    }
  }
  if found { return {notes: links.notes, counts: counts} }
  return {notes: links.notes.append(other), counts: counts.append(1)}
}

// The note the link goes back to: the last answer, or, when there is no
// other note to link, this one again, so the second write changes nothing.
fn back_key(before: Msg, answer: Msg) -> Text {
  if before.text.is_empty() or before.text == answer.text { return key_text(answer.text) }
  return key_text(before.text)
}

fn back_value(theirs: LinksRecalled, ours: Links, before: Msg, answer: Msg) -> Links {
  if before.text.is_empty() or before.text == answer.text { return ours }
  return grown(theirs, answer.text, before.text)
}

fn answered(answer: Msg, linked: NotesLike, links: Links) -> Said {
  var reminders: Text[] = []
  for i in 0 until linked.matches.length() {
    let found = linked.matches[i]
    if found.value.text != answer.text and reminders.length() < 2 and near_enough(linked, i, answer.text) {
      reminders = reminders.append(found.value.text)
    }
  }
  var together: Text[] = []
  for i in 0 until links.notes.length() {
    let other = links.notes[i]
    if links.counts[i] >= learned() and together.length() < 2 and not reminders.contains(other) {
      together = together.append(other)
    }
  }
  let near = if reminders.is_empty() { "" } else { "\nThat reminds me of:\n  " + reminders.join("\n  ") }
  let used = if together.is_empty() { "" } else { "\nYou often ask about this with:\n  " + together.join("\n  ") }
  return {text: answer.text + near + used}
}

// ---------------------------------------------------------------- workflows

workflow keep(msg: Msg) -> Said {
  note  = note_of(msg)
  saved = remember note in notes under key_of(note)
  said  = kept(note)
}

// A note that answered: what it is near in meaning, and the links to the
// last answer, made one stronger in both directions.
workflow answer_with(answer: Msg) -> Said {
  linked = recall notes like answer.text
  last   = recall recent under "last"
  before = last_of(last)
  mine   = recall links under key_text(answer.text)
  ours   = grown(mine, before.text, answer.text)
  theirs = recall links under back_key(before, answer)
  back   = back_value(theirs, ours, before, answer)
  one    = remember ours in links under key_text(answer.text)
  two    = remember back in links under back_key(before, answer)
  note   = as_note(answer)
  now    = remember note in recent under "last"
  said   = answered(answer, linked, ours)
}

fn as_note(answer: Msg) -> Note {
  return {text: answer.text}
}

workflow ask(msg: Msg) -> Said {
  asked  = question_of(msg)
  near   = recall notes like asked.text
  answer = best(near)
  said   = match answer.text.is_empty() {
    case true { {text: "I don't remember anything about that. Tell me with: remember ..."} }
    case _ { call answer_with(answer) }
  }
}

fn kind_of(msg: Msg) -> Text {
  if first_word(msg) != "remember" { return "ask" }
  if note_of(msg).text.is_empty() { return "empty" }
  return "keep"
}

workflow main(msg: Msg) -> Said {
  said = match kind_of(msg) {
    case "keep" { call keep(msg) }
    case "empty" { kept(note_of(msg)) }
    case _ { call ask(msg) }
  }
}

// ------------------------------------------------------------------ tests
// A test has no embedding model, so these recall by the words in common.

test "remembering keeps the note, and asking finds it" {
  a = main({text: "remember Rent is 900 euros a month"})
  b = main({text: "what is the rent a month?"})
  expect a.text == "I will remember: Rent is 900 euros a month"
  expect b.text == "Rent is 900 euros a month"
}

test "the nearest note answers, and the notes near it are what it reminds of" {
  a = main({text: "remember Rent for the flat is 900 euros a month"})
  b = main({text: "remember The flat landlord wants the rent on the 1st"})
  c = main({text: "remember The cat needs its vaccine in May"})
  d = main({text: "recall rent for the flat"})
  expect d.text == "Rent for the flat is 900 euros a month\nThat reminds me of:\n  The flat landlord wants the rent on the 1st"
}

test "a question near nothing kept is not answered" {
  a = main({text: "remember Rent is 900 euros a month"})
  b = main({text: "quantum physics homework"})
  expect b.text.starts_with("I don't remember anything about that")
}

test "notes asked about one after the other become linked" {
  a = main({text: "remember Maths exam is on 3 November"})
  b = main({text: "remember Physics revision covers chapters 4 to 6"})
  c = main({text: "remember Rent is 900 euros a month"})
  d = main({text: "when is the maths exam"})
  e = main({text: "what is in the physics revision"})
  f = main({text: "when is the maths exam"})
  g = main({text: "what is the rent"})
  // Asked once together, exam and physics are not linked yet; twice, they are.
  expect e.text == "Physics revision covers chapters 4 to 6"
  expect f.text == "Maths exam is on 3 November\nYou often ask about this with:\n  Physics revision covers chapters 4 to 6"
  expect g.text == "Rent is 900 euros a month"
}

test "remember with nothing after it asks for the note" {
  a = main({text: "remember"})
  expect a.text.starts_with("Tell me what to remember")
}
