// Notebook: tell it things, and later ask in your own words. It finds what
// you meant, not only what you typed, and says what that reminds it of.
//
//   kosika test main.kos
//   kosika chat main.kos --memory FOLDER --embed-model nomic-embed-text
//
// No chat model is needed: only the small embedding model, which runs in
// Ollama on the laptop, so nothing you say leaves it. Without
// --embed-model it still works, by the words a question shares with a note.
//
// Say: remember <something>, or ask anything. "what do I pay for the flat"
// finds "Rent is 900 euros a month" although they share no word.
//
// How it works. Each note is kept in a memory. Asking recalls the notes
// most like the question, each with how near it is. The nearest is the
// answer, if it stands out from the rest. Then it recalls again with that note as
// the question: the notes near the answer are what it "reminds" the
// notebook of. That second hop is how memories link to each other without
// anyone writing the links down, and only notes that stand out are linked.
//
// Links also grow with use. Two notes that answer questions asked one
// after the other are linked, and the link gets stronger each time it
// happens again. Once a link has been used twice, recalling one note brings
// up the other, even when their meanings are far apart: the notebook learns
// that your maths exam goes with your physics revision because you keep
// asking about them together.
//
// And it learns what you mean. After an answer, say "wrong" and it offers
// the next most likely note; say "right" when it has it. A right answer is
// kept as a lesson: this question, this note. Each time, it also teaches a
// small neural network (std/nn.kos, written in Kosika) about the note it
// showed: how near it was, how much it stood out, whether it is linked to
// what you asked before, and how like the question is to one this note
// was the right answer to. Once the network has a few right and wrong
// answers to go on, it is the network that chooses among the notes that
// could answer, so the notebook comes to answer the way you mean.

import "std/nn.kos"

record Msg { text: Text }
record Said { text: Text }
record Note { text: Text }

// The notes that could answer a question, with what the network is told
// about each, and the ones tried so far, the last one shown.
record Pick { question: Text text: Text rows: Number[][] texts: Text[] tried: Number[] }
// A question and the note that was the right answer to it.
record Lesson { question: Text note: Text }
// The network, and every answer it has learned from: what it was told
// about a note, and 1 if that note was right, 0 if wrong.
record Brain { net: Net xs: Number[][] ys: Number[][] }

// What a note has been asked about together with, and how many times.
record Links { notes: Text[] counts: Number[] }

memory notes of Note
// For each note, the notes asked about just before or after it.
memory links of Links
// The last question's answer and what else could have answered it,
// under the key "last".
memory recent of Pick
// What the notebook has learned, under the key "me".
memory brain of Brain
// Questions and their right answers, under the question.
memory lessons of Lesson

// A link is shown once it has been used this many times.
fn learned() -> Number {
  return 2
}

// How near is near enough. With meaning, every note scores about 0.4 even
// against an unrelated question, so a fixed line does not work: a note
// counts when it stands out from the others the recall found, by
// stands_out() or more. Words in common have no such floor, so a share of
// words is enough there.
fn stands_out() -> Number {
  return 0.08
}

// How far the match at `at` is above the average of the others, leaving
// out the text it was asked with.
fn lead(found: NotesLike, at: Number, asked: Text) -> Number {
  var total = 0
  var count = 0
  for i in 0 until found.matches.length() {
    let other = found.matches[i]
    if i != at and other.value.text != asked {
      total = total + other.score
      count = count + 1
    }
  }
  if count == 0 { return found.matches[at].score }
  return found.matches[at].score - total / count
}

fn near_enough(found: NotesLike, at: Number, asked: Text) -> Bool {
  if found.by != "meaning" { return found.matches[at].score >= 0.15 }
  if found.matches.length() < 3 { return found.matches[at].score >= 0.6 }
  return lead(found, at, asked) >= stands_out()
}

// ---------------------------------------------------------------- notes

fn first_word(msg: Msg) -> Text {
  return msg.text.trim().lower().words().first().or("")
}

fn note_of(msg: Msg) -> Note {
  return {text: msg.text.trim().drop(8).trim()}
}

// The same note said twice is kept once.
fn key_of(note: Note) -> Text {
  return key_text(note.text)
}

fn key_text(text: Text) -> Text {
  return text.lower().trim().take(200)
}

fn question_of(msg: Msg) -> Msg {
  let text = msg.text.trim()
  if first_word(msg) == "recall" { return {text: text.drop(6).trim()} }
  return {text: text}
}

// ---------------------------------------------------------------- learning

// At most this many notes are weighed for one question.
fn candidates() -> Number {
  return 5
}

fn no_pick() -> Pick {
  return {question: "", text: "", rows: [], texts: [], tried: []}
}

fn new_brain() -> Brain {
  return {net: net([4, 6, 1], 11), xs: [], ys: []}
}

// Whether the lesson at `at` is about this question. By meaning, the same
// question asked again scores about 0.8 and one put another way about
// 0.65, while lessons about other things score about 0.4, so a lesson
// counts when it is near and stands out from the other lessons.
fn lesson_fits(lessons: LessonsLike, at: Number) -> Bool {
  let score = lessons.matches[at].score
  if lessons.by != "meaning" { return score >= 0.3 }
  if score < 0.62 { return false }
  var total = 0
  var count = 0
  for i in 0 until lessons.matches.length() {
    if i != at {
      total += lessons.matches[i].score
      count = count + 1
    }
  }
  return count == 0 or score - total / count >= 0.2
}

// How like this question is to one that `text` was the right answer to,
// 0 when no lesson that fits says so.
fn taught_for(lessons: LessonsLike, text: Text) -> Number {
  var high = 0
  for i in 0 until lessons.matches.length() {
    let found = lessons.matches[i]
    if found.value.note == text and lesson_fits(lessons, i) { high = high.max(found.score) }
  }
  return high
}

// A note a fitting lesson points to may answer by itself.
fn taught_enough(lessons: LessonsLike) -> Number {
  return 0.01
}

// What the network is told about the note at `at`: how near it is, how much
// it stands out, how often it followed the last answer, and how like the
// question is to one it was the right answer to.
fn row_of(found: NotesLike, at: Number, before: LinksRecalled, lessons: LessonsLike) -> Number[] {
  let links = before.value.or({notes: [], counts: []})
  let text = found.matches[at].value.text
  var used = 0
  for i in 0 until links.notes.length() {
    if links.notes[i] == text { used = links.counts[i].min(5) }
  }
  return [found.matches[at].score, lead(found, at, ""), used / 5, taught_for(lessons, text)]
}

// The network chooses once it has seen at least four answers, some right
// and some wrong.
fn ready(brain: Brain) -> Bool {
  let labels = for y in brain.ys { y[0] }
  return brain.xs.length() >= 4 and labels.contains(1) and labels.contains(0)
}

// The untried note the network thinks most likely, or, before it is
// ready, the first untried one. -1 when there is none.
fn likeliest(brain: Brain, rows: Number[][], tried: Number[]) -> Number {
  var found = -1
  var high = -1
  for i in 0 until rows.length() {
    if not tried.contains(i) {
      let p = if ready(brain) { predict(brain.net, rows[i])[0] } else { 1 - i / 10 }
      if p > high {
        high = p
        found = i
      }
    }
  }
  return found
}

fn choose(asked: Msg, found: NotesLike, before: LinksRecalled, known: BrainRecalled, lessons: LessonsLike) -> Pick {
  let brain = known.value.or(new_brain())
  let count = found.matches.length().min(candidates())
  if count == 0 { return no_pick() }
  let rows = for i in 0 until count { row_of(found, i, before, lessons) }
  let texts = for i in 0 until count { found.matches[i].value.text }
  // Only a note that stands out, or that was the right answer to a question
  // much like this one, may answer: the network chooses among those, and
  // never answers a question nothing kept is about.
  var could: Number[] = []
  for i in 0 until count {
    if near_enough(found, i, "") or rows[i][3] >= taught_enough(lessons) { could = could.append(i) }
  }
  if could.is_empty() { return no_pick() }
  // What you said was right for a question like this one comes first;
  // only without such a lesson does the network choose.
  var at = could[0]
  var lessoned = false
  for i in could {
    if rows[i][3] >= taught_enough(lessons) and rows[i][3] > rows[at][3] {
      at = i
      lessoned = true
    }
  }
  if rows[at][3] >= taught_enough(lessons) { lessoned = true }
  if ready(brain) and not lessoned {
    var high = -1
    for i in could {
      let p = predict(brain.net, rows[i])[0]
      if p > high {
        high = p
        at = i
      }
    }
  }
  return {question: asked.text, text: texts[at], rows: rows, texts: texts, tried: [at]}
}

// The brain after learning that the last note shown was right (1) or
// wrong (0). It keeps the last 200 answers.
fn taught(known: BrainRecalled, last: RecentRecalled, label: Number) -> Brain {
  let brain = known.value.or(new_brain())
  let pick = last.value.or(no_pick())
  if pick.text.is_empty() { return brain }
  let row = pick.rows[pick.tried[pick.tried.length() - 1]]
  let full = brain.xs.length() >= 200
  let xs = (if full { brain.xs.drop(1) } else { brain.xs }).append(row)
  let ys = (if full { brain.ys.drop(1) } else { brain.ys }).append([label])
  return {net: train(brain.net, xs, ys, 0.3, 40), xs: xs, ys: ys}
}

fn next_pick(last: RecentRecalled, brain: Brain) -> Pick {
  let pick = last.value.or(no_pick())
  if pick.text.is_empty() { return no_pick() }
  let at = likeliest(brain, pick.rows, pick.tried)
  if at < 0 { return no_pick() }
  return {question: pick.question, text: pick.texts[at], rows: pick.rows, texts: pick.texts, tried: pick.tried.append(at)}
}

fn lesson_of(last: RecentRecalled) -> Lesson {
  let pick = last.value.or(no_pick())
  return {question: pick.question, note: pick.text}
}

// ---------------------------------------------------------------- replies

fn kept(note: Note) -> Said {
  if note.text.is_empty() { return {text: "Tell me what to remember, like this: remember rent is 900 euros"} }
  return {text: "I will remember: " + note.text}
}

// ---------------------------------------------------------------- links

fn last_of(last: RecentRecalled) -> Msg {
  return {text: last.value.or(no_pick()).text}
}

// Where the links of the last answer are kept; a key nothing is kept
// under when there was no last answer.
fn link_key(before: Msg) -> Text {
  return if before.text.is_empty() { "-" } else { key_text(before.text) }
}

// `known` with the link to `other` one stronger, or new.
fn grown(known: LinksRecalled, other: Text, me: Text) -> Links {
  let links = known.value.or({notes: [], counts: []})
  if other.is_empty() or other == me { return links }
  var counts: Number[] = []
  var found = false
  for i in 0 until links.notes.length() {
    if links.notes[i] == other {
      counts = counts.append(links.counts[i] + 1)
      found = true
    } else {
      counts = counts.append(links.counts[i])
    }
  }
  if found { return {notes: links.notes, counts: counts} }
  return {notes: links.notes.append(other), counts: counts.append(1)}
}

// The note the link goes back to: the last answer, or, when there is no
// other note to link, this one again, so the second write changes nothing.
fn back_key(before: Msg, answer: Msg) -> Text {
  if before.text.is_empty() or before.text == answer.text { return key_text(answer.text) }
  return key_text(before.text)
}

fn back_value(theirs: LinksRecalled, ours: Links, before: Msg, answer: Msg) -> Links {
  if before.text.is_empty() or before.text == answer.text { return ours }
  return grown(theirs, answer.text, before.text)
}

fn answered(answer: Msg, linked: NotesLike, links: Links) -> Said {
  var reminders: Text[] = []
  for i in 0 until linked.matches.length() {
    let found = linked.matches[i]
    if found.value.text != answer.text and reminders.length() < 2 and near_enough(linked, i, answer.text) {
      reminders = reminders.append(found.value.text)
    }
  }
  var together: Text[] = []
  for i in 0 until links.notes.length() {
    let other = links.notes[i]
    if links.counts[i] >= learned() and together.length() < 2 and not reminders.contains(other) {
      together = together.append(other)
    }
  }
  let near = if reminders.is_empty() { "" } else { "\nThat reminds me of:\n  " + reminders.join("\n  ") }
  let used = if together.is_empty() { "" } else { "\nYou often ask about this with:\n  " + together.join("\n  ") }
  return {text: answer.text + near + used}
}

// ---------------------------------------------------------------- workflows

workflow keep(msg: Msg) -> Said {
  note  = note_of(msg)
  saved = remember note in notes under key_of(note)
  said  = kept(note)
}

// A note that answered: what it is near in meaning, and the links to the
// last answer, made one stronger in both directions.
workflow answer_with(pick: Pick) -> Said {
  answer = picked(pick)
  linked = recall notes like answer.text
  last   = recall recent under "last"
  before = last_of(last)
  mine   = recall links under key_text(answer.text)
  ours   = grown(mine, before.text, answer.text)
  theirs = recall links under back_key(before, answer)
  back   = back_value(theirs, ours, before, answer)
  one    = remember ours in links under key_text(answer.text)
  two    = remember back in links under back_key(before, answer)
  now    = remember pick in recent under "last"
  said   = answered(answer, linked, ours)
}

fn picked(pick: Pick) -> Msg {
  return {text: pick.text}
}

workflow ask(msg: Msg) -> Said {
  asked  = question_of(msg)
  near   = recall notes like asked.text
  last   = recall recent under "last"
  before = last_of(last)
  prev   = recall links under link_key(before)
  known  = recall brain under "me"
  taught = recall lessons like asked.text
  pick   = choose(asked, near, prev, known, taught)
  said   = match pick.text.is_empty() {
    case true { {text: "I don't remember anything about that. Tell me with: remember ..."} }
    case _ { call answer_with(pick) }
  }
}

workflow offer(pick: Pick) -> Said {
  now  = remember pick in recent under "last"
  said = perhaps(pick)
}

fn perhaps(pick: Pick) -> Said {
  return {text: "Then perhaps: " + pick.text}
}

workflow wrong(msg: Msg) -> Said {
  last  = recall recent under "last"
  known = recall brain under "me"
  brain = taught(known, last, 0)
  saved = remember brain in brain under "me"
  pick  = next_pick(last, brain)
  said  = match pick.text.is_empty() {
    case true { {text: "Sorry, I have nothing else that fits. Tell me with: remember ..."} }
    case _ { call offer(pick) }
  }
}

workflow learn_right(last: RecentRecalled) -> Said {
  known  = recall brain under "me"
  brain  = taught(known, last, 1)
  saved  = remember brain in brain under "me"
  lesson = lesson_of(last)
  kept   = remember lesson in lessons under key_text(lesson.question)
  said   = thanked(lesson)
}

workflow right(msg: Msg) -> Said {
  last   = recall recent under "last"
  before = last_of(last)
  said   = match before.text.is_empty() {
    case true { {text: "Ask me something first."} }
    case _ { call learn_right(last) }
  }
}

fn thanked(lesson: Lesson) -> Said {
  return {text: "Good, I will remember that this answers \"" + lesson.question + "\"."}
}

fn bare_word(msg: Msg) -> Text {
  return first_word(msg).replace("!", "").replace(".", "")
}

fn kind_of(msg: Msg) -> Text {
  let short = msg.text.trim().words().length() <= 3
  if short and ["right", "yes", "correct", "thanks", "good"].contains(bare_word(msg)) { return "right" }
  if short and ["wrong", "no", "nope"].contains(bare_word(msg)) { return "wrong" }
  if first_word(msg) != "remember" { return "ask" }
  if note_of(msg).text.is_empty() { return "empty" }
  return "keep"
}

workflow main(msg: Msg) -> Said {
  said = match kind_of(msg) {
    case "keep" { call keep(msg) }
    case "empty" { kept(note_of(msg)) }
    case "right" { call right(msg) }
    case "wrong" { call wrong(msg) }
    case _ { call ask(msg) }
  }
}

// ------------------------------------------------------------------ tests
// A test has no embedding model, so these recall by the words in common.

test "remembering keeps the note, and asking finds it" {
  a = main({text: "remember Rent is 900 euros a month"})
  b = main({text: "what is the rent a month?"})
  expect a.text == "I will remember: Rent is 900 euros a month"
  expect b.text == "Rent is 900 euros a month"
}

test "the nearest note answers, and the notes near it are what it reminds of" {
  a = main({text: "remember Rent for the flat is 900 euros a month"})
  b = main({text: "remember The flat landlord wants the rent on the 1st"})
  c = main({text: "remember The cat needs its vaccine in May"})
  d = main({text: "recall rent for the flat"})
  expect d.text == "Rent for the flat is 900 euros a month\nThat reminds me of:\n  The flat landlord wants the rent on the 1st"
}

test "a question near nothing kept is not answered" {
  a = main({text: "remember Rent is 900 euros a month"})
  b = main({text: "quantum physics homework"})
  expect b.text.starts_with("I don't remember anything about that")
}

test "notes asked about one after the other become linked" {
  a = main({text: "remember Maths exam is on 3 November"})
  b = main({text: "remember Physics revision covers chapters 4 to 6"})
  c = main({text: "remember Rent is 900 euros a month"})
  d = main({text: "when is the maths exam"})
  e = main({text: "what is in the physics revision"})
  f = main({text: "when is the maths exam"})
  g = main({text: "what is the rent"})
  // Asked once together, exam and physics are not linked yet; twice, they are.
  expect e.text == "Physics revision covers chapters 4 to 6"
  expect f.text == "Maths exam is on 3 November\nYou often ask about this with:\n  Physics revision covers chapters 4 to 6"
  expect g.text == "Rent is 900 euros a month"
}

record XorCheck { before: Number after: Number one: Number both: Number }

fn xor_check() -> XorCheck {
  let xs = [[0, 0], [0, 1], [1, 0], [1, 1]]
  let ys = [[0], [1], [1], [0]]
  let start = net([2, 4, 1], 1)
  let done = train(start, xs, ys, 0.3, 400)
  return {before: loss(start, xs, ys), after: loss(done, xs, ys), one: predict(done, [0, 1])[0], both: predict(done, [1, 1])[0]}
}

test "the network learns XOR, so it can learn what is not a straight line" {
  x = xor_check()
  expect x.before > 0.5
  expect x.after < 0.05
  expect x.one > 0.9
  expect x.both < 0.1
}

test "wrong offers the next note, and right is learned from" {
  a = main({text: "remember Rent is 900 euros a month"})
  b = main({text: "remember The rent goes to the landlord on the 1st"})
  c = main({text: "what is the rent"})
  d = main({text: "wrong"})
  e = main({text: "right"})
  expect c.text.starts_with("Rent is 900 euros a month")
  expect d.text == "Then perhaps: The rent goes to the landlord on the 1st"
  expect e.text == "Good, I will remember that this answers \"what is the rent\"."
}

test "after a few corrections, the network answers the way you mean" {
  a = main({text: "remember Rent is 900 euros a month"})
  b = main({text: "remember The rent goes to the landlord on the 1st"})
  c = main({text: "what is the rent"})
  d = main({text: "wrong"})
  e = main({text: "right"})
  f = main({text: "what is the rent"})
  g = main({text: "what is the cat called"})
  h = main({text: "wrong"})
  i = main({text: "what is the rent"})
  // The nearest note by words is the first, but the second was meant.
  expect c.text.starts_with("Rent is 900 euros a month")
  expect f.text.starts_with("The rent goes to the landlord on the 1st")
  expect i.text.starts_with("The rent goes to the landlord on the 1st")
}

test "right or wrong before any question" {
  a = main({text: "right"})
  b = main({text: "wrong"})
  expect a.text == "Ask me something first."
  expect b.text.starts_with("Sorry, I have nothing else")
}

test "remember with nothing after it asks for the note" {
  a = main({text: "remember"})
  expect a.text.starts_with("Tell me what to remember")
}
