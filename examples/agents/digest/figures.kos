  expect html.contains("cmp2")
  expect html.contains("<h4")
  expect html.contains("needs labels")
  expect html.contains("<i>costly</i>")
  expect html.contains("labels itself")
}

test "cycle draws a ring with an arrow back to the start" {
  loop: Figure = {look: Look.cycle, title: "The training loop", section: "§3", center: "training", items: [
    {label: "predict", value: "guess the mask", note: "", group: ""},
    {label: "score", value: "measure the error", note: "", group: ""},
    {label: "update", value: "nudge the weights", note: "", group: ""}
  ]}
  html = drawn(loop)
  expect html.contains("<marker")
  expect html.contains("marker-end")
  expect html.contains("predict")
  expect html.contains("guess the mask")
  expect html.count("<rect") >= 3
  expect html.contains("<div class=\"outline\"><b class=\"root\">training</b>")
}

test "the outline speaks of columns and loops" {
  drawing: Drawing = {question: "q", figures: [
    {look: Look.compare, title: "Two ways to learn", section: "", center: "learning", items: [
      {label: "supervised", value: "", note: "", group: ""},
      {label: "needs labels", value: "", note: "", group: "supervised"},
      {label: "self-supervised", value: "", note: "", group: ""},
      {label: "labels itself", value: "", note: "", group: "self-supervised"}
    ]},
    {look: Look.cycle, title: "The training loop", section: "", center: "training", items: [
      {label: "predict", value: "guess the mask", note: "", group: ""},
      {label: "score", value: "measure the error", note: "", group: ""},
      {label: "update", value: "nudge the weights", note: "", group: ""}
    ]}
  ]}
  text = outline_text(drawing, 1200)
  expect text.contains("supervised")
  expect text.contains("  · needs labels")
  expect text.contains("predict — guess the mask")
  expect text.contains("(and back to the start: the loop repeats)")
}
