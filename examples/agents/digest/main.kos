test "a paper's own words start at its abstract" {
  paper: Paper = {title: "T", link: "https://arxiv.org/abs/9", published: "", authors: "", summary: "Short.", field: "X"}
  expect paper_page(paper) == "https://arxiv.org/html/9"
  expect paper_text(paper, {url: "", title: "", text: "Menu Login Abstract: Long words."}) == "Abstract: Long words."
  expect paper_text(paper, no_page()) == "Abstract: Short."
  long = "Abstract: " + "intro words here. ".repeat(300) + "Our results show the lens bends light by 40 percent. " + "filler text again. ".repeat(900)
  kept = paper_text(paper, {url: "", title: "", text: long})
  expect kept.length() <= 14000
  expect kept.starts_with("Abstract: intro words here.")
  expect kept.contains("bends light by 40 percent")
}

test "with nothing read there is nothing to explain" {
  answers clock_now: [{date: "2026-10-15", time: "15:00", weekday: "Thursday", year: 2026, month: 10, day: 15, hour: 15, minute: 0, epoch: 1791810000}]
  answers read_feed: [{url: "", title: "", text: ""}, {url: "", title: "", text: ""}, {url: "", title: "", text: ""}, {url: "", title: "", text: ""}, {url: "", title: "", text: ""}]
    d = afternoon({text: ""})
  expect d.text.starts_with("No new papers could be read today.")
  e = evening({text: ""})
  expect e.text.starts_with("There is no afternoon digest")
}

test "the phone gets the titles, the links and the ideas" {
  said: Said = {text: "# Research digest\n\n### Light in glass\nOptics · 2026-10-14 · Ann Lee\nhttps://arxiv.org/abs/1 (preprint; explained from its abstract)\n\nThe idea: How to bend light.\nWhat it found: A new lens."}
  note = phone_note("Research digest", said)
  expect note.text == "Light in glass\nhttps://arxiv.org/abs/1 (preprint; explained from its abstract)\nHow to bend light."
  expect shown_with(said, {sent: true}).text.ends_with("(Sent to your phone.)")
  expect shown_with(said, {sent: false}).text == said.text
}
