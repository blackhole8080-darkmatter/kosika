// Digest: learn something new from the newest research, twice a day.
//
//   kosika test main.kos
//   kosika run main.kos --workflow afternoon --model qwen2.5:7b --model-protocol ollama
//       --model-timeout 1800 --max-output-tokens 4000
//       --allow-site export.arxiv.org --allow-site connect.biorxiv.org
//       --allow-site www.biorxiv.org --memory memory
//   kosika run main.kos --workflow evening ...the same...
//   kosika run main.kos --input ask.json ...the same sites...
//       where ask.json holds a paper's link to draw, like
//       {"msg": {"text": "https://arxiv.org/abs/2610.23850"}} or a
//       bioRxiv content link, or a topic to survey, like
//       {"msg": {"text": "survey cost-aware abstention"}}.
//
// In the afternoon it reads arXiv's newest papers in five fields, a
// different five each day from twenty across the sciences, AI, maths and
// computing, and one bioRxiv subject a day from four in biology, and
// explains each paper in plain words: the question it asks, what it found,
// how strong the evidence is, and what it leaves open. In the evening it
// takes two of the afternoon's papers further, with an example worked
// through and questions to check you understood.
//
// It only reads. It reaches nothing but the sites you allow, every paper
// is shown with its link so you can read it yourself, and a paper is
// never explained twice: the links it has shown are kept in its memory.
// An arXiv or bioRxiv paper is a preprint, not yet reviewed by other
// scientists, and it says so.
//
// It can send each digest to your phone as a notification. Install the
// free ntfy app (iOS or Android), subscribe to a topic name only you know,
// and run with --notify https://ntfy.sh/THAT-NAME. Notes go to that one
// address and nowhere else. Without --notify nothing is sent. A note about
// one paper taps open that paper's link, carries the figures written as an
// outline in its own words, and has the page of figures attached to it, so
// the mind maps, statistics and diagrams reach the phone with the paper.
//
// The models explain from each paper's abstract. They are told not to add
// what the abstract does not say, and each explanation says it was made
// from the abstract alone.

import "figures.kos"
import "std/search.kos"
import "std/evidence.kos"

record Msg { text: Text }
record Said { text: Text }
// The evening's lesson, and its two papers drawn as a page of figures.
record Lesson { text: Text page: Text }

record PageRequest { url: Text }
record Page { url: Text title: Text text: Text }

// A paper as the feed gives it.
record Paper { title: Text link: Text published: Text authors: Text summary: Text field: Text }
// What a model is asked: how to teach, and the papers.
record Batch { task: Text papers: Paper[] }

// One paper explained, in plain words.
record Explained { title: Text idea: Text found: Text evidence: Text open: Text use: Text }
record Lessons { items: Explained[] }

// One paper taken further, for the evening.
record Deep { title: Text lesson: Text example: Text questions: Text[] try_it: Text }
record Deeper { items: Deep[] }

// What one afternoon covered, for the evening to go on from.
record Day { date: Text papers: Paper[] }
// Every paper ever shown, by its link.
record Seen { links: Text[] }

record Field { code: Text name: Text }
record Plan { fields: Field[] urls: Text[] }

tool read_feed {
  source system "web"
  operation: "fetch"
  access: observe
  input: PageRequest
  output: Page
}

// A note to the phone: its words, the link tapping it opens, and one
// attached page (file_name and file empty for a plain note).
record Note { title: Text text: Text link: Text file_name: Text file: Text }
record Sent { sent: Bool }

tool tell_me {
  source system "notify"
  operation: "send"
  access: observe
  input: Note
  output: Sent
}

// A paper's page, a part at a time: `next` is where the following part
// begins, or -1 at the end.
record PartRequest { url: Text start: Number }
record Part { url: Text title: Text text: Text next: Number }

tool read_paper {
  source system "web"
  operation: "fetch_from"
  access: observe
  input: PartRequest
  output: Part
}

agent library {
  can: [read_feed, read_paper, tell_me]
}

model teacher {
  input: Batch
  output: Lessons
  parameters: {
    max_output_tokens: 4000
  }
}

model tutor {
  input: Batch
  output: Deeper
  parameters: {
    max_output_tokens: 3000
  }
}

// What the illustrator is given: how to draw, and one paper to read.
record Study { task: Text title: Text text: Text }
// A second try, with what the first one gave.
record Again { study: Study first: Drawing }

model illustrator {
  input: Study
  output: Drawing
  parameters: {
    max_output_tokens: 3000
  }
}

// One thing several papers say, and which of them say it (their places in
// the survey's list of papers, from 1).
record Claim { text: Text sources: Number[] }
// What reading several papers on one topic together says: where they
// agree, where they differ, what none of them settles, and two figures
// drawn for the whole topic: themes, a mind map of the area (items with
// an empty group are branches, a leaf's group is its branch's label, a
// leaf's note is the number of the paper it comes from), and numbers, a
// bar chart of one number per paper (label the paper in a few words,
// value the number as that paper's abstract writes it, note what it
// counts, group the paper's number).
record Survey { question: Text agreed: Claim[] differed: Claim[] open: Text[] themes: Item[] numbers: Item[] }
// What the synthesiser is asked.
record Ask { text: Text }

model synthesiser {
  input: Ask
  output: Survey
  parameters: {
    max_output_tokens: 2000
  }
}

memory days of Day
memory seen of Seen

// ---------------------------------------------------------------- the fields

fn fields() -> Field[] {
  return [
    {code: "cs.AI", name: "Artificial intelligence"},
    {code: "physics.optics", name: "Optics"},
    {code: "q-bio.NC", name: "Neuroscience"},
    {code: "math.PR", name: "Probability"},
    {code: "physics.chem-ph", name: "Chemistry"},
    {code: "cs.LG", name: "Machine learning"},
    {code: "astro-ph.GA", name: "Galaxies"},
    {code: "q-bio.GN", name: "Genomics"},
    {code: "math.CO", name: "Combinatorics"},
    {code: "cond-mat.mtrl-sci", name: "Materials"},
    {code: "cs.CL", name: "Language and computers"},
    {code: "quant-ph", name: "Quantum physics"},
    {code: "physics.bio-ph", name: "Biophysics"},
    {code: "stat.ML", name: "Statistics"},
    {code: "econ.GN", name: "Economics"},
    {code: "cs.CR", name: "Computer security"},
    {code: "astro-ph.EP", name: "Planets"},
    {code: "q-bio.PE", name: "Evolution"},
    {code: "math.NA", name: "Numerical methods"},
    {code: "cs.RO", name: "Robotics"}
  ]
}

fn feed_url(field: Field) -> Text {
  return "https://export.arxiv.org/api/query?search_query=cat:" + field.code + "&sortBy=submittedDate&sortOrder=descending&max_results=6"
}

// The bioRxiv subjects followed, one a day: biology's own preprints, in
// fields arXiv does not cover. The feed is RSS 1.0, read by the same
// feed-to-lines step as arXiv's.
fn biorxiv_fields() -> Field[] {
  return [
    {code: "bioinformatics", name: "Bioinformatics (bioRxiv)"},
    {code: "genetics", name: "Genetics (bioRxiv)"},
    {code: "neuroscience", name: "Neuroscience (bioRxiv)"},
    {code: "microbiology", name: "Microbiology (bioRxiv)"}
  ]
}

fn biorxiv_url(field: Field) -> Text {
  return "https://connect.biorxiv.org/biorxiv_xml.php?subject=" + field.code
}

// The six fields of a day: a different five arXiv fields each day, all
// twenty in four days, and one bioRxiv subject a day, all four in four
// days, so every subject comes round again.
fn plan_for(day: Number) -> Plan {
  let all = fields()
  let start = (day * 5) % all.length()
  var chosen: Field[] = []
  for i in 0 until 5 { chosen = chosen.append(all[(start + i) % all.length()]) }
  let life = biorxiv_fields()
  let pick = life[day % life.length()]
  chosen = chosen.append(pick)
  return {fields: chosen, urls: for field in chosen { if field.name.contains("bioRxiv") { biorxiv_url(field) } else { feed_url(field) }}}
}

// ---------------------------------------------------------------- reading a feed

// The papers in a feed's text: an entry begins with ---, then a line for
// each of its parts.
fn papers_in(text: Text, field: Text) -> Paper[] {
  var found: Paper[] = []
  var title = ""
  var link = ""
  var published = ""
  var authors: Text[] = []
  var summary = ""
  var open = false
  for line in (text + "\n---").lines() {
    if line.trim() == "---" {
      if open and not title.is_empty() and not link.is_empty() {
        found = found.append({title: title, link: link, published: published.take(10), authors: authors.take(4).join(", "), summary: summary.take(1500), field: field})
      }
      title = ""
      link = ""
      published = ""
      authors = []
      summary = ""
      open = true
    } else if line.starts_with("Title: ") { title = line.drop(7).trim() }
    else if line.starts_with("Link: ") { link = line.drop(6).trim() }
    else if line.starts_with("Published: ") { published = line.drop(11).trim() }
    else if line.starts_with("Author: ") { authors = authors.append(line.drop(8).trim()) }
    else if line.starts_with("Summary: ") { summary = line.drop(9).trim() }
  }
  return found
}

// Up to `most` papers of a feed that have not been shown before.
fn new_papers(page: Page, field: Field, seen: Text[], most: Number) -> Paper[] {
  var kept: Paper[] = []
  for paper in papers_in(page.text, field.name) {
    if kept.length() < most and not seen.contains(paper.link) { kept = kept.append(paper) }
  }
  return kept
}

fn gathered(plan: Plan, pages: Page[], past: SeenRecalled) -> Paper[] {
  let seen = if past.found { past.value.value().links } else { [] }
  var all: Paper[] = []
  for i in 0 until pages.length() {
    all = all.concat(new_papers(pages[i], plan.fields[i], seen, 3))
  }
  return all
}

fn no_page() -> Page {
  return {url: "", title: "", text: ""}
}

// ---------------------------------------------------------------- asking the models

fn teach_task() -> Text {
  return "You are a patient teacher who explains new research to a curious person who is not an expert in the field. For each paper, in the same order, write: idea, the question the paper asks and why it matters, in two or three sentences; found, what it found or built, with its key numbers if the abstract gives them; evidence, how strong the evidence is and what kind (an experiment, a proof, a simulation, a survey), remembering that an arXiv or bioRxiv paper is a preprint not yet reviewed by other scientists; open, what is still uncertain or limited; use, one practical way the idea could be used or tested. Define any technical term in plain words the first time you use it. Use only what the abstract says: do not invent results, numbers or methods it does not state. Keep the paper's title exactly."
}

fn tutor_task() -> Text {
  return "You are a tutor giving an evening lesson that goes deeper into two research papers the person met this afternoon. For each paper write: lesson, a clear explanation of the main idea from the ground up in five to eight sentences, with the background a beginner needs; example, one small worked example or analogy that shows the idea in action, step by step; questions, three short questions that check understanding, from easy to harder; try_it, one thing the person could do, read or try next to learn more. Use only what the abstract says about the paper itself, and say so when you add general background. Keep the paper's title exactly."
}

// The papers of one field, to be explained together: a few at a time is
// what a small model on a laptop writes well.
fn field_batch(papers: Paper[], plan: Plan, which: Number) -> Batch {
  let name = plan.fields[which].name
  return {task: teach_task(), papers: for paper in papers where paper.field == name { paper }}
}

fn no_lessons() -> Lessons {
  return {items: []}
}

// ---------------------------------------------------------------- what is shown

fn explained_text(item: Explained, paper: Paper) -> Text {
  return f"### {paper.title}\n{paper.field} · {paper.published} · {paper.authors}\n{paper.link} (preprint; explained from its abstract)\n\nThe idea: {item.idea}\nWhat it found: {item.found}\nHow strong the evidence is: {item.evidence}\nStill open: {item.open}\nUse it: {item.use}\n"
}

fn plain_text(paper: Paper) -> Text {
  return f"### {paper.title}\n{paper.field} · {paper.published} · {paper.authors}\n{paper.link} (preprint)\n\n{paper.summary.take(600)}\n"
}

// The afternoon's digest: each paper with its explanation, or, when the
// model gave none for it, its own abstract.
fn digest(today: Moment, papers: Paper[], explained: Lessons[]) -> Said {
  if papers.is_empty() {
    return {text: "No new papers could be read today. Check that export.arxiv.org is allowed and the computer is online, then ask again."}
  }
  var lessons: Explained[] = []
  for one in explained { lessons = lessons.concat(one.items) }
  var parts: Text[] = [f"# Research digest, {today.weekday} {today.date}\n\n{papers.length()} new papers from {fields_named(papers)}. Each is a preprint on arXiv; read the paper before relying on it.\n"]
  for i in 0 until papers.length() {
    let paper = papers[i]
    var shown = plain_text(paper)
    for item in lessons {
      if item.title.trim().lower() == paper.title.trim().lower() { shown = explained_text(item, paper) }
    }
    parts = parts.append(shown)
  }
  parts = parts.append("Tonight at eight: two of these, taken further.")
  return {text: parts.join("\n")}
}

fn fields_named(papers: Paper[]) -> Text {
  return (for paper in papers { paper.field }).unique().join(", ")
}

fn shown_with(said: Said, sent: Sent) -> Said {
  return if sent.sent { {text: said.text + "

(Sent to your phone.)"} } else { said }
}

fn day_of(today: Moment, papers: Paper[]) -> Day {
  return {date: today.date, papers: papers}
}

fn seen_with(past: SeenRecalled, papers: Paper[]) -> Seen {
  let before = if past.found { past.value.value().links } else { [] }
  return {links: before.concat(for paper in papers { paper.link }).unique()}
}

// The evening's two papers: the first two of different fields.
fn evening_batch(past: DaysRecalled) -> Batch {
  let papers = if past.found { past.value.value().papers } else { [] }
  var chosen: Paper[] = []
  for paper in papers {
    if chosen.length() < 2 and not (for c in chosen { c.field }).contains(paper.field) { chosen = chosen.append(paper) }
  }
  return {task: tutor_task(), papers: chosen}
}

fn lesson_text(item: Deep, paper: Paper) -> Text {
  var asked: Text[] = []
  for i in 0 until item.questions.length() { asked = asked.append(f"{i + 1}. {item.questions[i]}") }
  return f"## {paper.title}\n{paper.link}\n\n{item.lesson}\n\nAn example: {item.example}\n\nCheck yourself:\n{asked.join(\"\\n\")}\n\nNext: {item.try_it}\n"
}

fn evening_text(batch: Batch, deeper: Deeper) -> Said {
  if batch.papers.is_empty() {
    return {text: "There is no afternoon digest to go on from yet. Run the afternoon digest first."}
  }
  var parts: Text[] = ["# Evening lesson\n"]
  for paper in batch.papers {
    var shown = plain_text(paper)
    for item in deeper.items {
      if item.title.trim().lower() == paper.title.trim().lower() { shown = lesson_text(item, paper) }
    }
    parts = parts.append(shown)
  }
  return {text: parts.join("\n")}
}

// ---------------------------------------------------------------- drawing a paper

// arXiv shows most new papers as a web page as well as a PDF.
fn paper_page(paper: Paper) -> Text {
  return source_of(paper.link).page
}

// The paper's own words from its abstract on, without the site's menus.
// When the page could not be read, the abstract is all there is.
fn paper_text(paper: Paper, page: Page) -> Text {
  let at = page.text.index_of("Abstract")
  if not at.exists() { return "Abstract: " + paper.summary }
  return passages(page.text.drop(at.value()), 14000)
}

// What a model can read of a long paper: its opening (the abstract and
// the start of the introduction), then the passages that best say what
// it did, found and concluded, kept in the paper's own order. Code picks
// them, by the words they share with those questions.
fn passages(text: Text, most: Number) -> Text {
  if text.length() <= most { return text }
  let opening = text.take(3000)
  let pieces = slices(text.drop(3000), 1500)
  var chosen: Number[] = []
  for question in ["results we find show our experiments demonstrate", "conclusion summary we conclude in this work limitations future work", "method approach we propose model framework algorithm", "table figure compared improves accuracy error percent"] {
    for hit in rank(question, pieces, 6) { chosen = chosen.append(hit.index) }
  }
  var kept: Text[] = [opening]
  var size = opening.length()
  for i in chosen.unique().sort() {
    if size + pieces[i].length() + 5 <= most {
      kept = kept.append(pieces[i])
      size = size + pieces[i].length() + 5
    }
  }
  return kept.join("
[...]
")
}

// A long text cut into pieces of `size` characters. (std's chunks splits
// into words first, and a value may hold at most 512 parts.)
fn slices(text: Text, size: Number) -> Text[] {
  return for i in 0 until (text.length() / size).ceil() { text.slice(i * size, ((i + 1) * size).min(text.length())) }
}

fn part_page(parts: Part[]) -> Page {
  return {url: "", title: "", text: (for part in parts { part.text }).join("")}
}

fn no_part() -> Part {
  return {url: "", title: "", text: "", next: -1}
}

fn draw_task() -> Text {
  return "You turn one research paper into a page of figures that explain it to a curious person who is not an expert. Read the paper, then choose the four to seven figures that best explain THIS paper: what it asks, how it works, what it found and how firmly. Pick the kinds that fit what the paper is about, so a paper of proofs, a lab experiment and a survey each look different. The kinds, and what each item means: flow (label is a step, value what happens in it); numbers (label is a number written as the paper gives it, like 69% or x3.1, value what it counts); bars (label a thing, value its number, note the unit; only numbers the paper gives); curve (label a line's name, value its heights left to right like \"1 2 4 3\", center what runs along the bottom; only for a shape the paper describes or plots); tree (items with an empty group are branches, items whose group is a branch's label hang from it, note a short tag like exact or bound); mindmap (the same as tree, with center the paper's subject in two or three words, and three to six branches); timeline (label when, value what happened); glossary (label a technical word, value its meaning in plain words); card (center a name, each item one fact as label and value); quote (value one important sentence copied exactly from the paper); scatter (label names the point, value its two numbers as \"x y\", center the two axes in a few words; only for pairs the paper itself lists); box (label a group's name, value that group's numbers as \"12 14 9 11\" exactly as the paper gives them; for comparing how several groups spread); forest (label the study or condition, value three numbers as \"estimate low high\": the finding and its confidence interval; for differences where no effect is 0; every row shares one axis); compare (items with an empty group name the columns, two to four of them; items whose group is a column's name are its rows, label the point in a few words, note a short tag; center says what is being compared; for putting two paradigms or approaches side by side); cycle (label a stage, value what happens in it, three to eight stages in order round the loop; center names the loop; for a process that feeds back on itself). For a scatter, a box or a forest you give only the paper's raw numbers: the correlation r, the medians, the quartiles and the whiskers are worked out by code and marked computed, and a number the paper does not give loses the figure. For every figure give a short title, and section: where in the paper it comes from, like Abstract or Section 3. Keep every label under six words and every value under twenty. Use only what the paper says: never invent a number, result or method. Also write question: the paper's question in one plain sentence."
}

fn study_of(paper: Paper, page: Page) -> Study {
  return {task: draw_task(), title: paper.title, text: paper_text(paper, page)}
}

fn again_task(first: Drawing) -> Text {
  let kept = (for figure in first.figures { f"{figure.look}" }).join(", ")
  return draw_task() + f" Your first answer gave only {first.figures.length()} usable figures ({kept}). Give five to seven this time, of at least four different kinds, each filled completely. A numbers or bars figure is dropped unless every number appears in the paper exactly as written, and its label must be the number itself."
}

// Only the figures whose numbers the paper really gives.
fn checked(drawing: Drawing, text: Text) -> Drawing {
  return {question: drawing.question, figures: for figure in drawing.figures where grounded(figure, text) { figure }}
}

fn no_drawing() -> Drawing {
  return {question: "", figures: []}
}

fn sheet_of(paper: Paper, drawing: Drawing) -> Sheet {
  return {title: paper.title, field: paper.field, published: paper.published, authors: paper.authors, link: paper.link, drawing: drawing}
}

// The page of figures, when the model drew anything worth showing.
fn figures_page(batch: Batch, drawings: Drawing[]) -> Text {
  var sheets: Sheet[] = []
  for i in 0 until batch.papers.length().min(drawings.length()) {
    if not (for figure in drawings[i].figures where drawable(figure) { figure }).is_empty() {
      sheets = sheets.append(sheet_of(batch.papers[i], drawings[i]))
    }
  }
  return if sheets.is_empty() { "" } else { page("Tonight's papers, drawn", sheets) }
}

// The arXiv link in a message, written the one way the site uses for
// a paper's page; empty when there is none.
fn arxiv_link(text: Text) -> Text {
  for word in text.replace("/pdf/", "/abs/").replace(".pdf", "").words() {
    var id = word.trim()
    let at = id.index_of("arxiv.org/abs/")
    if at.exists() { id = id.drop(at.value() + 14) }
    if is_arxiv_id(id) { return "https://arxiv.org/abs/" + id }
  }
  return ""
}

// An arXiv number: four digits, a dot, four or five digits, and perhaps
// a version such as v2.
fn is_arxiv_id(id: Text) -> Bool {
  let parts = id.split(".")
  if parts.length() != 2 or parts[0].length() != 4 or not parts[0].to_number().exists() { return false }
  let rest = parts[1].split("v")
  return rest.length() <= 2 and (rest[0].length() == 4 or rest[0].length() == 5) and rest[0].to_number().exists() and (rest.length() == 1 or rest[1].to_number().exists())
}

// The bioRxiv content link a message holds, without the feed's ?rss=1, or
// "" when it holds none: https://www.biorxiv.org/content/10.1101/...v1
fn biorxiv_link(text: Text) -> Text {
  for word in text.words() {
    let clean = word.trim().trim_marks(".,;:!?)(\"'")
    if clean.contains("biorxiv.org/content/") { return clean.split("?")[0] }
  }
  return ""
}

// Where a paper link is read from, and the preprint server it is on: the
// arXiv reading of an abs page, or a bioRxiv paper's full text.
record Source { page: Text server: Text }

fn source_of(link: Text) -> Source {
  let life = biorxiv_link(link)
  if not life.is_empty() {
    let full = if life.ends_with("full") { life } else { life + "/full" }
    return {page: full, server: "bioRxiv"}
  }
  return {page: link.replace("/abs/", "/html/"), server: "arXiv"}
}

// The paper of a link, once its page's opening has been read: its title,
// the link itself, and the server it is on.
fn paper_from(link: Text, source: Source, first: Part) -> Paper {
  let title = if first.title.trim().is_empty() { link } else { first.title.trim() }
  return {title: title, link: link, published: "", authors: "", summary: "", field: source.server}
}

fn no_lesson(text: Text) -> Lesson {
  return {text: text, page: ""}
}

fn one_drawn(one: Paper, drawing: Drawing) -> Lesson {
  let shown = for figure in drawing.figures where drawable(figure) { figure }
  if shown.is_empty() {
    return no_lesson(f"I could not draw {one.title}: the page could not be read, or no figure came out right. Try again, or try another paper.")
  }
  let kind = if shown.length() == 1 { "figure" } else { "figures" }
  return {text: f"Drew {one.title} as {shown.length()} {kind}.
{one.link}", page: page(one.title, [sheet_of(one, drawing)])}
}

fn paper_at(batch: Batch, i: Number) -> Paper {
  return if i < batch.papers.length() { batch.papers[i] } else { {title: "", link: "", published: "", authors: "", summary: "", field: ""} }
}

fn said_of(lesson: Lesson) -> Said {
  return {text: lesson.text}
}

fn lesson_of(said: Said, page: Text) -> Lesson {
  let told = if page.is_empty() { said.text } else { said.text + "\n\nThe two papers are drawn as figures in this evening's page, attached to the note and beside this digest on the laptop." }
  return {text: told, page: page}
}

// What is sent to the phone: short enough to read there. The whole digest
// is what the run prints.
fn phone_note(title: Text, said: Said) -> Note {
  var kept: Text[] = []
  for line in said.text.lines() {
    if line.starts_with("### ") { kept = kept.append("
" + line.drop(4)) }
    else if line.starts_with("## ") { kept = kept.append("
" + line.drop(3)) }
    else if line.starts_with("https://") { kept = kept.append(line) }
    else if line.starts_with("The idea: ") { kept = kept.append(line.drop(10).take(300)) }
    else if line.starts_with("An example: ") { kept = kept.append(line.drop(12).take(300)) }
  }
  let body = if kept.is_empty() { said.text } else { kept.join("
").trim() }
  return {title: title, text: body, link: "", file_name: "", file: ""}
}

// A title as a file name for an attached page: lower case, letters and
// digits, a dash between words, .html at the end.
fn page_name(title: Text) -> Text {
  var words: Text[] = []
  var word = ""
  for c in title.lower().chars() {
    if "abcdefghijklmnopqrstuvwxyz0123456789".contains(c) {
      word = word + c
    } else if not word.is_empty() {
      words = words.append(word)
      word = ""
    }
  }
  if not word.is_empty() { words = words.append(word) }
  let slug = words.join("-").take(40).trim_marks("-")
  let name = if slug.is_empty() { "paper" } else { slug }
  return name + ".html"
}

// The evening's note: the lesson's words, the first paper's link to tap,
// and the page of figures attached.
fn evening_note(said: Said, page: Text, link: Text) -> Note {
  let plain = phone_note("Evening lesson", said)
  let name = if page.is_empty() { "" } else { page_name("Evening lesson") }
  return {title: plain.title, text: plain.text, link: link, file_name: name, file: page}
}

// What the phone gets for one drawn paper: the words, the figures as an
// outline, the paper's link to tap, and the page itself attached.
fn drawn_note(one: Paper, drawing: Drawing, lesson: Lesson) -> Note {
  let said = if lesson.page.is_empty() { lesson.text } else { lesson.text + "\n\n" + outline_text(drawing, 1200) }
  let name = if lesson.page.is_empty() { "" } else { page_name(one.title) }
  return {title: "A paper, drawn", text: said, link: one.link, file_name: name, file: lesson.page}
}

fn not_sent() -> Sent {
  return {sent: false}
}

// ---------------------------------------------------------------- the survey

// Reading several papers on one topic together: code finds them on arXiv
// (the same relevance search the site itself offers), each paper's figures
// are drawn from its own abstract and grounded against it, and the
// synthesiser says where they agree, where they differ and what is still
// open — every claim carrying the numbers of the papers that say it.

// How many papers one survey reads.
fn survey_most() -> Number {
  return 3
}

// The topic a message asks a survey of: the words after "survey".
fn topic_of(text: Text) -> Text {
  let lower = text.trim().lower()
  if lower == "survey" or lower.starts_with("survey ") { return text.trim().drop(7).trim() }
  return text.trim()
}

// arXiv's own relevance search for the topic, as a feed the reader reads.
// Every word of the topic must be there, all of them ANDed.
fn survey_url(topic: Text) -> Text {
  var query: Text[] = []
  for word in topic.trim().words() { query = query.append("all:" + word) }
  return "https://export.arxiv.org/api/query?search_query=" + query.join("+AND+") + "&sortBy=relevance&max_results=8"
}

// The first `most` distinct papers of a search: one link each, every link
// and title real.
fn distinct_papers(papers: Paper[], most: Number) -> Paper[] {
  var kept: Paper[] = []
  for paper in papers {
    if kept.length() < most and not paper.title.is_empty() and not paper.link.is_empty() and (for k in kept where k.link == paper.link { k }).is_empty() {
      kept = kept.append(paper)
    }
  }
  return kept
}

// The survey's fill task: figures from the abstract alone, so every paper
// of the survey can be drawn without reading it in full.
fn survey_draw_task() -> Text {
  return "You turn one research paper's abstract into two to four figures that explain it to a curious person who is not an expert. Work from the abstract only. The kinds, and what each item means: numbers (label is a number written as the paper gives it, like 69% or x3.1, value what it counts); bars (label a thing, value its number, note the unit; only numbers the abstract gives); glossary (label a technical word, value its meaning in plain words); card (center a name, each item one fact as label and value); mindmap (the same as tree, with center the paper's subject in two or three words and three to six branches; items with an empty group are branches, items whose group is a branch's label hang from it); flow (label is a step, value what happens in it); compare (items with an empty group name the columns, two to four of them; items whose group is a column's name are its rows). A numbers or bars figure is dropped unless every number appears in the abstract exactly as written, and its label must be the number itself. For every figure give a short title and section: Abstract. Keep every label under six words and every value under twenty. Use only what the abstract says: never invent a number, result or method. Also write question: the paper's question in one plain sentence."
}

fn paper_pick(papers: Paper[], i: Number) -> Paper {
  return if i < papers.length() { papers[i] } else { {title: "", link: "", published: "", authors: "", summary: "", field: ""} }
}

// What the synthesiser reads: the topic, then each paper numbered, with
// its title, its place, and its abstract.
fn survey_prompt(topic: Text, papers: Paper[]) -> Ask {
  var parts: Text[] = []
  for i in 0 until papers.length() {
    let paper = papers[i]
    parts = parts.append(f"[{i + 1}] {paper.title}\nAbstract: {paper.summary}")
  }
  return {text: "You have read " + papers.length().to_text() + " research papers (preprints) on one topic. The topic: " + topic.trim() + "\n\n" + parts.join("\n\n") + "\n\nSay what reading them together shows. In question, the topic restated as one plain question.\nIn agreed, at most three short claims that more than one paper supports, each with sources: the numbers of the papers that support it, like [1, 3].\nIn differed, at most three short claims where papers disagree or differ in their findings or their setting, each with sources like [1, 2].\nIn open, at most three things none of the abstracts settles.\nEvery claim must come only from the abstracts above: never add what they do not say, and never give a paper number whose abstract does not back the claim. Keep each claim to one short sentence."}
}

// A claim is kept only when every source it names is a paper of the survey.
fn cited(claim: Claim, count: Number) -> Bool {
  if claim.sources.is_empty() { return false }
  return (for s in claim.sources where s < 1 or s > count { s }).is_empty()
}

fn clean_survey(survey: Survey, count: Number) -> Survey {
  return {
    question: survey.question,
    agreed: for claim in survey.agreed where cited(claim, count) { claim },
    differed: for claim in survey.differed where cited(claim, count) { claim },
    open: survey.open.take(3),
    themes: survey.themes,
    numbers: survey.numbers
  }
}

// Whether every paper a claim cites shares a content word with it: each
// cited abstract says something in the claim's own words. A claim no
// cited abstract shares a word with is the synthesiser's comparison, not
// the papers' words, and is marked as such rather than shown as fact.
fn claim_backed(claim: Claim, papers: Paper[]) -> Bool {
  let keys = search_words(claim.text, false).words()
  if keys.is_empty() { return false }
  for s in claim.sources {
    let paper = paper_pick(papers, s - 1)
    let words = paper.summary.lower()
    if (for key in keys where words.contains(key) { key }).is_empty() { return false }
  }
  return true
}

// The claims and their citations, as words for the reader and the phone.
// A claim that survived the citation check but shares no word with every
// abstract it cites is shown with a star, and the star is explained once.
fn survey_text(topic: Text, survey: Survey, papers: Paper[]) -> Text {
  var parts: Text[] = ["Survey: " + topic.trim()]
  if not survey.question.is_empty() { parts = parts.append("Question: " + survey.question) }
  var marked = false
  if not survey.agreed.is_empty() {
    parts = parts.append("Where they agree:")
    for claim in survey.agreed.take(3) {
      let backed = claim_backed(claim, papers)
      if not backed { marked = true }
      parts = parts.append("- " + claim.text + " [" + (for s in claim.sources { s.to_text() }).join(", ") + "]" + (if backed { "" } else { " *" }))
    }
  }
  if not survey.differed.is_empty() {
    parts = parts.append("Where they differ:")
    for claim in survey.differed.take(3) {
      let backed = claim_backed(claim, papers)
      if not backed { marked = true }
      parts = parts.append("- " + claim.text + " [" + (for s in claim.sources { s.to_text() }).join(", ") + "]" + (if backed { "" } else { " *" }))
    }
  }
  if not survey.open.is_empty() {
    parts = parts.append("Still open:")
    for line in survey.open.take(3) { parts = parts.append("- " + line) }
  }
  parts = parts.append("The papers:")
  for i in 0 until papers.length() {
    parts = parts.append("[" + (i + 1).to_text() + "] " + papers[i].title + "\n" + papers[i].link)
  }
  if marked {
    parts = parts.append("* marks a claim one of its cited papers shares no word with: part of it is the comparison across the papers, not what any one of them says.")
  }
  return parts.join("\n")
}

// One paper of the survey, drawn from its own abstract and grounded
// against it. A paper with no title is skipped without asking a model.
workflow survey_draw(paper: Paper) -> Drawing {
  drawing = match paper.title.is_empty() {
    case true { no_drawing() }
    case _ { call survey_drawn(paper) }
  }
}

workflow survey_drawn(paper: Paper) -> Drawing {
  raw     = use_model illustrator(survey_draw_task(), paper.title, paper.summary) retry 1 otherwise no_drawing()
  drawing = checked(raw, paper.summary)
}

fn no_survey() -> Survey {
  return {question: "", agreed: [], differed: [], open: [], themes: [], numbers: []}
}

// ------------------------------------------------- the survey's own figures

// Whether one bar of the papers' numbers is real: its number, as written,
// must be in the abstract of the paper it cites. The model may arrange the
// pair either way — the paper's number in group and the metric in value,
// or the paper's number in value and the metric in note — and whichever
// field holds a whole number in range is read as the citation, so a bar
// citing paper 1 is kept only when paper 1's own abstract holds its number.
record Bar { paper: Number metric: Text }

fn cited_paper(n: Number?, papers: Paper[]) -> Number {
  if not n.exists() { return 0 }
  if n.value() < 1 or n.value() > papers.length() { return 0 }
  if n.value() != n.value().floor() { return 0 }
  return n.value()
}

fn bar_parts(item: Item, papers: Paper[]) -> Bar {
  let from_group = cited_paper(item.group.trim().to_number(), papers)
  if from_group > 0 { return {paper: from_group, metric: item.value} }
  let from_value = cited_paper(item.value.trim().to_number(), papers)
  if from_value > 0 { return {paper: from_value, metric: item.note} }
  let by_name = cited_paper(named_paper(item, papers), papers)
  if by_name > 0 { return {paper: by_name, metric: item.value} }
  return {paper: 0, metric: ""}
}

// The paper a figure item cites by NAME: the one paper whose title holds a
// distinctive word of the item's own words, as a reader resolves
// "PrefixQuant" to its place in the list. Several or none is no citation.
fn named_paper(item: Item, papers: Paper[]) -> Number {
  var words: Text[] = []
  for word in (item.label + " " + item.note + " " + item.group).lower().words() {
    if word.length() >= 4 and not words.contains(word) { words = words.append(word) }
  }
  var found = 0
  for word in words {
    var matches = 0
    var which = 0
    for i in 0 until papers.length() {
      if papers[i].title.lower().contains(word) {
        matches += 1
        which = i + 1
      }
    }
    if matches == 1 {
      if found == 0 { found = which }
      if found != which { return 0 }
    }
  }
  return found
}

fn grounded_number(item: Item, papers: Paper[]) -> Bool {
  let parts = bar_parts(item, papers)
  if parts.paper == 0 { return false }
  let want = number_text(parts.metric)
  if want.is_empty() { return false }
  return paper_pick(papers, parts.paper - 1).summary.contains(want)
}

// The papers' numbers, grounded per citation: a bar citing paper 1 is kept
// only when paper 1's own abstract holds its number.
fn grounded_numbers(items: Item[], papers: Paper[]) -> Item[] {
  return for item in items where grounded_number(item, papers) { item }
}

// The topic's map from the synthesiser's themes. When the themes come as
// branches with leaves (an item's group empty names a branch, a leaf's
// group is its branch) they are used as they are; when every item names
// its theme in group, code builds the branches itself and hangs each item
// under its theme, the paper's number riding as the leaf's note.
fn theme_items(themes: Item[]) -> Item[] {
  if not (for item in themes where item.group.trim().is_empty() { item }).is_empty() { return themes }
  var seen: Text[] = []
  for item in themes {
    if not item.group.trim().is_empty() and not seen.contains(item.group) { seen = seen.append(item.group) }
  }
  if seen.length() >= 3 {
    var out: Item[] = []
    for name in seen { out = out.append({label: name, value: "", note: "", group: ""}) }
    for item in themes {
      if not item.group.trim().is_empty() {
        out = out.append({label: item.label, value: "", note: item.value, group: item.group})
      }
    }
    return out
  }
  // Fewer than three themes named: each item is its own branch, the paper
  // it names riding as the leaf under it.
  var out: Item[] = []
  for item in themes {
    out = out.append({label: item.label, value: "", note: "", group: ""})
    if not item.value.trim().is_empty() {
      out = out.append({label: item.value.trim().take(24), value: "", note: "", group: item.label})
    }
  }
  return out
}

// The papers on one line of time, oldest first, straight from their own
// dates: drawn by code from the papers' data, no model asked. Sorting the
// "date|title" lines sorts the dates, ISO dates being written so.
fn survey_timeline(papers: Paper[]) -> Figure {
  var lines: Text[] = []
  for paper in papers {
    let when = if paper.published.is_empty() { "9999-12-31" } else { paper.published }
    lines = lines.append(when + "|" + paper.title.replace("|", " "))
  }
  var rows: Item[] = []
  for line in lines.sort() {
    let at = line.index_of("|")
    let when = if at.exists() { line.take(at.value()) } else { "" }
    let what = if at.exists() { line.drop(at.value() + 1) } else { line }
    rows = rows.append({label: if when == "9999-12-31" { "preprint" } else { when }, value: what, note: "", group: ""})
  }
  return {look: Look.timeline, title: "The papers on one line of time", section: "Across the papers", center: "", items: rows}
}

// The topic's map: the synthesiser's themes, drawn as a mind map whose
// leaves name the papers under each theme.
fn survey_map(topic: Text, survey: Survey) -> Figure {
  return {look: Look.mindmap, title: "The topic's map", section: "Across the papers", center: topic.trim().take(28), items: theme_items(survey.themes)}
}

// The papers' numbers side by side: one bar per paper, every bar's number
// grounded against the paper its group names.
fn survey_graph(survey: Survey, papers: Paper[]) -> Figure {
  return {look: Look.bars, title: "The papers' numbers", section: "Across the papers", center: "", items: grounded_numbers(survey.numbers, papers)}
}

// The page: the survey's own figures first — the papers on one line of
// time, the topic's map, the papers' numbers — then one block per paper,
// each block's title linking to the paper itself.
fn survey_page(topic: Text, papers: Paper[], survey: Survey, drawings: Drawing[]) -> Text {
  var overview: Figure[] = []
  let time = survey_timeline(papers)
  if time.items.length() >= 2 { overview = overview.append(time) }
  let map = survey_map(topic, survey)
  if drawable(map) { overview = overview.append(map) }
  let graph = survey_graph(survey, papers)
  if drawable(graph) { overview = overview.append(graph) }
  var sheets: Sheet[] = []
  if not overview.is_empty() {
    sheets = sheets.append({title: "Survey: " + topic.trim(), field: "Survey", published: "", authors: "", link: "", drawing: {question: survey.question, figures: overview}})
  }
  for i in 0 until papers.length().min(drawings.length()) {
    let shown: Drawing = {question: drawings[i].question, figures: for figure in drawings[i].figures where drawable(figure) { figure }}
    if not shown.figures.is_empty() {
      sheets = sheets.append(sheet_of(papers[i], shown))
    }
  }
  return if sheets.is_empty() { "" } else { page("Survey: " + topic.trim(), sheets) }
}

fn survey_note(topic: Text, said: Said, page: Text, papers: Paper[]) -> Note {
  let link = if papers.is_empty() { survey_url(topic) } else { papers[0].link }
  let name = if page.is_empty() { "" } else { page_name("Survey " + topic) }
  return {title: "Survey: " + topic.trim().take(60), text: said.text, link: link, file_name: name, file: page}
}

// One survey of a topic: found by code, drawn per paper, synthesised with
// citations, sent to the phone.
workflow survey_of(msg: Msg) -> Lesson {
  budget 6 model calls, 7200 seconds
  topic   = topic_of(msg.text)
  found_p = execute library.read_feed(survey_url(topic)) otherwise no_page()
  found   = distinct_papers(papers_in(found_p.text, "arXiv"), survey_most())
  said0   = match found.is_empty() {
    case true { no_lesson("I found no papers on \"" + topic.trim() + "\" on arXiv. Try other words, or name the topic after \"survey\".") }
    case _ { call survey_full({text: topic}, {papers: found}) }
  }
}

// The papers a survey reads, as one record: a workflow takes records.
record Found { papers: Paper[] }

workflow survey_full(asked: Msg, found: Found) -> Lesson {
  papers = found.papers
  d1 = call survey_draw(paper_pick(papers, 0))
  d2 = call survey_draw(paper_pick(papers, 1))
  d3 = call survey_draw(paper_pick(papers, 2))
  ask  = survey_prompt(asked.text, papers)
  raw  = use_model synthesiser(ask.text) retry 1 otherwise no_survey()
  neat = clean_survey(raw, papers.length())
  said = {text: survey_text(asked.text, neat, papers)}
  page = survey_page(asked.text, papers, neat, [d1, d2, d3])
  note = survey_note(asked.text, said, page, papers)
  sent = execute library.tell_me(note.title, note.text, note.link, note.file_name, note.file) otherwise not_sent()
  shown = lesson_told({text: said.text, page: page}, sent)
}

// ---------------------------------------------------------------- workflows

workflow afternoon(msg: Msg) -> Said {
  budget 12 model calls, 7200 seconds
  today  = now
  plan   = plan_for(today.day)
  past   = recall seen under "all"
  a      = execute library.read_feed(plan.urls[0]) otherwise no_page()
  b      = execute library.read_feed(plan.urls[1]) otherwise no_page()
  c      = execute library.read_feed(plan.urls[2]) otherwise no_page()
  d      = execute library.read_feed(plan.urls[3]) otherwise no_page()
  e      = execute library.read_feed(plan.urls[4]) otherwise no_page()
  f      = execute library.read_feed(plan.urls[5]) otherwise no_page()
  papers = gathered(plan, [a, b, c, d, e, f], past)
  ta     = call teach(field_batch(papers, plan, 0))
  tb     = call teach(field_batch(papers, plan, 1))
  tc     = call teach(field_batch(papers, plan, 2))
  td     = call teach(field_batch(papers, plan, 3))
  te     = call teach(field_batch(papers, plan, 4))
  tf     = call teach(field_batch(papers, plan, 5))
  day    = day_of(today, papers)
  kept   = remember day in days under "last"
  marked = remember seen_with(past, papers) in seen under "all"
  said   = digest(today, papers, [ta, tb, tc, td, te, tf])
  note   = phone_note("Research digest " + today.date, said)
  sent   = execute library.tell_me(note.title, note.text, note.link, note.file_name, note.file) otherwise not_sent()
  shown  = shown_with(said, sent)
}

// One field's papers explained; a field with none asks no model.
workflow teach(batch: Batch) -> Lessons {
  lessons = match batch.papers.is_empty() {
    case true { no_lessons() }
    case _ { call ask_teacher(batch) }
  }
}

workflow ask_teacher(batch: Batch) -> Lessons {
  lessons = use_model teacher(batch.task, batch.papers) retry 1 otherwise no_lessons()
}

workflow evening(msg: Msg) -> Lesson {
  budget 6 model calls, 7200 seconds
  past   = recall days under "last"
  batch  = evening_batch(past)
  deeper = use_model tutor(batch.task, batch.papers) retry 1 otherwise {items: []}
  first  = call draw(paper_at(batch, 0))
  second = call draw(paper_at(batch, 1))
  page   = figures_page(batch, [first, second])
  said   = evening_text(batch, deeper)
  note   = evening_note(said, page, paper_at(batch, 0).link)
  sent   = execute library.tell_me(note.title, note.text, note.link, note.file_name, note.file) otherwise not_sent()
  shown  = lesson_of(shown_with(said, sent), page)
}

// One paper read in full and drawn; with no paper, nothing is asked.
workflow draw(paper: Paper) -> Drawing {
  drawing = match paper.link.is_empty() {
    case true { no_drawing() }
    case _ { call read_and_draw(paper) }
  }
}

// The whole paper is read, up to five parts of 20,000 characters, and
// its key passages are drawn.
workflow read_and_draw(paper: Paper) -> Drawing {
  url     = paper_page(paper)
  p1      = call read_part({url: url, start: 0})
  p2      = call read_part({url: url, start: p1.next})
  p3      = call read_part({url: url, start: p2.next})
  p4      = call read_part({url: url, start: p3.next})
  p5      = call read_part({url: url, start: p4.next})
  page    = part_page([p1, p2, p3, p4, p5])
  text    = paper_text(paper, page)
  raw     = use_model illustrator(draw_task(), paper.title, text) retry 1 otherwise no_drawing()
  first   = checked(raw, text)
  drawing = call fuller({study: {task: again_task(first), title: paper.title, text: text}, first: first})
}

// Too few good figures, and the model is asked once more, told which
// were kept and why some were not; the better of the two is drawn.
workflow fuller(again: Again) -> Drawing {
  drawing = match again.first.figures.length() >= 4 {
    case true { again.first }
    case _ { call redraw(again) }
  }
}

workflow redraw(again: Again) -> Drawing {
  raw     = use_model illustrator(again.study.task, again.study.title, again.study.text) retry 1 otherwise no_drawing()
  second  = checked(raw, again.study.text)
  drawing = if second.figures.length() > again.first.figures.length() { second } else { again.first }
}

// One part of a page; past the end, nothing is fetched.
workflow read_part(asked: PartRequest) -> Part {
  part = match asked.start < 0 or asked.url.is_empty() {
    case true { no_part() }
    case _ { call fetch_part(asked) }
  }
}

workflow fetch_part(asked: PartRequest) -> Part {
  part = execute library.read_paper(asked.url, asked.start) otherwise no_part()
}

// The paper link a message holds: an arXiv link or number, or a bioRxiv
// content link; "" when it holds neither.
fn paper_link(text: Text) -> Text {
  let arxiv = arxiv_link(text)
  if not arxiv.is_empty() { return arxiv }
  return biorxiv_link(text)
}

// Any one paper, drawn on request: the message holds its arXiv link or
// number (like https://arxiv.org/abs/2610.23850 or 2610.23850v1) or its
// bioRxiv content link. What it draws is also told to the phone: the
// words, the figures as an outline, the paper's link to tap, and the page
// attached.
workflow paper(msg: Msg) -> Lesson {
  budget 2 model calls, 3600 seconds
  link  = paper_link(msg.text)
  said  = match link.is_empty() {
    case true { no_lesson("Send a paper's link — arXiv, like https://arxiv.org/abs/2610.23850 or 2610.23850v1, or bioRxiv, like https://www.biorxiv.org/content/10.1101/2026.10.22.1v1 — and I will draw that paper.") }
    case _ { call drawn_told({text: link}) }
  }
}

// One paper: read, drawn, then told to the phone with its link and page.
workflow drawn_told(asked: Msg) -> Lesson {
  link    = asked.text
  source  = source_of(link)
  first   = call read_part({url: source.page, start: 0})
  one     = paper_from(link, source, first)
  drawing = call read_and_draw(one)
  lesson  = one_drawn(one, drawing)
  note    = drawn_note(one, drawing, lesson)
  sent    = execute library.tell_me(note.title, note.text, note.link, note.file_name, note.file) otherwise not_sent()
  shown   = lesson_told(lesson, sent)
}

// The lesson as shown, with a line when it reached the phone.
fn lesson_told(lesson: Lesson, sent: Sent) -> Lesson {
  return if sent.sent { {text: lesson.text + "\n\n(Sent to your phone, with the paper's link and its page attached.)", page: lesson.page} } else { lesson }
}

// "evening" gives the evening lesson; a paper's link (arXiv or bioRxiv),
// that one paper drawn; "survey TOPIC", several papers on the topic read
// together; anything else, the afternoon digest.
workflow main(msg: Msg) -> Said {
  budget 12 model calls, 10800 seconds
  said = match msg.text.trim().lower() == "evening" {
    case true { call evening_said(msg) }
    case _ { call not_evening(msg) }
  }
}

workflow not_evening(msg: Msg) -> Said {
  said = match msg.text.trim().lower().starts_with("survey ") or msg.text.trim().lower() == "survey" {
    case true { call survey_said(msg) }
    case _ { call by_link(msg) }
  }
}

workflow by_link(msg: Msg) -> Said {
  said = match paper_link(msg.text).is_empty() {
    case true { call afternoon(msg) }
    case _ { call paper_said(msg) }
  }
}

workflow survey_said(msg: Msg) -> Said {
  lesson = call survey_of(msg)
  said   = said_of(lesson)
}

workflow paper_said(msg: Msg) -> Said {
  lesson = call paper(msg)
  said   = said_of(lesson)
}

workflow evening_said(msg: Msg) -> Said {
  lesson = call evening(msg)
  said   = said_of(lesson)
}

// ---------------------------------------------------------------- tests

test "five arXiv fields and one bioRxiv a day, all in four days" {
  one = plan_for(1)
  expect one.fields.length() == 6
  expect one.urls[0].starts_with("https://export.arxiv.org/api/query?search_query=cat:")
  expect one.urls[5].starts_with("https://connect.biorxiv.org/biorxiv_xml.php?subject=")
  expect one.fields[5].name.contains("bioRxiv")
  expect four_days().unique().length() == 20
  expect four_lives().unique().length() == 4
}

fn four_days() -> Text[] {
  var all: Text[] = []
  for day in 0 until 4 { all = all.concat(for field in plan_for(day).fields where not field.name.contains("bioRxiv") { field.code }) }
  return all
}

fn four_lives() -> Text[] {
  var all: Text[] = []
  for day in 0 until 4 { all = all.concat(for field in plan_for(day).fields where field.name.contains("bioRxiv") { field.code }) }
  return all
}

test "a bioRxiv link is seen, cleaned and read from its full text" {
  expect biorxiv_link("draw https://www.biorxiv.org/content/10.1101/2026.10.22.1v1?rss=1 please") == "https://www.biorxiv.org/content/10.1101/2026.10.22.1v1"
  expect biorxiv_link("https://biorxiv.org/content/10.64898/x") == "https://biorxiv.org/content/10.64898/x"
  expect biorxiv_link("read https://arxiv.org/abs/2610.1") == ""
  expect paper_link("https://www.biorxiv.org/content/10.1101/2026.10.22.1v1") == "https://www.biorxiv.org/content/10.1101/2026.10.22.1v1"
  expect paper_link("2610.23850") == "https://arxiv.org/abs/2610.23850"
  feed: Paper = {title: "T", link: "https://www.biorxiv.org/content/10.1101/xv1?rss=1", published: "", authors: "", summary: "", field: "bioRxiv"}
  expect paper_page(feed) == "https://www.biorxiv.org/content/10.1101/xv1/full"
  arxiv: Paper = {title: "T", link: "https://arxiv.org/abs/9", published: "", authors: "", summary: "", field: "arXiv"}
  expect paper_page(arxiv) == "https://arxiv.org/html/9"
}

