// Digest: learn something new from the newest research, twice a day.
//
//   kosika test main.kos
//   kosika run main.kos --workflow afternoon --model qwen2.5:7b --model-protocol ollama
//       --model-timeout 1800 --max-output-tokens 4000
//       --allow-site export.arxiv.org --memory memory
//   kosika run main.kos --workflow evening ...the same...
//
// In the afternoon it reads arXiv's newest papers in five fields, a
// different five each day from twenty across the sciences, AI, maths and
// computing, and explains each paper in plain words: the question it asks,
// what it found, how strong the evidence is, and what it leaves open. In
// the evening it takes two of the afternoon's papers further, with an
// example worked through and questions to check you understood.
//
// It only reads. It reaches nothing but the arXiv site you allow, every
// paper is shown with its link so you can read it yourself, and a paper is
// never explained twice: the links it has shown are kept in its memory.
// An arXiv paper is a preprint, not yet reviewed by other scientists, and
// it says so.
//
// It can send each digest to your phone as a notification. Install the
// free ntfy app (iOS or Android), subscribe to a topic name only you know,
// and run with --notify https://ntfy.sh/THAT-NAME. Notes go to that one
// address and nowhere else. Without --notify nothing is sent.
//
// The models explain from each paper's abstract. They are told not to add
// what the abstract does not say, and each explanation says it was made
// from the abstract alone.

import "figures.kos"
import "std/search.kos"

record Msg { text: Text }
record Said { text: Text }
// The evening's lesson, and its two papers drawn as a page of figures.
record Lesson { text: Text page: Text }

record PageRequest { url: Text }
record Page { url: Text title: Text text: Text }

// A paper as the feed gives it.
record Paper { title: Text link: Text published: Text authors: Text summary: Text field: Text }
// What a model is asked: how to teach, and the papers.
record Batch { task: Text papers: Paper[] }

// One paper explained, in plain words.
record Explained { title: Text idea: Text found: Text evidence: Text open: Text use: Text }
record Lessons { items: Explained[] }

// One paper taken further, for the evening.
record Deep { title: Text lesson: Text example: Text questions: Text[] try_it: Text }
record Deeper { items: Deep[] }

// What one afternoon covered, for the evening to go on from.
record Day { date: Text papers: Paper[] }
// Every paper ever shown, by its link.
record Seen { links: Text[] }

record Field { code: Text name: Text }
record Plan { fields: Field[] urls: Text[] }

tool read_feed {
  source system "web"
  operation: "fetch"
  access: observe
  input: PageRequest
  output: Page
}

record Note { title: Text text: Text }
record Sent { sent: Bool }

tool tell_me {
  source system "notify"
  operation: "send"
  access: observe
  input: Note
  output: Sent
}

// A paper's page, a part at a time: `next` is where the following part
// begins, or -1 at the end.
record PartRequest { url: Text start: Number }
record Part { url: Text title: Text text: Text next: Number }

tool read_paper {
  source system "web"
  operation: "fetch_from"
  access: observe
  input: PartRequest
  output: Part
}

agent library {
  can: [read_feed, read_paper, tell_me]
}

model teacher {
  input: Batch
  output: Lessons
  parameters: {
    max_output_tokens: 4000
  }
}

model tutor {
  input: Batch
  output: Deeper
  parameters: {
    max_output_tokens: 3000
  }
}

// What the illustrator is given: how to draw, and one paper to read.
record Study { task: Text title: Text text: Text }
// A second try, with what the first one gave.
record Again { study: Study first: Drawing }

model illustrator {
  input: Study
  output: Drawing
  parameters: {
    max_output_tokens: 3000
  }
}

memory days of Day
memory seen of Seen

// ---------------------------------------------------------------- the fields

fn fields() -> Field[] {
  return [
    {code: "cs.AI", name: "Artificial intelligence"},
    {code: "physics.optics", name: "Optics"},
    {code: "q-bio.NC", name: "Neuroscience"},
    {code: "math.PR", name: "Probability"},
    {code: "physics.chem-ph", name: "Chemistry"},
    {code: "cs.LG", name: "Machine learning"},
    {code: "astro-ph.GA", name: "Galaxies"},
    {code: "q-bio.GN", name: "Genomics"},
    {code: "math.CO", name: "Combinatorics"},
    {code: "cond-mat.mtrl-sci", name: "Materials"},
    {code: "cs.CL", name: "Language and computers"},
    {code: "quant-ph", name: "Quantum physics"},
    {code: "physics.bio-ph", name: "Biophysics"},
    {code: "stat.ML", name: "Statistics"},
    {code: "econ.GN", name: "Economics"},
    {code: "cs.CR", name: "Computer security"},
    {code: "astro-ph.EP", name: "Planets"},
    {code: "q-bio.PE", name: "Evolution"},
    {code: "math.NA", name: "Numerical methods"},
    {code: "cs.RO", name: "Robotics"}
  ]
}

fn feed_url(field: Field) -> Text {
  return "https://export.arxiv.org/api/query?search_query=cat:" + field.code + "&sortBy=submittedDate&sortOrder=descending&max_results=6"
}

// The five fields of a day: a different five each day, all twenty in four
// days, so every subject comes round again.
fn plan_for(day: Number) -> Plan {
  let all = fields()
  let start = (day * 5) % all.length()
  var chosen: Field[] = []
  for i in 0 until 5 { chosen = chosen.append(all[(start + i) % all.length()]) }
  return {fields: chosen, urls: for field in chosen { feed_url(field) }}
}

// ---------------------------------------------------------------- reading a feed

// The papers in a feed's text: an entry begins with ---, then a line for
// each of its parts.
fn papers_in(text: Text, field: Text) -> Paper[] {
  var found: Paper[] = []
  var title = ""
  var link = ""
  var published = ""
  var authors: Text[] = []
  var summary = ""
  var open = false
  for line in (text + "\n---").lines() {
    if line.trim() == "---" {
      if open and not title.is_empty() and not link.is_empty() {
        found = found.append({title: title, link: link, published: published.take(10), authors: authors.take(4).join(", "), summary: summary.take(1500), field: field})
      }
      title = ""
      link = ""
      published = ""
      authors = []
      summary = ""
      open = true
    } else if line.starts_with("Title: ") { title = line.drop(7).trim() }
    else if line.starts_with("Link: ") { link = line.drop(6).trim() }
    else if line.starts_with("Published: ") { published = line.drop(11).trim() }
    else if line.starts_with("Author: ") { authors = authors.append(line.drop(8).trim()) }
    else if line.starts_with("Summary: ") { summary = line.drop(9).trim() }
  }
  return found
}

// Up to `most` papers of a feed that have not been shown before.
fn new_papers(page: Page, field: Field, seen: Text[], most: Number) -> Paper[] {
  var kept: Paper[] = []
  for paper in papers_in(page.text, field.name) {
    if kept.length() < most and not seen.contains(paper.link) { kept = kept.append(paper) }
  }
  return kept
}

fn gathered(plan: Plan, pages: Page[], past: SeenRecalled) -> Paper[] {
  let seen = if past.found { past.value.value().links } else { [] }
  var all: Paper[] = []
  for i in 0 until pages.length() {
    all = all.concat(new_papers(pages[i], plan.fields[i], seen, 3))
  }
  return all
}

fn no_page() -> Page {
  return {url: "", title: "", text: ""}
}

// ---------------------------------------------------------------- asking the models

fn teach_task() -> Text {
  return "You are a patient teacher who explains new research to a curious person who is not an expert in the field. For each paper, in the same order, write: idea, the question the paper asks and why it matters, in two or three sentences; found, what it found or built, with its key numbers if the abstract gives them; evidence, how strong the evidence is and what kind (an experiment, a proof, a simulation, a survey), remembering that an arXiv paper is a preprint not yet reviewed by other scientists; open, what is still uncertain or limited; use, one practical way the idea could be used or tested. Define any technical term in plain words the first time you use it. Use only what the abstract says: do not invent results, numbers or methods it does not state. Keep the paper's title exactly."
}

fn tutor_task() -> Text {
  return "You are a tutor giving an evening lesson that goes deeper into two research papers the person met this afternoon. For each paper write: lesson, a clear explanation of the main idea from the ground up in five to eight sentences, with the background a beginner needs; example, one small worked example or analogy that shows the idea in action, step by step; questions, three short questions that check understanding, from easy to harder; try_it, one thing the person could do, read or try next to learn more. Use only what the abstract says about the paper itself, and say so when you add general background. Keep the paper's title exactly."
}

// The papers of one field, to be explained together: a few at a time is
// what a small model on a laptop writes well.
fn field_batch(papers: Paper[], plan: Plan, which: Number) -> Batch {
  let name = plan.fields[which].name
  return {task: teach_task(), papers: for paper in papers where paper.field == name { paper }}
}

fn no_lessons() -> Lessons {
  return {items: []}
}

// ---------------------------------------------------------------- what is shown

fn explained_text(item: Explained, paper: Paper) -> Text {
  return f"### {paper.title}\n{paper.field} · {paper.published} · {paper.authors}\n{paper.link} (preprint; explained from its abstract)\n\nThe idea: {item.idea}\nWhat it found: {item.found}\nHow strong the evidence is: {item.evidence}\nStill open: {item.open}\nUse it: {item.use}\n"
}

fn plain_text(paper: Paper) -> Text {
  return f"### {paper.title}\n{paper.field} · {paper.published} · {paper.authors}\n{paper.link} (preprint)\n\n{paper.summary.take(600)}\n"
}

// The afternoon's digest: each paper with its explanation, or, when the
// model gave none for it, its own abstract.
fn digest(today: Moment, papers: Paper[], explained: Lessons[]) -> Said {
  if papers.is_empty() {
    return {text: "No new papers could be read today. Check that export.arxiv.org is allowed and the computer is online, then ask again."}
  }
  var lessons: Explained[] = []
  for one in explained { lessons = lessons.concat(one.items) }
  var parts: Text[] = [f"# Research digest, {today.weekday} {today.date}\n\n{papers.length()} new papers from {fields_named(papers)}. Each is a preprint on arXiv; read the paper before relying on it.\n"]
  for i in 0 until papers.length() {
    let paper = papers[i]
    var shown = plain_text(paper)
    for item in lessons {
      if item.title.trim().lower() == paper.title.trim().lower() { shown = explained_text(item, paper) }
    }
    parts = parts.append(shown)
  }
  parts = parts.append("Tonight at eight: two of these, taken further.")
  return {text: parts.join("\n")}
}

fn fields_named(papers: Paper[]) -> Text {
  return (for paper in papers { paper.field }).unique().join(", ")
}

fn shown_with(said: Said, sent: Sent) -> Said {
  return if sent.sent { {text: said.text + "

(Sent to your phone.)"} } else { said }
}

fn day_of(today: Moment, papers: Paper[]) -> Day {
  return {date: today.date, papers: papers}
}

fn seen_with(past: SeenRecalled, papers: Paper[]) -> Seen {
  let before = if past.found { past.value.value().links } else { [] }
  return {links: before.concat(for paper in papers { paper.link }).unique()}
}

// The evening's two papers: the first two of different fields.
fn evening_batch(past: DaysRecalled) -> Batch {
  let papers = if past.found { past.value.value().papers } else { [] }
  var chosen: Paper[] = []
  for paper in papers {
    if chosen.length() < 2 and not (for c in chosen { c.field }).contains(paper.field) { chosen = chosen.append(paper) }
  }
  return {task: tutor_task(), papers: chosen}
}

fn lesson_text(item: Deep, paper: Paper) -> Text {
  var asked: Text[] = []
  for i in 0 until item.questions.length() { asked = asked.append(f"{i + 1}. {item.questions[i]}") }
  return f"## {paper.title}\n{paper.link}\n\n{item.lesson}\n\nAn example: {item.example}\n\nCheck yourself:\n{asked.join(\"\\n\")}\n\nNext: {item.try_it}\n"
}

fn evening_text(batch: Batch, deeper: Deeper) -> Said {
  if batch.papers.is_empty() {
    return {text: "There is no afternoon digest to go on from yet. Run the afternoon digest first."}
  }
  var parts: Text[] = ["# Evening lesson\n"]
  for paper in batch.papers {
    var shown = plain_text(paper)
    for item in deeper.items {
      if item.title.trim().lower() == paper.title.trim().lower() { shown = lesson_text(item, paper) }
    }
    parts = parts.append(shown)
  }
  return {text: parts.join("\n")}
}

// ---------------------------------------------------------------- drawing a paper

// arXiv shows most new papers as a web page as well as a PDF.
fn paper_page(paper: Paper) -> Text {
  return paper.link.replace("/abs/", "/html/")
}

// The paper's own words from its abstract on, without the site's menus.
// When the page could not be read, the abstract is all there is.
fn paper_text(paper: Paper, page: Page) -> Text {
  let at = page.text.index_of("Abstract")
  if not at.exists() { return "Abstract: " + paper.summary }
  return passages(page.text.drop(at.value()), 14000)
}

// What a model can read of a long paper: its opening (the abstract and
// the start of the introduction), then the passages that best say what
// it did, found and concluded, kept in the paper's own order. Code picks
// them, by the words they share with those questions.
fn passages(text: Text, most: Number) -> Text {
  if text.length() <= most { return text }
  let opening = text.take(3000)
  let pieces = slices(text.drop(3000), 1500)
  var chosen: Number[] = []
  for question in ["results we find show our experiments demonstrate", "conclusion summary we conclude in this work limitations future work", "method approach we propose model framework algorithm", "table figure compared improves accuracy error percent"] {
    for hit in rank(question, pieces, 6) { chosen = chosen.append(hit.index) }
  }
  var kept: Text[] = [opening]
  var size = opening.length()
  for i in chosen.unique().sort() {
    if size + pieces[i].length() + 5 <= most {
      kept = kept.append(pieces[i])
      size = size + pieces[i].length() + 5
    }
  }
  return kept.join("
[...]
")
}

// A long text cut into pieces of `size` characters. (std's chunks splits
// into words first, and a value may hold at most 512 parts.)
fn slices(text: Text, size: Number) -> Text[] {
  return for i in 0 until (text.length() / size).ceil() { text.slice(i * size, ((i + 1) * size).min(text.length())) }
}

fn part_page(parts: Part[]) -> Page {
  return {url: "", title: "", text: (for part in parts { part.text }).join("")}
}

fn no_part() -> Part {
  return {url: "", title: "", text: "", next: -1}
}

fn draw_task() -> Text {
  return "You turn one research paper into a page of figures that explain it to a curious person who is not an expert. Read the paper, then choose the four to seven figures that best explain THIS paper: what it asks, how it works, what it found and how firmly. Pick the kinds that fit what the paper is about, so a paper of proofs, a lab experiment and a survey each look different. The kinds, and what each item means: flow (label is a step, value what happens in it); numbers (label is a number written as the paper gives it, like 69% or x3.1, value what it counts); bars (label a thing, value its number, note the unit; only numbers the paper gives); curve (label a line's name, value its heights left to right like \"1 2 4 3\", center what runs along the bottom; only for a shape the paper describes or plots); tree (items with an empty group are branches, items whose group is a branch's label hang from it, note a short tag like exact or bound); mindmap (the same as tree, with center the paper's subject in two or three words, and three to six branches); timeline (label when, value what happened); glossary (label a technical word, value its meaning in plain words); card (center a name, each item one fact as label and value); quote (value one important sentence copied exactly from the paper). For every figure give a short title, and section: where in the paper it comes from, like Abstract or Section 3. Keep every label under six words and every value under twenty. Use only what the paper says: never invent a number, result or method. Also write question: the paper's question in one plain sentence."
}

fn study_of(paper: Paper, page: Page) -> Study {
  return {task: draw_task(), title: paper.title, text: paper_text(paper, page)}
}

fn again_task(first: Drawing) -> Text {
  let kept = (for figure in first.figures { f"{figure.look}" }).join(", ")
  return draw_task() + f" Your first answer gave only {first.figures.length()} usable figures ({kept}). Give five to seven this time, of at least four different kinds, each filled completely. A numbers or bars figure is dropped unless every number appears in the paper exactly as written, and its label must be the number itself."
}

// Only the figures whose numbers the paper really gives.
fn checked(drawing: Drawing, text: Text) -> Drawing {
  return {question: drawing.question, figures: for figure in drawing.figures where grounded(figure, text) { figure }}
}

fn no_drawing() -> Drawing {
  return {question: "", figures: []}
}

fn sheet_of(paper: Paper, drawing: Drawing) -> Sheet {
  return {title: paper.title, field: paper.field, published: paper.published, authors: paper.authors, link: paper.link, drawing: drawing}
}

// The page of figures, when the model drew anything worth showing.
fn figures_page(batch: Batch, drawings: Drawing[]) -> Text {
  var sheets: Sheet[] = []
  for i in 0 until batch.papers.length().min(drawings.length()) {
    if not (for figure in drawings[i].figures where drawable(figure) { figure }).is_empty() {
      sheets = sheets.append(sheet_of(batch.papers[i], drawings[i]))
    }
  }
  return if sheets.is_empty() { "" } else { page("Tonight's papers, drawn", sheets) }
}

// The arXiv link in a message, written the one way the site uses for
// a paper's page; empty when there is none.
fn arxiv_link(text: Text) -> Text {
  for word in text.replace("/pdf/", "/abs/").replace(".pdf", "").words() {
    var id = word.trim()
    let at = id.index_of("arxiv.org/abs/")
    if at.exists() { id = id.drop(at.value() + 14) }
    if is_arxiv_id(id) { return "https://arxiv.org/abs/" + id }
  }
  return ""
}

// An arXiv number: four digits, a dot, four or five digits, and perhaps
// a version such as v2.
fn is_arxiv_id(id: Text) -> Bool {
  let parts = id.split(".")
  if parts.length() != 2 or parts[0].length() != 4 or not parts[0].to_number().exists() { return false }
  let rest = parts[1].split("v")
  return rest.length() <= 2 and (rest[0].length() == 4 or rest[0].length() == 5) and rest[0].to_number().exists() and (rest.length() == 1 or rest[1].to_number().exists())
}

fn paper_named(link: Text, first: Part) -> Paper {
  let title = if first.title.trim().is_empty() { link } else { first.title.trim() }
  return {title: title, link: link, published: "", authors: "", summary: "", field: "arXiv"}
}

fn no_lesson(text: Text) -> Lesson {
  return {text: text, page: ""}
}

fn one_drawn(one: Paper, drawing: Drawing) -> Lesson {
  let shown = for figure in drawing.figures where drawable(figure) { figure }
  if shown.is_empty() {
    return no_lesson(f"I could not draw {one.title}: the page could not be read, or no figure came out right. Try again, or try another paper.")
  }
  let kind = if shown.length() == 1 { "figure" } else { "figures" }
  return {text: f"Drew {one.title} as {shown.length()} {kind}.
{one.link}", page: page(one.title, [sheet_of(one, drawing)])}
}

fn paper_at(batch: Batch, i: Number) -> Paper {
  return if i < batch.papers.length() { batch.papers[i] } else { {title: "", link: "", published: "", authors: "", summary: "", field: ""} }
}

fn said_of(lesson: Lesson) -> Said {
  return {text: lesson.text}
}

fn lesson_of(said: Said, page: Text) -> Lesson {
  let told = if page.is_empty() { said.text } else { said.text + "\n\nThe two papers are drawn as figures in this evening's page, beside this digest on the laptop." }
  return {text: told, page: page}
}

// What is sent to the phone: short enough to read there. The whole digest
// is what the run prints.
fn phone_note(title: Text, said: Said) -> Note {
  var kept: Text[] = []
  for line in said.text.lines() {
    if line.starts_with("### ") { kept = kept.append("
" + line.drop(4)) }
    else if line.starts_with("## ") { kept = kept.append("
" + line.drop(3)) }
    else if line.starts_with("https://") { kept = kept.append(line) }
    else if line.starts_with("The idea: ") { kept = kept.append(line.drop(10).take(300)) }
    else if line.starts_with("An example: ") { kept = kept.append(line.drop(12).take(300)) }
  }
  let body = if kept.is_empty() { said.text } else { kept.join("
").trim() }
  return {title: title, text: body}
}

fn not_sent() -> Sent {
  return {sent: false}
}

// ---------------------------------------------------------------- workflows

workflow afternoon(msg: Msg) -> Said {
  budget 10 model calls, 7200 seconds
  today  = now
  plan   = plan_for(today.day)
  past   = recall seen under "all"
  a      = execute library.read_feed(plan.urls[0]) otherwise no_page()
  b      = execute library.read_feed(plan.urls[1]) otherwise no_page()
  c      = execute library.read_feed(plan.urls[2]) otherwise no_page()
  d      = execute library.read_feed(plan.urls[3]) otherwise no_page()
  e      = execute library.read_feed(plan.urls[4]) otherwise no_page()
  papers = gathered(plan, [a, b, c, d, e], past)
  ta     = call teach(field_batch(papers, plan, 0))
  tb     = call teach(field_batch(papers, plan, 1))
  tc     = call teach(field_batch(papers, plan, 2))
  td     = call teach(field_batch(papers, plan, 3))
  te     = call teach(field_batch(papers, plan, 4))
  day    = day_of(today, papers)
  kept   = remember day in days under "last"
  marked = remember seen_with(past, papers) in seen under "all"
  said   = digest(today, papers, [ta, tb, tc, td, te])
  note   = phone_note("Research digest " + today.date, said)
  sent   = execute library.tell_me(note.title, note.text) otherwise not_sent()
  shown  = shown_with(said, sent)
}

// One field's papers explained; a field with none asks no model.
workflow teach(batch: Batch) -> Lessons {
  lessons = match batch.papers.is_empty() {
    case true { no_lessons() }
    case _ { call ask_teacher(batch) }
  }
}

workflow ask_teacher(batch: Batch) -> Lessons {
  lessons = use_model teacher(batch.task, batch.papers) retry 1 otherwise no_lessons()
}

workflow evening(msg: Msg) -> Lesson {
  budget 6 model calls, 7200 seconds
  past   = recall days under "last"
  batch  = evening_batch(past)
  deeper = use_model tutor(batch.task, batch.papers) retry 1 otherwise {items: []}
  first  = call draw(paper_at(batch, 0))
  second = call draw(paper_at(batch, 1))
  page   = figures_page(batch, [first, second])
  said   = evening_text(batch, deeper)
  note   = phone_note("Evening lesson", said)
  sent   = execute library.tell_me(note.title, note.text) otherwise not_sent()
  shown  = lesson_of(shown_with(said, sent), page)
}

// One paper read in full and drawn; with no paper, nothing is asked.
workflow draw(paper: Paper) -> Drawing {
  drawing = match paper.link.is_empty() {
    case true { no_drawing() }
    case _ { call read_and_draw(paper) }
  }
}

// The whole paper is read, up to five parts of 20,000 characters, and
// its key passages are drawn.
workflow read_and_draw(paper: Paper) -> Drawing {
  url     = paper_page(paper)
  p1      = call read_part({url: url, start: 0})
  p2      = call read_part({url: url, start: p1.next})
  p3      = call read_part({url: url, start: p2.next})
  p4      = call read_part({url: url, start: p3.next})
  p5      = call read_part({url: url, start: p4.next})
  page    = part_page([p1, p2, p3, p4, p5])
  text    = paper_text(paper, page)
  raw     = use_model illustrator(draw_task(), paper.title, text) retry 1 otherwise no_drawing()
  first   = checked(raw, text)
  drawing = call fuller({study: {task: again_task(first), title: paper.title, text: text}, first: first})
}

// Too few good figures, and the model is asked once more, told which
// were kept and why some were not; the better of the two is drawn.
workflow fuller(again: Again) -> Drawing {
  drawing = match again.first.figures.length() >= 4 {
    case true { again.first }
    case _ { call redraw(again) }
  }
}

workflow redraw(again: Again) -> Drawing {
  raw     = use_model illustrator(again.study.task, again.study.title, again.study.text) retry 1 otherwise no_drawing()
  second  = checked(raw, again.study.text)
  drawing = if second.figures.length() > again.first.figures.length() { second } else { again.first }
}

// One part of a page; past the end, nothing is fetched.
workflow read_part(asked: PartRequest) -> Part {
  part = match asked.start < 0 or asked.url.is_empty() {
    case true { no_part() }
    case _ { call fetch_part(asked) }
  }
}

workflow fetch_part(asked: PartRequest) -> Part {
  part = execute library.read_paper(asked.url, asked.start) otherwise no_part()
}

// Any one paper, drawn on request: the message holds its arXiv link or
// number, like https://arxiv.org/abs/2610.23850 or 2610.23850v1.
workflow paper(msg: Msg) -> Lesson {
  budget 2 model calls, 3600 seconds
  link    = arxiv_link(msg.text)
  drawn   = match link.is_empty() {
    case true { no_lesson("Send an arXiv link or number, like https://arxiv.org/abs/2610.23850, and I will draw that paper.") }
    case _ { call draw_one({text: link}) }
  }
}

workflow draw_one(msg: Msg) -> Lesson {
  first   = call read_part({url: msg.text.replace("/abs/", "/html/"), start: 0})
  one     = paper_named(msg.text, first)
  drawing = call read_and_draw(one)
  shown   = one_drawn(one, drawing)
}

// "evening" gives the evening lesson; anything else, the afternoon digest.
workflow main(msg: Msg) -> Said {
  budget 12 model calls, 10800 seconds
  said = match msg.text.trim().lower() == "evening" {
    case true { call evening_said(msg) }
    case _ { call afternoon(msg) }
  }
}

workflow evening_said(msg: Msg) -> Said {
  lesson = call evening(msg)
  said   = said_of(lesson)
}

// ---------------------------------------------------------------- tests

test "five fields a day, all twenty in four days" {
  one = plan_for(1)
  expect one.fields.length() == 5
  expect one.urls[0].starts_with("https://export.arxiv.org/api/query?search_query=cat:")
  expect four_days().unique().length() == 20
}

fn four_days() -> Text[] {
  var all: Text[] = []
  for day in 0 until 4 { all = all.concat(for field in plan_for(day).fields { field.code }) }
  return all
}

test "a feed's text becomes papers" {
  text = "---\nTitle: Light in glass\nUpdated: 2026-10-14T10:00:00Z\nLink: https://arxiv.org/abs/1\nSummary: We bend light.\nPublished: 2026-10-14T10:00:00Z\nAuthor: Ann Lee\nAuthor: Bo Kim\n---\nTitle: No link here\n---\nTitle: Second\nLink: https://arxiv.org/abs/2\nSummary: More."
  papers = papers_in(text, "Optics")
  expect papers.length() == 2
  expect papers[0].title == "Light in glass"
  expect papers[0].authors == "Ann Lee, Bo Kim"
  expect papers[0].published == "2026-10-14"
  expect papers[1].link == "https://arxiv.org/abs/2"
}

test "a paper is never shown twice" {
  page: Page = {url: "u", title: "", text: "---\nTitle: A\nLink: L1\nSummary: s\n---\nTitle: B\nLink: L2\nSummary: s"}
  field: Field = {code: "x", name: "X"}
  expect new_papers(page, field, ["L1"], 3).length() == 1
  expect new_papers(page, field, [], 1).length() == 1
}

test "the afternoon explains each new paper, and keeps what it showed" {
  answers clock_now: [{date: "2026-10-15", time: "15:00", weekday: "Thursday", year: 2026, month: 10, day: 15, hour: 15, minute: 0, epoch: 1791810000}]
  answers read_feed: [
    {url: "a", title: "", text: "---\nTitle: Light in glass\nLink: https://arxiv.org/abs/1\nPublished: 2026-10-14T10:00:00Z\nAuthor: Ann Lee\nSummary: We bend light."},
    {url: "b", title: "", text: ""},
    {url: "c", title: "", text: "---\nTitle: Cells talk\nLink: https://arxiv.org/abs/2\nSummary: Cells send signals."},
    {url: "d", title: "", text: ""},
    {url: "e", title: "", text: ""}
  ]
  answers teacher: [
    {items: [{title: "Light in glass", idea: "How to bend light.", found: "A new lens.", evidence: "One experiment.", open: "Only red light.", use: "Try a prism."}]},
    {items: []}
  ]
  d = afternoon({text: ""})
  expect d.text.starts_with("# Research digest, Thursday 2026-10-15")
  expect d.text.contains("The idea: How to bend light.")
  expect d.text.contains("https://arxiv.org/abs/1 (preprint; explained from its abstract)")
  expect d.text.contains("### Cells talk")
  expect d.text.contains("Cells send signals.")
}

test "the evening goes deeper into the afternoon's papers" {
  answers clock_now: [{date: "2026-10-15", time: "15:00", weekday: "Thursday", year: 2026, month: 10, day: 15, hour: 15, minute: 0, epoch: 1791810000}]
  answers read_feed: [
    {url: "a", title: "", text: "---\nTitle: Light in glass\nLink: https://arxiv.org/abs/1\nSummary: We bend light."},
    {url: "b", title: "", text: "---\nTitle: Cells talk\nLink: https://arxiv.org/abs/2\nSummary: Cells send signals."},
    {url: "c", title: "", text: ""},
    {url: "d", title: "", text: ""},
    {url: "e", title: "", text: ""}
  ]
  answers teacher: [{items: []}, {items: []}]
  answers tutor: [{items: [{title: "Cells talk", lesson: "Cells use molecules.", example: "Like a letter.", questions: ["What is a signal?", "Why?", "How?"], try_it: "Read about hormones."}]}]
  answers read_paper: [
    {url: "https://arxiv.org/html/1", title: "", text: "arXiv menu Abstract: We bend light 30% more ", next: 35},
    {url: "https://arxiv.org/html/1", title: "", text: "through glass. 1 Introduction ...", next: -1},
    {url: "https://arxiv.org/html/2", title: "", text: "", next: -1}
  ]
  answers illustrator: [
    {question: "Can glass bend light more?", figures: [
      {look: Look.flow, title: "How it works", section: "Section 2", center: "", items: [{label: "Shine", value: "Light enters the glass.", note: "", group: ""}, {label: "Bend", value: "It turns 30 degrees.", note: "", group: ""}]},
      {look: Look.numbers, title: "Key number", section: "Abstract", center: "", items: [{label: "30%", value: "more bending", note: "", group: ""}]}
    ]},
    {question: "", figures: []}
  ]
  first = afternoon({text: ""})
  e = evening({text: ""})
  expect e.text.starts_with("# Evening lesson")
  expect e.text.contains("## Cells talk")
  expect e.text.contains("1. What is a signal?")
  expect e.text.contains("### Light in glass")
  expect e.text.contains("drawn as figures")
  expect e.page.contains("Can glass bend light more?")
  expect e.page.contains("2 figures")
  expect not e.page.contains("Cells talk")
}

test "a paper is found from its link or number" {
  expect arxiv_link("draw https://arxiv.org/abs/2610.23850v1 please") == "https://arxiv.org/abs/2610.23850v1"
  expect arxiv_link("arxiv.org/pdf/2610.23798.pdf") == "https://arxiv.org/abs/2610.23798"
  expect arxiv_link("2610.23850") == "https://arxiv.org/abs/2610.23850"
  expect arxiv_link("version 1.2 of my notes") == ""
}

test "one paper is drawn on request" {
  answers read_paper: [
    {url: "https://arxiv.org/html/2610.1", title: "Light in glass", text: "menu Abstract: We bend light 30% more.", next: -1},
    {url: "https://arxiv.org/html/2610.1", title: "Light in glass", text: "menu Abstract: We bend light 30% more.", next: -1}
  ]
  answers illustrator: [{question: "Can glass bend light?", figures: [{look: Look.numbers, title: "Key number", section: "Abstract", center: "", items: [{label: "30%", value: "more bending", note: "", group: ""}]}]}]
  drawn = paper({text: "please draw arxiv.org/abs/2610.12345"})
  expect drawn.text.starts_with("Drew Light in glass as 1 figure.")
  expect drawn.page.contains("Can glass bend light?")
  none = paper({text: "hello"})
  expect none.text.starts_with("Send an arXiv link")
  expect none.page == ""
}

test "a paper's own words start at its abstract" {
  paper: Paper = {title: "T", link: "https://arxiv.org/abs/9", published: "", authors: "", summary: "Short.", field: "X"}
  expect paper_page(paper) == "https://arxiv.org/html/9"
  expect paper_text(paper, {url: "", title: "", text: "Menu Login Abstract: Long words."}) == "Abstract: Long words."
  expect paper_text(paper, no_page()) == "Abstract: Short."
  long = "Abstract: " + "intro words here. ".repeat(300) + "Our results show the lens bends light by 40 percent. " + "filler text again. ".repeat(900)
  kept = paper_text(paper, {url: "", title: "", text: long})
  expect kept.length() <= 14000
  expect kept.starts_with("Abstract: intro words here.")
  expect kept.contains("bends light by 40 percent")
}

test "with nothing read there is nothing to explain" {
  answers clock_now: [{date: "2026-10-15", time: "15:00", weekday: "Thursday", year: 2026, month: 10, day: 15, hour: 15, minute: 0, epoch: 1791810000}]
  answers read_feed: [{url: "", title: "", text: ""}, {url: "", title: "", text: ""}, {url: "", title: "", text: ""}, {url: "", title: "", text: ""}, {url: "", title: "", text: ""}]
    d = afternoon({text: ""})
  expect d.text.starts_with("No new papers could be read today.")
  e = evening({text: ""})
  expect e.text.starts_with("There is no afternoon digest")
}

test "the phone gets the titles, the links and the ideas" {
  said: Said = {text: "# Research digest\n\n### Light in glass\nOptics · 2026-10-14 · Ann Lee\nhttps://arxiv.org/abs/1 (preprint; explained from its abstract)\n\nThe idea: How to bend light.\nWhat it found: A new lens."}
  note = phone_note("Research digest", said)
  expect note.text == "Light in glass\nhttps://arxiv.org/abs/1 (preprint; explained from its abstract)\nHow to bend light."
  expect shown_with(said, {sent: true}).text.ends_with("(Sent to your phone.)")
  expect shown_with(said, {sent: false}).text == said.text
}
