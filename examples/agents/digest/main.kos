test "the survey's search finds, picks and cites its papers" {
  expect survey_url("cost aware abstention").contains("search_query=all:cost+AND+all:aware+AND+all:abstention")
  expect topic_of("Survey cost-aware abstention") == "cost-aware abstention"
  expect topic_of("plain words") == "plain words"
  papers: Paper[] = [
    {title: "First", link: "https://arxiv.org/abs/1", published: "", authors: "", summary: "s", field: "arXiv"},
    {title: "Again first", link: "https://arxiv.org/abs/1", published: "", authors: "", summary: "s", field: "arXiv"},
    {title: "Second", link: "https://arxiv.org/abs/2", published: "", authors: "", summary: "s", field: "arXiv"},
    {title: "", link: "https://arxiv.org/abs/3", published: "", authors: "", summary: "s", field: "arXiv"}
  ]
  picked = distinct_papers(papers, 3)
  expect picked.length() == 2
  expect picked[0].title == "First"
  expect picked[1].title == "Second"
  expect cited({text: "c", sources: [1, 2]}, 2)
  expect not cited({text: "c", sources: [3]}, 2)
  expect not cited({text: "c", sources: []}, 2)
  neat = clean_survey({question: "q", agreed: [{text: "a", sources: [1, 2]}, {text: "bad", sources: [4]}], differed: [{text: "d", sources: [2]}], open: ["o1", "o2", "o3", "o4"], themes: [], numbers: []}, 2)
  expect neat.agreed.length() == 1
  expect neat.differed.length() == 1
  expect neat.open.length() == 3
}

test "the survey is told in words with its citations" {
  papers: Paper[] = [
    {title: "First paper", link: "https://arxiv.org/abs/1", published: "", authors: "", summary: "Abstention cuts the cost of deployment when the model is unsure.", field: "arXiv"},
    {title: "Second paper", link: "https://arxiv.org/abs/2", published: "", authors: "", summary: "Thresholds decide when the system abstains and what it costs.", field: "arXiv"}
  ]
  survey: Survey = {question: "Does abstention save cost?", agreed: [{text: "Abstention cuts cost.", sources: [1, 2]}], differed: [{text: "They disagree on thresholds.", sources: [2]}], open: ["No one tests on audio."], themes: [], numbers: []}
  text = survey_text("abstention", survey, papers)
  expect text.contains("Survey: abstention")
  expect text.contains("- Abstention cuts cost. [1, 2]")
  expect text.contains("- They disagree on thresholds. [2]")
  expect not text.contains(" *")
  expect text.contains("Still open:")
  expect text.contains("[1] First paper\nhttps://arxiv.org/abs/1")
  expect text.contains("[2] Second paper")
  note = survey_note("abstention", {text: text}, "<html>page</html>", papers)
  expect note.title == "Survey: abstention"
  expect note.link == "https://arxiv.org/abs/1"
  expect note.file_name == "survey-abstention.html"
  expect note.file == "<html>page</html>"
}

test "a claim no cited abstract shares a word with is marked as the comparison" {
  papers: Paper[] = [
    {title: "First paper", link: "https://arxiv.org/abs/1", published: "", authors: "", summary: "Abstention cuts the cost of deployment when the model is unsure.", field: "arXiv"},
    {title: "Second paper", link: "https://arxiv.org/abs/2", published: "", authors: "", summary: "Thresholds decide when the system abstains and what it costs.", field: "arXiv"}
  ]
  expect claim_backed({text: "Abstention reduces cost.", sources: [1]}, papers)
  expect claim_backed({text: "Thresholds decide abstention.", sources: [1, 2]}, papers)
  expect not claim_backed({text: "The evaluation metrics and benchmarks are not aligned.", sources: [1]}, papers)
  expect not claim_backed({text: "The evaluation metrics and benchmarks are not aligned.", sources: [1, 2]}, papers)
  expect not claim_backed({text: "What is it?", sources: [1]}, papers)
  marked: Survey = {question: "q", agreed: [{text: "The evaluation metrics and benchmarks are not aligned.", sources: [1, 2]}], differed: [], open: [], themes: [], numbers: []}
  text = survey_text("abstention", marked, papers)
  expect text.contains("- The evaluation metrics and benchmarks are not aligned. [1, 2] *")
  expect text.contains("* marks a claim")
  clean: Survey = {question: "q", agreed: [{text: "Abstention reduces cost.", sources: [1]}], differed: [], open: [], themes: [], numbers: []}
  tidy = survey_text("abstention", clean, papers)
  expect not tidy.contains(" *")
  expect not tidy.contains("* marks a claim")
}

test "a survey reads several papers and cites what they share" {
  answers read_feed: [{url: "u", title: "", text: "---\nTitle: First on abstention\nLink: https://arxiv.org/abs/1\nSummary: Abstaining when unsure cut test cost by 12% with accuracy 0.88.\nAuthor: Ann Lee\nPublished: 2026-10-25\n---\nTitle: Second on abstention\nLink: https://arxiv.org/abs/2\nSummary: Deferring 12% of tickets kept accuracy at 0.90 and cut cost.\nAuthor: Bo Kim\nPublished: 2026-10-24\n---\nTitle: Third, the same link again\nLink: https://arxiv.org/abs/1\nSummary: duplicate."}]
  answers illustrator: [
    {question: "When should a model abstain?", figures: [{look: Look.numbers, title: "Key numbers", section: "Abstract", center: "", items: [{label: "12%", value: "test cost cut when unsure", note: "", group: ""}, {label: "0.88", value: "accuracy kept", note: "", group: ""}]}]},
    {question: "How much deferring is safe?", figures: [{look: Look.numbers, title: "Cost and accuracy", section: "Abstract", center: "", items: [{label: "0.90", value: "accuracy with deferring", note: "", group: ""}]}]}
  ]
  answers synthesiser: [{question: "When should a ticket router abstain?", agreed: [{text: "Abstaining on unsure tickets cuts cost without hurting accuracy.", sources: [1, 2]}], differed: [], open: ["Neither abstract tests on audio tickets."], themes: [
    {label: "When to abstain", value: "", note: "", group: ""},
    {label: "cut cost when unsure", value: "", note: "1", group: "When to abstain"},
    {label: "defer some tickets", value: "", note: "2", group: "When to abstain"},
    {label: "What it costs", value: "", note: "", group: ""},
    {label: "cheaper routing", value: "", note: "2", group: "What it costs"},
    {label: "Where it fails", value: "", note: "", group: ""},
    {label: "no audio tickets", value: "", note: "1", group: "Where it fails"}
  ], numbers: [
    {label: "First on abstention", value: "12%", note: "test cost cut", group: "1"},
    {label: "Second on abstention", value: "0.90", note: "accuracy kept", group: "2"},
    {label: "Misattributed", value: "0.88", note: "that is paper 1's", group: "2"}
  ]}]
  answers tell_me: [{sent: true}]
  lesson = survey_of({text: "survey cost-aware abstention for tickets"})
  expect lesson.text.contains("Survey: cost-aware abstention for tickets")
  expect lesson.text.contains("- Abstaining on unsure tickets cuts cost without hurting accuracy. [1, 2]")
  expect lesson.text.contains("[1] First on abstention")
  expect lesson.text.contains("[2] Second on abstention")
  expect not lesson.text.contains("duplicate")
  expect lesson.page.contains("First on abstention")
  expect lesson.page.contains("Second on abstention")
  expect lesson.page.contains("12%")
  expect lesson.page.contains("The topic&#39;s map") or lesson.page.contains("The topic")
  expect lesson.page.contains("The papers on one line of time")
  expect lesson.page.contains("The papers&#39; numbers") or lesson.page.contains("The papers")
  expect lesson.page.contains("When to abstain")
  expect lesson.page.contains("defer some tickets")
  expect not lesson.page.contains("Misattributed")
  expect lesson.page.contains("2026-10-24")
  expect lesson.page.contains("Survey: cost-aware abstention for tickets")
  expect lesson.text.contains("(Sent to your phone")
}

test "the overview figures take the fills however the model arranges them" {
  papers: Paper[] = [
    {title: "First", link: "u1", published: "2026-10-25", authors: "", summary: "Abstaining cut test cost by 12% and prefilling sped up 2.74x.", field: "arXiv"},
    {title: "Second", link: "u2", published: "2026-10-20", authors: "", summary: "Deferring 12% of tickets kept accuracy at 0.90 and cut cost.", field: "arXiv"},
    {title: "Third", link: "u3", published: "2026-10-15", authors: "", summary: "Static quantization keeps accuracy within one point.", field: "arXiv"}
  ]
  expect grounded_number({label: "a", value: "12%", note: "", group: "1"}, papers)
  expect grounded_number({label: "b", value: "1", note: "2.74x", group: "Speedup"}, papers)
  expect not grounded_number({label: "c", value: "3", note: "2.74x", group: "Speedup"}, papers)
  expect not grounded_number({label: "d", value: "0.90", note: "", group: "1"}, papers)
  kept = grounded_numbers([
    {label: "a", value: "12%", note: "", group: "1"},
    {label: "b", value: "1", note: "2.74x", group: "Speedup"},
    {label: "c", value: "3", note: "2.74x", group: "Speedup"}
  ], papers)
  expect kept.length() == 2
  flat = theme_items([
    {label: "Cost of deployment", value: "1", note: "detail", group: "Challenges"},
    {label: "Quantization methods", value: "2", note: "", group: "Methods"},
    {label: "Accuracy kept", value: "3", note: "", group: "Performance"}
  ])
  expect flat.length() == 6
  expect (for item in flat where item.group.trim().is_empty() { item }).length() == 3
  map: Figure = {look: Look.mindmap, title: "map", section: "", center: "topic", items: flat}
  expect drawable(map)
  shaped = theme_items([{label: "root", value: "", note: "", group: ""}, {label: "leaf", value: "", note: "1", group: "root"}])
  expect shaped.length() == 2
  time = survey_timeline(papers)
  expect time.items.length() == 3
  expect time.items[0].label == "2026-10-15"
  expect time.items[0].value == "Third"
  expect time.items[2].label == "2026-10-25"
}

test "a bar may cite its paper by name, as a reader resolves it" {
  papers: Paper[] = [
    {title: "WKVQuant: Quantizing Weight and Key Value Cache", link: "u1", published: "", authors: "", summary: "attention computation improves 2.16x with W4A4.", field: "arXiv"},
    {title: "PrefixQuant: Eliminating Outliers by Prefixed Tokens", link: "u2", published: "", authors: "", summary: "prefilling sped up 2.74x for LLMs on W4A4.", field: "arXiv"},
    {title: "MQuant: Full Static Quantization", link: "u3", published: "", authors: "", summary: "static scales for visual and textual tokens.", field: "arXiv"}
  ]
  expect named_paper({label: "Prefilling", value: "2.74x", note: "For LLMs using W4A4 PrefixQuant", group: "Speedup"}, papers) == 2
  expect named_paper({label: "Decoding", value: "2.16x", note: "as WKVQuant reports", group: "Speedup"}, papers) == 1
  expect named_paper({label: "quant", value: "x", note: "", group: ""}, papers) == 0
  expect grounded_number({label: "Prefilling", value: "2.74x", note: "For LLMs using W4A4 PrefixQuant", group: "Speedup"}, papers)
  expect not grounded_number({label: "Prefilling", value: "2.74x", note: "For LLMs using W4A4 MQuant", group: "Speedup"}, papers)
  flat = theme_items([
    {label: "Past-only Quantization", value: "WKVQuant", note: "attention", group: "Techniques"},
    {label: "Token-wise Outlier Elimination", value: "PrefixQuant", note: "outliers", group: "Techniques"},
    {label: "Full Static Quantization", value: "MQuant", note: "multimodal", group: "Techniques"}
  ])
  expect flat.length() == 6
  expect (for item in flat where item.group.trim().is_empty() { item }).length() == 3
  map: Figure = {look: Look.mindmap, title: "m", section: "", center: "t", items: flat}
  expect drawable(map)
}

