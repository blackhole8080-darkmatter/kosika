// Kosi: an assistant you talk to by typing. It greets you, tells the time,
// does sums exactly, keeps reminders (with a time if you give one) and the
// things you ask it to remember, and answers questions in a few short
// sentences meant to be heard as well as read.
//
//   kosika test main.kos
//   kosika start
//
// It touches nothing on the computer: no files, no programs, no web. It has
// a clock and its own memory, and that is all. Asked to open or play
// something, it says plainly that it cannot. For work on files, use the box
// "Not sure which agent?" above it in Studio.
//
// Say: hello, what time is it, what is 17 times 23, remind me at 6pm to call
// Sam, remind me in 10 minutes to stretch, my reminders, done 1, remember
// that my locker is 14, what do you remember, call me Aryan, call yourself
// Nova, forget everything, or ask a question.

record Msg { text: Text }
// What it says, and a few things you might say next.
record Said { text: Text suggest: Text[] }

// due is the moment it falls due, in seconds since 1970, or 0 for no time.
// at is that moment in words, such as "18:00".
record Reminder { what: Text due: Number at: Text }
// What it keeps between conversations.
record Book { name: Text you: Text reminders: Reminder[] facts: Text[] }
// The book after a request, what to say, and what to suggest.
record Turn { book: Book text: Text suggest: Text[] }
// A time found in what was said: when, in words, and the words left over.
record When { due: Number at: Text rest: Text }
// A sum worked out, or the reason it could not be.
record Sum { ok: Bool value: Number problem: Text }

model voice {
  input: Prompt
  output: Reply
  parameters: {
    max_output_tokens: 160
  }
}

memory books of Book

// ---------------------------------------------------------------- routing

fn kind_of(msg: Msg) -> Text {
  let text = msg.text.lower().trim().trim_marks("?!.")
  let first = text.split(" ").first().or("")
  var kind = "ask"
  if text == "" or text == "help" or text == "what can you do" { kind = "help" }
  else if ["hello", "hi", "hey", "good morning", "good afternoon", "good evening", "hello kosi", "hi kosi", "hey kosi"].contains(text) { kind = "hello" }
  else if text.contains("what time") or text == "time" or text.contains("the time") { kind = "time" }
  else if text.contains("what day") or text.contains("the date") or text == "date" or text.contains("what is today") { kind = "date" }
  else if text.starts_with("remind me") or text.starts_with("set a reminder") { kind = "remind" }
  else if text == "reminders" or text.contains("my reminders") or text.contains("what are my reminders") { kind = "reminders" }
  else if text.starts_with("done ") or text.starts_with("finished ") { kind = "done" }
  else if text.starts_with("call me ") or text.starts_with("my name is ") { kind = "you" }
  else if text.starts_with("call yourself ") or text.starts_with("your name is ") { kind = "rename" }
  else if text.contains("your name") or text == "who are you" { kind = "who" }
  else if text.starts_with("remember that ") or text.starts_with("remember ") { kind = "remember" }
  else if text.contains("what do you remember") or text.contains("what do you know about me") { kind = "recall" }
  else if text == "forget everything" { kind = "forget" }
  else if sum_of(text).ok { kind = "sum" }
  else if wants_action(first) { kind = "cannot" }
  return kind
}

// A request to do something on the computer, which this assistant cannot.
// It is caught here, by its first word, so that the model is never given
// the chance to say "Sure, opening it now" about something that will not
// happen.
fn wants_action(first: Text) -> Bool {
  let verbs = ["open", "launch", "start", "play", "google", "search", "send", "email", "text", "call", "close", "install", "download", "delete", "shut", "restart", "turn", "set", "mute", "pause", "stop", "print"]
  return verbs.contains(first)
}

// What it says when asked to act on the computer.
fn cannot_text() -> Text {
  return "I cannot do that. I have no way to open programs, play things, search the web or change settings on this computer. I can tell the time, do sums, keep reminders, remember things and answer questions."
}

// A model will sometimes say it did something it has no way of doing. If
// its answer claims an action, the honest sentence is said instead.
fn honest(text: Text) -> Text {
  let lower = text.lower()
  let claims = ["i'll open", "i will open", "i've opened", "i have opened", "opening ", "i'll search", "i will search", "searching ", "i'll play", "i will play", "playing ", "i'll send", "i will send", "i've sent", "i have sent", "i'll set", "i will set", "i've set", "i'll turn", "i will turn", "i'll launch", "i will launch", "launching ", "i'll start", "i will start"]
  for claim in claims {
    if lower.contains(claim) { return cannot_text() }
  }
  return text
}

// ---------------------------------------------------------------- sums

// The words of a sum, with every way of saying an operator made one sign.
fn sum_words(text: Text) -> Text[] {
  var t = " " + text.lower().trim().trim_marks("?=.") + " "
  for lead in [" what is ", " what's ", " whats ", " calculate ", " work out ", " how much is "] {
    t = t.replace(lead, " ")
  }
  t = t.replace(" multiplied by ", " * ").replace(" times ", " * ").replace(" x ", " * ").replace("×", " * ")
  t = t.replace(" divided by ", " / ").replace(" over ", " / ").replace("÷", " / ")
  t = t.replace(" plus ", " + ").replace(" add ", " + ").replace(" minus ", " - ").replace(" take away ", " - ")
  t = t.replace(" percent of ", " / 100 * ").replace("% of ", " / 100 * ")
  t = t.replace("*", " * ").replace("/", " / ").replace("+", " + ").replace(",", "")
  return t.words()
}

// Works out a sum written as numbers with signs between them. Multiplying
// and dividing are done before adding and taking away, as in school.
fn sum_of(text: Text) -> Sum {
  let no: Sum = {ok: false, value: 0, problem: ""}
  let words = sum_words(text)
  if words.length() < 3 or words.length() == (words.length() / 2).floor() * 2 { return no }
  // First pass: numbers and signs must take turns; fold * and / as we go.
  var terms: Number[] = []
  var signs: Text[] = []
  var held = 0
  var doing = ""
  var at = 0
  for word in words {
    if at == (at / 2).floor() * 2 {
      let n = word.to_number()
      if not n.exists() { return no }
      if doing == "*" { held = held * n.value() }
      else if doing == "/" {
        if n.value() == 0 { return {ok: true, value: 0, problem: "You cannot divide by zero."} }
        held = held / n.value()
      }
      else { held = n.value() }
    } else {
      if not ["*", "/", "+", "-"].contains(word) { return no }
      if word == "+" or word == "-" {
        terms = terms.append(held)
        signs = signs.append(word)
        doing = ""
      } else { doing = word }
    }
    at = at + 1
  }
  terms = terms.append(held)
  // Second pass: add and take away, left to right.
  var total = terms[0]
  var i = 1
  for sign in signs {
    total = if sign == "+" { total + terms[i] } else { total - terms[i] }
    i = i + 1
  }
  return {ok: true, value: (total * 1000000).round() / 1000000, problem: ""}
}

// ---------------------------------------------------------------- the book

fn book_in(known: BooksRecalled) -> Book {
  let empty: Book = {name: "Kosi", you: "", reminders: [], facts: []}
  return if known.found { known.value.value() } else { empty }
}

// The words after a beginning such as "remind me to", tidied.
fn after(text: Text, starts: Text[]) -> Text {
  let tidy = text.trim().trim_marks(".!")
  let lower = tidy.lower()
  for start in starts {
    if lower.starts_with(start) { return tidy.drop(start.length()).trim() }
  }
  return tidy
}

// The first whole number in what was said, or 0.
fn number_in(msg: Msg) -> Number {
  for word in msg.text.split(" ") {
    let n = word.trim().trim_marks(".,").to_number().or(0)
    if n >= 1 and n == n.floor() { return n }
  }
  return 0
}

fn two(n: Number) -> Text {
  return if n < 10 { f"0{n}" } else { f"{n}" }
}

fn reminder_line(r: Reminder) -> Text {
  return if r.due > 0 { r.what + ", at " + r.at } else { r.what }
}

fn numbered(items: Text[]) -> Text {
  var lines: Text[] = []
  var n = 1
  for item in items {
    lines = lines.append(f"{n}. {item}")
    n = n + 1
  }
  return lines.join("\n")
}

// ---------------------------------------------------------------- times

// A clock time written as 6pm, 6:30pm, 18:30 or 6, as minutes after
// midnight, or -1 when it is not a time. `half` is a following am or pm.
fn clock_minutes(word: Text, half: Text) -> Number {
  var w = word.lower().trim_marks(".,")
  var pm = half == "pm"
  var am = half == "am"
  if w.ends_with("pm") { pm = true  w = w.take(w.length() - 2) }
  else if w.ends_with("am") { am = true  w = w.take(w.length() - 2) }
  let parts = w.split(":")
  if parts.length() > 2 { return -1 }
  let h = parts[0].to_number().or(-1)
  let m = if parts.length() == 2 { parts[1].to_number().or(-1) } else { 0 }
  if h < 0 or h > 23 or m < 0 or m > 59 or h != h.floor() or m != m.floor() { return -1 }
  var hour = h
  if pm and h < 12 { hour = h + 12 }
  if am and h == 12 { hour = 0 }
  return hour * 60 + m
}

// Finds "at 6pm" or "in 10 minutes" in what was said. The time is turned
// into the moment it falls due, counted from now; a clock time already
// past today means tomorrow.
fn when_of(text: Text, moment: Moment) -> When {
  let words = text.words()
  let now_minutes = moment.hour * 60 + moment.minute
  // The start of this minute, so a reminder falls due on the minute.
  let base = moment.epoch - (moment.epoch - (moment.epoch / 60).floor() * 60)
  var due = 0
  var at = ""
  var kept: Text[] = []
  var skip = 0
  var i = 0
  for word in words {
    let next = if i + 1 < words.length() { words[i + 1] } else { "" }
    let after_next = if i + 2 < words.length() { words[i + 2].lower().trim_marks(".,") } else { "" }
    if skip > 0 { skip = skip - 1 }
    else if due == 0 and word.lower() == "at" and clock_minutes(next, after_next) >= 0 {
      let minutes = clock_minutes(next, after_next)
      var wait = minutes - now_minutes
      if wait <= 0 { wait = wait + 24 * 60 }
      due = base + wait * 60
      at = f"{(minutes / 60).floor()}:{two(minutes - (minutes / 60).floor() * 60)}"
      skip = if after_next == "am" or after_next == "pm" { 2 } else { 1 }
    }
    else if due == 0 and word.lower() == "in" and next.to_number().or(0) > 0 and ["minute", "minutes", "min", "mins", "hour", "hours"].contains(after_next) {
      let count = next.to_number().or(0)
      let wait = if after_next.starts_with("hour") { count * 60 } else { count }
      let minutes = now_minutes + wait
      let on_clock = minutes - (minutes / 1440).floor() * 1440
      due = base + (wait * 60).round()
      at = f"{(on_clock / 60).floor()}:{two((on_clock - (on_clock / 60).floor() * 60).floor())}"
      skip = 2
    }
    else { kept = kept.append(word) }
    i = i + 1
  }
  return {due: due, at: at, rest: kept.join(" ")}
}

// ---------------------------------------------------------------- what it does

fn remind(msg: Msg, known: BooksRecalled, moment: Moment) -> Turn {
  let book = book_in(known)
  let said = after(msg.text, ["remind me", "set a reminder"])
  let when = when_of(said, moment)
  let what = after(when.rest, ["to ", "that ", "for "])
  if what.is_empty() {
    return {book: book, text: "Tell me what to remind you of, like this: remind me at 6pm to call Sam.", suggest: []}
  }
  let all = book.reminders.append({what: what, due: when.due, at: when.at})
  let timed = if when.due > 0 { " at " + when.at } else { "" }
  return {
    book: {name: book.name, you: book.you, reminders: all, facts: book.facts},
    text: f"I will remind you to {what}{timed}. You have {all.length()} on the list.",
    suggest: ["my reminders"]
  }
}

fn reminders(known: BooksRecalled) -> Turn {
  let book = book_in(known)
  var lines: Text[] = []
  for r in book.reminders { lines = lines.append(reminder_line(r)) }
  let text = if lines.is_empty() { "You have no reminders." } else { "Your reminders:\n" + numbered(lines) + "\nSay done and the number when one is finished." }
  return {book: book, text: text, suggest: if lines.is_empty() { ["remind me in 10 minutes to stretch"] } else { ["done 1"] }}
}

fn finish(msg: Msg, known: BooksRecalled) -> Turn {
  let book = book_in(known)
  let n = number_in(msg)
  if n < 1 or n > book.reminders.length() {
    return {book: book, text: "Say done and the number of the reminder. Say my reminders to see the numbers.", suggest: ["my reminders"]}
  }
  let gone = book.reminders[n - 1]
  var left: Reminder[] = []
  var at = 1
  for item in book.reminders {
    if at != n { left = left.append(item) }
    at = at + 1
  }
  return {book: {name: book.name, you: book.you, reminders: left, facts: book.facts}, text: f"Done: {gone.what}. {left.length()} left.", suggest: []}
}

fn remember(msg: Msg, known: BooksRecalled) -> Turn {
  let book = book_in(known)
  let what = after(msg.text, ["remember that ", "remember "])
  if what.is_empty() or what.lower() == "remember" {
    return {book: book, text: "Tell me what to remember, like this: remember that my locker is 14.", suggest: []}
  }
  let all = book.facts.append(what).unique()
  return {book: {name: book.name, you: book.you, reminders: book.reminders, facts: all}, text: f"I will remember that {what}.", suggest: ["what do you remember"]}
}

fn recall_all(known: BooksRecalled) -> Turn {
  let book = book_in(known)
  let text = if book.facts.is_empty() { "You have not asked me to remember anything yet." } else { "I remember:\n" + numbered(book.facts) }
  return {book: book, text: text, suggest: []}
}

fn forget(known: BooksRecalled) -> Turn {
  let book = book_in(known)
  return {book: {name: book.name, you: "", reminders: [], facts: []}, text: "I have forgotten everything: your name, your reminders and what you asked me to remember.", suggest: []}
}

// A name as it was typed, kept short and without marks.
fn name_in(msg: Msg, starts: Text[]) -> Text {
  let name = after(msg.text, starts).trim_marks("\"'.,!?").trim()
  return if name.length() > 30 { name.take(30).trim() } else { name }
}

fn you_are(msg: Msg, known: BooksRecalled) -> Turn {
  let book = book_in(known)
  let name = name_in(msg, ["call me ", "my name is "])
  if name.is_empty() { return {book: book, text: "Tell me your name, like this: call me Aryan.", suggest: []} }
  return {book: {name: book.name, you: name, reminders: book.reminders, facts: book.facts}, text: f"Nice to meet you, {name}.", suggest: ["hello"]}
}

fn rename(msg: Msg, known: BooksRecalled) -> Turn {
  let book = book_in(known)
  let name = name_in(msg, ["call yourself ", "your name is "])
  if name.is_empty() { return {book: book, text: "Tell me the name, like this: call yourself Nova.", suggest: []} }
  return {book: {name: name, you: book.you, reminders: book.reminders, facts: book.facts}, text: f"From now on I am {name}.", suggest: ["what is your name"]}
}

fn who(known: BooksRecalled) -> Turn {
  let book = book_in(known)
  return {book: book, text: f"I am {book.name}, your assistant, written in Kosika. I run on this computer and nothing you tell me leaves it.", suggest: ["what can you do"]}
}

fn same(known: BooksRecalled, text: Text) -> Turn {
  return {book: book_in(known), text: text, suggest: []}
}

fn help_said(known: BooksRecalled) -> Turn {
  let book = book_in(known)
  return {
    book: book,
    text: f"I am {book.name}. I can tell the time, do sums, keep reminders, remember things you tell me, and answer questions.\nwhat is 17 times 23\nremind me at 6pm to call Sam\nremind me in 10 minutes to stretch\nmy reminders, then done 1\nremember that my locker is 14\nwhat do you remember\ncall me Aryan, or call yourself Nova\nforget everything\nFor work on your files, use the box above: it passes your request to the right agent.",
    suggest: ["what time is it", "what is 17 times 23", "my reminders"]
  }
}

fn sum_said(msg: Msg, known: BooksRecalled) -> Turn {
  let sum = sum_of(msg.text)
  let text = if sum.problem.length() > 0 { sum.problem } else { f"{sum.value}" }
  return {book: book_in(known), text: text, suggest: []}
}

// ---------------------------------------------------------------- the clock

fn part_of_day(moment: Moment) -> Text {
  var part = "evening"
  if moment.hour < 5 { part = "night" }
  else if moment.hour < 12 { part = "morning" }
  else if moment.hour < 18 { part = "afternoon" }
  return part
}

fn hello_said(known: BooksRecalled, moment: Moment) -> Turn {
  let book = book_in(known)
  let part = part_of_day(moment)
  let name = if book.you.is_empty() { "" } else { ", " + book.you }
  let opening = if part == "night" { "You are up late" + name + "." } else { "Good " + part + name + "." }
  let count = book.reminders.length()
  let list = if count == 0 { "" } else if count == 1 { " You have 1 reminder." } else { f" You have {count} reminders." }
  return {
    book: book,
    text: opening + list,
    suggest: if book.you.is_empty() { ["call me Aryan", "what can you do"] } else if count > 0 { ["my reminders", "what time is it"] } else { ["what time is it", "what can you do"] }
  }
}

fn time_said(known: BooksRecalled, moment: Moment) -> Turn {
  return same(known, f"It is {moment.hour}:{two(moment.minute)}.")
}

fn date_said(known: BooksRecalled, moment: Moment) -> Turn {
  return same(known, f"Today is {moment.weekday}, {moment.date}.")
}

// ---------------------------------------------------------------- asking the model

// What the model is told: how to speak, what it cannot do, and what it knows.
fn ask_prompt(msg: Msg, known: BooksRecalled, moment: Moment) -> Prompt {
  let book = book_in(known)
  let facts = if book.facts.is_empty() { "nothing yet" } else { book.facts.join("; ") }
  var lines: Text[] = []
  for r in book.reminders { lines = lines.append(reminder_line(r)) }
  let list = if lines.is_empty() { "none" } else { lines.join("; ") }
  let person = if book.you.is_empty() { "The person has not told you their name." } else { "The person's name is " + book.you + "." }
  return {text: "You are " + book.name + ", a voice assistant on a person's laptop. Answer in one to three short sentences that sound natural when read aloud. Use plain words. No lists, no headings, no symbols. If you are not sure, say so instead of guessing. You cannot open programs, browse the web or see files, so never say you did.\n" + person + "\nIt is " + moment.weekday + ", " + moment.date + ", " + moment.hour + ":" + two(moment.minute) + ".\nThings the person asked you to remember: " + facts + ".\nTheir reminders: " + list + ".\n\nThe person says: " + msg.text.trim()}
}

fn spoken(known: BooksRecalled, reply: Reply) -> Turn {
  return same(known, honest(reply.text.trim()))
}

fn book_of(turn: Turn) -> Book {
  return turn.book
}

fn say(turn: Turn) -> Said {
  return {text: turn.text, suggest: turn.suggest}
}

// ---------------------------------------------------------------- workflows

workflow answer(msg: Msg) -> Turn {
  known  = recall books under "me"
  moment = now
  prompt = ask_prompt(msg, known, moment)
  reply  = use_model voice(prompt.text) retry 1 otherwise {text: "Sorry, I could not think of an answer just now. Please ask again."}
  turn   = spoken(known, reply)
}

// Everything that needs the clock and no model.
workflow by_clock(msg: Msg) -> Turn {
  known  = recall books under "me"
  moment = now
  kind   = kind_of(msg)
  turn   = match kind {
    case "time" { time_said(known, moment) }
    case "date" { date_said(known, moment) }
    case "remind" { remind(msg, known, moment) }
    case _ { hello_said(known, moment) }
  }
}

// Everything that needs neither the clock nor a model.
workflow keep(msg: Msg) -> Turn {
  known = recall books under "me"
  kind  = kind_of(msg)
  turn  = match kind {
    case "reminders" { reminders(known) }
    case "done" { finish(msg, known) }
    case "remember" { remember(msg, known) }
    case "recall" { recall_all(known) }
    case "forget" { forget(known) }
    case "you" { you_are(msg, known) }
    case "rename" { rename(msg, known) }
    case "who" { who(known) }
    case "sum" { sum_said(msg, known) }
    case "cannot" { same(known, cannot_text()) }
    case _ { help_said(known) }
  }
}

workflow main(msg: Msg) -> Said {
  budget 2 model calls, 120 seconds
  kind = kind_of(msg)
  turn = match kind {
    case "ask" { call answer(msg) }
    case "time" { call by_clock(msg) }
    case "date" { call by_clock(msg) }
    case "remind" { call by_clock(msg) }
    case "hello" { call by_clock(msg) }
    case _ { call keep(msg) }
  }
  book  = book_of(turn)
  saved = remember book in books under "me"
  said  = say(turn)
}

// ------------------------------------------------------------------ tests

test "requests are understood" {
  expect kind_of({text: "What time is it?"}) == "time"
  expect kind_of({text: "what day is it"}) == "date"
  expect kind_of({text: "Remind me to call Sam."}) == "remind"
  expect kind_of({text: "Set a reminder to water the plants"}) == "remind"
  expect kind_of({text: "my reminders"}) == "reminders"
  expect kind_of({text: "done 2"}) == "done"
  expect kind_of({text: "remember that my locker is 14"}) == "remember"
  expect kind_of({text: "What do you remember?"}) == "recall"
  expect kind_of({text: "forget everything"}) == "forget"
  expect kind_of({text: "help"}) == "help"
  expect kind_of({text: "Hello"}) == "hello"
  expect kind_of({text: "call me Aryan"}) == "you"
  expect kind_of({text: "Call yourself Nova"}) == "rename"
  expect kind_of({text: "What is your name?"}) == "who"
  expect kind_of({text: "what is 17 times 23"}) == "sum"
  expect kind_of({text: "why is the sky blue"}) == "ask"
}

test "sums are worked out by code, exactly" {
  expect sum_of("what is 17 times 23").value == 391
  expect sum_of("2 + 3 * 4").value == 14
  expect sum_of("100 divided by 8").value == 12.5
  expect sum_of("What is 15% of 240?").value == 36
  expect sum_of("10 minus 4 minus 3").value == 3
  expect sum_of("1,000 x 12").value == 12000
  expect sum_of("7 / 0").problem == "You cannot divide by zero."
  expect sum_of("why is the sky blue").ok == false
  expect sum_of("call 3 friends").ok == false
  expect sum_of("3 times").ok == false
  a = main({text: "what is 17 times 23?"})
  expect a.text == "391"
}

test "reminders are kept, listed and finished" {
  a = main({text: "remind me to call Sam"})
  b = main({text: "Remind me to buy milk."})
  c = main({text: "my reminders"})
  d = main({text: "done 1"})
  e = main({text: "my reminders"})
  f = main({text: "done 7"})
  expect a.text == "I will remind you to call Sam. You have 1 on the list."
  expect a.suggest == ["my reminders"]
  expect b.text == "I will remind you to buy milk. You have 2 on the list."
  expect c.text == "Your reminders:\n1. call Sam\n2. buy milk\nSay done and the number when one is finished."
  expect d.text == "Done: call Sam. 1 left."
  expect e.text.contains("1. buy milk")
  expect f.text.starts_with("Say done and the number")
}

test "a time in a reminder is read and turned into a moment" {
  // Twenty seconds into 09:05; a reminder falls due on the minute.
  nine: Moment = {date: "2026-10-12", time: "09:05", weekday: "Monday", year: 2026, month: 10, day: 12, hour: 9, minute: 5, epoch: 1000000040}
  a = when_of("at 6pm to call Sam", nine)
  b = when_of("to call Sam at 18:30", nine)
  c = when_of("in 10 minutes to stretch", nine)
  d = when_of("in 2 hours to eat", nine)
  e = when_of("at 8 am to wake", nine)
  f = when_of("to look at the stars", nine)
  expect a.at == "18:00"
  expect a.rest == "to call Sam"
  expect a.due == 1000000020 + (18 * 60 - 545) * 60
  expect b.at == "18:30"
  expect b.rest == "to call Sam"
  expect c.at == "9:15"
  expect c.due == 1000000020 + 600
  expect d.at == "11:05"
  expect e.at == "8:00"
  expect e.due == 1000000020 + (8 * 60 - 545 + 1440) * 60
  expect f.due == 0
  expect f.rest == "to look at the stars"
  expect clock_minutes("6:15pm", "") == 18 * 60 + 15
  expect clock_minutes("12", "am") == 0
  expect clock_minutes("25", "") == -1
  expect clock_minutes("soon", "") == -1
}

test "a reminder with a time says when" {
  answers clock_now: [{date: "2026-10-12", time: "09:05", weekday: "Monday", year: 2026, month: 10, day: 12, hour: 9, minute: 5, epoch: 1000000020}]
  a = main({text: "Remind me at 6pm to call Sam"})
  b = main({text: "my reminders"})
  expect a.text == "I will remind you to call Sam at 18:00. You have 1 on the list."
  expect b.text.contains("1. call Sam, at 18:00")
}

test "names, and a greeting by the clock" {
  answers clock_now: [{date: "2026-10-12", time: "09:05", weekday: "Monday", year: 2026, month: 10, day: 12, hour: 9, minute: 5, epoch: 0}, {date: "2026-10-12", time: "20:00", weekday: "Monday", year: 2026, month: 10, day: 12, hour: 20, minute: 0, epoch: 0}]
  a = main({text: "hello"})
  b = main({text: "call me Aryan"})
  c = main({text: "what is your name?"})
  d = main({text: "call yourself Nova"})
  e = main({text: "who are you"})
  f = main({text: "hello"})
  expect a.text == "Good morning."
  expect a.suggest == ["call me Aryan", "what can you do"]
  expect b.text == "Nice to meet you, Aryan."
  expect c.text.starts_with("I am Kosi, your assistant, written in Kosika.")
  expect d.text == "From now on I am Nova."
  expect e.text.starts_with("I am Nova,")
  expect f.text == "Good evening, Aryan."
}

test "what it is told, it remembers until told to forget" {
  a = main({text: "remember that my locker is 14"})
  b = main({text: "what do you remember"})
  c = main({text: "forget everything"})
  d = main({text: "what do you remember"})
  e = main({text: "my reminders"})
  expect a.text == "I will remember that my locker is 14."
  expect b.text == "I remember:\n1. my locker is 14"
  expect c.text.starts_with("I have forgotten everything")
  expect d.text == "You have not asked me to remember anything yet."
  expect e.text == "You have no reminders."
}

test "the time and the date come from the clock, not the model" {
  answers clock_now: [{date: "2026-10-12", time: "09:05", weekday: "Monday", year: 2026, month: 10, day: 12, hour: 9, minute: 5, epoch: 0}, {date: "2026-10-12", time: "09:05", weekday: "Monday", year: 2026, month: 10, day: 12, hour: 9, minute: 5, epoch: 0}]
  a = main({text: "what time is it"})
  b = main({text: "what day is it"})
  expect a.text == "It is 9:05."
  expect b.text == "Today is Monday, 2026-10-12."
}

test "a question goes to the model with what it has been told" {
  answers voice: [{text: " Your locker is number 14. "}]
  a = main({text: "remember that my locker is 14"})
  p = ask_prompt({text: "which locker is mine?"}, {found: true, value: {name: "Kosi", you: "Aryan", reminders: [{what: "call Sam", due: 5, at: "18:00"}], facts: ["my locker is 14"]}}, {date: "2026-10-12", time: "09:05", weekday: "Monday", year: 2026, month: 10, day: 12, hour: 9, minute: 5, epoch: 0})
  b = main({text: "which locker is mine?"})
  expect p.text.starts_with("You are Kosi, a voice assistant")
  expect p.text.contains("The person's name is Aryan.")
  expect p.text.contains("Things the person asked you to remember: my locker is 14.")
  expect p.text.contains("Their reminders: call Sam, at 18:00.")
  expect p.text.contains("It is Monday, 2026-10-12, 9:05.")
  expect p.text.contains("never say you did")
  expect b.text == "Your locker is number 14."
}

test "it never says it did what it cannot do" {
  answers voice: [{text: "Sure, I'll open the web browser and search for cats."}, {text: "Cats sleep most of the day."}]
  a = main({text: "open my web browser and search for cats"})
  b = main({text: "could you look up cats for me?"})
  c = main({text: "tell me something about cats"})
  expect kind_of({text: "Play some music"}) == "cannot"
  expect a.text.starts_with("I cannot do that.")
  expect b.text.starts_with("I cannot do that.")
  expect c.text == "Cats sleep most of the day."
}

test "help needs no model" {
  a = main({text: "help"})
  expect a.text.starts_with("I am Kosi. I can tell the time, do sums, keep reminders")
}

// ------------------------------------------------------------------ evals
// These ask a real model. Run them with:
//   kosika measure main.kos --model qwen2.5:7b --model-protocol ollama

eval "it answers a plain question briefly" {
  a = main({text: "why is the sky blue?"})
  expect a.text.length() > 20
  expect a.text.length() < 500
  expect a.text.contains("\n- ") == false
  expect not a.text.starts_with("Sorry")
}

eval "it uses what it was asked to remember" {
  a = main({text: "remember that my sister is called Meera"})
  b = main({text: "what is my sister called?"})
  expect b.text.contains("Meera")
}

eval "it does not pretend to act on the computer" {
  a = main({text: "could you put on some music for me?"})
  expect a.text.lower().contains("cannot") or a.text.lower().contains("can't") or a.text.lower().contains("unable") or a.text.lower().contains("not able")
}
