// Each agent's name and mascot, drawn and animated by Kosika: Kosi the sun,
// Nova the fox, Quark the owl and Comet the hare, each in its agent's own
// colour. An agent without a mascot here is drawn as a spark with its own
// name, until it is given one.
//
// A mascot shows how its agent is doing, in motion:
//   idle     breathes, blinks now and then, its tail or rays turning slowly
//   waiting  bobs and blinks fast, with a question bubble: it wants your yes
//   typing   ears twitching and tail swishing quickly, letters flying out
//   done     hops, with sparks around it
//   failed   droops, grey, eyes half shut
//
// The pictures are SVG, sharp at any size; the motion is CSS (mascot_css),
// which pages put in their style once. Motion stops for anyone who asked
// their computer for less motion.

import "pointer_look.kos"

export [Mascot, mascots, mascot_for, known_creatures, mascot_states, mascot_problems, title_for, tag_for, mascot_svg, mascot_alone, mascot_css]

record Mascot { agent: Text nickname: Text creature: Text line: Text }

fn mascots() -> Mascot[] {
  return [
    {agent: "Kosika", nickname: "Kosi", creature: "sun", line: "warm and steady; keeps the whole team going"},
    {agent: "coder-1", nickname: "Nova", creature: "fox", line: "quick and clever; writes the code"},
    {agent: "coder-2", nickname: "Quark", creature: "owl", line: "watchful; looks closely and tests"},
    {agent: "scout", nickname: "Comet", creature: "hare", line: "fast; runs ahead to read the web"}
  ]
}

fn known_creatures() -> Text[] {
  return ["sun", "fox", "owl", "hare", "spark"]
}

fn mascot_states() -> Text[] {
  return ["idle", "waiting", "typing", "done", "failed"]
}

fn mascot_for(agent: Text) -> Mascot {
  for m in mascots() {
    if m.agent == agent { return m }
  }
  return {agent: agent, nickname: agent, creature: "spark", line: "a new agent, still finding its shape"}
}

// "Nova the fox"; an agent with no mascot is just its name.
fn title_for(agent: Text) -> Text {
  let m = mascot_for(agent)
  if m.creature == "spark" { return agent }
  return f"{m.nickname} the {m.creature}"
}

// The name on the agent's pointer tag.
fn tag_for(agent: Text) -> Text {
  return mascot_for(agent).nickname
}

fn mascot_problems(m: Mascot) -> Text[] {
  var problems: Text[] = []
  if not known_creatures().contains(m.creature) { problems = problems.append(f"'{m.creature}' is not a creature Kosika can draw") }
  if m.nickname.trim() == "" or m.nickname.length() > 16 { problems = problems.append(f"the nickname '{m.nickname}' must be 1 to 16 letters") }
  for other in mascots() {
    if other.agent != m.agent and other.nickname == m.nickname { problems = problems.append(f"'{m.nickname}' is already {other.agent}'s name") }
  }
  return problems
}

// ---- The creatures, on a 120 by 120 stage ----------------------------------

fn cream() -> Text { return "#fff4e6" }
fn ink() -> Text { return "#07080d" }
fn gold() -> Text { return "#f5b45c" }
fn blush() -> Text { return "#ff9ec8" }

fn eyes(lx: Number, rx: Number, y: Number, size: Number) -> Text {
  let l = lx.to_text()
  let r = rx.to_text()
  let at = y.to_text()
  let w = size.to_text()
  let h = (size * 1.25).to_text()
  let hi = (size * 0.38).to_text()
  return "<g class=\"mz-eye\">"
    + f"<ellipse cx=\"{l}\" cy=\"{at}\" rx=\"{w}\" ry=\"{h}\" fill=\"{ink()}\"/><ellipse cx=\"{r}\" cy=\"{at}\" rx=\"{w}\" ry=\"{h}\" fill=\"{ink()}\"/>"
    + f"<circle cx=\"{(lx + size * 0.35).to_text()}\" cy=\"{(y - size * 0.45).to_text()}\" r=\"{hi}\" fill=\"#fff\"/>"
    + f"<circle cx=\"{(rx + size * 0.35).to_text()}\" cy=\"{(y - size * 0.45).to_text()}\" r=\"{hi}\" fill=\"#fff\"/>"
    + "</g>"
}

fn fox(c: Text) -> Text {
  return f"<g class=\"mz-tail\"><path d=\"M76 96 Q114 94 106 56 Q98 80 78 82 Z\" fill=\"{c}\"/><path d=\"M106 56 Q110 66 106 74 Q101 66 100 62 Z\" fill=\"{cream()}\"/></g>"
    + f"<ellipse cx=\"60\" cy=\"96\" rx=\"22\" ry=\"16\" fill=\"{c}\"/><ellipse cx=\"60\" cy=\"100\" rx=\"11\" ry=\"10\" fill=\"{cream()}\"/>"
    + f"<g class=\"mz-ear\"><path d=\"M33 50 L37 16 L56 38 Z\" fill=\"{c}\"/><path d=\"M38 42 L40 25 L50 37 Z\" fill=\"{ink()}\" opacity=\".45\"/></g>"
    + f"<g class=\"mz-ear mz-ear-r\"><path d=\"M87 50 L83 16 L64 38 Z\" fill=\"{c}\"/><path d=\"M82 42 L80 25 L70 37 Z\" fill=\"{ink()}\" opacity=\".45\"/></g>"
    + f"<path d=\"M28 46 Q60 24 92 46 Q90 68 60 82 Q30 68 28 46 Z\" fill=\"{c}\"/>"
    + f"<path d=\"M30 50 Q46 56 60 80 Q36 72 30 50 Z\" fill=\"{cream()}\"/><path d=\"M90 50 Q74 56 60 80 Q84 72 90 50 Z\" fill=\"{cream()}\"/>"
    + eyes(47, 73, 53, 3.8)
    + f"<ellipse cx=\"60\" cy=\"73\" rx=\"4\" ry=\"2.8\" fill=\"{ink()}\"/>"
}

fn owl(c: Text) -> Text {
  return f"<g class=\"mz-ear\"><path d=\"M30 44 L26 18 L48 34 Z\" fill=\"{c}\"/></g><g class=\"mz-ear mz-ear-r\"><path d=\"M90 44 L94 18 L72 34 Z\" fill=\"{c}\"/></g>"
    + f"<ellipse cx=\"60\" cy=\"72\" rx=\"35\" ry=\"39\" fill=\"{c}\"/>"
    + f"<g class=\"mz-tail\"><path d=\"M27 64 Q14 92 36 108 Q28 86 31 64 Z\" fill=\"{ink()}\" opacity=\".28\"/><path d=\"M93 64 Q106 92 84 108 Q92 86 89 64 Z\" fill=\"{ink()}\" opacity=\".28\"/></g>"
    + f"<ellipse cx=\"60\" cy=\"90\" rx=\"20\" ry=\"18\" fill=\"{cream()}\" opacity=\".92\"/>"
    + f"<path d=\"M50 86 l4 4 l4 -4 M62 86 l4 4 l4 -4 M56 96 l4 4 l4 -4\" stroke=\"{c}\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>"
    + f"<circle cx=\"45\" cy=\"58\" r=\"14\" fill=\"{cream()}\"/><circle cx=\"75\" cy=\"58\" r=\"14\" fill=\"{cream()}\"/>"
    + eyes(45, 75, 58, 5.6)
    + f"<path d=\"M55 68 L65 68 L60 78 Z\" fill=\"{gold()}\"/>"
    + f"<path d=\"M50 110 l-3 5 M54 110 l0 6 M66 110 l0 6 M70 110 l3 5\" stroke=\"{gold()}\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>"
}

fn hare(c: Text) -> Text {
  return f"<g class=\"mz-tail\" opacity=\".7\"><path d=\"M4 70 L34 74\" stroke=\"{c}\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\".5\"/><path d=\"M10 86 L36 86\" stroke=\"{c}\" stroke-width=\"4\" stroke-linecap=\"round\" opacity=\".35\"/><path d=\"M2 100 L38 96\" stroke=\"{c}\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\".25\"/></g>"
    + f"<ellipse cx=\"62\" cy=\"98\" rx=\"22\" ry=\"15\" fill=\"{c}\"/><circle cx=\"84\" cy=\"100\" r=\"6\" fill=\"{cream()}\"/>"
    + f"<g class=\"mz-ear\"><path d=\"M47 48 Q34 4 49 5 Q59 8 57 48 Z\" fill=\"{c}\"/><path d=\"M50 42 Q43 14 50 13 Q54 16 53 42 Z\" fill=\"{blush()}\" opacity=\".7\"/></g>"
    + f"<g class=\"mz-ear mz-ear-r\"><path d=\"M65 48 Q63 6 74 5 Q88 7 75 48 Z\" fill=\"{c}\"/><path d=\"M68 42 Q68 15 73 13 Q79 16 72 42 Z\" fill=\"{blush()}\" opacity=\".7\"/></g>"
    + f"<circle cx=\"60\" cy=\"64\" r=\"25\" fill=\"{c}\"/>"
    + f"<ellipse cx=\"60\" cy=\"74\" rx=\"11\" ry=\"8\" fill=\"{cream()}\"/>"
    + eyes(50, 70, 60, 3.6)
    + f"<path d=\"M57 70 L63 70 L60 73.5 Z\" fill=\"{blush()}\"/><rect x=\"57.5\" y=\"76\" width=\"5\" height=\"5\" rx=\"1.2\" fill=\"#fff\"/>"
    + f"<path d=\"M46 72 L34 70 M46 75 L35 77 M74 72 L86 70 M74 75 L85 77\" stroke=\"{ink()}\" stroke-width=\"1\" opacity=\".55\" stroke-linecap=\"round\"/>"
}

fn sun(c: Text) -> Text {
  let rays = (for angle in [0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330] {
    let long = if angle % 60 == 0 { "18" } else { "12" }
    let top = if angle % 60 == 0 { "8" } else { "14" }
    f"<rect x=\"56.5\" y=\"{top}\" width=\"7\" height=\"{long}\" rx=\"3.5\" fill=\"{c}\" transform=\"rotate({angle.to_text()} 60 60)\"/>"
  }).join("")
  return f"<g class=\"mz-rays\">{rays}</g>"
    + f"<circle cx=\"60\" cy=\"60\" r=\"30\" fill=\"{c}\"/><circle cx=\"60\" cy=\"56\" r=\"22\" fill=\"#ffd9a8\" opacity=\".45\"/>"
    + eyes(50, 70, 56, 3.6)
    + f"<circle cx=\"43\" cy=\"66\" r=\"4.5\" fill=\"{blush()}\" opacity=\".75\"/><circle cx=\"77\" cy=\"66\" r=\"4.5\" fill=\"{blush()}\" opacity=\".75\"/>"
    + f"<path d=\"M51 68 Q60 77 69 68\" stroke=\"{ink()}\" stroke-width=\"2.6\" fill=\"none\" stroke-linecap=\"round\"/>"
}

fn spark(c: Text) -> Text {
  return f"<g class=\"mz-rays\"><path d=\"M60 14 Q67 53 106 60 Q67 67 60 106 Q53 67 14 60 Q53 53 60 14 Z\" fill=\"{c}\"/></g>"
    + f"<circle cx=\"60\" cy=\"60\" r=\"18\" fill=\"{c}\"/>"
    + eyes(53, 67, 58, 3)
    + f"<path d=\"M55 66 Q60 70 65 66\" stroke=\"{ink()}\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>"
}

fn creature(kind: Text, c: Text) -> Text {
  return match kind {
    case "sun" { sun(c) }
    case "fox" { fox(c) }
    case "owl" { owl(c) }
    case "hare" { hare(c) }
    case _ { spark(c) }
  }
}

// What floats around the creature in each state.
fn around(state: Text, c: Text) -> Text {
  if state == "waiting" {
    return f"<g class=\"mz-fx mz-ask\"><circle cx=\"100\" cy=\"18\" r=\"14\" fill=\"{gold()}\"/><path d=\"M90 28 L86 36 L96 30 Z\" fill=\"{gold()}\"/>"
      + f"<text x=\"100\" y=\"24\" text-anchor=\"middle\" font-family=\"Segoe UI, Arial, sans-serif\" font-size=\"18\" font-weight=\"800\" fill=\"{ink()}\">?</text></g>"
  }
  if state == "typing" {
    return f"<g font-family=\"ui-monospace, Consolas, monospace\" font-size=\"13\" font-weight=\"700\" fill=\"{c}\">"
      + "<text class=\"mz-fly\" x=\"96\" y=\"84\">a</text><text class=\"mz-fly mz-d2\" x=\"104\" y=\"70\">k</text><text class=\"mz-fly mz-d3\" x=\"98\" y=\"56\">s</text></g>"
  }
  if state == "done" {
    return (for at in ["14,26", "104,22", "108,92", "12,92"] {
      let xy = at.split(",")
      f"<path class=\"mz-fx\" d=\"M{xy[0]} {(xy[1].to_number().or(0) - 7).to_text()} l2 5 l5 2 l-5 2 l-2 5 l-2 -5 l-5 -2 l5 -2 Z\" fill=\"{gold()}\"/>"
    }).join("")
  }
  return ""
}

// The mascot of an agent, `size` pixels wide, in its colour and state.
fn mascot_svg(agent: Text, colour: Text, state: Text, size: Number) -> Text {
  let m = mascot_for(agent)
  let shown = if mascot_states().contains(state) { state } else { "idle" }
  let px = size.round().to_text()
  return f"<svg class=\"mz mz-{shown}\" xmlns=\"http://www.w3.org/2000/svg\" width=\"{px}\" height=\"{px}\" viewBox=\"-6 -6 132 132\" role=\"img\" aria-label=\"{escaped_text(title_for(agent))}, {shown}\" style=\"--c:{colour};filter:drop-shadow(0 0 8px {colour}66)\">"
    + f"<ellipse class=\"mz-shadow\" cx=\"60\" cy=\"118\" rx=\"30\" ry=\"4\" fill=\"{ink()}\" opacity=\".55\"/>"
    + f"<g class=\"mz-all\">{creature(m.creature, colour)}</g>"
    + around(shown, colour)
    + "</svg>"
}

// The same, with its motion inside, for a file or an <img> of its own.
fn mascot_alone(agent: Text, colour: Text, state: Text, size: Number) -> Text {
  return mascot_svg(agent, colour, state, size).replace("<ellipse class=\"mz-shadow\"", "<style>" + mascot_css() + "</style><ellipse class=\"mz-shadow\"")
}

fn mascot_css() -> Text {
  return ".mz{overflow:visible}.mz g,.mz text,.mz path{transform-box:fill-box;transform-origin:center}"
    + ".mz .mz-all{transform-origin:50% 100%;animation:mz-breathe 3.6s ease-in-out infinite}"
    + ".mz .mz-eye{animation:mz-blink 4.4s infinite}"
    + ".mz .mz-ear{transform-origin:50% 100%;animation:mz-ear 5s ease-in-out infinite}.mz .mz-ear-r{animation-delay:.18s}"
    + ".mz .mz-tail{transform-origin:0% 100%;animation:mz-swish 3s ease-in-out infinite}"
    + ".mz .mz-rays{animation:mz-spin 16s linear infinite}"
    + ".mz-waiting .mz-all{animation:mz-bob 1.1s ease-in-out infinite}.mz-waiting .mz-eye{animation-duration:1.7s}"
    + ".mz .mz-ask{transform-origin:20% 100%;animation:mz-ask 1.1s ease-in-out infinite}"
    + ".mz-typing .mz-ear{animation:mz-ear-fast .45s ease-in-out infinite}.mz-typing .mz-tail{animation-duration:.7s}.mz-typing .mz-rays{animation-duration:3s}"
    + ".mz-typing .mz-all{animation:mz-tap .35s ease-in-out infinite}"
    + ".mz .mz-fly{opacity:0;animation:mz-fly 1.2s ease-out infinite}.mz .mz-d2{animation-delay:.4s}.mz .mz-d3{animation-delay:.8s}"
    + ".mz-done .mz-all{animation:mz-hop 1.5s cubic-bezier(.3,1.5,.5,1) infinite}"
    + ".mz-done .mz-fx{animation:mz-pop 1.5s ease-out infinite}.mz-done .mz-fx:nth-of-type(2n){animation-delay:.35s}"
    + ".mz-failed .mz-all{animation:mz-sigh 4s ease-in-out infinite;filter:saturate(.25) brightness(.8)}.mz-failed .mz-eye{animation:none;transform:scaleY(.3)}.mz-failed .mz-ear{animation:none;transform:rotate(-14deg)}.mz-failed .mz-ear-r{transform:rotate(14deg)}"
    + "@keyframes mz-breathe{50%{transform:scale(1.03,.97)}}"
    + "@keyframes mz-blink{0%,93%,100%{transform:scaleY(1)}96%{transform:scaleY(.08)}}"
    + "@keyframes mz-ear{0%,78%,100%{transform:rotate(0)}84%{transform:rotate(-9deg)}90%{transform:rotate(6deg)}}"
    + "@keyframes mz-ear-fast{50%{transform:rotate(-8deg)}}"
    + "@keyframes mz-swish{50%{transform:rotate(-9deg)}}"
    + "@keyframes mz-spin{to{transform:rotate(360deg)}}"
    + "@keyframes mz-bob{50%{transform:translateY(-7px)}}"
    + "@keyframes mz-ask{0%,100%{transform:scale(1) rotate(0)}50%{transform:scale(1.12) rotate(-6deg)}}"
    + "@keyframes mz-tap{50%{transform:translateY(-2px) rotate(-1.5deg)}}"
    + "@keyframes mz-fly{0%{opacity:0;transform:translate(0,0) scale(.6)}25%{opacity:1}100%{opacity:0;transform:translate(14px,-22px) scale(1.2)}}"
    + "@keyframes mz-hop{0%,100%{transform:translateY(0) scale(1)}14%{transform:translateY(2px) scale(1.07,.9)}40%{transform:translateY(-18px) scale(.95,1.06)}66%{transform:translateY(0) scale(1.05,.95)}80%{transform:scale(1)}}"
    + "@keyframes mz-pop{0%{opacity:0;transform:scale(.3) rotate(0)}30%{opacity:1}100%{opacity:0;transform:scale(1.4) rotate(90deg)}}"
    + "@keyframes mz-sigh{50%{transform:translateY(4px) scaleY(.95)}}"
    + "@media (prefers-reduced-motion:reduce){.mz *{animation:none!important}}"
}

// Every mascot in every state, on one page, to look at them all.
//   kosika run mascots.kos --workflow sheet --input '{"s": {"title": "Kosika mascots"}}'
record Sheet { title: Text }
record Picture { html: Text }

fn sheet_page(title: Text) -> Text {
  let names = (for m in mascots() { m.agent }).append("helper")
  let colours = ["#ff8a4c", "#ff3ea5", "#55d6ff", "#4fe0a6", "#a993ff"]
  var rows: Text[] = []
  var at = 0
  for agent in names {
    let c = colours[at]
    let cells = (for state in mascot_states() { f"<figure>{mascot_svg(agent, c, state, 120)}<figcaption>{state}</figcaption></figure>" }).join("")
    rows = rows.append(f"<section style=\"--c:{c}\"><h2>{escaped_text(title_for(agent))}<small>{escaped_text(agent)} · {escaped_text(mascot_for(agent).line)}</small></h2><div class=\"row\">{cells}</div></section>")
    at += 1
  }
  return "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
    + f"<title>{escaped_text(title)}</title><style>" + sheet_css() + mascot_css() + "</style></head><body>"
    + f"<h1>{escaped_text(title)}</h1>" + rows.join("") + "</body></html>"
}

fn sheet_css() -> Text {
  return "body{margin:0;padding:28px 16px;background:radial-gradient(1000px 500px at 0 -10%,#1b1f4a,transparent 60%),#07080d;color:#eef0f7;font:15px/1.5 'Segoe UI',Inter,system-ui,sans-serif}"
    + "h1{max-width:1100px;margin:0 auto 18px;font-size:34px;background:linear-gradient(90deg,#ff8a4c,#f5b45c 40%,#a993ff);-webkit-background-clip:text;background-clip:text;color:transparent}"
    + "section{max-width:1100px;margin:0 auto 16px;padding:16px 20px;border-radius:20px;background:linear-gradient(150deg,color-mix(in srgb,var(--c) 14%,#111428),#111428 60%);border:1px solid color-mix(in srgb,var(--c) 40%,transparent)}"
    + "h2{margin:0 0 6px;font-size:20px}h2 small{margin-left:10px;font-size:13px;font-weight:500;color:#a3a8bd}"
    + ".row{display:flex;flex-wrap:wrap;gap:14px}figure{margin:0;text-align:center}figcaption{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--c)}"
}

workflow sheet(s: Sheet) -> Picture {
  result = {html: sheet_page(s.title)}
}

test "every agent with a kit has a mascot, each with its own name" {
  expect (for m in mascots() { mascot_problems(m).join("; ") }).join("") == ""
  expect title_for("coder-1") == "Nova the fox"
  expect title_for("coder-2") == "Quark the owl"
  expect title_for("scout") == "Comet the hare"
  expect title_for("Kosika") == "Kosi the sun"
  expect tag_for("coder-1") == "Nova"
}

test "an agent without a mascot is a spark with its own name" {
  expect mascot_for("helper").creature == "spark"
  expect title_for("helper") == "helper"
  expect tag_for("helper") == "helper"
}

test "a bad mascot is told" {
  said = mascot_problems({agent: "x", nickname: "Nova", creature: "dragon", line: ""}).join("\n")
  expect said.contains("'dragon' is not a creature")
  expect said.contains("already coder-1's name")
}

test "a mascot is drawn in its agent's colour, showing its state" {
  svg = mascot_svg("coder-1", "#ff3ea5", "waiting", 80)
  expect svg.contains("class=\"mz mz-waiting\"")
  expect svg.contains("fill=\"#ff3ea5\"")
  expect svg.contains("aria-label=\"Nova the fox, waiting\"")
  expect svg.contains("width=\"80\"")
  expect svg.contains(">?</text>")
  expect mascot_svg("scout", "#4fe0a6", "dancing", 40).contains("mz mz-idle")
  expect mascot_svg("coder-2", "#55d6ff", "done", 40).contains("mz-fx")
  expect mascot_svg("Kosika", "#ff8a4c", "typing", 40).contains("mz-rays")
  expect mascot_alone("coder-1", "#ff3ea5", "idle", 40).contains("<style>")
  expect not mascot_svg("coder-1", "#ff3ea5", "idle", 40).contains("<style>")
}
