// The look of a Kosika agent's pointer, designed in Kosika: a vector arrow
// with the agent's name on a tag, in a colour from Kosika's own palette
// (Kosika Designs, std/designs_palette.kos). It is drawn as SVG, so it is
// sharp at any size; pointer.py renders it at the screen's real resolution.
//
//   kosika run cursor.kos --input '{"w": {"name": "coder-1", "scale": 1.5}}'
//
// Each agent gets the next hue of the palette by the letters of its name,
// so the same agent always has the same colour and different agents differ.

import "pointer_look.kos"

workflow main(w: Want) -> Drawn {
  drawn = pointer_svg(w)
}

test "an agent keeps its colour, and the picture is as wide as its name" {
  a = pointer_svg({name: "coder-1", scale: 1})
  b = pointer_svg({name: "coder-1", scale: 2})
  c = pointer_svg({name: "a-much-longer-agent-name", scale: 1})
  expect a.colour == b.colour
  expect b.width == a.width * 2 or b.width == a.width * 2 + 1 or b.width == a.width * 2 - 1
  expect c.width > a.width
  expect a.svg.starts_with("<svg") and a.svg.contains("coder-1")
}

test "names are written safely into the picture" {
  d = pointer_svg({name: "<x&y>", scale: 1})
  expect d.svg.contains("&lt;x&amp;y&gt;")
  expect not d.svg.contains("<x&y>")
}
