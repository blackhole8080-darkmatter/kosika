// The look of a Kosika agent's pointer, designed in Kosika: a vector arrow
// with the agent's name on a tag, in a colour from Kosika's own palette
// (Kosika Designs, std/designs_palette.kos). It is drawn as SVG, so it is
// sharp at any size; pointer.py renders it at the screen's real resolution.
//
//   kosika run cursor.kos --input '{"w": {"name": "coder-1", "scale": 1.5}}'
//
// Each agent gets the next hue of the palette by the letters of its name,
// so the same agent always has the same colour and different agents differ.

import "std/designs_palette.kos"

record Want { name: Text scale: Number }
record Drawn { svg: Text width: Number height: Number colour: Text }

// A hue for an agent: its name's letters added up, picking one of the
// palette's hues; the same name gives the same hue every time.
fn hue_for(name: Text) -> Text {
  let hues = palette_named("dark_matter").hues
  let letters = "abcdefghijklmnopqrstuvwxyz0123456789-_ "
  var total = 0
  var at = 1
  for ch in name.lower().chars() {
    total += at * (letters.index_of(ch).or(40) + 1)
    at += 1
  }
  return hues[total % hues.length()]
}

fn escaped_text(text: Text) -> Text {
  return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

fn pointer_svg(w: Want) -> Drawn {
  let colour = hue_for(w.name)
  let ink = palette_named("dark_matter").bg
  let label = escaped_text(w.name)
  // The tag is as wide as the name, at about 7.2 units a letter.
  let tag_width = 18 + w.name.length() * 7.2
  let width = 26 + tag_width + 11
  let height = 67
  let px_w = (width * w.scale).round()
  let px_h = (height * w.scale).round()
  let arrow = "M4 3 L4 37 Q4 40 6.6 38.2 L13.4 31.6 L19.2 44.6 Q20.2 46.6 22.2 45.8 L26.4 44 Q28.4 43.1 27.5 41.1 L21.7 28.4 L31.4 28.2 Q34.6 28.1 32.3 25.8 L6.9 1.6 Q4 -0.9 4 3 Z"
  let svg = f"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{px_w}\" height=\"{px_h}\" viewBox=\"-3 -3 {width} {height}\">"
    + "<defs>"
    + f"<linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"0.6\" y2=\"1\"><stop offset=\"0\" stop-color=\"{colour}\"/><stop offset=\"1\" stop-color=\"{colour}\" stop-opacity=\"0.82\"/></linearGradient>"
    + "<filter id=\"s\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\"><feDropShadow dx=\"0.8\" dy=\"1.6\" stdDeviation=\"1.4\" flood-color=\"#000\" flood-opacity=\"0.45\"/></filter>"
    + "</defs>"
    + f"<g filter=\"url(#s)\"><path d=\"{arrow}\" fill=\"url(#g)\" stroke=\"#ffffff\" stroke-width=\"2.2\" stroke-linejoin=\"round\"/>"
    + f"<rect x=\"24\" y=\"40\" rx=\"9\" ry=\"9\" width=\"{tag_width}\" height=\"19\" fill=\"{colour}\" stroke=\"#ffffff\" stroke-width=\"1.6\"/>"
    + f"<text x=\"33\" y=\"53.6\" font-family=\"Segoe UI, Arial, sans-serif\" font-size=\"11.5\" font-weight=\"700\" fill=\"{ink}\">{label}</text></g>"
    + "</svg>"
  return {svg: svg, width: px_w, height: px_h, colour: colour}
}

workflow main(w: Want) -> Drawn {
  drawn = pointer_svg(w)
}

test "an agent keeps its colour, and the picture is as wide as its name" {
  a = pointer_svg({name: "coder-1", scale: 1})
  b = pointer_svg({name: "coder-1", scale: 2})
  c = pointer_svg({name: "a-much-longer-agent-name", scale: 1})
  expect a.colour == b.colour
  expect b.width == a.width * 2 or b.width == a.width * 2 + 1 or b.width == a.width * 2 - 1
  expect c.width > a.width
  expect a.svg.starts_with("<svg") and a.svg.contains("coder-1")
}

test "names are written safely into the picture" {
  d = pointer_svg({name: "<x&y>", scale: 1})
  expect d.svg.contains("&lt;x&amp;y&gt;")
  expect not d.svg.contains("<x&y>")
}
