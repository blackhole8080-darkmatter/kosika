import "context.kos"

// Pure coordinator support. Context selection is lexical and heuristic, not
// semantic verification. Structural checks below do not prove advice correct.
record TeamRequest { project: Text question: Text focus: Text reference: Text }
record ReadSourceResult { text: Text }
record TeamSelection { sources: Text[] }
record EvidenceItem { source: Text quote: Text }
record TeamAdvice { explanation: Text steps: Text[] clarification: Text }
record TeamVerdict { approved: Bool concerns: Text[] }
record TeamResult { status: Text answer: Text suggestions: Text[] clarification: Text evidence: EvidenceItem[] concerns: Text[] participants: Text[] memory: Text }
record ProjectSnapshot { question: Text context: Text advice: TeamAdvice evidence: EvidenceItem[] review: TeamVerdict }
record TeamContext { request: TeamRequest selected: Context }

fn team_input_problem(request: TeamRequest) -> Text {
  var missing: Text[] = []
  if request.project.trim().is_empty() { missing = missing.append("project") }
  if request.question.trim().is_empty() { missing = missing.append("question") }
  if request.focus.trim().is_empty() { missing = missing.append("focus") }
  if request.reference.trim().is_empty() { missing = missing.append("reference") }
  if not missing.is_empty() { return "Please provide nonblank " + missing.join(", ") + "." }
  if request.project.length() > 200 { return "Please provide a project key of at most 200 characters." }
  return ""
}

// Paragraph boundaries are blank lines, not language syntax. Scan offsets to
// preserve exact source text, line endings and source line numbers. Blank-only
// paragraphs are omitted; a paragraph's final content-line ending is retained.
record TeamSourceParagraph { start: Number end: Number line: Number }

// Standalone ATX or two-line setext Markdown heading paragraphs carry their
// next body paragraph. This is text retrieval, not a code or Markdown parser.
fn team_source_heading(text: Text) -> Bool {
  let heading = text.trim()
  var position = 0
  while position < heading.length() and heading.slice(position, position + 1) != "\r" and heading.slice(position, position + 1) != "\n" { position += 1 }
  if position < heading.length() {
    let ending = heading.slice(position, position + 1)
    position += 1
    if ending == "\r" and position < heading.length() and heading.slice(position, position + 1) == "\n" { position += 1 }
    let underline = heading.slice(position, heading.length()).trim()
    if underline.is_empty() { return false }
    let marker = underline.slice(0, 1)
    if marker != "=" and marker != "-" { return false }
    return underline.replace(marker, "").is_empty()
  }
  var hashes = 0
  while hashes < heading.length() and heading.slice(hashes, hashes + 1) == "#" { hashes += 1 }
  return hashes > 0 and hashes <= 6 and (hashes == heading.length() or heading.slice(hashes, hashes + 1).trim().is_empty())
}

fn team_source_spans(text: Text) -> TeamSourceParagraph[] {
  var paragraphs: TeamSourceParagraph[] = []
  var position = 0
  var line = 1
  var start = -1
  var start_line = 1
  var end = 0
  while position < text.length() {
    let line_start = position
    while position < text.length() and text.slice(position, position + 1) != "\r" and text.slice(position, position + 1) != "\n" { position += 1 }
    let content = text.slice(line_start, position)
    if position < text.length() {
      let ending = text.slice(position, position + 1)
      position += 1
      if ending == "\r" and position < text.length() and text.slice(position, position + 1) == "\n" { position += 1 }
    }
    if content.trim().is_empty() {
      if start >= 0 {
        paragraphs = paragraphs.append({start: start, end: end, line: start_line})
        start = -1
      }
    } else {
      if start < 0 {
        start = line_start
        start_line = line
      }
      end = position
    }
    line += 1
  }
  if start >= 0 { paragraphs = paragraphs.append({start: start, end: end, line: start_line}) }
  var spans: TeamSourceParagraph[] = []
  var index = 0
  while index < paragraphs.length() {
    let paragraph = paragraphs[index]
    var passage_end = paragraph.end
    // Keep consecutive standalone headings with the eventual following body,
    // including every intervening blank line, as one contiguous source slice.
    while team_source_heading(text.slice(paragraphs[index].start, paragraphs[index].end)) and index + 1 < paragraphs.length() {
      index += 1
      passage_end = paragraphs[index].end
    }
    spans = spans.append({start: paragraph.start, end: passage_end, line: paragraph.line})
    index += 1
  }
  return spans
}

fn team_source_passages(path: Text, text: Text) -> Passage[] {
  var passages: Passage[] = []
  for span in team_source_spans(text) {
    passages = passages.append({id: path + ":" + span.line.to_text(), text: text.slice(span.start, span.end)})
  }
  return passages
}

fn team_source_indent(text: Text, start: Number) -> Number {
  var position = start
  while position < text.length() and (text.slice(position, position + 1) == " " or text.slice(position, position + 1) == "\t") { position += 1 }
  return position - start
}

// Whitespace-only grouping, not language parsing. Deeper paragraphs stay with
// their opening paragraph. Oversized groups reopen at whole span boundaries;
// an individual oversized span is still never cut. All text uses exact offsets.
fn team_context_passages(path: Text, text: Text) -> Passage[] {
  let spans = team_source_spans(text)
  var passages: Passage[] = []
  var index = 0
  var start = -1
  var end = 0
  var line = 1
  while index < spans.length() {
    let unit = spans[index]
    let unit_index = index
    let indent = team_source_indent(text, unit.start)
    let overhead = path.length() + unit.line.to_text().length() + 4
    var unit_end = unit.end
    index += 1
    while index < spans.length() and unit_end - unit.start + overhead <= 12000 and team_source_indent(text, spans[index].start) > indent {
      unit_end = spans[index].end
      index += 1
    }
    if unit_end - unit.start + overhead > 12000 {
      unit_end = unit.end
      index = unit_index + 1
    }
    if start >= 0 and unit_end - start > 2500 {
      passages = passages.append({id: path + ":" + line.to_text(), text: text.slice(start, end)})
      start = -1
    }
    if unit_end - unit.start > 2500 {
      passages = passages.append({id: path + ":" + unit.line.to_text(), text: text.slice(unit.start, unit_end)})
    } else {
      if start < 0 {
        start = unit.start
        line = unit.line
      }
      end = unit_end
    }
  }
  if start >= 0 { passages = passages.append({id: path + ":" + line.to_text(), text: text.slice(start, end)}) }
  return passages
}

// Explicit focus is not merely a keyword search result. Keep every whole unit
// when it fits; larger files retain lexical ranking, with one whole-unit fallback.
fn team_focus_context(question: Text, passages: Passage[]) -> Context {
  var characters = 0
  var all_fit = true
  for passage in passages {
    if characters > 0 { characters += 2 }
    characters += passage.id.length() + passage.text.length() + 3
    if characters > 12000 {
      all_fit = false
      break
    }
  }
  if all_fit {
    let blocks = for passage in passages { "[" + passage.id + "]\n" + passage.text }
    return {question: question, passages: passages, text: blocks.join("\n\n"), supplied: passages.length(), selected: passages.length(), characters: characters}
  }
  let ranked = select_context({question: question, passages: passages, limit: 12000})
  if ranked.selected > 0 { return ranked }
  for passage in passages {
    if passage.id.length() + passage.text.length() + 3 <= 12000 {
      let rendered = "[" + passage.id + "]\n" + passage.text
      return {question: question, passages: [passage], text: rendered, supplied: passages.length(), selected: 1, characters: rendered.length()}
    }
  }
  return ranked
}

fn build_team_context(request: TeamRequest, focus: ReadSourceResult, reference: ReadSourceResult) -> TeamContext {
  let focus_passages = team_context_passages(request.focus, focus.text)
  let reference_passages = team_context_passages(request.reference, reference.text)
  let primary = team_focus_context(request.question, focus_passages)
  var supplemental: Passage[] = []
  let focus_ids = for passage in focus_passages { passage.id }
  for passage in reference_passages {
    if not focus_ids.contains(passage.id) { supplemental = supplemental.append(passage) }
  }
  // The explicit focus gets first use of the shared budget. Reference material
  // fills remaining space; neither selection truncates a whole source passage.
  let separator = if primary.selected == 0 { "" } else { "\n\n" }
  let secondary = select_context({question: request.question, passages: supplemental, limit: 12000 - primary.characters - separator.length()})
  let suffix = if secondary.selected == 0 { "" } else { separator + secondary.text }
  let text = primary.text + suffix
  var passages = primary.passages
  for passage in secondary.passages { passages = passages.append(passage) }
  return {request: request, selected: {question: request.question, passages: passages, text: text, supplied: focus_passages.length() + reference_passages.length(), selected: passages.length(), characters: text.length()}}
}

fn team_frame(text: Text) -> Text { return text.length().to_text() + ":" + text }

// Unambiguous length framing, not a cryptographic hash. Identity intentionally
// covers selected context only, plus both requested paths and format version.
fn team_context_identity(context: TeamContext) -> Text {
  var identity = "kosika-team-context-v7:" + team_frame(context.request.focus) + team_frame(context.request.reference) + team_frame(context.selected.passages.length().to_text())
  for passage in context.selected.passages { identity = identity + team_frame(passage.id) + team_frame(passage.text) }
  return identity
}

fn team_evidence(selection: TeamSelection, context: TeamContext) -> EvidenceItem[] {
  var evidence: EvidenceItem[] = []
  var seen: Text[] = []
  if selection.sources.length() < 1 or selection.sources.length() > 3 { return [] }
  for source in selection.sources {
    if seen.contains(source) { return [] }
    seen = seen.append(source)
    var found = false
    for passage in context.selected.passages {
      if passage.id == source and not passage.text.trim().is_empty() {
        evidence = evidence.append({source: source, quote: passage.text})
        found = true
      }
    }
    if not found { return [] }
  }
  return evidence
}

fn team_evidence_valid(evidence: EvidenceItem[], context: TeamContext) -> Bool {
  if evidence.length() < 1 or evidence.length() > 3 { return false }
  var sources: Text[] = []
  for item in evidence {
    if item.quote.trim().is_empty() or sources.contains(item.source) { return false }
    sources = sources.append(item.source)
    var found = false
    for passage in context.selected.passages {
      if item.source == passage.id and item.quote == passage.text { found = true }
    }
    if not found { return false }
  }
  return true
}

fn team_advice_problem(advice: TeamAdvice) -> Text {
  if advice.explanation.trim().is_empty() { return "Advice requires a nonblank explanation." }
  if not advice.clarification.trim().is_empty() {
    if not advice.steps.is_empty() { return "Clarification advice must not include recommendation steps." }
    return ""
  }
  if not advice.clarification.is_empty() { return "Clarification must be empty or nonblank." }
  if advice.steps.length() < 1 or advice.steps.length() > 5 { return "Recommendation advice requires one to five steps." }
  for item in advice.steps {
    if item.trim().is_empty() { return "Every recommendation step must be nonblank." }
  }
  return ""
}

fn team_review_problem(review: TeamVerdict) -> Text {
  for concern in review.concerns {
    if concern.trim().is_empty() { return "Every reviewer concern must be nonblank." }
  }
  if review.approved and not review.concerns.is_empty() { return "An approved review cannot include concerns." }
  if not review.approved and review.concerns.is_empty() { return "A declined review must explain at least one concern." }
  return ""
}

fn team_snapshot_reusable(snapshot: ProjectSnapshot, context: TeamContext) -> Bool {
  return snapshot.question == context.request.question and snapshot.context == team_context_identity(context) and team_evidence_valid(snapshot.evidence, context) and team_advice_problem(snapshot.advice).is_empty() and snapshot.advice.clarification.is_empty() and team_review_problem(snapshot.review).is_empty() and snapshot.review.approved and snapshot.review.concerns.is_empty()
}

fn team_evidence_text(evidence: EvidenceItem[]) -> Text {
  var rendered: Text[] = []
  for item in evidence { rendered = rendered.append("EXACT_SOURCE_ID: " + item.source + "\nSOURCE_TEXT:\n" + item.quote) }
  return rendered.join("\n\n")
}

export [TeamRequest, ReadSourceResult, TeamSelection, EvidenceItem, TeamAdvice, TeamVerdict, TeamResult, ProjectSnapshot, TeamContext, team_input_problem, build_team_context, team_context_identity, team_evidence, team_evidence_valid, team_advice_problem, team_review_problem, team_snapshot_reusable, team_evidence_text]

// Test-only pure fixtures: no workflow named main and no models or tools.
fn team_test_context() -> TeamContext {
  return build_team_context({project: "demo", question: "cache", focus: "src/cache.kos", reference: "notes.txt"}, {text: "cache original\n"}, {text: "cache reference"})
}

fn team_test_snapshot(context: TeamContext) -> ProjectSnapshot {
  return {question: context.request.question, context: team_context_identity(context), advice: {explanation: "A proposal, not an action.", steps: ["Consider a cache test."], clarification: ""}, evidence: team_evidence({sources: ["src/cache.kos:1"]}, context), review: {approved: true, concerns: []}}
}

test "team requires explicit nonblank inputs without guessing question intent" {
  expect not team_input_problem({project: " ", question: "", focus: "\t", reference: ""}).is_empty()
  expect not team_input_problem({project: "x".repeat(201), question: "cache", focus: "a", reference: "b"}).is_empty()
  expect team_input_problem({project: "x".repeat(200), question: "???", focus: "a", reference: "b"}) == ""
}

test "team whole function paragraph is not split at six lines" {
  source = "fn cache() {\n  first()\n  second()\n  third()\n  fourth()\n  fifth()\n  sixth()\n  return result\n}\n"
  passages = team_source_passages("a", source)
  expect passages.length() == 1
  expect passages[0].id == "a:1"
  expect passages[0].text == source
}

test "team negative heading stays contiguous with its capability list" {
  source = "Introduction\n\n## What it does not have\r\n \r\n- cache persistence\r\n- automatic execution\r\n\r\nOther notes\n"
  passages = team_source_passages("a", source)
  expect passages.length() == 3
  expect passages[1].id == "a:3"
  expect passages[1].text == "## What it does not have\r\n \r\n- cache persistence\r\n- automatic execution\r\n"
  expect passages[2].id == "a:8"
  context = build_team_context({project: "p", question: "cache persistence", focus: "a", reference: "b"}, {text: source}, {text: ""})
  expect context.selected.passages[0].text.contains(passages[1].text)
}

test "team setext heading and consecutive headings retain exact intervening blanks" {
  source = "# Limits\n\nWhat it does not have\r\n---\r\n\r\n- cache writes"
  passages = team_source_passages("a", source)
  expect passages.length() == 1
  expect passages[0].id == "a:1"
  expect passages[0].text == source
}

test "team context retains blank-separated indented methods and initialization" {
  body = "class Cache:\r\n    def __init__(self):\r\n        self.value = 0\r\n\r\n    def read(self):\r\n        return self.value\r\n\r\n    def write(self, value):\r\n        self.value = value\r\n"
  source = "\r\n\r\n" + body
  passages = team_context_passages("cache.py", source)
  expect passages.length() == 1
  expect passages[0].id == "cache.py:3"
  expect passages[0].text == body
  result = build_team_context({project: "p", question: "Cache read value", focus: "cache.py", reference: "b"}, {text: source}, {text: ""})
  expect result.selected.passages == passages
  expect result.selected.characters <= 12000
}

test "team oversized class exposes complete peer methods" {
  target = "    def target(self):\n        value = 7\n\n        return value\n"
  source = "class Big:\n\n    def before(self):\n        return \"" + "x".repeat(6000) + "\"\n\n" + target + "\n    def after(self):\n        return \"" + "y".repeat(6000) + "\"\n"
  result = build_team_context({project: "p", question: "target", focus: "a", reference: "b"}, {text: source}, {text: ""})
  expect result.selected.passages.length() == 1
  expect result.selected.passages[0].id == "a:6"
  expect result.selected.passages[0].text == target
  expect result.selected.characters <= 12000
}

test "team oversized tab-indented class preserves nested method paragraphs" {
  target = "\tdef target(self):\n\t\tvalue = 7\n\n\t\treturn value\n"
  source = "class Big:\n\n\tdef before(self):\n\t\treturn \"" + "x".repeat(6000) + "\"\n\n" + target + "\n\tdef after(self):\n\t\treturn \"" + "y".repeat(6000) + "\"\n"
  result = build_team_context({project: "p", question: "target", focus: "tabs", reference: "b"}, {text: source}, {text: ""})
  expect result.selected.passages.length() == 1
  expect result.selected.passages[0].id == "tabs:6"
  expect result.selected.passages[0].text == target
  expect result.selected.characters <= 12000
}

test "team class recovery counts source id overhead at the budget boundary" {
  target = "    def target(self):\n        return 7\n"
  prefix = "class Edge:\n\n    def padding(self):\n        return \""
  suffix = "\"\n\n" + target
  source = prefix + "x".repeat(11999 - prefix.length() - suffix.length()) + suffix
  result = build_team_context({project: "p", question: "target", focus: "a", reference: "b"}, {text: source}, {text: ""})
  expect source.length() == 11999
  expect result.selected.passages.length() == 1
  expect result.selected.passages[0].id == "a:6"
  expect result.selected.passages[0].text == target
  expect result.selected.characters <= 12000
}

test "team oversized paragraph does not hide following methods" {
  oversized = "class Cache:\n    state = \"" + "x".repeat(12100) + "\"\n"
  method = "    def read(self):\n        return self.state\n"
  source = oversized + "\n" + method + "\ncache small"
  result = build_team_context({project: "p", question: "cache read state", focus: "a", reference: "b"}, {text: source}, {text: ""})
  expect result.selected.selected == 1
  expect result.selected.passages[0].id == "a:4"
  expect result.selected.passages[0].text == method + "\ncache small"
  expect result.selected.characters <= 12000
}

test "team context packs adjacent whole units to the exact source bound" {
  first = "cache " + "x".repeat(2493) + "\r"
  source = first + "\rnext\n\nlast"
  passages = team_context_passages("a", source)
  expect first.length() == 2500
  expect passages.length() == 2
  expect passages[0].id == "a:1"
  expect passages[0].text == first
  expect passages[1].id == "a:3"
  expect passages[1].text == "next\n\nlast"
}

test "team context retains handover introduction with adjacent permission rules" {
  source = "This handover explains cache assistance.\r\n\r\n## Permission rules\r\n\r\nRead only; never write files or execute commands.\r\n"
  result = build_team_context({project: "p", question: "cache assistance", focus: "handover.md", reference: "b"}, {text: source}, {text: ""})
  expect result.selected.passages.length() == 1
  expect result.selected.passages[0].id == "handover.md:1"
  expect result.selected.passages[0].text == source
  expect result.selected.characters <= 12000
}

test "team indented unit above packing bound stays standalone without truncation" {
  unit = "class Cache:\n    state = \"" + "x".repeat(4600) + "\"\n\n\tdef read(self):\n\t\treturn self.state\n"
  passages = team_context_passages("a", unit + "\nnext")
  expect passages.length() == 2
  expect passages[0].id == "a:1"
  expect passages[0].text == unit
  expect passages[1].id == "a:7"
  expect passages[1].text == "next"
  result = build_team_context({project: "p", question: "cache", focus: "a", reference: "b"}, {text: unit + "\nnext"}, {text: ""})
  expect result.selected.passages[0].text == unit
  expect result.selected.characters > 4000
  expect result.selected.characters <= 12000
}

test "team paragraphs preserve mixed endings trailing spaces and source starts" {
  passages = team_source_passages("a", "\r\n \r\t\ncache first  \r\nnext\r\r\ncache second\n\ncache final\r")
  expect passages.length() == 3
  expect passages[0].id == "a:4"
  expect passages[0].text == "cache first  \r\nnext\r"
  expect passages[1].id == "a:7"
  expect passages[1].text == "cache second\n"
  expect passages[2].id == "a:9"
  expect passages[2].text == "cache final\r"
  expect team_source_passages("a", "\r\n \r\t\n") == []
}

test "team blank paragraphs do not shift later line numbers or truncate large files" {
  result = build_team_context({project: "p", question: "cache", focus: "a", reference: "b"}, {text: "\n".repeat(600) + "cache tail"}, {text: ""})
  expect result.selected.supplied == 1
  expect result.selected.passages[0].id == "a:601"
  expect result.selected.passages[0].text == "cache tail"
}

test "team oversized whole passage is omitted rather than partially quoted" {
  result = build_team_context({project: "p", question: "cache", focus: "a", reference: "b"}, {text: "cache ".repeat(2100)}, {text: "cache small"})
  passages = team_source_passages("a", "cache ".repeat(2100))
  expect passages.length() == 1
  expect passages[0].text == "cache ".repeat(2100)
  expect result.selected.selected == 1
  expect result.selected.passages[0].id == "b:1"
  expect result.selected.passages[0].text == "cache small"
}

test "team focus cannot be crowded out by a denser reference" {
  focused = "cache " + "x".repeat(11500)
  result = build_team_context({project: "p", question: "cache retry capacity", focus: "a", reference: "b"}, {text: focused}, {text: "cache retry capacity " + "y".repeat(11500) + "\n\ncache supplemental"})
  expect result.selected.selected == 2
  expect result.selected.passages[0].id == "a:1"
  expect result.selected.passages[0].text == focused
  expect result.selected.passages[1].id == "b:3"
  expect result.selected.characters <= 12000
}

test "team shared budget counts the separator between focus and reference" {
  request: TeamRequest = {project: "p", question: "cache", focus: "a", reference: "b"}
  exact = build_team_context(request, {text: "cache " + "x".repeat(11975)}, {text: "cache"})
  overflow = build_team_context(request, {text: "cache " + "x".repeat(11976)}, {text: "cache"})
  expect exact.selected.selected == 2
  expect exact.selected.characters == 12000
  expect overflow.selected.selected == 1
  expect overflow.selected.passages[0].id == "a:1"
  expect overflow.selected.characters == 11988
}

test "team explicit focus survives zero keyword overlap" {
  body = "fn opaque() -> Number { return 7 }\r\n"
  result = build_team_context({project: "p", question: "durability", focus: "impl.kos", reference: "contract.txt"}, {text: body}, {text: "durability contract"})
  expect result.selected.passages.length() == 2
  expect result.selected.passages[0].id == "impl.kos:1"
  expect result.selected.passages[0].text == body
  expect result.selected.passages[1].id == "contract.txt:1"
  expect result.selected.characters <= 12000
}

test "team explicit focus retains unmatched units when the whole file fits" {
  first = "cache " + "x".repeat(2600) + "\r\n"
  second = "fn opaque() -> Number { return 7 }\r\n"
  result = build_team_context({project: "p", question: "cache", focus: "impl.kos", reference: "b"}, {text: first + "\r\n" + second}, {text: ""})
  expect result.selected.passages.length() == 2
  expect result.selected.passages[0].text == first
  expect result.selected.passages[1].id == "impl.kos:3"
  expect result.selected.passages[1].text == second
}

test "team explicit focus falls back to the first whole fitting unit" {
  body = "fn opaque() -> Number { return 7 }\n"
  source = "padding " + "x".repeat(12000) + "\n\n" + body + "\n" + "y".repeat(12000)
  result = build_team_context({project: "p", question: "durability", focus: "impl.kos", reference: "b"}, {text: source}, {text: "durability contract"})
  expect result.selected.passages[0].id == "impl.kos:3"
  expect result.selected.passages[0].text == body
  expect result.selected.characters <= 12000
}

test "team explicit focus keeps lexical ranking for larger matching files" {
  source = "padding " + "x".repeat(2600) + "\n\ncache target\n\n" + "y".repeat(12000)
  result = build_team_context({project: "p", question: "cache", focus: "impl.kos", reference: "b"}, {text: source}, {text: ""})
  expect result.selected.passages.length() == 1
  expect result.selected.passages[0].id == "impl.kos:3"
  expect result.selected.passages[0].text == "cache target\n"
}

test "team repeated source paths cannot duplicate evidence" {
  result = build_team_context({project: "p", question: "cache", focus: "a", reference: "a"}, {text: "cache original"}, {text: "cache original"})
  expect result.selected.selected == 1
  expect result.selected.passages[0].id == "a:1"
  expect result.selected.passages[0].text == "cache original"
}

test "team selection copies whole current passages in requested order" {
  context = team_test_context()
  evidence = team_evidence({sources: ["notes.txt:1", "src/cache.kos:1"]}, context)
  expect evidence[0].quote == "cache reference"
  expect evidence[1].quote == "cache original\n"
  expect team_evidence_valid(evidence, context)
}

test "team malformed selections cannot supply evidence" {
  context = team_test_context()
  expect team_evidence({sources: []}, context) == []
  expect team_evidence({sources: ["src/cache.kos:1", "src/cache.kos:1"]}, context) == []
  expect team_evidence({sources: ["src/cache.kos:1", "invented:1"]}, context) == []
  expect team_evidence({sources: ["a", "b", "c", "d"]}, context) == []
}

test "team evidence rejects paraphrases partial quotes duplicate and missing sources" {
  context = team_test_context()
  expect not team_evidence_valid([{source: "src/cache.kos:1", quote: "cache original"}], context)
  expect not team_evidence_valid([{source: "src/cache.kos:1", quote: "cache paraphrase\n"}], context)
  expect not team_evidence_valid([{source: "unknown", quote: "cache original\n"}], context)
  expect not team_evidence_valid([{source: "src/cache.kos:1", quote: ""}], context)
  expect not team_evidence_valid([{source: "src/cache.kos:1", quote: "cache original\n"}, {source: "src/cache.kos:1", quote: "cache original\n"}], context)
}

test "team identity frames paths and passage boundaries against delimiter collisions" {
  first = build_team_context({project: "p", question: "cache", focus: "a:b", reference: "c"}, {text: "cache"}, {text: ""})
  second = build_team_context({project: "p", question: "cache", focus: "a", reference: "b:c"}, {text: "cache"}, {text: ""})
  expect team_context_identity(first) != team_context_identity(second)
}

test "team advice distinguishes clarification and structurally valid recommendations" {
  expect team_advice_problem({explanation: "Need scope", steps: [], clarification: "Which cache?"}) == ""
  expect team_advice_problem({explanation: "Proposal", steps: ["Consider a test"], clarification: ""}) == ""
  expect not team_advice_problem({explanation: " ", steps: ["test"], clarification: ""}).is_empty()
  expect not team_advice_problem({explanation: "Proposal", steps: [" "], clarification: ""}).is_empty()
  expect not team_advice_problem({explanation: "Proposal", steps: ["test"], clarification: "Which?"}).is_empty()
  expect not team_advice_problem({explanation: "Proposal", steps: [], clarification: ""}).is_empty()
}

test "team reviewer contradictions fail but a reasoned decline is valid" {
  expect team_review_problem({approved: true, concerns: []}) == ""
  expect team_review_problem({approved: false, concerns: ["Missing test"]}) == ""
  expect not team_review_problem({approved: true, concerns: ["Missing test"]}).is_empty()
  expect not team_review_problem({approved: false, concerns: []}).is_empty()
  expect not team_review_problem({approved: false, concerns: [" "]}).is_empty()
}

test "team accepted snapshots require exact current question context and evidence" {
  context = team_test_context()
  snapshot = team_test_snapshot(context)
  changed = build_team_context(context.request, {text: "cache changed\n"}, {text: "cache reference"})
  question = build_team_context({project: "demo", question: "cache?", focus: "src/cache.kos", reference: "notes.txt"}, {text: "cache original\n"}, {text: "cache reference"})
  expect team_snapshot_reusable(snapshot, context)
  expect not team_snapshot_reusable(snapshot, changed)
  expect not team_snapshot_reusable(snapshot, question)
  legacy: ProjectSnapshot = {question: snapshot.question, context: "kosika-team-context-v6:" + snapshot.context.slice("kosika-team-context-v7:".length(), snapshot.context.length()), advice: snapshot.advice, evidence: snapshot.evidence, review: snapshot.review}
  expect not team_snapshot_reusable(legacy, context)
}

test "team clarification or declined review is never reusable as accepted advice" {
  context = team_test_context()
  snapshot = team_test_snapshot(context)
  clarification: ProjectSnapshot = {question: snapshot.question, context: snapshot.context, advice: {explanation: "Need detail", steps: [], clarification: "Which cache?"}, evidence: snapshot.evidence, review: snapshot.review}
  declined: ProjectSnapshot = {question: snapshot.question, context: snapshot.context, advice: snapshot.advice, evidence: snapshot.evidence, review: {approved: false, concerns: ["Need more evidence"]}}
  expect not team_snapshot_reusable(clarification, context)
  expect not team_snapshot_reusable(declined, context)
}

test "team snapshots cannot reuse evidence from another requested source path" {
  context = team_test_context()
  snapshot = team_test_snapshot(context)
  other = build_team_context({project: "demo", question: "cache", focus: "other/cache.kos", reference: "notes.txt"}, {text: "cache original\n"}, {text: "cache reference"})
  expect not team_snapshot_reusable(snapshot, other)
  expect not team_evidence_valid(snapshot.evidence, other)
}
