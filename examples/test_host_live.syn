record DiskStatus {
  mount: Text
  used_percent: Number
}

tool check_disk {
  source mcp "local_stdio"
  operation: "get_disk_info"
  access: observe
  output: DiskStatus
}

agent monitor {
  can: [check_disk]
  cannot: [arbitrary_shell]
}

workflow main() -> DiskStatus {
  step inspect {
    let result = execute monitor.check_disk()
    return result
  }
}
