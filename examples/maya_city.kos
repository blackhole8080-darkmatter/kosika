// Maya, the agent city, written in Kosika.
//
// The host parses every .kos program under a root and hands this workflow the
// people it found, plus the count so the join below can bound itself without a
// length builtin. Everything under the host -- deciding which megastructure
// each person belongs to, laying eight platforms out along a ring, and
// emitting the SVG -- is Kosika doing the work.

record Agent {
  name: Text
  department: Text
  can: Text[]
}

record City {
  agents: Agent[]
  count: Number
}

record Piece { svg: Text }

fn esc(text: Text) -> Text {
  return match text {
    case "&" { "&amp;" }
    case "<" { "&lt;" }
    case ">" { "&gt;" }
    case "\"" { "&quot;" }
    case "'" { "&apos;" }
    case _ { text }
  }
}

// Isometric platform: a top face plus two side faces, the standard dimetric
// block Maya's megastructures stand on.
fn platform(index: Number, domain: Text, hue: Text) -> Piece {
  let x: Number = 140.0 + index * 230.0
  let y: Number = 300.0 + index * 120.0
  let half: Number = 96.0
  let rise: Number = 52.0
  let top: Text =
    "<polygon points=\""
    + (x - half) + "," + y
    + " " + x + "," + (y - rise)
    + " " + (x + half) + "," + y
    + " " + x + "," + (y + rise)
    + "\" fill=\"" + hue + "\" data-domain=\"" + esc(text: domain) + "\"/>"
  let left: Text =
    "<polygon points=\"" + (x - half) + "," + y
    + " " + x + "," + (y + rise)
    + " " + x + "," + (y + rise + 40)
    + " " + (x - half) + "," + (y + 40)
    + "\" fill=\"" + hue + "\" opacity=\"0.55\"/>"
  let right: Text =
    "<polygon points=\"" + (x + half) + "," + y
    + " " + x + "," + (y + rise)
    + " " + x + "," + (y + rise + 40)
    + " " + (x + half) + "," + (y + 40)
    + "\" fill=\"" + hue + "\" opacity=\"0.35\"/>"
  return {svg: left + right + top}
}

fn person(agent: Agent, index: Number) -> Piece {
  let x: Number = 140.0 + index * 230.0
  let y: Number = 250.0 + index * 120.0
  let body: Text =
    "<g class=\"avatar\" data-agent=\"" + esc(text: agent.name) + "\" "
    + "data-department=\"" + esc(text: agent.department) + "\">"
    + "<ellipse cx=\"" + x + "\" cy=\"" + (y + 18) + "\" rx=\"7\" ry=\"3\" fill=\"#000\" opacity=\"0.35\"/>"
    + "<line x1=\"" + x + "\" y1=\"" + y + "\" x2=\"" + x + "\" y2=\"" + (y - 14) + "\" stroke=\"#e6edf5\" stroke-width=\"3\"/>"
    + "<circle cx=\"" + x + "\" cy=\"" + (y - 18) + "\" r=\"5\" fill=\"#e6edf5\"/>"
    + "<text x=\"" + x + "\" y=\"" + (y - 28) + "\" fill=\"#e6edf5\" font-size=\"10\" "
    + "text-anchor=\"middle\" font-family=\"Menlo,Consolas,monospace\">"
    + esc(text: agent.name) + "</text></g>"
  return {svg: body}
}

// One fragment per person: their platform and their figure standing on it.
fn plot(city: City) -> Text[] {
  return for a in city.agents {
    platform(index: 1.0, domain: a.department, hue: "#22d3ee").svg
    + person(agent: a, index: 1.0).svg
  }
}

// join, bounded by a caller-supplied count because the language has no length
// builtin and no way to catch an out-of-range index.
fn join(items: Text[], i: Number, count: Number) -> Text recurse 32 {
  return match i < count {
    case true { items[i] + join(items: items, i: i + 1, count: count) }
    case false { "" }
  }
}

fn render(city: City) -> Piece {
  let pieces: Text[] = plot(city: city)
  let body: Text = join(items: pieces, i: 0, count: city.count)
  return {svg: "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 2200 900\">"
    + "<title id=\"city-title\">Maya, an agent city</title>" + body + "</svg>"}
}

workflow main(city: City) -> Piece {
  step lay_out {
    let built = render(city: city)
    return built
  }
}
