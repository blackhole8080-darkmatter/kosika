// A function or workflow a module does not export belongs to that module
// (proposal 2). Two modules may each have their own `clip` and `solve`,
// and the program may have its own too: each file calls its own. A file's
// own declaration also comes before one it imports: this file has its own
// `solve`, though std/math.kos exports one, and std/math's own tests, run
// with this file's, still reach std/math's.

import "std/math.kos"
import "lib/plan_a.kos"
import "lib/plan_b.kos"

record Out { text: Text }

fn clip(t: Text) -> Text { return "[" + t + "]" }

fn joined(a: Answer, b: Answer) -> Out {
  return {text: clip(a.text) + clip(b.text)}
}

workflow solve(ask: Ask) -> Out {
  a = call plan_a(a: ask)
  b = call plan_b(a: ask)
  out = joined(a, b)
}

workflow main(ask: Ask) -> Out {
  out = call solve(ask: ask)
}

test "each file's clip and solve are its own" {
  o = main({text: "kosika"})
  expect o.text == "[a:kos][b:KOSIKA]"
}

