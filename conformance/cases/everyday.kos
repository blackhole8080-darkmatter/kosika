// Text, numbers, lists and dates, as people use them every day.

fn label(n: Number) -> Text { return n.to_fixed(2) }

test "text" {
  expect "hello WORLD".capitalize() == "Hello world"
  expect "the quick  fox".title() == "The Quick  Fox"
  expect "banana".count("an") == 2
  expect "ab".repeat(3) == "ababab"
  expect "ab".repeat(0) == ""
  expect "stressed".reverse() == "desserts"
  expect "".capitalize() == ""
}

test "numbers" {
  expect 15.clamp(0, 10) == 10
  expect (-3).clamp(0, 10) == 0
  expect 2.5.clamp(0, 10) == 2.5
  expect 1.log() == 0
  expect 0.exp() == 1
  expect 2.exp() == 7.389056099
  expect 10.log() == 2.302585093
  expect label(3.14159) == "3.14"
  expect label(2) == "2.00"
  expect 2.5.to_fixed(0) == "2"
  expect 3.5.to_fixed(0) == "4"
}

test "lists" {
  expect [1, 2, 1, 3, 1].count(1) == 3
  expect ["a", "b"].count("c") == 0
  expect [true, false, true].count(true) == 2
}

test "dates" {
  expect "2026-10-15".add_days(17) == "2026-11-01"
  expect "2026-03-01".add_days(-1) == "2026-02-28"
  expect "2024-03-01".add_days(-1) == "2024-02-29"
  expect "2026-10-15".days_until("2026-12-25") == 71
  expect "2026-12-25".days_until("2026-10-15") == -71
  expect "2026-10-15".weekday() == "Thursday"
  expect "2000-01-01".weekday() == "Saturday"
}
