// Conformance: lists and loops over them.

fn total(numbers: Number[]) -> Number {
  var sum = 0
  for n in numbers { sum += n }
  return sum
}

fn evens(numbers: Number[]) -> Number[] {
  return for n in numbers where n % 2 == 0 { n }
}

fn first_over(numbers: Number[], limit: Number) -> Number {
  for n in numbers {
    if n > limit { return n }
  }
  return -1
}

test "measuring and reaching in" {
  items = [10, 20, 30]
  expect items.length() == 3
  expect items[0] == 10
  expect items[2] == 30
  expect items.first().or(0) == 10
  expect items.last().or(0) == 30
  expect not items.is_empty()
  empty: Number[] = []
  expect empty.is_empty()
  expect empty.first().or(-1) == -1
}

test "a list is never changed; a new one is made" {
  items = [1, 2]
  more = items.append(3)
  expect items == [1, 2]
  expect more == [1, 2, 3]
  expect items.concat([8, 9]) == [1, 2, 8, 9]
}

test "parts and order" {
  items = [1, 2, 3, 4, 5]
  expect items.take(2) == [1, 2]
  expect items.drop(3) == [4, 5]
  expect items.slice(1, 3) == [2, 3]
  expect items.reverse() == [5, 4, 3, 2, 1]
  expect [1, 2, 2, 3, 1].unique() == [1, 2, 3]
}

test "finding" {
  expect [1, 2, 3].contains(2)
  expect not [1, 2, 3].contains(9)
  expect ["a", "b"].index_of("b").or(-1) == 1
  expect ["a", "b"].index_of("z").or(-1) == -1
}

test "a loop that gathers, filters and returns early" {
  expect total([1, 2, 3, 4]) == 10
  expect total([]) == 0
  expect evens([1, 2, 3, 4, 5, 6]) == [2, 4, 6]
  expect first_over([1, 5, 9], 4) == 5
  expect first_over([1, 2], 4) == -1
}

test "a loop that makes a new list" {
  doubled = for n in [1, 2, 3] { n * 2 }
  words = for word in ["a", "bb", "ccc"] where word.length() > 1 { word.upper() }
  expect doubled == [2, 4, 6]
  expect words == ["BB", "CCC"]
}

test "lists of lists" {
  grid = [[1, 2], [3, 4]]
  expect grid[1][0] == 3
  expect grid.length() == 2
  expect grid == [[1, 2], [3, 4]]
}
