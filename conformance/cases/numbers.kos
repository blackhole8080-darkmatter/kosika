// Conformance: numbers and their arithmetic.

fn half(n: Number) -> Number {
  return n / 2
}

test "whole-number arithmetic is exact" {
  expect 2 + 3 * 4 == 14
  expect (2 + 3) * 4 == 20
  expect 7 - 10 == -3
  expect 17 % 5 == 2
  expect 2 * 3 * 4 * 5 == 120
}

test "division gives a decimal when it must" {
  expect 10 / 4 == 2.5
  expect 9 / 3 == 3
  expect half(7) == 3.5
  expect 1 / 8 == 0.125
}

test "comparison" {
  expect 3 < 4
  expect 4 <= 4
  expect 5 > 4
  expect 5 >= 5
  expect 3 != 4
  expect not (3 == 4)
}

test "rounding to a whole number" {
  expect (2.5).floor() == 2
  expect (2.5).ceil() == 3
  expect (2.4).round() == 2
  expect (-2.5).floor() == -3
  expect (7).is_whole()
  expect not (7.5).is_whole()
}

test "roots, powers and size" {
  expect (16).sqrt() == 4
  expect (2).power(10) == 1024
  expect (-3).abs() == 3
  expect (2).sqrt() == 1.414213562
}

test "a number as text and back" {
  expect (12).to_text() == "12"
  expect (2.5).to_text() == "2.5"
  expect "42".to_number() == 42
}

fn worked(start: Number) -> Number {
  var n = start
  n += 5
  n -= 3
  n *= 2
  n /= 4
  return n
}

test "compound assignment" {
  expect worked(10) == 6
}
