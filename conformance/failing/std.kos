// Fails on purpose: the standard library refuses what it cannot do, and
// says why.

import "std/text.kos"
import "std/stats.kos"
import "std/db.kos"

test "chunks of no size" {
  expect chunks("a b c", 0, 0) == []
}

test "an overlap as big as the chunk" {
  expect chunks("a b c", 2, 2) == []
}

test "a column the answer does not have" {
  expect cell(["1"], ["id"], "title") == ""
}

test "a cell that is not a number" {
  expect as_number("later") == 0
}

test "a percentile past 100" {
  expect percentile([1, 2], 120).or(0) == 2
}

test "lists of different lengths" {
  expect correlation([1, 2], [1]).or(0) == 1
}
