// Refused: `finish` gives what the workflow returns, so its call must
// give the workflow's own type.

record Ask { text: Text }
record Hit { found: Bool text: Text }
record Reply { text: Text }

model thinker {
  input: Ask
  output: Hit
}

fn look(ask: Ask) -> Hit {
  return {found: ask.text == "hi", text: "hello"}
}

fn reply(hit: Hit) -> Reply {
  return {text: hit.text}
}

workflow main(ask: Ask) -> Reply {
  hit = look(ask)
  more = if hit.found { finish look(ask) } else { use_model thinker(text: ask.text) }
  out = reply(more)
}
