// Refused: a test runs a workflow with an input of the wrong type.

record Ask { text: Text }
record Said { text: Text }

fn echo(ask: Ask) -> Said {
  return {text: ask.text}
}

workflow main(ask: Ask) -> Said {
  said = echo(ask)
}

test "never runs" {
  r = main(ask: "hi")
  expect r.text == "hi"
}
