// Refused: a test may not script a tool that changes the world.

record Change { id: Text left: Number }
record Stock { id: Text left: Number }

tool set_stock {
  source mcp "shop"
  operation: "set_stock"
  access: execute
  input: Change
  output: Stock
}

agent clerk {
  can: [set_stock]
}

workflow main(change: Change) -> Stock {
  require approval
  stock = execute clerk.set_stock(id: change.id, left: change.left)
}

test "never runs" {
  answers set_stock: [{id: "a", left: 1}]
  r = main({id: "a", left: 1})
  expect r.left == 1
}
