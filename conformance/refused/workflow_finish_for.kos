// Refused: a `for` step makes all its passes; finishing is decided in
// an `if` step after it.

record Plan { steps: Text[] }
record Ask { text: Text }
record Hit { found: Bool text: Text }
record Reply { text: Text }

model thinker {
  input: Ask
  output: Hit
}

fn look(ask: Ask) -> Hit {
  return {found: ask.text == "hi", text: "hello"}
}

fn reply(hit: Hit) -> Reply {
  return {text: hit.text}
}

workflow main(plan: Plan) -> Reply {
  done = for s in plan.steps limit 3 {
    if s == "stop" { finish {text: "stopped"} } else { use_model thinker(text: s) }
  }
  out = reply(done[0])
}
