// Refused: a step whose every branch finishes is the last step written
// another way.

record Ask { text: Text }
record Hit { found: Bool text: Text }
record Reply { text: Text }

model thinker {
  input: Ask
  output: Hit
}

fn look(ask: Ask) -> Hit {
  return {found: ask.text == "hi", text: "hello"}
}

fn reply(hit: Hit) -> Reply {
  return {text: hit.text}
}

workflow main(ask: Ask) -> Reply {
  hit = look(ask)
  more = if hit.found { finish reply(hit) } else { finish {text: "no"} }
  out = reply(hit)
}
